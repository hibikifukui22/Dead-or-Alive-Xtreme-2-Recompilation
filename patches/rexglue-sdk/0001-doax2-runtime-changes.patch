diff --git a/include/rex/graphics/frame_bank.h b/include/rex/graphics/frame_bank.h
new file mode 100644
index 0000000..a1dffa2
--- /dev/null
+++ b/include/rex/graphics/frame_bank.h
@@ -0,0 +1,88 @@
+#pragma once
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <optional>
+namespace rex::graphics {
+// CPU-side ownership protocol for private render-resource banks.
+// Does not allocate resources, certify resource isolation, or submit GPU work.
+// One serialized command-processor owner; fence values must be observations
+// from the SAME queue timeline, never frame numbers or CPU completion counters.
+template <size_t Count> class FrameBanks {
+ public:
+  struct Lease {
+    size_t bank;
+    uint64_t generation;
+    bool operator==(const Lease&) const = default;
+  };
+  std::optional<Lease> Acquire(uint64_t completed_fence) {
+    if (completed_fence < completed_ || exhausted_) return std::nullopt;
+    completed_ = completed_fence;
+    for (size_t offset = 0; offset < Count; ++offset) {
+      const size_t i = (next_search_ + offset) % Count;
+      auto& bank = banks_[i];
+      if (bank.state == State::Submitted && bank.fence <= completed_)
+        bank.state = State::Free;
+      if (bank.state != State::Free) continue;
+      if (generation_ == std::numeric_limits<uint64_t>::max()) {
+        exhausted_ = true; return std::nullopt;
+      }
+      bank.generation = ++generation_;
+      bank.state = State::Recording;
+      next_search_ = (i + 1) % Count;
+      return Lease{i, bank.generation};
+    }
+    return std::nullopt; // Never overwrite a still-in-flight bank.
+  }
+  bool IsRecording(Lease lease) const {
+    return lease.bank < Count && banks_[lease.bank].generation == lease.generation &&
+           lease.generation && banks_[lease.bank].state == State::Recording;
+  }
+  // Call only after queue submission and a successful signal establish that
+  // this fence covers ALL references to the bank, including presentation.
+  bool Submitted(Lease lease, uint64_t fence) {
+    if (!IsRecording(lease) || fence <= completed_ || fence <= last_submitted_) return false;
+    auto& bank = banks_[lease.bank];
+    bank.state = State::Submitted;
+    bank.fence = fence;
+    last_submitted_ = fence;
+    return true;
+  }
+  // Extend protection when a later submission on the same queue consumes the
+  // bank. The exact prior fence prevents extending a stale lease.
+  bool ExtendSubmitted(Lease lease, uint64_t prior_fence, uint64_t fence) {
+    if (lease.bank >= Count || !lease.generation || fence <= prior_fence ||
+        fence <= last_submitted_) {
+      return false;
+    }
+    auto& bank = banks_[lease.bank];
+    if (bank.state != State::Submitted || bank.generation != lease.generation ||
+        bank.fence != prior_fence) {
+      return false;
+    }
+    bank.fence = fence;
+    last_submitted_ = fence;
+    return true;
+  }
+  // Only before any command referencing the bank has been submitted.
+  bool CancelUnsubmitted(Lease lease) {
+    if (!IsRecording(lease)) return false;
+    banks_[lease.bank].state = State::Free;
+    return true;
+  }
+  // Failed/uncertain submission or device loss: no fence proof exists.
+  // Recreate resources and this owner; do not silently make banks reusable.
+  void QuarantineAll() {
+    exhausted_ = true;
+    for (auto& bank : banks_) bank.state = State::Quarantined;
+  }
+ private:
+  enum class State { Free, Recording, Submitted, Quarantined };
+  struct Bank { State state = State::Free; uint64_t generation = 0, fence = 0; };
+  std::array<Bank, Count> banks_{};
+  uint64_t completed_ = 0, last_submitted_ = 0, generation_ = 0;
+  size_t next_search_ = 0;
+  bool exhausted_ = false;
+};
+}
