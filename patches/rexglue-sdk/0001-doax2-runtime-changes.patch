diff --git a/src/graphics/shaders/direct_rgba8_to_a8.cs.hlsl b/src/graphics/shaders/direct_rgba8_to_a8.cs.hlsl
new file mode 100644
index 0000000..136df56
--- /dev/null
+++ b/src/graphics/shaders/direct_rgba8_to_a8.cs.hlsl
@@ -0,0 +1,42 @@
+// Intel compatibility path for DOAX2 alpha-mask resolves. This fuses the
+// normal host-RT-to-EDRAM dump and EDRAM-to-tiled-A8 resolve into one pass.
+
+cbuffer XeDirectA8Constants : register(b0) {
+  uint xe_dest_base;
+  uint xe_dest_pitch;
+  uint xe_width;
+  uint xe_height;
+};
+
+Texture2D<float4> xe_source : register(t0);
+RWByteAddressBuffer xe_dest : register(u0);
+
+uint TiledOffset2D(uint x, uint y, uint pitch) {
+  pitch = (pitch + 31u) & ~31u;
+  uint macro = ((x >> 5u) + (y >> 5u) * (pitch >> 5u)) << 7u;
+  uint micro = (x & 7u) + ((y & 14u) << 2u);
+  uint offset = macro + ((micro & ~15u) << 1u) + (micro & 15u) +
+                ((y & 1u) << 4u);
+  return ((offset & ~511u) << 3u) + ((y & 16u) << 7u) +
+         ((offset & 448u) << 2u) +
+         (((((y & 8u) >> 2u) + (x >> 3u)) & 3u) << 6u) +
+         (offset & 63u);
+}
+
+// Four horizontally adjacent A8 texels are contiguous and DWORD-aligned in
+// Xbox 360 2D tiling, allowing one non-racing raw-buffer store per thread.
+[numthreads(16, 8, 1)]
+void main(uint3 dispatch_id : SV_DispatchThreadID) {
+  uint x = dispatch_id.x << 2u;
+  uint y = dispatch_id.y;
+  if (x >= xe_width || y >= xe_height) return;
+
+  uint packed = 0u;
+  [unroll]
+  for (uint i = 0u; i < 4u; ++i) {
+    uint alpha = (uint)(saturate(xe_source.Load(int3(x + i, y, 0)).a) *
+                        255.0f + 0.5f);
+    packed |= alpha << (i << 3u);
+  }
+  xe_dest.Store(xe_dest_base + TiledOffset2D(x, y, xe_dest_pitch), packed);
+}
