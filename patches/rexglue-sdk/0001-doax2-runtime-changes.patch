+void GraphicsSystem::PollCaptureRequest() {
+  const std::string request = REXCVAR_GET(gpu_capture_request_file);
+  if (request.empty() || !presenter_) {
+    return;
+  }
+  // Sequence: <path>_<index>.ppm, one per vblank tick.
+  if (capture_sequence_remaining_) {
+    --capture_sequence_remaining_;
+    CaptureGuestOutputTo(capture_sequence_path_ + "_" +
+                         std::to_string(capture_sequence_index_++) + ".ppm");
+    return;
+  }
+  std::error_code ec;
+  if (!std::filesystem::exists(request, ec)) {
+    return;
+  }
+  std::string out_path, count_line;
+  {
+    std::ifstream in(request);
+    std::getline(in, out_path);
+    std::getline(in, count_line);
+  }
+  std::filesystem::remove(request, ec);
+  while (!out_path.empty() && (out_path.back() == 0x0D || out_path.back() == 0x20)) out_path.pop_back();
+  const uint32_t count = uint32_t(std::strtoul(count_line.c_str(), nullptr, 10));
+  if (count > 1) {
+    capture_sequence_path_ = out_path;
+    capture_sequence_index_ = 0;
+    capture_sequence_remaining_ = count;
+    return;
+  }
+  CaptureGuestOutputTo(out_path);
+}
+
+void GraphicsSystem::CaptureGuestOutputTo(const std::string& out_path) {
+  std::error_code ec;
+  ::rex::ui::RawImage image;
+  if (out_path.empty() || !presenter_->CaptureGuestOutput(image) || !image.width || !image.height) {
+    REXGPU_WARN("Guest output capture failed ({})", out_path);
+    return;
+  }
+  std::ofstream out(out_path + ".tmp", std::ios::binary);
+  out << "P6" << char(10) << image.width << " " << image.height << char(10) << "255" << char(10);
+  std::vector<uint8_t> row(size_t(image.width) * 3);
+  for (uint32_t y = 0; y < image.height; ++y) {
+    const uint8_t* src = image.data.data() + size_t(y) * image.stride;
+    for (uint32_t x = 0; x < image.width; ++x) {
+      row[x * 3 + 0] = src[x * 4 + 0];
+      row[x * 3 + 1] = src[x * 4 + 1];
+      row[x * 3 + 2] = src[x * 4 + 2];
+    }
+    out.write(reinterpret_cast<const char*>(row.data()), std::streamsize(row.size()));
+  }
+  out.close();
+  std::filesystem::rename(out_path + ".tmp", out_path, ec);
+}
