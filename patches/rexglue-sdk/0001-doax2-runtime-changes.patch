@@ -902,6 +906,79 @@ bool PrimitiveProcessor::Process(ProcessingResult& result_out) {
           cache_transaction.SetNewResult(cacheable);
         }
       }
+      if (cacheable.index_buffer_type == ProcessedIndexBufferType::kGuestDMA &&
+          REXCVAR_GET(gpu_convert_indices_on_cpu)) {
+        CacheTransaction cache_transaction(
+            *this, CacheKey(guest_index_base, guest_draw_vertex_count, guest_index_format,
+                            guest_index_endian, guest_primitive_reset_enabled,
+                            xenos::PrimitiveType::kNone, true));
+        if (cache_transaction.GetFoundResult()) {
+          cacheable = *cache_transaction.GetFoundResult();
+        } else {
+          const uint32_t reset_index = regs.Get<reg::VGT_MULTI_PRIM_IB_RESET_INDX>().reset_indx;
+          static thread_local std::vector<uint32_t> converted;
+          converted.clear();
+          converted.reserve(guest_draw_vertex_count);
+          if (guest_index_format == xenos::IndexFormat::kInt16) {
+            auto guest_indices = memory_.TranslatePhysical<const uint16_t*>(guest_index_base);
+            for (uint32_t i = 0; i < guest_draw_vertex_count; ++i) {
+              uint32_t index = xenos::GpuSwap(guest_indices[i], guest_index_endian);
+              converted.push_back(guest_primitive_reset_enabled && index == (reset_index & 0xFFFF)
+                                      ? UINT32_MAX
+                                      : index);
+            }
+          } else {
+            auto guest_indices = memory_.TranslatePhysical<const uint32_t*>(guest_index_base);
+            for (uint32_t i = 0; i < guest_draw_vertex_count; ++i) {
+              uint32_t index =
+                  xenos::GpuSwap(guest_indices[i], guest_index_endian) & xenos::kVertexIndexMask;
+              converted.push_back(guest_primitive_reset_enabled && index == reset_index ? UINT32_MAX
+                                                                                        : index);
+            }
+          }
+          if (guest_primitive_reset_enabled &&
+              guest_primitive_type == xenos::PrimitiveType::kTriangleStrip) {
+            // Join the strips with degenerate triangles instead of relying on
+            // primitive restart, each strip starting at an even position to
+            // keep its winding.
+            static thread_local std::vector<uint32_t> stitched;
+            stitched.clear();
+            stitched.reserve(converted.size() + converted.size() / 4);
+            bool strip_start = false;
+            for (uint32_t index : converted) {
+              if (index == UINT32_MAX) {
+                strip_start = true;
+                continue;
+              }
+              if (strip_start && !stitched.empty()) {
+                const uint32_t last = stitched.back();
+                stitched.push_back(last);
+                if (!(stitched.size() & 1)) {
+                  stitched.push_back(last);
+                }
+                stitched.push_back(index);
+              }
+              strip_start = false;
+              stitched.push_back(index);
+            }
+            converted.swap(stitched);
+            cacheable.host_primitive_reset_enabled = false;
+            cacheable.host_draw_vertex_count = uint32_t(converted.size());
+          }
+          auto host_indices =
+              reinterpret_cast<uint32_t*>(RequestHostConvertedIndexBufferForCurrentFrame(
+                  xenos::IndexFormat::kInt32, uint32_t(converted.size()), false, guest_index_base,
+                  cacheable.host_index_buffer_handle));
+          if (!host_indices) {
+            return false;
+          }
+          std::memcpy(host_indices, converted.data(), converted.size() * sizeof(uint32_t));
+          cacheable.index_buffer_type = ProcessedIndexBufferType::kHostConverted;
+          cacheable.host_index_format = xenos::IndexFormat::kInt32;
+          cacheable.host_shader_index_endian = xenos::Endian::kNone;
+          cache_transaction.SetNewResult(cacheable);
+        }
+      }
     }
   }
 
