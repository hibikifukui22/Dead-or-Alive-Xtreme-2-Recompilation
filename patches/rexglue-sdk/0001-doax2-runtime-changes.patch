+void DrawExtentEstimator::LogVertexSample(const Shader& vertex_shader,
+                                          std::vector<uint32_t>* capture_indices,
+                                          std::vector<float>* capture_positions) {
+  const RegisterFile& regs = register_file_;
+  auto vgt_draw_initiator = regs.Get<reg::VGT_DRAW_INITIATOR>();
+  const uint32_t count = vgt_draw_initiator.num_indices;
+  if (!count || !ShaderInterpreter::CanInterpretShader(vertex_shader)) {
+    return;
+  }
+  const bool indexed = vgt_draw_initiator.source_select == xenos::SourceSelect::kDMA;
+  if (!indexed && vgt_draw_initiator.source_select != xenos::SourceSelect::kAutoIndex) {
+    return;
+  }
+  auto vgt_dma_size = regs.Get<reg::VGT_DMA_SIZE>();
+  xenos::Endian index_endian = vgt_dma_size.swap_mode;
+  const bool index_16 = vgt_draw_initiator.index_size == xenos::IndexFormat::kInt16;
+  if (index_16) {
+    if (index_endian == xenos::Endian::k8in32) {
+      index_endian = xenos::Endian::k8in16;
+    } else if (index_endian == xenos::Endian::k16in32) {
+      index_endian = xenos::Endian::kNone;
+    }
+  }
+  const void* index_buffer =
+      indexed ? memory_.TranslatePhysical(regs[XE_GPU_REG_VGT_DMA_BASE] &
+                                          ~uint32_t(index_16 ? 1 : 3))
+              : nullptr;
+  const uint32_t index_offset = regs.Get<reg::VGT_INDX_OFFSET>().indx_offset;
+  const uint32_t min_index = regs.Get<reg::VGT_MIN_VTX_INDX>().min_indx;
+  const uint32_t max_index = regs.Get<reg::VGT_MAX_VTX_INDX>().max_indx;
+  auto pa_cl_vte_cntl = regs.Get<reg::PA_CL_VTE_CNTL>();
+
+  shader_interpreter_.SetShader(vertex_shader);
+  PositionYExportSink sink;
+  shader_interpreter_.SetExportSink(&sink);
+  std::string samples;
+  const uint32_t sample_positions[] = {0, count / 3, count / 2, count - 1};
+  for (uint32_t position : sample_positions) {
+    uint32_t vertex_index = position;
+    if (indexed) {
+      vertex_index = index_16 ? static_cast<const uint16_t*>(index_buffer)[position]
+                              : static_cast<const uint32_t*>(index_buffer)[position];
+      vertex_index = xenos::GpuSwap(vertex_index, index_endian) & 0xFFFFFF;
+    }
+    vertex_index =
+        std::min(max_index, std::max(min_index, (vertex_index + index_offset) & 0xFFFFFF));
+    sink.Reset();
+    shader_interpreter_.temp_registers()[0] = float(vertex_index);
+    shader_interpreter_.Execute();
+    if (capture_indices && vertex_index < 0xFFFF) {
+      capture_indices->push_back(vertex_index);
+      std::string registers;
+      const float* r = shader_interpreter_.temp_registers();
+      for (uint32_t i = 0; i < 40; ++i) {
+        registers += fmt::format("{}{:.4f}", (i & 3) ? "," : " r", r[i]);
+      }
+      REXGPU_INFO("DOAX2 capture cpu VS {:016X} [{}]{}", vertex_shader.ucode_data_hash(),
+                  vertex_index, registers);
+    }
+    samples += fmt::format(" [{}]({:.3f},{:.3f},{:.3f},{:.3f})", vertex_index,
+                           sink.position_x().value_or(-99999.0f),
+                           sink.position_y().value_or(-99999.0f),
+                           sink.position_z().value_or(-99999.0f),
+                           sink.position_w().value_or(-99999.0f));
+  }
+  if (capture_positions) {
+    // Every vertex below the capture's slot count, xyzw, NaN if not used.
+    capture_positions->assign(4096 * 4, std::numeric_limits<float>::quiet_NaN());
+    for (uint32_t position = 0; position < count; ++position) {
+      uint32_t vertex_index = position;
+      if (indexed) {
+        vertex_index = index_16 ? static_cast<const uint16_t*>(index_buffer)[position]
+                                : static_cast<const uint32_t*>(index_buffer)[position];
+        vertex_index = xenos::GpuSwap(vertex_index, index_endian) & 0xFFFFFF;
+      }
+      vertex_index =
+          std::min(max_index, std::max(min_index, (vertex_index + index_offset) & 0xFFFFFF));
+      if (vertex_index >= 4096 || !std::isnan((*capture_positions)[vertex_index * 4 + 3])) {
+        continue;
+      }
+      sink.Reset();
+      shader_interpreter_.temp_registers()[0] = float(vertex_index);
+      shader_interpreter_.Execute();
+      float* out = capture_positions->data() + vertex_index * 4;
+      out[0] = sink.position_x().value_or(0.0f);
+      out[1] = sink.position_y().value_or(0.0f);
+      out[2] = sink.position_z().value_or(0.0f);
+      out[3] = sink.position_w().value_or(0.0f);
+    }
+  }
+  shader_interpreter_.SetExportSink(nullptr);
+  REXGPU_INFO("DOAX2 vertex sample VS {:016X} prim {} n {} min {} max {} off {} vte {:08X}:{}",
+              vertex_shader.ucode_data_hash(), uint32_t(vgt_draw_initiator.prim_type), count,
+              min_index, max_index, index_offset, pa_cl_vte_cntl.value, samples);
+}
