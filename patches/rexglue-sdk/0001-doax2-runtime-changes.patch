+std::atomic<uint64_t> transition_read_calls{0};
+std::atomic<uint64_t> transition_read_bytes{0};
+std::atomic<uint64_t> transition_read_microseconds{0};
+std::atomic<int64_t> transition_read_report_milliseconds{0};
+
+void RecordTransitionRead(const char* api, const XFile& file, uint32_t requested_bytes,
+                          uint32_t completed_bytes, uint64_t byte_offset, bool requested_async,
+                          X_STATUS result, uint64_t duration_microseconds) {
+  transition_read_calls.fetch_add(1, std::memory_order_relaxed);
+  transition_read_bytes.fetch_add(completed_bytes, std::memory_order_relaxed);
+  transition_read_microseconds.fetch_add(duration_microseconds, std::memory_order_relaxed);
+
+  if (duration_microseconds >= 2000) {
+    REXKRNL_INFO(
+        "DOAX2 transition IO slow: api={} path='{}' requested={} completed={} offset={} "
+        "requested_async={} duration_ms={:.3f} status={:#x}",
+        api, file.path(), requested_bytes, completed_bytes, byte_offset, requested_async,
+        double(duration_microseconds) / 1000.0, uint32_t(result));
+  }
+
+  using Clock = std::chrono::steady_clock;
+  const int64_t now_milliseconds =
+      std::chrono::duration_cast<std::chrono::milliseconds>(Clock::now().time_since_epoch())
+          .count();
+  int64_t previous_report = transition_read_report_milliseconds.load(std::memory_order_relaxed);
+  if (!previous_report) {
+    transition_read_report_milliseconds.compare_exchange_strong(
+        previous_report, now_milliseconds, std::memory_order_relaxed);
+    return;
+  }
+  if (now_milliseconds - previous_report < 500 ||
+      !transition_read_report_milliseconds.compare_exchange_strong(
+          previous_report, now_milliseconds, std::memory_order_relaxed)) {
+    return;
+  }
+
+  const uint64_t calls = transition_read_calls.exchange(0, std::memory_order_relaxed);
+  const uint64_t bytes = transition_read_bytes.exchange(0, std::memory_order_relaxed);
+  const uint64_t microseconds =
+      transition_read_microseconds.exchange(0, std::memory_order_relaxed);
+  if (calls) {
+    REXKRNL_INFO(
+        "DOAX2 transition IO window: calls={} bytes={} synchronous_host_ms={:.3f} "
+        "window_ms={}",
+        calls, bytes, double(microseconds) / 1000.0, now_milliseconds - previous_report);
+  }
+}
