+  if (!GetCandidateAuditPosition(swap_serial, before_draw)) return;
+  auto& frame = interpolation_frame_recording_;
+  if (frame.audit_ownership_plans.size() >= 4096) {
+    ++frame.audit_ownership_plans_dropped;
+    return;
+  }
+  frame.audit_ownership_plans.push_back({before_draw, ++frame.audit_event_serial,
