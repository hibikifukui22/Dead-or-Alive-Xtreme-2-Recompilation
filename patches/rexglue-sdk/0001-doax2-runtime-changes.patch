+
+void VulkanPipelineCache::SaveDriverPipelineCache() {
+  std::lock_guard<std::mutex> lock(driver_pipeline_cache_save_mutex_);
+  if (driver_pipeline_cache_ == VK_NULL_HANDLE || !driver_pipelines_unsaved_.exchange(0)) {
+    return;
+  }
+  const ui::vulkan::VulkanDevice* vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  size_t size = 0;
+  if (dfn.vkGetPipelineCacheData(vulkan_device->device(), driver_pipeline_cache_, &size, nullptr) !=
+          VK_SUCCESS ||
+      !size) {
+    return;
+  }
+  std::vector<char> data(size);
+  if (dfn.vkGetPipelineCacheData(vulkan_device->device(), driver_pipeline_cache_, &size,
+                                 data.data()) != VK_SUCCESS) {
+    return;
+  }
+  std::error_code error;
+  std::filesystem::create_directories(driver_pipeline_cache_path_.parent_path(), error);
+  std::filesystem::path temporary = driver_pipeline_cache_path_;
+  temporary += ".tmp";
+  {
+    std::ofstream file(temporary, std::ios::binary | std::ios::trunc);
+    file.write(data.data(), std::streamsize(size));
+    if (!file) {
+      return;
+    }
+  }
+  std::filesystem::rename(temporary, driver_pipeline_cache_path_, error);
+}
+
+void VulkanPipelineCache::CloseDriverPipelineCache() {
+  if (driver_pipeline_cache_ == VK_NULL_HANDLE) {
