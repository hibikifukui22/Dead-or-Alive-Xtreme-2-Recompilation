+bool D3D12RenderTargetCache::SubmitDoax2SecondFrameTargets(FrameBanks<2>::Lease lease,
+                                                           uint64_t fence) {
+  return doax2_second_frame_owner_.Submitted(lease, fence);
+}
+
+bool D3D12RenderTargetCache::ExtendDoax2SecondFrameTargets(
+    FrameBanks<2>::Lease lease, uint64_t prior_fence, uint64_t fence) {
+  const bool extended =
+      doax2_second_frame_owner_.ExtendSubmitted(lease, prior_fence, fence);
+  if (!extended) doax2_second_frame_owner_.QuarantineAll();
+  return extended;
+}
+
+void D3D12RenderTargetCache::CancelDoax2SecondFrameTargets(FrameBanks<2>::Lease lease) {
+  doax2_second_frame_owner_.CancelUnsubmitted(lease);
+}
