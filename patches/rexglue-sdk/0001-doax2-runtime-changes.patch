diff --git a/include/rex/audio/title_playlist_player.h b/include/rex/audio/title_playlist_player.h
new file mode 100644
index 0000000..78252c2
--- /dev/null
+++ b/include/rex/audio/title_playlist_player.h
@@ -0,0 +1,71 @@
+/**
+ * @file        audio/title_playlist_player.h
+ * @brief       Host playback for Xbox 360 XMP title playlists.
+ *
+ * @copyright   Copyright (c) 2026 Tom Clay <tomc@tctechstuff.com>
+ *              All rights reserved.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include <rex/memory/mapped_memory.h>
+
+namespace rex::audio {
+
+struct TitlePlaylistTrack {
+  std::shared_ptr<memory::MappedMemory> encoded_data;
+  std::string name;
+  // Guest file path, identifies the same song across playlists.
+  std::string path;
+};
+
+struct TitlePlaylistDiagnostics {
+  uint64_t generation = 0;
+  size_t track_count = 0;
+  size_t requested_track = 0;
+  size_t decoded_track = 0;
+  size_t decoded_stereo_frames = 0;
+  size_t mixed_stereo_frames = 0;
+  float requested_volume = 1.0f;
+  float effective_gain = 0.25f;
+  bool playing = false;
+  bool paused = false;
+  bool decoding = false;
+  bool decode_failed = false;
+};
+
+// The XMP service owns playlist semantics while this process-wide player owns
+// host decoding and output. The Xbox exposes one system/title music player, so
+// there must never be more than one active stream.
+bool PlayTitlePlaylist(std::vector<TitlePlaylistTrack> tracks, size_t first_track);
+// Replaces the track list without interrupting the audible song, which must be
+// tracks[current_track]; playback continues from its position and then moves
+// on through the new list.
+bool AdoptTitlePlaylist(std::vector<TitlePlaylistTrack> tracks, size_t current_track);
+// Called from the decoder thread when a song that the player moved to on its
+// own (end of song) is ready to play; Next/Previous come from the title, which
+// refreshes its song information itself.
+void SetTitlePlaylistTrackChangedCallback(std::function<void(size_t track)> callback);
+void ContinueTitlePlaylist();
+void PauseTitlePlaylist();
+void StopTitlePlaylist();
+void NextTitlePlaylistTrack();
+void PreviousTitlePlaylistTrack();
+void SetTitlePlaylistVolume(float volume);
+
+// Mixes 48 kHz stereo music into interleaved float output. On surround output,
+// only front-left/front-right are touched. Safe on the SDL audio callback.
+void MixTitlePlaylist(float* output, size_t frame_count, uint8_t channel_count);
+
+TitlePlaylistDiagnostics GetTitlePlaylistDiagnostics();
+
+}  // namespace rex::audio
