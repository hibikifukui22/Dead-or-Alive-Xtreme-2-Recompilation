+    }
+  }
+  if (!candidate_audit) {
+    TryCaptureOwnedRenderUnit(draw);
+    TryCaptureOwnedRenderGroupUnit(draw,
+                                   interpolation_frame_recording_.draws.size());
+  } else if (REXCVAR_GET(d3d12_doax2_owned_composite_draw)) {
+    TryCaptureOwnedRenderUnit(draw);
+  }
+  interpolation_frame_recording_.draws.push_back(std::move(draw));
+  if (candidate_audit) {
+    interpolation_frame_recording_.audit_capture_ns +=
+        std::chrono::duration_cast<std::chrono::nanoseconds>(
+            std::chrono::steady_clock::now() - audit_begin).count();
+  }
