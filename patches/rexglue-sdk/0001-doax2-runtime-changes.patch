+
+void D3D12CommandProcessor::AuditOwnedRenderCandidates(
+    const InterpolationFrame& previous, const InterpolationFrame& current) {
+  const auto begin = std::chrono::steady_clock::now();
+  struct Run {
+    uint64_t target = 0, bytes = 0;
+    size_t first = 0, count = 0, oversized_units = 0;
+    // Attachment mask, bindless, side effects, pixel shader, constants,
+    // index class, empty draw. These are independent counts.
+    std::array<size_t, 7> unsupported{};
+    size_t missing_pipeline = 0;
+    float area = 0;
+  };
+  struct FrameInfo {
+    std::vector<Run> runs;
+    std::vector<uint64_t> recipes;
+    std::vector<std::array<uint64_t, 8>> fields;
+  };
+  auto target_identity = [](const InterpolationDrawBinding& draw) {
+    uint64_t hash = 14695981039346656037ull;
+    auto mix = [&](uint32_t value) { hash = (hash ^ value) * 1099511628211ull; };
+    mix(draw.bound_render_target_bits);
+    for (auto value : draw.bound_render_target_keys) mix(value);
+    for (auto value : draw.bound_render_target_formats) mix(value);
+    return hash;
+  };
+  auto inspect = [&](const InterpolationFrame& frame) {
+    FrameInfo info;
+    info.recipes.resize(frame.draws.size());
+    info.fields.resize(frame.draws.size());
+    for (size_t i = 0; i < frame.draws.size(); ++i) {
+      const auto& draw = frame.draws[i];
+      const uint64_t target = target_identity(draw);
+      if (info.runs.empty() || info.runs.back().target != target) {
+        info.runs.push_back(Run{});
+        info.runs.back().target = target;
+        info.runs.back().first = i;
+      }
+      auto& run = info.runs.back();
+      ++run.count;
+      info.recipes[i] = GetOwnedRenderUnitRecipeKey(frame, draw, &info.fields[i]);
+      const uint64_t bytes = GetOwnedRenderUnitDependencyBytes(draw);
+      run.bytes += bytes;
+      run.oversized_units += bytes > (32ull << 20);
+      run.unsupported[0] += draw.bound_render_target_bits != 0x3;
+      run.unsupported[1] += !draw.bindless_descriptors;
+      run.unsupported[2] += draw.shader_side_effects;
+      run.unsupported[3] += !draw.pixel_shader_hash;
+      run.unsupported[4] += draw.constants_index >= frame.vertex_constants.size() ||
+          (draw.pixel_constants_index != UINT32_MAX &&
+           draw.pixel_constants_index >= frame.pixel_constants.size());
+      run.unsupported[5] += draw.index_buffer_type != uint8_t(PrimitiveProcessor::kGuestDMA);
+      run.unsupported[6] += !draw.host_draw_vertex_count;
+      run.missing_pipeline += !draw.pipeline_handle || !draw.root_signature;
+      run.area = std::max(run.area, draw.viewport.Width * draw.viewport.Height);
+    }
+    return info;
+  };
+  const auto n = inspect(previous);
+  const auto n1 = inspect(current);
+  // A target-identity run is not necessarily an executable render pass:
+  // resolves may consume or clear the same EDRAM target between its draws.
+  // Keep production selection unchanged, but measure the largest run by
+  // resolve-separated spans and by unique guest backing bytes. Summing each
+  // draw's full texture ranges can otherwise greatly overstate its footprint.
+  if (!n1.runs.empty()) {
+    const auto largest = std::max_element(
+        n1.runs.begin(), n1.runs.end(),
+        [](const Run& a, const Run& b) { return a.count < b.count; });
+    std::vector<size_t> boundaries;
+    for (const auto& event : current.audit_resolves) {
+      if (event.before_draw > largest->first &&
+          event.before_draw < largest->first + largest->count)
+        boundaries.push_back(event.before_draw);
+    }
+    std::sort(boundaries.begin(), boundaries.end());
+    boundaries.erase(std::unique(boundaries.begin(), boundaries.end()),
+                     boundaries.end());
+    std::vector<std::pair<uint64_t, uint64_t>> ranges;
+    std::vector<uint64_t> byte_prefix(1, 0);
+    auto add_range = [&](uint64_t address, uint64_t size) {
+      if (size) ranges.emplace_back(address, address + size);
+    };
+    std::array<size_t, 5> index_classes{};
+    size_t absent_pixel_shader = 0;
+    for (size_t ordinal = largest->first;
+         ordinal < largest->first + largest->count; ++ordinal) {
+      const auto& draw = current.draws[ordinal];
+      byte_prefix.push_back(byte_prefix.back() +
+                            GetOwnedRenderUnitDependencyBytes(draw));
+      absent_pixel_shader += !draw.pixel_shader_hash;
+      const size_t index_class = draw.index_buffer_type;
+      if (index_class < index_classes.size()) ++index_classes[index_class];
+      for (size_t word = 0; word + 1 < draw.vertex_fetch_words.size(); word += 2) {
+        xenos::xe_gpu_vertex_fetch_t fetch{};
+        fetch.dword_0 = draw.vertex_fetch_words[word];
+        fetch.dword_1 = draw.vertex_fetch_words[word + 1];
+        add_range(uint64_t(fetch.address) << 2, uint64_t(fetch.size) << 2);
+      }
+      if (draw.index_buffer_type == uint8_t(PrimitiveProcessor::kGuestDMA))
+        add_range(draw.guest_index_base, draw.index_bytes);
+      auto add_texture_keys = [&](const auto& keys) {
+        for (const auto& key : keys) {
+          if (!key.IsValid()) continue;
+          add_range(key.GetGuestBaseAddress(), key.GetGuestBaseSize());
+          add_range(key.GetGuestMipAddress(), key.GetGuestMipsSize());
+        }
+      };
+      add_texture_keys(draw.texture_srv_keys_vertex);
+      add_texture_keys(draw.texture_srv_keys_pixel);
+    }
+    std::sort(ranges.begin(), ranges.end());
+    uint64_t unique_bytes = 0, covered_end = 0;
+    for (const auto& [begin, end] : ranges) {
+      if (end > covered_end) {
+        unique_bytes += end - std::max(begin, covered_end);
+        covered_end = end;
+      }
+    }
+    std::vector<size_t> span_lengths;
+    std::vector<uint64_t> span_logical_bytes;
+    size_t span_begin = largest->first;
+    for (const size_t boundary : boundaries) {
+      span_lengths.push_back(boundary - span_begin);
+      span_logical_bytes.push_back(
+          byte_prefix[boundary - largest->first] -
+          byte_prefix[span_begin - largest->first]);
+      span_begin = boundary;
+    }
+    span_lengths.push_back(largest->first + largest->count - span_begin);
+    span_logical_bytes.push_back(
+        byte_prefix.back() - byte_prefix[span_begin - largest->first]);
+    auto footprint_counts_string = [](const auto& values) {
+      std::string result;
+      for (const auto value : values) {
+        if (!result.empty()) result += ',';
+        result += std::to_string(value);
+      }
+      return result;
+    };
+    REXGPU_INFO(
+        "DOAX2 candidate audit largest-run footprint: frame={} first={} draws={} logical_bytes={} unique_guest_bytes={} guest_ranges={} resolve_boundaries=[{}] span_draws=[{}] span_logical_bytes=[{}] index_classes=[{}] absent_pixel_shader={} accounting=read_only",
+        current.guest_swap_serial, largest->first, largest->count,
+        largest->bytes, unique_bytes, ranges.size(),
+        footprint_counts_string(boundaries),
+        footprint_counts_string(span_lengths),
+        footprint_counts_string(span_logical_bytes),
+        footprint_counts_string(index_classes), absent_pixel_shader);
+  }
+  if (REXCVAR_GET(d3d12_doax2_owned_composite_source_copy)) {
+    auto describe_composite = [&](const InterpolationFrame& frame,
+                                  const char* which) {
+      size_t vertex_quad_count = 0, exact_shader_count = 0;
+      size_t source_base_count = 0, details = 0;
+      for (size_t ordinal = 0; ordinal < frame.draws.size(); ++ordinal) {
+        const auto& draw = frame.draws[ordinal];
+        if (draw.shader_hash != 0x118071C8F97830EAull ||
+            draw.host_draw_vertex_count != 4) continue;
+        ++vertex_quad_count;
+        const bool exact_shader =
+            draw.pixel_shader_hash == 0x1E70EB9513D670C9ull;
+        exact_shader_count += exact_shader;
+        uint32_t first_base = 0;
+        bool target_base = false;
+        for (const auto& key : draw.texture_srv_keys_pixel) {
+          if (!key.IsValid()) continue;
+          if (!first_base) first_base = key.GetGuestBaseAddress();
+          target_base |= key.GetGuestBaseAddress() == 0x1F90F000;
+        }
+        source_base_count += target_base;
+        if (details < 4 && (exact_shader || target_base)) {
+          REXGPU_INFO(
+              "DOAX2 adjacent composite draw: side={} frame={} ordinal={} ps={:016X} first_guest_base={:08X} target_base={} rt_bits={:02X} rt_keys={:08X}/{:08X} texture_keys={}; sampled CPU description only",
+              which, frame.guest_swap_serial, ordinal,
+              draw.pixel_shader_hash, first_base, target_base,
+              draw.bound_render_target_bits,
