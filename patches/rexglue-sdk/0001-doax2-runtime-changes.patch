+                                            clear_transfers_[0], clear_render_targets[1],
+                                            clear_transfers_[1])) {
+    return false;
+  }
+  uint64_t clear_values[2];
+  clear_values[0] = info.rb_depth_clear;
+  clear_values[1] = info.rb_color_clear | (uint64_t(info.rb_color_clear_lo) << 32);
+  resolve_clear_keep_stencil_ = keep_stencil;
+  PerformTransfersAndResolveClears(2, clear_render_targets, clear_transfers_, clear_values,
+                                   &clear_rectangle);
+  resolve_clear_keep_stencil_ = false;
+  return (!info.IsClearingDepth() || clear_render_targets[0]) &&
+         (!info.IsClearingColor() || clear_render_targets[1]);
