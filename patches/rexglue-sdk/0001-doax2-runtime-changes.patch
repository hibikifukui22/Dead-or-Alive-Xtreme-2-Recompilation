+  }
+  width_out = key.GetWidth();
+  height_out = key.GetHeight();
+  VkImageView store_view = vulkan_texture.GetDoax2StoreView();
+  if (store_view == VK_NULL_HANDLE) {
+    return false;
+  }
+  VkDescriptorSet descriptor_set = command_processor_.AllocateSingleTransientDescriptor(
+      VulkanCommandProcessor::SingleTransientDescriptorLayout::kStorageImageCompute);
+  if (descriptor_set == VK_NULL_HANDLE) {
+    return false;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  VkDescriptorImageInfo image_info;
+  image_info.sampler = VK_NULL_HANDLE;
+  image_info.imageView = store_view;
+  image_info.imageLayout = VK_IMAGE_LAYOUT_GENERAL;
+  VkWriteDescriptorSet write = {};
+  write.sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+  write.dstSet = descriptor_set;
+  write.dstBinding = 0;
+  write.descriptorCount = 1;
+  write.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;
+  write.pImageInfo = &image_info;
+  vulkan_device->functions().vkUpdateDescriptorSets(vulkan_device->device(), 1, &write, 0,
+                                                    nullptr);
+  vulkan_texture.MarkAsUsed();
+  // Always a barrier (also write after write), keeping the contents.
+  VulkanTexture::Usage old_usage = vulkan_texture.SetUsage(VulkanTexture::Usage::kComputeWrite);
+  VkPipelineStageFlags src_stage_mask, dst_stage_mask;
+  VkAccessFlags src_access_mask, dst_access_mask;
+  VkImageLayout old_layout, new_layout;
+  GetTextureUsageMasks(old_usage, src_stage_mask, src_access_mask, old_layout);
+  GetTextureUsageMasks(VulkanTexture::Usage::kComputeWrite, dst_stage_mask, dst_access_mask,
+                       new_layout);
+  if (!src_stage_mask) {
+    src_stage_mask = VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT;
+  }
+  command_processor_.PushImageMemoryBarrier(
+      vulkan_texture.image(), ui::vulkan::util::InitializeSubresourceRange(), src_stage_mask,
+      dst_stage_mask, src_access_mask, dst_access_mask, old_layout, new_layout);
+  descriptor_set_out = descriptor_set;
+  doax2_direct_pending_ = texture;
+  return true;
+}
+
+void VulkanTextureCache::Doax2WriteLazyResolve(const Doax2LazyResolve& lazy) {
+  VulkanTexture& vulkan_texture = static_cast<VulkanTexture&>(*lazy.texture);
+  const TextureKey& key = vulkan_texture.key();
+  const uint32_t base = key.base_page << 12;
+  VkImageView store_view = vulkan_texture.GetDoax2StoreView();
+  uint64_t dest_start, dest_length;
+  if (doax2_lazy_write_back_pipeline_ == VK_NULL_HANDLE || store_view == VK_NULL_HANDLE ||
+      !GetScaledResolveRange(base, lazy.end - base, 2, dest_start, dest_length)) {
+    REXGPU_ERROR("VulkanTextureCache: DOAX2 lazy resolve write-back unavailable");
+    return;
+  }
+  VkDescriptorSet descriptor_set_src = command_processor_.AllocateSingleTransientDescriptor(
+      VulkanCommandProcessor::SingleTransientDescriptorLayout::kStorageImageCompute);
+  VkDescriptorSet descriptor_set_dest = command_processor_.AllocateSingleTransientDescriptor(
+      VulkanCommandProcessor::SingleTransientDescriptorLayout::kStorageBufferCompute);
+  if (descriptor_set_src == VK_NULL_HANDLE || descriptor_set_dest == VK_NULL_HANDLE) {
+    REXGPU_ERROR("VulkanTextureCache: DOAX2 lazy resolve write-back descriptors failed");
+    return;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  VkDescriptorImageInfo image_info;
+  image_info.sampler = VK_NULL_HANDLE;
+  image_info.imageView = store_view;
+  image_info.imageLayout = VK_IMAGE_LAYOUT_GENERAL;
+  VkDescriptorBufferInfo buffer_info;
+  buffer_info.buffer = scaled_resolve_buffer_;
+  buffer_info.offset = dest_start;
+  buffer_info.range = dest_length;
+  VkWriteDescriptorSet writes[2] = {};
+  writes[0].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+  writes[0].dstSet = descriptor_set_src;
+  writes[0].descriptorCount = 1;
+  writes[0].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;
+  writes[0].pImageInfo = &image_info;
+  writes[1].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+  writes[1].dstSet = descriptor_set_dest;
+  writes[1].descriptorCount = 1;
+  writes[1].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+  writes[1].pBufferInfo = &buffer_info;
+  vulkan_device->functions().vkUpdateDescriptorSets(vulkan_device->device(), 2, writes, 0,
+                                                    nullptr);
+
+  vulkan_texture.MarkAsUsed();
+  VulkanTexture::Usage old_usage = vulkan_texture.SetUsage(VulkanTexture::Usage::kComputeWrite);
+  VkPipelineStageFlags src_stage_mask, dst_stage_mask;
+  VkAccessFlags src_access_mask, dst_access_mask;
+  VkImageLayout old_layout, new_layout;
+  GetTextureUsageMasks(old_usage, src_stage_mask, src_access_mask, old_layout);
+  GetTextureUsageMasks(VulkanTexture::Usage::kComputeWrite, dst_stage_mask, dst_access_mask,
+                       new_layout);
+  if (!src_stage_mask) {
+    src_stage_mask = VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT;
+  }
+  command_processor_.PushImageMemoryBarrier(
+      vulkan_texture.image(), ui::vulkan::util::InitializeSubresourceRange(), src_stage_mask,
+      dst_stage_mask, src_access_mask, dst_access_mask, old_layout, new_layout);
+  UseScaledResolveBufferForWrite(dest_start, dest_length);
+  command_processor_.SubmitBarriers(true);
+
+  const uint32_t scale_x = draw_resolution_scale_x(), scale_y = draw_resolution_scale_y();
+  const uint32_t width = lazy.width * scale_x, height = lazy.height * scale_y;
+  uint32_t constants[4 + 4 * kDoax2MaxDeadRects] = {};
+  constants[0] = (lazy.x0 * scale_x) | ((lazy.y0 * scale_y) << 16);
+  constants[1] = width | (height << 16);
+  // k_24_8: the texture holds the loaded float depth.
+  constants[2] = scale_x | (scale_y << 4) | (uint32_t(key.endianness) << 8) |
+                 (uint32_t(key.format == xenos::TextureFormat::k_24_8) << 10) |
+                 (uint32_t(key.pitch) << 16);
+  constants[3] = lazy.dead_count;
+  for (uint32_t i = 0; i < lazy.dead_count; ++i) {
+    const Doax2DeadRect& dead = lazy.dead[i];
+    uint32_t* dead_constants = constants + 4 + 4 * i;
+    dead_constants[0] = uint32_t(dead.offset);
+    dead_constants[1] = dead.pitch_div_32 | (dead.bpp_log2 << 16);
+    dead_constants[2] = dead.x0 | (dead.y0 << 16);
+    dead_constants[3] = dead.x1 | (dead.y1 << 16);
+  }
+  DeferredCommandBuffer& command_buffer = command_processor_.deferred_command_buffer();
+  command_processor_.BindExternalComputePipeline(doax2_lazy_write_back_pipeline_);
+  VkDescriptorSet descriptor_sets[2] = {descriptor_set_src, descriptor_set_dest};
+  command_buffer.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE,
+                                         doax2_lazy_write_back_pipeline_layout_, 0, 2,
+                                         descriptor_sets, 0, nullptr);
+  command_buffer.CmdVkPushConstants(doax2_lazy_write_back_pipeline_layout_,
+                                    VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(constants), constants);
+  command_buffer.CmdVkDispatch((width + 15) / 16, (height + 7) / 8, 1);
+}
+
+VkFormat VulkanTextureCache::Doax2StoreFormat(uint32_t bytes) {
+  switch (bytes) {
+    case 1:
+      return VK_FORMAT_R8_UINT;
+    case 2:
+      return VK_FORMAT_R16_UINT;
+    case 4:
+      return VK_FORMAT_R32_UINT;
+    case 8:
+      return VK_FORMAT_R16G16B16A16_UINT;
+    case 16:
+      return VK_FORMAT_R32G32B32A32_UINT;
+    default:
+      return VK_FORMAT_UNDEFINED;
+  }
+}
+
+uint32_t VulkanTextureCache::Doax2StoreBytes(const TextureKey& key) const {
+  // Screen copies (resolution-scaled), 2D, one level and layer.
+  if (!REXCVAR_GET(vulkan_direct_texture_store) || !key.scaled_resolve ||
+      key.dimension != xenos::DataDimension::k2DOrStacked || key.depth_or_array_size_minus_1 ||
+      key.mip_max_level) {
+    return 0;
+  }
+  const HostFormatPair& host_format_pair = GetHostFormatPair(key);
+  bool is_signed = IsSignedVersionSeparateForFormat(key)
+                       ? bool(key.signed_separate)
+                       : host_format_pair.format_unsigned.load_shader == kLoadShaderIndexUnknown;
+  const HostFormat& host_format =
+      is_signed ? host_format_pair.format_signed : host_format_pair.format_unsigned;
+  if (host_format.load_shader == kLoadShaderIndexUnknown || host_format.block_compressed) {
+    return 0;
+  }
+  switch (host_format.load_shader) {
+    // Two-pass float conversion in the scratch buffer.
+    case kLoadShaderIndexR10G11B11ToRGBA16:
+    case kLoadShaderIndexR11G11B10ToRGBA16:
+    case kLoadShaderIndexR10G11B11ToRGBA16SNorm:
+    case kLoadShaderIndexR11G11B10ToRGBA16SNorm:
+      if (host_format.format == VK_FORMAT_R16G16B16A16_SFLOAT) {
+        return 0;
+      }
+      break;
+    default:
+      break;
+  }
+  const uint32_t bytes = GetLoadShaderInfo(host_format.load_shader).bytes_per_host_block;
+  const size_t pipeline_index = Doax2StorePipelineIndex(bytes);
+  if (pipeline_index >= doax2_store_pipelines_.size() ||
+      doax2_store_pipelines_[pipeline_index] == VK_NULL_HANDLE) {
+    return 0;
+  }
+  return bytes;
 }
 
