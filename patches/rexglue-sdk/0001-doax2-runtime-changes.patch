+void D3D12RenderTargetCache::EndDoax2FrameCensus(uint64_t guest_frame) {
+  if (!REXCVAR_GET(d3d12_doax2_second_frame_census)) return;
+  if (++doax2_census_frames_ < 120) return;
+  REXGPU_INFO(
+      "DOAX2 second-frame resources: ending_frame={} frames={} path={} edram_backing={} draws={} rov_draws={} host_targets={} transfer_ranges={} resolve_destinations={}",
+      guest_frame, doax2_census_frames_,
+      GetPath() == Path::kHostRenderTargets ? "host_rt" : "edram_rov",
+      static_cast<void*>(edram_buffer_), doax2_census_draws_, doax2_census_rov_draws_,
+      doax2_census_targets_.size(), doax2_census_transfer_ranges_,
+      doax2_census_resolves_.size());
+  size_t emitted = 0;
+  for (const auto& [identity, target] : doax2_census_targets_) {
+    if (emitted++ >= 32) break;
+    REXGPU_INFO(
+        "DOAX2 second-frame target: backing={} key={:08X} type={} base_tiles={} pitch_tiles={} msaa={} format={} bindings={}",
+        reinterpret_cast<void*>(identity), target.key.key,
+        target.key.is_depth ? "depth" : "color", target.key.base_tiles,
+        target.key.GetPitchTiles(), uint32_t(1) << uint32_t(target.key.msaa_samples),
+        target.key.GetFormatName(), target.bindings);
+  }
+  for (const auto& [identity, resolve] : doax2_census_resolves_) {
+    REXGPU_INFO(
+        "DOAX2 second-frame resolve: base={:08X} extent={:08X}+{:X} calls={} depth_copy={} color_copy={} depth_clear={} color_clear={}",
+        resolve.base, resolve.extent_start, resolve.extent_length, resolve.calls,
+        resolve.depth_copies, resolve.color_copies, resolve.depth_clears,
+        resolve.color_clears);
+  }
+  doax2_census_frames_ = doax2_census_draws_ = doax2_census_transfer_ranges_ = 0;
+  doax2_census_rov_draws_ = 0;
+  doax2_census_targets_.clear();
+  doax2_census_resolves_.clear();
+}
