+            "DOAX2 terminal lineage: frame={} final_event={} suffix_after_event={} start_draw={} final_draw={} claims={} transfers={} unknown_claim_pieces={} no_target_draws={} outside_terminal_draws={} suffix_memexport_draws={} prior_owner_checkpoint={} prior_owner_key={:08X} expected_owner={:08X} traced_owners=[{}] owner_observed={} owner_match={} failed_versions={} missing_output_pixels={} content_complete={} final_layout_and_draw_inputs=unproven publishable=false",
+            current.guest_swap_serial, final_index,
+            final_index ? final_index - 1 : SIZE_MAX, start_draw,
+            final.before_draw, suffix_claims, suffix_transfers,
+            unknown_claim_pieces, no_target_draws, outside_terminal_draws,
+            suffix_memexport_draws, prior_owner_checkpoint, prior_owner_key,
+            final.owners[0][0],
+            counts_string(trace.terminal_owner_keys), owner_observed,
+            owner_match,
+            trace.failed_versions.size(), trace.missing_output_pixels,
+            trace.complete);
+      } else {
+        REXGPU_INFO(
+            "DOAX2 terminal lineage rejected: frame={} final_event={} owner_shape={} first_invalid_draw={} start_draw={} final_draw={} claims={} transfers={} reason=ambiguous_or_incomplete_suffix publishable=false",
+            current.guest_swap_serial, final_index, owner_shape,
+            first_invalid_draw, start_draw, final.before_draw,
+            suffix_claims, suffix_transfers);
+      }
+    } else {
+      REXGPU_INFO("DOAX2 terminal lineage skipped: frame={} reason=no_exact_final_swap_resolve publishable=false",
+                  current.guest_swap_serial);
+    }
+  }
+  // Bound detail logging by shape, rather than logging every repeated draw.
+  std::unordered_set<uint64_t> unsupported_shapes;
+  size_t omitted_shapes = 0;
+  for (size_t d = 0; d < current.draws.size(); ++d) {
+    const auto& draw = current.draws[d];
+    if (draw.pixel_shader_hash && draw.index_buffer_type == uint8_t(PrimitiveProcessor::kGuestDMA)) continue;
+    uint64_t shape = draw.shader_hash ^ (draw.pixel_shader_hash << 1);
+    shape ^= uint64_t(draw.index_buffer_type) << 48;
+    shape ^= uint64_t(draw.host_draw_vertex_count) << 16;
+    shape ^= draw.bound_render_target_bits;
+    if (!unsupported_shapes.insert(shape).second) continue;
+    if (unsupported_shapes.size() > 16) { ++omitted_shapes; continue; }
+    REXGPU_INFO("DOAX2 candidate audit unsupported_shape: frame={} ordinal={} vs={:016X} ps={:016X} index_class={} guest_primitive={} host_primitive={} vertices={} rt_mask={} keys={:08X}/{:08X} viewport={}x{} textures={:08X} side_effects={}",
+        current.guest_swap_serial, d, draw.shader_hash, draw.pixel_shader_hash,
+        draw.index_buffer_type, draw.guest_primitive_type, draw.host_primitive_type,
+        draw.host_draw_vertex_count, draw.bound_render_target_bits,
+        draw.bound_render_target_keys[0], draw.bound_render_target_keys[1],
+        draw.viewport.Width, draw.viewport.Height, draw.used_texture_mask, draw.shader_side_effects);
+  }
+  if (omitted_shapes) REXGPU_INFO("DOAX2 candidate audit unsupported_shapes_omitted={}", omitted_shapes);
+  const double elapsed_ms = std::chrono::duration<double, std::milli>(
+      std::chrono::steady_clock::now() - begin).count();
+  REXGPU_INFO(
+      "DOAX2 candidate audit summary: pair={}/{} draws={}/{} runs={}/{} eligible={} reported={} omitted={} independent_rejections=[{}] first_rejections=[{}] missing_cbv={}/{} capture_ms={:.3f}/{:.3f} analysis_and_log_ms={:.3f} group_slots={} submission={}/{} gpu_resource_availability=not_tested lifetime_probe=not_executed reconstruction=0 publication=0",
+      previous.guest_swap_serial, current.guest_swap_serial, previous.draws.size(),
+      current.draws.size(), n.runs.size(), n1.runs.size(), eligible, report_count,
+      report_order.size() - report_count, counts_string(rejection_counts),
+      counts_string(first_rejection_counts), previous.audit_missing_vertex_constants,
+      current.audit_missing_vertex_constants, double(previous.audit_capture_ns) / 1e6,
+      double(current.audit_capture_ns) / 1e6, elapsed_ms,
+      owned_render_group_slots_.size(), submission_current_, submission_completed_);
+}
+
+// Diagnostic burst capture (xenos60): F10 records the next 60 swap sources
+// into a ring of readback buffers and writes each as a half-size BMP once its
+// submission has completed, so per-update motion can be inspected without a
+// screen recorder. Frames whose ring slot is still busy are logged as gaps.
+// Per-session tag for burst file names (HHMMSS of the first use) so runs
+// do not overwrite each other's captures.
+static const std::string doax2_burst_session = [] {
+  const std::time_t now = std::time(nullptr);
+  std::tm local{};
+  localtime_s(&local, &now);
+  char text[16];
+  std::strftime(text, sizeof(text), "%H%M%S", &local);
+  return std::string(text);
+}();
+
+void D3D12CommandProcessor::CaptureDoax2FrameBurst(ID3D12Resource* source,
+                                                   const D3D12_RESOURCE_DESC& desc) {
+  struct Slot {
+    Microsoft::WRL::ComPtr<ID3D12Resource> readback;
+    D3D12_PLACED_SUBRESOURCE_FOOTPRINT footprint{};
+    UINT64 bytes = 0;
+    UINT64 width = 0;
+    UINT height = 0;
+    uint64_t submission = 0;
+    uint64_t frame = 0;
+    bool pending = false;
+  };
+  constexpr uint32_t kBurstFrames = 60;
+  static std::array<Slot, 8> slots;
+  static uint32_t next_slot = 0, burst_id = 0, recorded = 0, gaps = 0;
+  static uint64_t burst_start = 0;
+  static bool key_was_down = false;
+  const uint64_t frame = doax2_transform_trace_swap_serial;
+  // Write out completed frames.
+  for (auto& slot : slots) {
+    if (!slot.pending || slot.submission > submission_completed_) continue;
+    void* mapped = nullptr;
+    const D3D12_RANGE read_range{0, SIZE_T(slot.bytes)};
+    if (SUCCEEDED(slot.readback->Map(0, &read_range, &mapped)) && mapped) {
+      const auto* pixels = static_cast<const uint8_t*>(mapped) + slot.footprint.Offset;
+      const uint32_t pitch = slot.footprint.Footprint.RowPitch;
+      const uint32_t w = uint32_t(slot.width) / 2, h = slot.height / 2;
+      std::vector<uint8_t> half(size_t(w) * h * 4);
+      for (uint32_t y = 0; y < h; ++y) {
+        const uint8_t* r0 = pixels + size_t(y * 2) * pitch;
+        const uint8_t* r1 = r0 + pitch;
+        uint8_t* out = half.data() + size_t(y) * w * 4;
+        for (uint32_t x = 0; x < w; ++x)
+          for (uint32_t c = 0; c < 4; ++c)
+            out[x * 4 + c] = uint8_t((r0[x * 8 + c] + r0[x * 8 + 4 + c] +
+                                      r1[x * 8 + c] + r1[x * 8 + 4 + c] + 2) / 4);
+      }
+      const D3D12_RANGE no_write{0, 0};
+      slot.readback->Unmap(0, &no_write);
+      std::error_code path_error;
+      const auto path = std::filesystem::current_path(path_error) / "out/game/captures" /
+          ("burst-" + doax2_burst_session + "-" + std::to_string(burst_id) + "-frame-" +
+           std::to_string(slot.frame) + ".bmp");
+      const bool saved = !path_error && WriteOwnedCompositeBmp(path, half.data(), w, h, w * 4);
+      if (!saved) REXGPU_WARN("DOAX2 frame burst: failed to save frame {}", slot.frame);
+    }
+    slot.pending = false;
+  }
+  const bool key_down = (GetAsyncKeyState(VK_F10) & 0x8000) != 0;
+  if (key_down && !key_was_down && !burst_start) {
+    burst_start = frame;
+    ++burst_id;
+    recorded = 0;
+    gaps = 0;
+    REXGPU_INFO("DOAX2 frame burst {} started at swap {} ({}x{} format {})", burst_id, frame,
+                desc.Width, desc.Height, uint32_t(desc.Format));
+  }
+  key_was_down = key_down;
+  if (!burst_start) return;
+  if (frame >= burst_start + kBurstFrames) {
+    REXGPU_INFO("DOAX2 frame burst {} done: swaps {}-{}, recorded {}, gaps {}", burst_id,
+                burst_start, burst_start + kBurstFrames - 1, recorded, gaps);
+    burst_start = 0;
+    return;
+  }
+  if (!source || desc.Dimension != D3D12_RESOURCE_DIMENSION_TEXTURE2D ||
+      desc.SampleDesc.Count != 1 || desc.Width > 8192 || desc.Height > 8192 ||
+      (desc.Format != DXGI_FORMAT_R8G8B8A8_TYPELESS &&
+       desc.Format != DXGI_FORMAT_R8G8B8A8_UNORM &&
+       desc.Format != DXGI_FORMAT_B8G8R8A8_UNORM) || !submission_open_) {
+    ++gaps;
+    return;
+  }
+  Slot& slot = slots[next_slot];
+  if (slot.pending) {
+    ++gaps;
+    REXGPU_WARN("DOAX2 frame burst: swap {} skipped, ring slot busy", frame);
+    return;
+  }
+  ID3D12Device* device = GetD3D12Provider().GetDevice();
+  if (!slot.readback || slot.width != desc.Width || slot.height != desc.Height) {
+    slot.readback.Reset();
+    UINT rows = 0;
+    UINT64 row_bytes = 0;
+    device->GetCopyableFootprints(&desc, 0, 1, 0, &slot.footprint, &rows, &row_bytes,
+                                  &slot.bytes);
+    D3D12_RESOURCE_DESC buffer_desc{};
+    ui::d3d12::util::FillBufferResourceDesc(buffer_desc, slot.bytes, D3D12_RESOURCE_FLAG_NONE);
+    if (FAILED(device->CreateCommittedResource(
+            &ui::d3d12::util::kHeapPropertiesReadback, D3D12_HEAP_FLAG_NONE, &buffer_desc,
+            D3D12_RESOURCE_STATE_COPY_DEST, nullptr, IID_PPV_ARGS(&slot.readback)))) {
+      ++gaps;
+      REXGPU_WARN("DOAX2 frame burst: readback allocation failed");
+      return;
+    }
+    slot.width = desc.Width;
+    slot.height = desc.Height;
+  }
+  constexpr D3D12_RESOURCE_STATES kSourceState = D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
+  PushTransitionBarrier(source, kSourceState, D3D12_RESOURCE_STATE_COPY_SOURCE);
+  SubmitBarriers();
+  D3D12_TEXTURE_COPY_LOCATION source_copy{};
+  source_copy.pResource = source;
+  source_copy.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+  D3D12_TEXTURE_COPY_LOCATION destination_copy{};
+  destination_copy.pResource = slot.readback.Get();
+  destination_copy.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+  destination_copy.PlacedFootprint = slot.footprint;
+  deferred_command_list_.D3DCopyTextureRegion(&destination_copy, 0, 0, 0, &source_copy, nullptr);
+  PushTransitionBarrier(source, D3D12_RESOURCE_STATE_COPY_SOURCE, kSourceState);
+  SubmitBarriers();
+  slot.submission = submission_current_;
+  slot.frame = frame;
+  slot.pending = true;
+  next_slot = (next_slot + 1) % slots.size();
+  ++recorded;
+}
+
+void D3D12CommandProcessor::TryRecordOwnedFinalSwapSourceCopy(
+    ID3D12Resource* source, const D3D12_RESOURCE_DESC& desc) {
+  const uint64_t frame = doax2_transform_trace_swap_serial;
+  const bool hotkey_capture =
+      REXCVAR_GET(d3d12_doax2_owned_final_swap_capture_hotkey);
+  const bool capture_frame = hotkey_capture
+      ? (owned_final_swap_capture_request_frame_ &&
+         (frame == owned_final_swap_capture_request_frame_ ||
+          frame == owned_final_swap_capture_request_frame_ + 1))
+      : (frame % 120 == 119 || frame % 120 == 0);
+  if (!REXCVAR_GET(d3d12_doax2_owned_final_swap_copy) ||
+      !REXCVAR_GET(d3d12_doax2_candidate_audit) ||
+      REXCVAR_GET(d3d12_doax2_owned_composite_source_copy) ||
+      !capture_frame ||
+      frame == owned_composite_source_last_frame_ || !submission_open_ ||
+      !source) {
+    return;
+  }
+  owned_composite_source_last_frame_ = frame;
+  if (desc.Dimension != D3D12_RESOURCE_DIMENSION_TEXTURE2D ||
+      desc.Format != DXGI_FORMAT_R8G8B8A8_TYPELESS ||
+      desc.Width != 1280 || desc.Height != 720 ||
+      desc.DepthOrArraySize != 1 || desc.MipLevels != 1 ||
+      desc.SampleDesc.Count != 1 || desc.Flags != D3D12_RESOURCE_FLAG_NONE) {
+    ++owned_composite_source_failures_;
+    REXGPU_WARN("DOAX2 owned final swap rejected: frame={} stage=layout format={} size={}x{} mips={} arrays={} samples={} flags={}",
+                frame, uint32_t(desc.Format), desc.Width, desc.Height,
+                desc.MipLevels, desc.DepthOrArraySize, desc.SampleDesc.Count,
+                uint32_t(desc.Flags));
+    return;
+  }
+  const size_t bank_index = size_t(owned_composite_source_copies_ % 2);
+  auto& bank = owned_composite_source_banks_[bank_index];
+  if (bank.readback_pending || bank.witness_pending) {
+    ++owned_composite_source_failures_;
+    REXGPU_WARN("DOAX2 owned final swap rejected: frame={} stage=readback_pending bank={}",
+                frame, bank_index);
+    return;
+  }
+  const auto lease = bank.owner.Acquire(submission_completed_);
+  if (!lease) {
+    ++owned_composite_source_failures_;
+    REXGPU_WARN("DOAX2 owned final swap rejected: frame={} stage=bank_busy bank={} completed={} fence={}",
+                frame, bank_index, submission_completed_, bank.fence);
+    return;
+  }
+  auto reject = [&](const char* stage) {
+    bank.owner.CancelUnsubmitted(*lease);
+    ++owned_composite_source_failures_;
+    REXGPU_WARN("DOAX2 owned final swap rejected: frame={} stage={} bank={}",
+                frame, stage, bank_index);
+  };
+  ID3D12Device* device = GetD3D12Provider().GetDevice();
+  if (!bank.texture) {
+    if (FAILED(device->CreateCommittedResource(
+            &ui::d3d12::util::kHeapPropertiesDefault,
+            GetD3D12Provider().GetHeapFlagCreateNotZeroed(), &desc,
+            D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+            IID_PPV_ARGS(&bank.texture)))) {
+      reject("private_allocation");
+      return;
+    }
+    bank.texture_state = D3D12_RESOURCE_STATE_COPY_DEST;
+  }
+  if (!bank.readback) {
+    UINT rows = 0;
+    device->GetCopyableFootprints(&desc, 0, 1, 0, &bank.footprint,
+                                  &rows, &bank.row_bytes,
+                                  &bank.readback_bytes);
+    if (rows != 720 || !bank.readback_bytes) {
+      reject("readback_layout");
+      return;
+    }
+    D3D12_RESOURCE_DESC buffer_desc{};
+    ui::d3d12::util::FillBufferResourceDesc(
+        buffer_desc, bank.readback_bytes, D3D12_RESOURCE_FLAG_NONE);
+    if (FAILED(device->CreateCommittedResource(
+            &ui::d3d12::util::kHeapPropertiesReadback,
+            D3D12_HEAP_FLAG_NONE, &buffer_desc,
+            D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+            IID_PPV_ARGS(&bank.readback))) ||
+        FAILED(device->CreateCommittedResource(
+            &ui::d3d12::util::kHeapPropertiesReadback,
+            D3D12_HEAP_FLAG_NONE, &buffer_desc,
+            D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+            IID_PPV_ARGS(&bank.witness_readback)))) {
+      reject("readback_allocation");
+      return;
+    }
+  }
+  // RequestSwapTexture has made this exact decoded source shader-readable.
+  // Restore that state before the ordinary gamma/FXAA presentation consumes it.
+  constexpr D3D12_RESOURCE_STATES kSourceState =
+      D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
+  PushTransitionBarrier(source, kSourceState, D3D12_RESOURCE_STATE_COPY_SOURCE);
+  PushTransitionBarrier(bank.texture.Get(), bank.texture_state,
+                        D3D12_RESOURCE_STATE_COPY_DEST);
+  SubmitBarriers();
+  deferred_command_list_.D3DCopyResource(bank.texture.Get(), source);
+  PushTransitionBarrier(source, D3D12_RESOURCE_STATE_COPY_SOURCE, kSourceState);
+  PushTransitionBarrier(bank.texture.Get(), D3D12_RESOURCE_STATE_COPY_DEST,
+                        D3D12_RESOURCE_STATE_COPY_SOURCE);
+  SubmitBarriers();
+  D3D12_TEXTURE_COPY_LOCATION source_copy{};
+  source_copy.pResource = bank.texture.Get();
+  source_copy.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+  D3D12_TEXTURE_COPY_LOCATION destination_copy{};
+  destination_copy.pResource = bank.readback.Get();
+  destination_copy.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+  destination_copy.PlacedFootprint = bank.footprint;
+  deferred_command_list_.D3DCopyTextureRegion(
+      &destination_copy, 0, 0, 0, &source_copy, nullptr);
+  PushTransitionBarrier(bank.texture.Get(), D3D12_RESOURCE_STATE_COPY_SOURCE,
+                        kSourceState);
+  bank.texture_state = kSourceState;
+
+  auto& witness = owned_composite_source_banks_[bank_index ^ 1];
+  if ((hotkey_capture || frame % 120 == 0) &&
+      witness.frame == frame - 1 &&
+      witness.texture && witness.witness_readback &&
+      !witness.witness_pending && !witness.lease &&
+      witness.submitted_lease && witness.fence &&
+      witness.texture_state == kSourceState) {
+    PushTransitionBarrier(witness.texture.Get(), kSourceState,
+                          D3D12_RESOURCE_STATE_COPY_SOURCE);
+    SubmitBarriers();
+    source_copy.pResource = witness.texture.Get();
+    destination_copy.pResource = witness.witness_readback.Get();
+    destination_copy.PlacedFootprint = witness.footprint;
+    deferred_command_list_.D3DCopyTextureRegion(
+        &destination_copy, 0, 0, 0, &source_copy, nullptr);
+    PushTransitionBarrier(witness.texture.Get(),
+                          D3D12_RESOURCE_STATE_COPY_SOURCE, kSourceState);
+    witness.witness_pending = true;
+    witness.witness_fence = 0;
+  }
+  bank.lease = lease;
+  bank.submitted_lease.reset();
+  bank.fence = 0;
+  bank.hash_valid = false;
+  bank.capture_saved = false;
+  bank.frame = frame;
+  bank.final_swap_source = true;
+  bank.readback_pending = true;
+  ++owned_composite_source_copies_;
+  REXGPU_INFO("DOAX2 owned final swap recorded: frame={} bank={} guest_source={:016X} private_backing={:016X} other_private_backing={:016X} bytes={} pending_submission={}; source state restored, no extra presentation",
+              frame, bank_index, reinterpret_cast<uintptr_t>(source),
+              reinterpret_cast<uintptr_t>(bank.texture.Get()),
+              reinterpret_cast<uintptr_t>(witness.texture.Get()),
+              bank.readback_bytes, submission_current_);
+}
+
+void D3D12CommandProcessor::TryRecordOwnedCompositeSourceCopy(
+    uint32_t fetch_index, uint32_t guest_base, uint32_t host_swizzle,
+    size_t draw_ordinal) {
+  const uint64_t frame = doax2_transform_trace_swap_serial + 1;
+  if (!REXCVAR_GET(d3d12_doax2_owned_composite_source_copy) ||
+      !REXCVAR_GET(d3d12_doax2_candidate_audit) ||
+      (frame % 120 != 119 && frame % 120 != 0) ||
+      frame == owned_composite_source_last_frame_ ||
+      !submission_open_ || !bindless_resources_used_) {
+    return;
+  }
+  owned_composite_source_last_frame_ = frame;
+  D3D12TextureCache::ActiveTextureResourceInfo source;
+  if (!texture_cache_->DescribeActiveTextureResource(fetch_index, source)) {
+    REXGPU_WARN("DOAX2 owned composite source rejected: frame={} stage=active_texture", frame);
+    ++owned_composite_source_failures_;
+    return;
+  }
+  const auto& desc = source.description;
+  constexpr D3D12_RESOURCE_STATES kShaderRead =
+      D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE |
+      D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+  if (desc.Dimension != D3D12_RESOURCE_DIMENSION_TEXTURE2D ||
+      desc.Format != DXGI_FORMAT_R8G8B8A8_TYPELESS ||
+      desc.Width != 1280 || desc.Height != 720 ||
+      desc.DepthOrArraySize != 1 || desc.MipLevels != 1 ||
+      desc.SampleDesc.Count != 1 || desc.Flags != D3D12_RESOURCE_FLAG_NONE ||
+      source.state != kShaderRead || source.signed_resource_separate) {
+    REXGPU_WARN(
+        "DOAX2 owned composite source rejected: frame={} stage=unsupported_layout dimension={} format={} size={}x{} mips={} samples={} state={}",
+        frame, uint32_t(desc.Dimension), uint32_t(desc.Format), desc.Width,
+        desc.Height, desc.MipLevels, desc.SampleDesc.Count,
+        uint32_t(source.state));
+    ++owned_composite_source_failures_;
+    return;
+  }
+  const size_t bank_index = size_t(owned_composite_source_copies_ % 2);
+  auto& bank = owned_composite_source_banks_[bank_index];
+  if (bank.private_srv.ptr && bank.host_swizzle != host_swizzle) {
+    REXGPU_WARN(
+        "DOAX2 owned composite source rejected: frame={} stage=swizzle_changed bank={} old={:08X} new={:08X}",
+        frame, bank_index, bank.host_swizzle, host_swizzle);
+    ++owned_composite_source_failures_;
+    return;
+  }
+  if (bank.readback_pending || bank.witness_pending) {
+    REXGPU_WARN(
+        "DOAX2 owned composite source rejected: frame={} stage=readback_pending bank={}",
+        frame, bank_index);
+    ++owned_composite_source_failures_;
+    return;
+  }
+  const auto lease = bank.owner.Acquire(submission_completed_);
+  if (!lease) {
+    REXGPU_WARN(
+        "DOAX2 owned composite source rejected: frame={} stage=bank_busy bank={} completed_submission={} protected_submission={}",
+        frame, bank_index, submission_completed_, bank.fence);
+    ++owned_composite_source_failures_;
+    return;
+  }
+  auto reject = [&](const char* stage) {
+    bank.owner.CancelUnsubmitted(*lease);
+    ++owned_composite_source_failures_;
+    REXGPU_WARN("DOAX2 owned composite source rejected: frame={} stage={} bank={}",
+                frame, stage, bank_index);
+  };
+  ID3D12Device* device = GetD3D12Provider().GetDevice();
+  if (!bank.texture) {
+    if (FAILED(device->CreateCommittedResource(
+            &ui::d3d12::util::kHeapPropertiesDefault,
+            GetD3D12Provider().GetHeapFlagCreateNotZeroed(), &desc,
+            D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+            IID_PPV_ARGS(&bank.texture)))) {
+      reject("private_texture_allocation");
+      return;
+    }
+    bank.texture_state = D3D12_RESOURCE_STATE_COPY_DEST;
+  } else if (bank.texture->GetDesc().Width != desc.Width ||
+             bank.texture->GetDesc().Height != desc.Height ||
+             bank.texture->GetDesc().Format != desc.Format) {
+    reject("private_texture_layout_changed");
+    return;
+  }
+  if (!bank.readback) {
+    UINT rows = 0;
+    device->GetCopyableFootprints(&desc, 0, 1, 0, &bank.footprint,
+                                  &rows, &bank.row_bytes,
+                                  &bank.readback_bytes);
+    if (!bank.readback_bytes || rows != 720) {
+      reject("readback_layout");
+      return;
+    }
+    D3D12_RESOURCE_DESC buffer_desc{};
+    ui::d3d12::util::FillBufferResourceDesc(
+        buffer_desc, bank.readback_bytes, D3D12_RESOURCE_FLAG_NONE);
+    if (FAILED(device->CreateCommittedResource(
+            &ui::d3d12::util::kHeapPropertiesReadback,
+            D3D12_HEAP_FLAG_NONE, &buffer_desc,
+            D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+            IID_PPV_ARGS(&bank.readback))) ||
+        FAILED(device->CreateCommittedResource(
+            &ui::d3d12::util::kHeapPropertiesReadback,
+            D3D12_HEAP_FLAG_NONE, &buffer_desc,
+            D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+            IID_PPV_ARGS(&bank.witness_readback)))) {
+      reject("readback_allocation");
+      return;
+    }
+  }
+  if (!bank.private_srv.ptr) {
+    ui::d3d12::util::DescriptorCpuGpuHandlePair descriptor;
+    if (!RequestPersistentViewBindlessDescriptors(1, &descriptor)) {
+      reject("private_descriptor_allocation");
+      return;
+    }
+    D3D12_SHADER_RESOURCE_VIEW_DESC view{};
+    view.Shader4ComponentMapping =
+        host_swizzle |
+        D3D12_SHADER_COMPONENT_MAPPING_ALWAYS_SET_BIT_AVOIDING_ZEROMEM_MISTAKES;
+    view.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+    view.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2DARRAY;
+    view.Texture2DArray.MipLevels = 1;
+    view.Texture2DArray.ArraySize = 1;
+    device->CreateShaderResourceView(bank.texture.Get(), &view,
+                                     descriptor.first);
+    bank.private_srv = descriptor.second;
+    bank.host_swizzle = host_swizzle;
+  }
+  if (REXCVAR_GET(d3d12_doax2_owned_composite_draw) &&
+      !bank.private_signed_srv.ptr) {
+    ui::d3d12::util::DescriptorCpuGpuHandlePair descriptor;
+    if (!RequestPersistentViewBindlessDescriptors(1, &descriptor)) {
+      reject("private_signed_descriptor_allocation");
+      return;
+    }
+    D3D12_SHADER_RESOURCE_VIEW_DESC view{};
+    view.Shader4ComponentMapping =
+        host_swizzle |
+        D3D12_SHADER_COMPONENT_MAPPING_ALWAYS_SET_BIT_AVOIDING_ZEROMEM_MISTAKES;
+    view.Format = DXGI_FORMAT_R8G8B8A8_SNORM;
+    view.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2DARRAY;
+    view.Texture2DArray.MipLevels = 1;
+    view.Texture2DArray.ArraySize = 1;
+    device->CreateShaderResourceView(bank.texture.Get(), &view,
+                                     descriptor.first);
+    bank.private_signed_srv = descriptor.second;
+  }
+  if (!texture_cache_->RecordOwnedActiveTextureCopy(
+          fetch_index, bank.texture.Get(), bank.texture_state,
+          D3D12_RESOURCE_STATE_COPY_SOURCE)) {
+    reject("native_copy_guard");
+    return;
+  }
+  bank.texture_state = D3D12_RESOURCE_STATE_COPY_SOURCE;
+  SubmitBarriers();
+  D3D12_TEXTURE_COPY_LOCATION source_copy{};
+  source_copy.pResource = bank.texture.Get();
+  source_copy.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+  D3D12_TEXTURE_COPY_LOCATION destination_copy{};
+  destination_copy.pResource = bank.readback.Get();
+  destination_copy.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+  destination_copy.PlacedFootprint = bank.footprint;
+  deferred_command_list_.D3DCopyTextureRegion(
+      &destination_copy, 0, 0, 0, &source_copy, nullptr);
+  PushTransitionBarrier(bank.texture.Get(), bank.texture_state, kShaderRead);
+  bank.texture_state = kShaderRead;
+
+  const size_t witness_index = bank_index ^ 1;
+  auto& witness = owned_composite_source_banks_[witness_index];
+  // Witness the N image only after copying N+1. Queue ordering keeps the
+  // read-only witness copy after N's submitted write, even if N's fence has
+  // not yet completed on the CPU. Extending the bank lease through this
+  // submission prevents reuse until both copies actually finish. Witnessing
+  // the previous pair during N would occupy the N+1 bank at its draw.
+  if (frame % 120 == 0 && witness.frame == frame - 1 &&
+      witness.texture && witness.witness_readback &&
+      !witness.witness_pending && !witness.lease &&
+      witness.submitted_lease && witness.fence &&
+      witness.texture_state == kShaderRead) {
+    PushTransitionBarrier(witness.texture.Get(), kShaderRead,
+                          D3D12_RESOURCE_STATE_COPY_SOURCE);
+    SubmitBarriers();
+    source_copy.pResource = witness.texture.Get();
+    destination_copy.pResource = witness.witness_readback.Get();
+    destination_copy.PlacedFootprint = witness.footprint;
+    deferred_command_list_.D3DCopyTextureRegion(
+        &destination_copy, 0, 0, 0, &source_copy, nullptr);
+    PushTransitionBarrier(witness.texture.Get(),
+                          D3D12_RESOURCE_STATE_COPY_SOURCE, kShaderRead);
+    witness.witness_pending = true;
+    witness.witness_fence = 0;  // Assigned only after the queue signal.
+  }
+  bank.lease = lease;
+  bank.submitted_lease.reset();
+  bank.fence = 0;  // Old completion is not proof of the just-recorded copy.
+  bank.hash_valid = false;
+  bank.capture_saved = false;
+  bank.frame = frame;
+  bank.final_swap_source = false;
+  bank.readback_pending = true;
+  ++owned_composite_source_copies_;
+  REXGPU_INFO(
+      "DOAX2 owned composite source recorded: frame={} ordinal={} bank={} native_identity={:016X} private_identity={:016X} other_private_identity={:016X} private_srv={:016X} bytes={} pending_submission={} guest_base={:08X}; independent backing, native state restored, not bound or presented",
+      frame, draw_ordinal, bank_index, source.identity,
+      reinterpret_cast<uintptr_t>(bank.texture.Get()),
+      reinterpret_cast<uintptr_t>(witness.texture.Get()),
+      bank.private_srv.ptr, bank.readback_bytes, submission_current_,
+      guest_base);
+}
+
+void D3D12CommandProcessor::TryRecordOwnedResolvedInputCopy(
+    uint32_t fetch_index, uint32_t guest_base, uint32_t host_swizzle,
+    size_t producer_event) {
+  const uint64_t frame = doax2_transform_trace_swap_serial + 1;
+  if (!REXCVAR_GET(d3d12_doax2_owned_resolved_input_copy) ||
+      frame == owned_resolved_input_last_frame_ || !submission_open_ ||
+      !bindless_resources_used_) return;
+  owned_resolved_input_last_frame_ = frame;
+  D3D12TextureCache::ActiveTextureResourceInfo source;
+  if (!texture_cache_->DescribeActiveTextureResource(fetch_index, source)) {
+    ++owned_resolved_input_failures_;
+    REXGPU_WARN("DOAX2 owned resolved input rejected: frame={} stage=active_texture", frame);
+    return;
+  }
+  const auto& desc = source.description;
+  constexpr D3D12_RESOURCE_STATES kShaderRead =
+      D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE |
+      D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+  if (desc.Dimension != D3D12_RESOURCE_DIMENSION_TEXTURE2D ||
+      !desc.Width || desc.Width > 1024 || !desc.Height || desc.Height > 1024 ||
+      desc.DepthOrArraySize != 1 || desc.MipLevels != 1 ||
+      desc.Format != DXGI_FORMAT_R8_TYPELESS ||
+      desc.SampleDesc.Count != 1 || desc.Flags != D3D12_RESOURCE_FLAG_NONE ||
+      source.state != kShaderRead || source.signed_resource_separate) {
+    ++owned_resolved_input_failures_;
+    REXGPU_WARN("DOAX2 owned resolved input rejected: frame={} stage=layout guest_base={:08X} producer_event={} size={}x{} format={} samples={} state={} signed_separate={}",
+                frame, guest_base, producer_event, desc.Width, desc.Height,
+                uint32_t(desc.Format), desc.SampleDesc.Count,
+                uint32_t(source.state), source.signed_resource_separate);
+    return;
+  }
+  const size_t index = size_t(owned_resolved_input_copies_ % 2);
+  auto& bank = owned_resolved_input_banks_[index];
+  auto& other = owned_resolved_input_banks_[index ^ 1];
+  if (bank.private_srv.ptr && bank.host_swizzle != host_swizzle) {
+    ++owned_resolved_input_failures_;
+    REXGPU_WARN("DOAX2 owned resolved input rejected: frame={} stage=swizzle_changed bank={} old={:08X} new={:08X}",
+                frame, index, bank.host_swizzle, host_swizzle);
+    return;
+  }
+  if (bank.readback_pending || bank.witness_pending) {
+    ++owned_resolved_input_failures_;
+    REXGPU_WARN("DOAX2 owned resolved input rejected: frame={} stage=pending bank={}", frame, index);
+    return;
+  }
+  const auto lease = bank.owner.Acquire(submission_completed_);
+  if (!lease) {
+    ++owned_resolved_input_failures_;
+    REXGPU_WARN("DOAX2 owned resolved input rejected: frame={} stage=bank_busy bank={} completed={} fence={}",
+                frame, index, submission_completed_, bank.fence);
+    return;
+  }
+  auto reject = [&](const char* stage) {
+    bank.owner.CancelUnsubmitted(*lease);
+    ++owned_resolved_input_failures_;
+    REXGPU_WARN("DOAX2 owned resolved input rejected: frame={} stage={} bank={}", frame, stage, index);
+  };
+  ID3D12Device* device = GetD3D12Provider().GetDevice();
+  if (!bank.texture) {
+    if (FAILED(device->CreateCommittedResource(
+            &ui::d3d12::util::kHeapPropertiesDefault,
+            GetD3D12Provider().GetHeapFlagCreateNotZeroed(), &desc,
+            D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+            IID_PPV_ARGS(&bank.texture)))) {
+      reject("private_texture_allocation");
+      return;
+    }
+    bank.texture_state = D3D12_RESOURCE_STATE_COPY_DEST;
+  } else {
+    const auto old = bank.texture->GetDesc();
+    if (old.Width != desc.Width || old.Height != desc.Height ||
+        old.Format != desc.Format || old.SampleDesc.Quality != desc.SampleDesc.Quality) {
+      reject("private_texture_layout_changed");
+      return;
+    }
+  }
+  if (!bank.readback) {
+    UINT rows = 0;
+    device->GetCopyableFootprints(&desc, 0, 1, 0, &bank.footprint,
+                                  &rows, &bank.row_bytes,
+                                  &bank.readback_bytes);
+    if (!bank.readback_bytes || bank.readback_bytes > 16 * 1024 * 1024 ||
+        rows != desc.Height) {
+      reject("readback_layout");
+      return;
+    }
+    D3D12_RESOURCE_DESC buffer_desc{};
+    ui::d3d12::util::FillBufferResourceDesc(
+        buffer_desc, bank.readback_bytes, D3D12_RESOURCE_FLAG_NONE);
+    if (FAILED(device->CreateCommittedResource(
+            &ui::d3d12::util::kHeapPropertiesReadback,
+            D3D12_HEAP_FLAG_NONE, &buffer_desc,
+            D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+            IID_PPV_ARGS(&bank.readback))) ||
+        FAILED(device->CreateCommittedResource(
+            &ui::d3d12::util::kHeapPropertiesReadback,
+            D3D12_HEAP_FLAG_NONE, &buffer_desc,
+            D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+            IID_PPV_ARGS(&bank.witness_readback)))) {
+      reject("readback_allocation");
+      return;
+    }
+  }
+  if (!bank.private_srv.ptr) {
+    ui::d3d12::util::DescriptorCpuGpuHandlePair unsigned_descriptor;
+    ui::d3d12::util::DescriptorCpuGpuHandlePair signed_descriptor;
+    if (!RequestPersistentViewBindlessDescriptors(1, &unsigned_descriptor) ||
+        !RequestPersistentViewBindlessDescriptors(1, &signed_descriptor)) {
+      reject("private_descriptor_allocation");
+      return;
+    }
+    D3D12_SHADER_RESOURCE_VIEW_DESC view{};
+    view.Shader4ComponentMapping = host_swizzle |
+        D3D12_SHADER_COMPONENT_MAPPING_ALWAYS_SET_BIT_AVOIDING_ZEROMEM_MISTAKES;
+    view.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2DARRAY;
+    view.Texture2DArray.MipLevels = 1;
+    view.Texture2DArray.ArraySize = 1;
+    view.Format = DXGI_FORMAT_R8_UNORM;
+    device->CreateShaderResourceView(bank.texture.Get(), &view,
+                                     unsigned_descriptor.first);
+    view.Format = DXGI_FORMAT_R8_SNORM;
+    device->CreateShaderResourceView(bank.texture.Get(), &view,
+                                     signed_descriptor.first);
+    bank.private_srv = unsigned_descriptor.second;
+    bank.private_signed_srv = signed_descriptor.second;
+    bank.host_swizzle = host_swizzle;
+  }
+  if (!texture_cache_->RecordOwnedActiveTextureCopy(
+          fetch_index, bank.texture.Get(), bank.texture_state,
+          D3D12_RESOURCE_STATE_COPY_SOURCE)) {
+    reject("native_copy_guard");
+    return;
+  }
+  bank.texture_state = D3D12_RESOURCE_STATE_COPY_SOURCE;
+  SubmitBarriers();
+  D3D12_TEXTURE_COPY_LOCATION source_copy{};
+  source_copy.pResource = bank.texture.Get();
+  source_copy.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+  D3D12_TEXTURE_COPY_LOCATION destination_copy{};
+  destination_copy.pResource = bank.readback.Get();
+  destination_copy.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+  destination_copy.PlacedFootprint = bank.footprint;
+  deferred_command_list_.D3DCopyTextureRegion(
+      &destination_copy, 0, 0, 0, &source_copy, nullptr);
+  PushTransitionBarrier(bank.texture.Get(), bank.texture_state, kShaderRead);
+  bank.texture_state = kShaderRead;
+  if (other.frame == frame - 1 && other.texture && other.witness_readback &&
+      !other.witness_pending && !other.lease && other.submitted_lease &&
+      other.fence && other.texture_state == kShaderRead) {
+    PushTransitionBarrier(other.texture.Get(), kShaderRead,
+                          D3D12_RESOURCE_STATE_COPY_SOURCE);
+    SubmitBarriers();
+    source_copy.pResource = other.texture.Get();
+    destination_copy.pResource = other.witness_readback.Get();
+    destination_copy.PlacedFootprint = other.footprint;
+    deferred_command_list_.D3DCopyTextureRegion(
+        &destination_copy, 0, 0, 0, &source_copy, nullptr);
+    PushTransitionBarrier(other.texture.Get(),
+                          D3D12_RESOURCE_STATE_COPY_SOURCE, kShaderRead);
+    other.witness_pending = true;
+    other.witness_fence = 0;
+  }
+  bank.lease = lease;
+  bank.submitted_lease.reset();
+  bank.fence = 0;
+  bank.hash_valid = false;
+  bank.frame = frame;
+  bank.readback_pending = true;
+  ++owned_resolved_input_copies_;
+  REXGPU_INFO("DOAX2 owned resolved input recorded: frame={} bank={} producer_event={} guest_base={:08X} native_identity={:016X} private_backing={:016X} other_backing={:016X} private_srv={:016X} private_signed_srv={:016X} swizzle={:08X} size={}x{} format={} bytes={} pending_submission={}; no extra render or presentation",
+              frame, index, producer_event, guest_base, source.identity,
+              reinterpret_cast<uintptr_t>(bank.texture.Get()),
+              reinterpret_cast<uintptr_t>(other.texture.Get()),
+              bank.private_srv.ptr, bank.private_signed_srv.ptr, host_swizzle,
+              desc.Width, desc.Height, uint32_t(desc.Format),
+              bank.readback_bytes, submission_current_);
+}
+
+void D3D12CommandProcessor::ConsumeOwnedCompositeSourceCopies() {
+  auto read_hash = [this](ID3D12Resource* readback,
+                      OwnedCompositeSourceBank& bank,
+                      uint64_t& hash_out, uint64_t& nonzero_out,
+                      uint64_t& rgb_nonzero_out, bool allow_dump) {
+    if (!readback || !bank.readback_bytes || !bank.row_bytes) return false;
+    const D3D12_RANGE range{0, SIZE_T(bank.readback_bytes)};
+    void* mapped = nullptr;
+    if (FAILED(readback->Map(0, &range, &mapped)) || !mapped) {
+      return false;
+    }
+    const auto* bytes = static_cast<const uint8_t*>(mapped);
+    uint64_t hash = 14695981039346656037ull;
+    uint64_t nonzero = 0;
+    uint64_t rgb_nonzero = 0;
+    for (uint32_t y = 0; y < bank.footprint.Footprint.Height; ++y) {
+      const uint8_t* row = bytes + size_t(y) * bank.footprint.Footprint.RowPitch;
+      for (uint64_t x = 0; x < bank.row_bytes; ++x) {
+        hash = (hash ^ row[x]) * 1099511628211ull;
+        nonzero += row[x] != 0;
+        rgb_nonzero += (x & 3) != 3 && row[x] != 0;
+      }
+    }
+    if (allow_dump && !bank.final_swap_source &&
+        REXCVAR_GET(d3d12_doax2_owned_composite_source_capture) &&
+        bank.footprint.Footprint.Width == 1280 &&
+        bank.footprint.Footprint.Height == 720) {
+      static uint64_t source_pair_start = 0;
+      const uint64_t capture_after = uint64_t(std::max(
+          REXCVAR_GET(d3d12_doax2_owned_composite_source_capture_after), 0));
+      const bool on_small_span = REXCVAR_GET(
+          d3d12_doax2_owned_composite_source_capture_on_small_span);
+      if (!on_small_span && !source_pair_start &&
+          bank.frame >= capture_after && bank.frame % 120 == 119)
+        source_pair_start = bank.frame;
+      const uint64_t selected_start = on_small_span
+          ? owned_composite_source_capture_pair_start_ : source_pair_start;
+      if (!bank.capture_saved && selected_start &&
+          (bank.frame == selected_start ||
+           bank.frame == selected_start + 1)) {
+        std::error_code path_error;
+        const auto root = std::filesystem::current_path(path_error);
+        const auto path = root / "out/game/captures" /
+            ("owned-composite-source-frame-" +
+             std::to_string(bank.frame) + ".bmp");
+        const bool saved = !path_error && WriteOwnedCompositeBmp(
+            path, bytes + bank.footprint.Offset,
+            bank.footprint.Footprint.Width, bank.footprint.Footprint.Height,
+            bank.footprint.Footprint.RowPitch);
+        bank.capture_saved = saved;
+        REXGPU_INFO("DOAX2 owned composite source visual capture: frame={} saved={} path={} hash={:016X}; fenced native reference, not a midpoint",
+                    bank.frame, saved, path.string(), hash);
+      }
+    }
+    if (allow_dump && bank.final_swap_source) {
+      static uint64_t capture_pair_start = 0;
+      const uint64_t capture_after =
+          REXCVAR_GET(d3d12_doax2_owned_final_swap_capture_hotkey)
+              ? (owned_final_swap_capture_request_frame_
+                     ? owned_final_swap_capture_request_frame_
+                     : UINT64_MAX)
+              : uint64_t(std::max(
+                    REXCVAR_GET(d3d12_doax2_owned_final_swap_capture_after), 0));
+      if (!capture_pair_start && bank.frame >= capture_after &&
+          (REXCVAR_GET(d3d12_doax2_owned_final_swap_capture_hotkey)
+               ? bank.frame == capture_after
+               : bank.frame % 120 == 119)) {
+        capture_pair_start = bank.frame;
+      }
+      // xenos60: F10 saves a burst of 40 consecutive final frames (any
+      // resolution) and re-arms afterwards, to inspect per-update motion.
+      constexpr uint64_t kCaptureBurst = 40;
+      const bool hotkey_burst = REXCVAR_GET(d3d12_doax2_owned_final_swap_capture_hotkey);
+      if (capture_pair_start && hotkey_burst &&
+          bank.frame >= capture_pair_start + kCaptureBurst) {
+        REXGPU_INFO("DOAX2 owned final swap capture burst done: frames {}-{}",
+                    capture_pair_start, capture_pair_start + kCaptureBurst - 1);
+        capture_pair_start = 0;
+        owned_final_swap_capture_request_frame_ = 0;
+      }
+      if (capture_pair_start &&
+          (hotkey_burst ? bank.frame < capture_pair_start + kCaptureBurst
+                        : (bank.frame == capture_pair_start ||
+                           bank.frame == capture_pair_start + 1)) &&
+          bank.footprint.Footprint.Width >= 320 &&
+          bank.footprint.Footprint.Height >= 240) {
+        std::error_code path_error;
+        const auto root = std::filesystem::current_path(path_error);
+        const auto path = root / "out/game/captures" /
+            ("owned-final-swap-frame-" + std::to_string(bank.frame) + ".bmp");
+        const bool saved = !path_error && WriteOwnedCompositeBmp(
+            path, bytes + bank.footprint.Offset,
+            bank.footprint.Footprint.Width, bank.footprint.Footprint.Height,
+            bank.footprint.Footprint.RowPitch);
+        REXGPU_INFO("DOAX2 owned final swap visual capture: frame={} saved={} path={} hash={:016X}; fenced post-resolve source, not a midpoint",
+                    bank.frame, saved, path.string(), hash);
+      }
+    }
+    const D3D12_RANGE no_write{0, 0};
+    readback->Unmap(0, &no_write);
+    hash_out = hash;
+    nonzero_out = nonzero;
+    rgb_nonzero_out = rgb_nonzero;
+    return true;
+  };
+  for (size_t i = 0; i < owned_composite_source_banks_.size(); ++i) {
+    auto& bank = owned_composite_source_banks_[i];
+    if (bank.readback_pending && bank.fence &&
+        bank.fence <= submission_completed_) {
+      uint64_t nonzero = 0, rgb_nonzero = 0;
+      bank.hash_valid = read_hash(bank.readback.Get(), bank,
+                                  bank.content_hash, nonzero, rgb_nonzero, true);
+      bank.readback_pending = false;
+      // A fully black intro/transition is valid image content. Nonzero RGB is
+      // reported for coverage, not treated as an ownership failure.
+      if (!bank.hash_valid || !nonzero)
+        ++owned_composite_source_failures_;
+      REXGPU_INFO(
+          "DOAX2 owned source proof: final_swap={} bank={} frame={} fence={} completed={} mapped={} nonzero_bytes={} nonzero_rgb_bytes={} hash={:016X} failures={}; private GPU copy read only after observed fence",
+          bank.final_swap_source,
+          i, bank.frame, bank.fence, submission_completed_, bank.hash_valid,
+          nonzero, rgb_nonzero, bank.content_hash,
+          owned_composite_source_failures_);
+    }
+    if (bank.witness_pending && bank.witness_fence &&
+        bank.witness_fence <= submission_completed_) {
+      uint64_t hash = 0, nonzero = 0, rgb_nonzero = 0;
+      const bool mapped = read_hash(bank.witness_readback.Get(), bank,
+                                    hash, nonzero, rgb_nonzero, false);
+      const bool preserved = mapped && bank.hash_valid &&
+                             hash == bank.content_hash;
+      if (!preserved) ++owned_composite_source_failures_;
+      REXGPU_INFO(
+          "DOAX2 owned source witness: final_swap={} bank={} original_frame={} witness_fence={} completed={} preserved={} original_hash={:016X} witness_hash={:016X} failures={}; copying the other bank did not modify this backing",
+          bank.final_swap_source, i, bank.frame, bank.witness_fence, submission_completed_,
+          preserved, bank.content_hash, hash,
+          owned_composite_source_failures_);
+      bank.witness_pending = false;
+      bank.witness_fence = 0;
+    }
+    // The N readback may have been consumed before the N+1 audit selected
+    // this pair. Its separate readback buffer is still valid until the bank
+    // is reused; map it again only after its observed submission fence.
+    if (!bank.final_swap_source && bank.hash_valid &&
+        !bank.readback_pending && !bank.capture_saved &&
+        bank.fence && bank.fence <= submission_completed_ &&
+        REXCVAR_GET(d3d12_doax2_owned_composite_source_capture) &&
+        REXCVAR_GET(d3d12_doax2_owned_composite_source_capture_on_small_span) &&
+        owned_composite_source_capture_pair_start_ &&
+        (bank.frame == owned_composite_source_capture_pair_start_ ||
+         bank.frame == owned_composite_source_capture_pair_start_ + 1)) {
+      uint64_t hash = 0, nonzero = 0, rgb_nonzero = 0;
+      const bool mapped = read_hash(bank.readback.Get(), bank, hash,
+                                    nonzero, rgb_nonzero, true);
+      if (!mapped || hash != bank.content_hash)
+        ++owned_composite_source_failures_;
+      REXGPU_INFO("DOAX2 retrospective native source capture: frame={} mapped={} hash_unchanged={} saved={} fence={} completed={} failures={}",
+                  bank.frame, mapped, mapped && hash == bank.content_hash,
+                  bank.capture_saved, bank.fence, submission_completed_,
+                  owned_composite_source_failures_);
+    }
+  }
