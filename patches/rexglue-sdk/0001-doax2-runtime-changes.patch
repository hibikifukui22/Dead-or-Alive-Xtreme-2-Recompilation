+ID3D12Resource* D3D12CommandProcessor::PrepareFxaaBank(uint32_t width, uint32_t height) {
+  // Intentionally serialized diagnostic: both banks (including the read-only
+  // witness) retire on the REAL direct-queue fence. No parallel allocator,
+  // synthetic frame fence, descriptor alias, or guest-state modification.
+  for (const auto& bank : fxaa_banks_) {
+    if (bank.lease) {
+      REXGPU_ERROR("DOAX2 FXAA banks: previous recording not submitted; refusing reuse");
+      return nullptr;
+    }
+  }
+  const uint64_t required = std::max(fxaa_banks_[0].fence, fxaa_banks_[1].fence);
+  CheckSubmissionFence(required);
+  if (submission_completed_ == UINT64_MAX || submission_completed_ < required) {
+    for (auto& bank : fxaa_banks_) bank.owner.QuarantineAll();
+    ++fxaa_bank_failures_;
+    REXGPU_ERROR("DOAX2 FXAA banks: completion not proven; refusing reuse");
+    return nullptr;
+  }
+  VerifyFxaaBankWitness();
+  CheckFxaaBankValidation();
+  if (fxaa_bank_failures_) return nullptr;
+  auto* device = GetD3D12Provider().GetDevice();
+  bool resized = false;
+  for (auto& bank : fxaa_banks_) {
+    bank.lease = bank.owner.Acquire(submission_completed_);
+    if (!bank.lease) {
+      ++fxaa_bank_failures_;
+      REXGPU_ERROR("DOAX2 FXAA banks: lease rejected");
+      return nullptr;
+    }
+    if (bank.texture && bank.texture->GetDesc().Width == width &&
+        bank.texture->GetDesc().Height == height) continue;
+    // Both banks' last GPU uses have completed, including witness copies.
+    bank.texture.Reset();
+    bank.initialized = false;
+    D3D12_RESOURCE_DESC desc{};
+    desc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    desc.Width = width;
+    desc.Height = height;
+    desc.DepthOrArraySize = desc.MipLevels = 1;
+    desc.Format = kFxaaSourceTextureFormat;
+    desc.SampleDesc.Count = 1;
+    desc.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+    if (FAILED(device->CreateCommittedResource(
+            &ui::d3d12::util::kHeapPropertiesDefault, D3D12_HEAP_FLAG_NONE, &desc,
+            D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE, nullptr,
+            IID_PPV_ARGS(&bank.texture)))) {
+      ++fxaa_bank_failures_;
+      REXGPU_ERROR("DOAX2 FXAA banks: committed texture allocation failed");
+      return nullptr;
+    }
+    resized = true;
+  }
+  if (resized) {
+    fxaa_bank_readbacks_ = {};
+    auto desc = fxaa_banks_[0].texture->GetDesc();
+    device->GetCopyableFootprints(&desc, 0, 1, 0, &fxaa_bank_footprint_, nullptr,
+                                 &fxaa_bank_row_bytes_, &fxaa_bank_readback_bytes_);
+    D3D12_RESOURCE_DESC buffer{};
+    buffer.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+    buffer.Width = fxaa_bank_readback_bytes_;
+    buffer.Height = buffer.DepthOrArraySize = buffer.MipLevels = 1;
+    buffer.SampleDesc.Count = 1;
+    buffer.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    D3D12_HEAP_PROPERTIES readback_heap{};
+    readback_heap.Type = D3D12_HEAP_TYPE_READBACK;
+    for (auto& readback : fxaa_bank_readbacks_) {
+      if (FAILED(device->CreateCommittedResource(&readback_heap, D3D12_HEAP_FLAG_NONE,
+              &buffer, D3D12_RESOURCE_STATE_COPY_DEST, nullptr, IID_PPV_ARGS(&readback)))) {
+        ++fxaa_bank_failures_;
+        REXGPU_ERROR("DOAX2 FXAA banks: witness allocation failed");
+        return nullptr;
+      }
+    }
+    REXGPU_INFO("DOAX2 FXAA banks allocated: A={} B={} independent_committed=true size={}x{} format={}",
+                static_cast<void*>(fxaa_banks_[0].texture.Get()),
+                static_cast<void*>(fxaa_banks_[1].texture.Get()), width, height, uint32_t(desc.Format));
+  }
+  fxaa_bank_active_ = uint32_t(fxaa_bank_frames_ & 1);
+  fxaa_bank_probe_planned_ = fxaa_banks_[fxaa_bank_active_ ^ 1].initialized &&
+                            (fxaa_bank_frames_ < 16 || fxaa_bank_frames_ % 120 == 0);
+  if (fxaa_bank_probe_planned_) CopyFxaaBankWitness(0);
+  if (fxaa_bank_frames_ < 8 || fxaa_bank_frames_ % 120 == 0) {
+    REXGPU_INFO("DOAX2 FXAA banks bind: frame={} bank={} backing={} completed={} required={} submission={} unsafe_reuse=0",
+                fxaa_bank_frames_, fxaa_bank_active_,
+                static_cast<void*>(fxaa_banks_[fxaa_bank_active_].texture.Get()),
+                submission_completed_, required, submission_current_);
+  }
+  return fxaa_banks_[fxaa_bank_active_].texture.Get();
+}
+
+void D3D12CommandProcessor::CopyFxaaBankWitness(uint32_t destination) {
+  auto* witness = fxaa_banks_[fxaa_bank_active_ ^ 1].texture.Get();
+  PushTransitionBarrier(witness, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE,
+                        D3D12_RESOURCE_STATE_COPY_SOURCE);
+  SubmitBarriers();
+  D3D12_TEXTURE_COPY_LOCATION source{};
+  source.pResource = witness;
+  source.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+  D3D12_TEXTURE_COPY_LOCATION target{};
+  target.pResource = fxaa_bank_readbacks_[destination].Get();
+  target.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+  target.PlacedFootprint = fxaa_bank_footprint_;
+  deferred_command_list_.D3DCopyTextureRegion(&target, 0, 0, 0, &source, nullptr);
+  PushTransitionBarrier(witness, D3D12_RESOURCE_STATE_COPY_SOURCE,
+                        D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+}
+
+void D3D12CommandProcessor::FinishFxaaBank() {
+  // Called only after the normal gamma and FXAA dispatches were recorded.
+  if (fxaa_bank_probe_planned_) {
+    CopyFxaaBankWitness(1);
+    fxaa_bank_probe_recording_ = true;
+  }
+  fxaa_banks_[fxaa_bank_active_].initialized = true;
+  ++fxaa_bank_frames_;
+}
