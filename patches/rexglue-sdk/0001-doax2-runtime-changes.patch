+    if (REXCVAR_GET(vulkan_doax2_resolve_census)) {
+      ++fail_counts[reason];
+      if ((++fail_counts[15] + direct_count) % 1000 == 0) {
+        REXGPU_INFO("DOAX2 direct resolve: {} direct; not: {} {} {} {} {} {} {} {} {} {} {} {}",
+                    direct_count, fail_counts[0], fail_counts[1], fail_counts[2], fail_counts[3],
+                    fail_counts[4], fail_counts[5], fail_counts[6], fail_counts[7], fail_counts[8],
+                    fail_counts[9], fail_counts[10], fail_counts[11]);
+      }
+    }
+    return false;
+  };
+  const bool is_depth = resolve_info.IsCopyingDepth();
+  if (!REXCVAR_GET(vulkan_direct_resolve_to_texture) || GetPath() != Path::kHostRenderTargets ||
+      (is_depth ? doax2_direct_resolve_depth_pipeline_layout_
+                : doax2_direct_resolve_pipeline_layout_) == VK_NULL_HANDLE ||
+      (is_depth && !REXCVAR_GET(vulkan_direct_depth_resolve_to_texture))) {
+    return Doax2DirectFail(0);
+  }
+  // k_8_8_8_8 -> k_8_8_8_8 UNORM without an exponent bias (R/B swap allowed),
+  // or kD24S8 -> k_24_8.
+  const draw_util::ResolveEdramInfo edram =
+      is_depth ? resolve_info.depth_edram_info : resolve_info.color_edram_info;
+  const reg::RB_COPY_DEST_INFO dest_info = resolve_info.copy_dest_info;
+  if ((is_depth
+           ? (xenos::DepthRenderTargetFormat(edram.format) !=
+                  xenos::DepthRenderTargetFormat::kD24S8 ||
+              uint32_t(dest_info.copy_dest_format) != uint32_t(xenos::TextureFormat::k_24_8))
+           : (xenos::ColorRenderTargetFormat(edram.format) !=
+                  xenos::ColorRenderTargetFormat::k_8_8_8_8 ||
+              edram.format_is_64bpp ||
+              dest_info.copy_dest_format != xenos::ColorFormat::k_8_8_8_8 ||
+              uint32_t(dest_info.copy_dest_number) != 0 || dest_info.copy_dest_exp_bias)) ||
+      dest_info.copy_dest_array) {
+    return Doax2DirectFail(1);
+  }
+  // Color: 1x sample 0, or 2x averaged (host 2x). Depth: 1x sample 0, or one
+  // 2x sample.
+  const uint32_t sample_select = uint32_t(resolve_info.rb_copy_control.copy_sample_select);
+  size_t pipeline_index;
+  uint32_t host_sample_index = 0;
+  if (edram.msaa_samples == xenos::MsaaSamples::k1X && sample_select == 0) {
+    pipeline_index = 0;
+  } else if (edram.msaa_samples == xenos::MsaaSamples::k2X && !is_depth && sample_select == 4 &&
+             msaa_2x_attachments_supported_) {
+    pipeline_index = 1;
+  } else if (edram.msaa_samples == xenos::MsaaSamples::k2X && is_depth && sample_select <= 1) {
+    pipeline_index = 1;
+    host_sample_index =
+        draw_util::GetD3D10SampleIndexForGuest2xMSAA(sample_select, msaa_2x_attachments_supported_);
+  } else {
+    return Doax2DirectFail(2);
+  }
+  VkPipeline pipeline = is_depth ? doax2_direct_resolve_depth_pipelines_[pipeline_index]
+                                 : doax2_direct_resolve_pipelines_[pipeline_index];
+  if (pipeline == VK_NULL_HANDLE || resolve_info.doax2_x0 < 0 || resolve_info.doax2_y0 < 0) {
+    return Doax2DirectFail(3);
+  }
+  // One host render target owning the whole source.
+  uint32_t span_base, span_row_length, span_rows, span_pitch;
+  resolve_info.GetCopyEdramTileSpan(span_base, span_row_length, span_rows, span_pitch);
+  GetResolveCopyRectanglesToDump(span_base, span_row_length, span_rows, span_pitch,
+                                 dump_rectangles_);
+  if (dump_rectangles_.size() != 1) {
+    return Doax2DirectFail(4);
+  }
+  const ResolveCopyDumpRectangle& rectangle = dump_rectangles_.front();
+  if (!rectangle.render_target || rectangle.row_first != 0 || rectangle.rows != span_rows ||
+      rectangle.row_first_start != 0 || rectangle.row_last_end != span_row_length) {
+    return Doax2DirectFail(5);
+  }
+  auto& rt = *static_cast<VulkanRenderTarget*>(rectangle.render_target);
+  const RenderTargetKey rt_key = rt.key();
+  if (rt_key.is_depth != is_depth ||
+      (is_depth ? rt_key.GetDepthFormat() != xenos::DepthRenderTargetFormat::kD24S8
+                : rt_key.GetColorFormat() != xenos::ColorRenderTargetFormat::k_8_8_8_8) ||
+      rt_key.msaa_samples != edram.msaa_samples || rt_key.GetPitchTiles() != edram.pitch_tiles ||
+      !edram.pitch_tiles) {
+    return Doax2DirectFail(6);
+  }
+  const uint32_t width = resolve_info.coordinate_info.width_div_8 * 8;
+  const uint32_t height = resolve_info.height_div_8 * 8;
+  VkDescriptorSet dest_descriptor_set;
+  uint32_t texture_width, texture_height;
+  const uint32_t dest_x0 = uint32_t(resolve_info.doax2_x0);
+  const uint32_t dest_y0 = uint32_t(resolve_info.doax2_y0);
+  if (!texture_cache.Doax2PrepareDirectResolveTarget(
+          register_file()[XE_GPU_REG_RB_COPY_DEST_BASE],
+          resolve_info.copy_dest_coordinate_info.pitch_aligned_div_32,
+          is_depth ? xenos::TextureFormat::k_24_8 : xenos::TextureFormat::k_8_8_8_8,
+          uint32_t(dest_info.copy_dest_endian), dest_x0, dest_y0, dest_x0 + width,
+          dest_y0 + height, texture_width, texture_height, dest_descriptor_set)) {
+    return Doax2DirectFail(7);
+  }
+  doax2_direct_texture_width_ = texture_width;
+  doax2_direct_texture_height_ = texture_height;
+
+  // Source origin: the resolve region's tile in the render target plus the
+  // offset in it (see XeResolveGetInfo / XeEdramOffsetBytes).
+  const uint32_t scale_x = draw_resolution_scale_x(), scale_y = draw_resolution_scale_y();
+  const uint32_t tile_offset =
+      (edram.base_tiles - rt_key.base_tiles) & (xenos::kEdramTileCount - 1);
+  const uint32_t tile_width =
+      xenos::kEdramTileWidthSamples >> uint32_t(edram.msaa_samples >= xenos::MsaaSamples::k4X);
+  const uint32_t tile_height =
+      xenos::kEdramTileHeightSamples >> uint32_t(edram.msaa_samples >= xenos::MsaaSamples::k2X);
+  uint32_t constants[9];
+  constants[0] = ((tile_offset % edram.pitch_tiles) * tile_width +
+                  resolve_info.coordinate_info.edram_offset_x_div_8 * 8) *
+                 scale_x;
+  constants[1] = ((tile_offset / edram.pitch_tiles) * tile_height +
+                  resolve_info.coordinate_info.edram_offset_y_div_8 * 8) *
+                 scale_y;
+  constants[2] = uint32_t(resolve_info.doax2_x0) * scale_x;
+  constants[3] = uint32_t(resolve_info.doax2_y0) * scale_y;
+  // Within the texture (resolves are 8-aligned, textures may not be).
+  constants[4] = std::min(width, texture_width - dest_x0) * scale_x;
+  constants[5] = std::min(height, texture_height - dest_y0) * scale_y;
+  constants[6] = edram.fill_half_pixel_offset ? (scale_x >> 1) : 0;
+  constants[7] = edram.fill_half_pixel_offset ? (scale_y >> 1) : 0;
+  // Depth: the host sample instead.
+  constants[8] = is_depth ? host_sample_index : (dest_info.copy_dest_swap ? 1 : 0);
+
+  command_processor_.PushImageMemoryBarrier(
+      rt.image(),
+      ui::vulkan::util::InitializeSubresourceRange(
+          is_depth ? VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT
+                   : VK_IMAGE_ASPECT_COLOR_BIT),
+      rt.current_stage_mask(), VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, rt.current_access_mask(),
+      VK_ACCESS_SHADER_READ_BIT, rt.current_layout(), VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+  rt.SetUsage(VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_READ_BIT,
+              VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+  command_processor_.SubmitBarriers(true);
+  DeferredCommandBuffer& command_buffer = command_processor_.deferred_command_buffer();
+  command_processor_.BindExternalComputePipeline(pipeline);
+  VkDescriptorSet descriptor_sets[2] = {dest_descriptor_set, rt.GetDescriptorSetTransferSource()};
+  const VkPipelineLayout pipeline_layout = is_depth ? doax2_direct_resolve_depth_pipeline_layout_
+                                                    : doax2_direct_resolve_pipeline_layout_;
+  command_buffer.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE, pipeline_layout, 0, 2,
+                                         descriptor_sets, 0, nullptr);
+  command_buffer.CmdVkPushConstants(pipeline_layout, VK_SHADER_STAGE_COMPUTE_BIT, 0,
+                                    sizeof(constants), constants);
+  command_buffer.CmdVkDispatch((constants[4] + 15) / 16, (constants[5] + 7) / 8, 1);
+  ++direct_count;
+  return true;
+}
