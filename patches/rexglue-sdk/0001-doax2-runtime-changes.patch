diff --git a/src/graphics/shaders/direct_rgba8_to_a8.cs.hlsl b/src/graphics/shaders/direct_rgba8_to_a8.cs.hlsl
new file mode 100644
index 0000000..136df56
--- /dev/null
+++ b/src/graphics/shaders/direct_rgba8_to_a8.cs.hlsl
@@ -0,0 +1,42 @@
+// Intel compatibility path for DOAX2 alpha-mask resolves. This fuses the
+// normal host-RT-to-EDRAM dump and EDRAM-to-tiled-A8 resolve into one pass.
+
+cbuffer XeDirectA8Constants : register(b0) {
+  uint xe_dest_base;
+  uint xe_dest_pitch;
+  uint xe_width;
+  uint xe_height;
+};
+
+Texture2D<float4> xe_source : register(t0);
+RWByteAddressBuffer xe_dest : register(u0);
+
+uint TiledOffset2D(uint x, uint y, uint pitch) {
+  pitch = (pitch + 31u) & ~31u;
+  uint macro = ((x >> 5u) + (y >> 5u) * (pitch >> 5u)) << 7u;
+  uint micro = (x & 7u) + ((y & 14u) << 2u);
+  uint offset = macro + ((micro & ~15u) << 1u) + (micro & 15u) +
+                ((y & 1u) << 4u);
+  return ((offset & ~511u) << 3u) + ((y & 16u) << 7u) +
+         ((offset & 448u) << 2u) +
+         (((((y & 8u) >> 2u) + (x >> 3u)) & 3u) << 6u) +
+         (offset & 63u);
+}
+
+// Four horizontally adjacent A8 texels are contiguous and DWORD-aligned in
+// Xbox 360 2D tiling, allowing one non-racing raw-buffer store per thread.
+[numthreads(16, 8, 1)]
+void main(uint3 dispatch_id : SV_DispatchThreadID) {
+  uint x = dispatch_id.x << 2u;
+  uint y = dispatch_id.y;
+  if (x >= xe_width || y >= xe_height) return;
+
+  uint packed = 0u;
+  [unroll]
+  for (uint i = 0u; i < 4u; ++i) {
+    uint alpha = (uint)(saturate(xe_source.Load(int3(x + i, y, 0)).a) *
+                        255.0f + 0.5f);
+    packed |= alpha << (i << 3u);
+  }
+  xe_dest.Store(xe_dest_base + TiledOffset2D(x, y, xe_dest_pitch), packed);
+}
diff --git a/src/graphics/shaders/doax2_direct_resolve.cs.glsl b/src/graphics/shaders/doax2_direct_resolve.cs.glsl
new file mode 100644
index 0000000..f217bdc
--- /dev/null
+++ b/src/graphics/shaders/doax2_direct_resolve.cs.glsl
@@ -0,0 +1,42 @@
+#version 450
+// DOAX2 direct resolve: copies a k_8_8_8_8 render target region straight into
+// a k_8_8_8_8 texture (uint view), bit-exact with the Xenia resolve shaders
+// (resolve.xesli / resolve_full_32bpp.xesli / pixel_formats.xesli): the
+// half-pixel offset gap is filled by clamping the source to fill, 2x MSAA
+// k01 averages the two samples in float, R/B swap, then round-half-up packing.
+// MSAA: 0 (1 sample) or 1 (2 samples averaged).
+#extension GL_EXT_samplerless_texture_functions : require
+layout(local_size_x = 16, local_size_y = 8) in;
+layout(push_constant) uniform Constants {
+  ivec2 src_origin;   // host pixels in the render target
+  ivec2 dest_origin;  // host pixels in the texture
+  uvec2 size;         // host pixels
+  uvec2 fill;         // half-pixel offset fill source (scale / 2, or 0)
+  uint swap;
+} c;
+layout(set = 0, binding = 0, r32ui) uniform writeonly uimage2D dest;
+#if MSAA
+layout(set = 1, binding = 0) uniform texture2DMS src;
+#else
+layout(set = 1, binding = 0) uniform texture2D src;
+#endif
+// Like XeUnpackR8G8B8A8UNorm: the exact byte, times (1 / 255).
+vec4 Unpack(vec4 f) { return vec4(uvec4(f * 255.0 + 0.5)) * (1.0 / 255.0); }
+void main() {
+  uvec2 p = gl_GlobalInvocationID.xy;
+  if (p.x >= c.size.x || p.y >= c.size.y) {
+    return;
+  }
+  ivec2 s = c.src_origin + ivec2(max(p, c.fill));
+#if MSAA
+  vec4 f = (Unpack(texelFetch(src, s, 0)) + Unpack(texelFetch(src, s, 1))) * 0.5;
+#else
+  vec4 f = Unpack(texelFetch(src, s, 0));
+#endif
+  if (c.swap != 0u) {
+    f = f.bgra;
+  }
+  uvec4 n = uvec4(clamp(f, 0.0, 1.0) * 255.0 + 0.5);
+  imageStore(dest, c.dest_origin + ivec2(p),
+             uvec4(n.r | (n.g << 8u) | (n.b << 16u) | (n.a << 24u), 0u, 0u, 0u));
+}
diff --git a/src/graphics/shaders/doax2_direct_resolve_depth.cs.glsl b/src/graphics/shaders/doax2_direct_resolve_depth.cs.glsl
new file mode 100644
index 0000000..b2240a3
--- /dev/null
+++ b/src/graphics/shaders/doax2_direct_resolve_depth.cs.glsl
@@ -0,0 +1,37 @@
+#version 450
+// DOAX2 direct depth resolve: copies a kD24S8 depth render target region
+// straight into a k_24_8 texture (uint view of its R32_SFLOAT host image),
+// bit-exact with the dump (round to nearest even of depth * 0xFFFFFF), the
+// resolve copy (the 32-bit EDRAM word) and the texture load
+// (float(d + (d >> 23)) / 2^24). Stencil isn't needed (the load drops it).
+// MSAA: 0 (1 sample) or 1 (one of 2 samples, the host sample index in sample).
+#extension GL_EXT_samplerless_texture_functions : require
+layout(local_size_x = 16, local_size_y = 8) in;
+layout(push_constant) uniform Constants {
+  ivec2 src_origin;   // host pixels in the render target
+  ivec2 dest_origin;  // host pixels in the texture
+  uvec2 size;         // host pixels
+  uvec2 fill;         // half-pixel offset fill source (scale / 2, or 0)
+  int sample_index;
+} c;
+layout(set = 0, binding = 0, r32ui) uniform writeonly uimage2D dest;
+#if MSAA
+layout(set = 1, binding = 0) uniform texture2DMS src;
+#else
+layout(set = 1, binding = 0) uniform texture2D src;
+#endif
+void main() {
+  uvec2 p = gl_GlobalInvocationID.xy;
+  if (p.x >= c.size.x || p.y >= c.size.y) {
+    return;
+  }
+  ivec2 s = c.src_origin + ivec2(max(p, c.fill));
+#if MSAA
+  float depth = texelFetch(src, s, c.sample_index).x;
+#else
+  float depth = texelFetch(src, s, 0).x;
+#endif
+  uint d = uint(roundEven(depth * 16777215.0));
+  float texel = float(d + (d >> 23u)) * (1.0 / 16777216.0);
+  imageStore(dest, c.dest_origin + ivec2(p), uvec4(floatBitsToUint(texel), 0u, 0u, 0u));
+}
diff --git a/src/graphics/shaders/doax2_lazy_write_back.cs.glsl b/src/graphics/shaders/doax2_lazy_write_back.cs.glsl
new file mode 100644
index 0000000..c95d8ef
--- /dev/null
+++ b/src/graphics/shaders/doax2_lazy_write_back.cs.glsl
@@ -0,0 +1,108 @@
+#version 450
+// DOAX2 lazy resolve memory: writes texels of a 32bpp resolution-scaled
+// texture (r32ui view) back to the scaled resolve buffer, at the addresses the
+// resolve copy would have written them (xenia's resolution-scaled tiled
+// addressing of this SDK's resolve and texture load shaders), with the guest
+// endianness.
+layout(local_size_x = 16, local_size_y = 8) in;
+layout(push_constant) uniform Constants {
+  uint origin;        // host texels: x | y << 16
+  uint size;          // host texels: width | height << 16
+  // scale x | scale y << 4 | endian << 8 | k_24_8 float depth << 10 |
+  // pitch (32 texels) << 16
+  uint scale_endian;
+  uint dead_count;
+  // Rectangles of later resolves (texels not to write): base offset from the
+  // texture's base (bytes), pitch (32 texels) | bytes per texel log2 << 16,
+  // x0 | y0 << 16, x1 | y1 << 16.
+  uvec4 dead[4];
+} c;
+layout(set = 0, binding = 0, r32ui) uniform readonly uimage2D src;
+// Bound from the scaled address of the texture's base.
+layout(set = 1, binding = 0, std430) writeonly buffer Dest { uint data[]; } dest;
+
+int XenosTextureTiledAddress2D(ivec2 p, uint pitch_macro_tiles, uint bytes_per_block_log2) {
+  int outer_blocks = ((p.y >> 5) * int(pitch_macro_tiles) + (p.x >> 5)) << 6;
+  int inner_blocks = (((p.y >> 1) & 0x7) << 3) | (p.x & 0x7);
+  int outer_inner_bytes = (outer_blocks | inner_blocks) << bytes_per_block_log2;
+  int bank = (p.y >> 4) & 0x1;
+  int pipe = ((p.x >> 3) & 0x3) ^ (((p.y >> 3) & 0x1) << 1);
+  return ((p.y & 1) << 4) | (pipe << 6) | (bank << 11) | (outer_inner_bytes & 0xF) |
+         (((outer_inner_bytes >> 4) & 0x1) << 5) | (((outer_inner_bytes >> 5) & 0x7) << 8) |
+         (outer_inner_bytes >> 8 << 12);
+}
+
+// Whether the byte at the tiled address belongs to a texel in the rectangle.
+bool XenosTiledAddressInRect(int address, uvec4 rect) {
+  if (address < 0) {
+    return false;
+  }
+  uint a = uint(address);
+  uint bpp_log2 = rect.y >> 16u;
+  uint outer_inner_bytes = (a & 0xFu) | (((a >> 5u) & 1u) << 4u) | (((a >> 8u) & 7u) << 5u) |
+                           ((a >> 12u) << 8u);
+  uint blocks = outer_inner_bytes >> bpp_log2;
+  uint inner = blocks & 63u;
+  uint macro = blocks >> 6u;
+  uint pitch = rect.y & 0xFFFFu;
+  uint y = (macro / pitch) * 32u + ((a >> 11u) & 1u) * 16u + ((inner >> 3u) << 1u) +
+           ((a >> 4u) & 1u);
+  uint pipe = (a >> 6u) & 3u;
+  uint x = (macro % pitch) * 32u + ((pipe ^ (((y >> 3u) & 1u) << 1u)) << 3u) + (inner & 7u);
+  return x >= (rect.z & 0xFFFFu) && y >= (rect.z >> 16u) && x < (rect.w & 0xFFFFu) &&
+         y < (rect.w >> 16u);
+}
+
+void main() {
+  uvec2 p = gl_GlobalInvocationID.xy;
+  uvec2 size = uvec2(c.size & 0xFFFFu, c.size >> 16u);
+  if (p.x >= size.x || p.y >= size.y) {
+    return;
+  }
+  uvec2 position = uvec2(c.origin & 0xFFFFu, c.origin >> 16u) + p;
+  uvec2 scale = uvec2(c.scale_endian & 0xFu, (c.scale_endian >> 4u) & 0xFu);
+  uint endian = (c.scale_endian >> 8u) & 0x3u;
+  uint pitch = c.scale_endian >> 16u;
+
+  // Skip texels overwritten by later resolves (guest texel address).
+  uvec2 guest_position = position / scale;
+  int guest_address = XenosTextureTiledAddress2D(ivec2(guest_position), pitch, 2u);
+  for (uint i = 0u; i < c.dead_count; ++i) {
+    int offset = int(c.dead[i].x);
+    if (XenosTiledAddressInRect(guest_address - offset, c.dead[i]) ||
+        XenosTiledAddressInRect(guest_address + 3 - offset, c.dead[i])) {
+      return;
+    }
+  }
+
+  uint value = imageLoad(src, ivec2(position)).x;
+  if ((c.scale_endian & (1u << 10u)) != 0u) {
+    // Inverse of the k_24_8 load float(d + (d >> 23)) / 2^24 (exact); the
+    // stencil isn't stored in the texture (written as 0).
+    uint t = uint(uintBitsToFloat(value) * 16777216.0);
+    value = (t - uint(t > 0x800000u)) << 8u;
+  }
+  if (endian == 1u || endian == 2u) {
+    value = ((value & 0x00FF00FFu) << 8u) | ((value & 0xFF00FF00u) >> 8u);
+  }
+  if (endian == 2u || endian == 3u) {
+    value = (value << 16u) | (value >> 16u);
+  }
+
+  // 4 bytes per block: groups of 4x1 blocks (as in this texture load shader).
+  const uvec2 group_blocks_log2 = uvec2(2u, 0u);
+  uvec2 host_group_id = position >> group_blocks_log2;
+  uvec2 guest_group_id = host_group_id / scale;
+  uvec2 host_group_in_guest = host_group_id - scale * guest_group_id;
+  uint host_group_index = host_group_in_guest.x * scale.y + host_group_in_guest.y;
+  const uint group_width_bytes_log2 = 2u + 2u;
+  uvec2 position_in_group = position & ((uvec2(1u) << group_blocks_log2) - 1u);
+  uint offset_in_guest_group = (host_group_index << (group_width_bytes_log2 + 0u)) |
+                               (position_in_group.y << group_width_bytes_log2) |
+                               (position_in_group.x << 2u);
+  uint address =
+      uint(XenosTextureTiledAddress2D(ivec2(guest_group_id << group_blocks_log2), pitch, 2u)) *
+          (scale.x * scale.y) +
+      offset_in_guest_group;
+  dest.data[address >> 2u] = value;
+}
diff --git a/src/graphics/shaders/doax2_texture_store.cs.glsl b/src/graphics/shaders/doax2_texture_store.cs.glsl
new file mode 100644
index 0000000..c991422
--- /dev/null
+++ b/src/graphics/shaders/doax2_texture_store.cs.glsl
@@ -0,0 +1,50 @@
+#version 450
+// DOAX2: writes texels loaded into the scratch buffer (host layout) straight
+// into the texture image through a uint view, bit-exact like
+// vkCmdCopyBufferToImage, without the slow buffer-to-image copy.
+// BYTES: 1 (r8ui), 2 (r16ui), 4 (r32ui), 8 (rgba16ui) or 16 (rgba32ui) per
+// texel.
+layout(local_size_x = 16, local_size_y = 8) in;
+layout(push_constant) uniform Constants {
+  uint buffer_offset;  // bytes
+  uint buffer_pitch;   // bytes per row
+  uint width;
+  uint height;
+  int dest_y;
+} c;
+#if BYTES == 1
+layout(set = 0, binding = 0, r8ui) uniform writeonly uimage2D dest;
+#elif BYTES == 2
+layout(set = 0, binding = 0, r16ui) uniform writeonly uimage2D dest;
+#elif BYTES == 4
+layout(set = 0, binding = 0, r32ui) uniform writeonly uimage2D dest;
+#elif BYTES == 8
+layout(set = 0, binding = 0, rgba16ui) uniform writeonly uimage2D dest;
+#else
+layout(set = 0, binding = 0, rgba32ui) uniform writeonly uimage2D dest;
+#endif
+layout(set = 1, binding = 0, std430) readonly buffer Source { uint data[]; } src;
+void main() {
+  uvec2 p = gl_GlobalInvocationID.xy;
+  if (p.x >= c.width || p.y >= c.height) {
+    return;
+  }
+  uint byte_offset = c.buffer_offset + p.y * c.buffer_pitch + p.x * uint(BYTES);
+  uint word = byte_offset >> 2;
+  ivec2 coord = ivec2(int(p.x), int(p.y) + c.dest_y);
+#if BYTES == 1
+  imageStore(dest, coord,
+             uvec4((src.data[word] >> ((byte_offset & 3u) << 3u)) & 0xFFu, 0u, 0u, 0u));
+#elif BYTES == 2
+  imageStore(dest, coord,
+             uvec4((src.data[word] >> ((byte_offset & 2u) << 3u)) & 0xFFFFu, 0u, 0u, 0u));
+#elif BYTES == 4
+  imageStore(dest, coord, uvec4(src.data[word], 0u, 0u, 0u));
+#elif BYTES == 8
+  uint w0 = src.data[word], w1 = src.data[word + 1u];
+  imageStore(dest, coord, uvec4(w0 & 0xFFFFu, w0 >> 16u, w1 & 0xFFFFu, w1 >> 16u));
+#else
+  imageStore(dest, coord,
+             uvec4(src.data[word], src.data[word + 1u], src.data[word + 2u], src.data[word + 3u]));
+#endif
+}
