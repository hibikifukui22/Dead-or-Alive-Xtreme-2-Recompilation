+bool D3D12TextureCache::RecordOwnedActiveTextureCopy(
+    uint32_t fetch_constant_index, ID3D12Resource* destination,
+    D3D12_RESOURCE_STATES destination_before,
+    D3D12_RESOURCE_STATES destination_after) {
+  if (!destination || fetch_constant_index >= xenos::kTextureFetchConstantCount)
+    return false;
+  const TextureBinding* binding = GetValidTextureBinding(fetch_constant_index);
+  if (!binding || !binding->texture) return false;
+  auto& source = static_cast<D3D12Texture&>(*binding->texture);
+  ID3D12Resource* source_resource = source.resource();
+  if (!source_resource || source_resource == destination) return false;
+  const D3D12_RESOURCE_DESC source_desc = source_resource->GetDesc();
+  const D3D12_RESOURCE_DESC destination_desc = destination->GetDesc();
+  const D3D12_RESOURCE_STATES shader_read_state =
+      D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE |
+      D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+  if (source.resource_state() != shader_read_state ||
+      source_desc.Dimension != D3D12_RESOURCE_DIMENSION_TEXTURE2D ||
+      source_desc.Width != destination_desc.Width ||
+      source_desc.Height != destination_desc.Height ||
+      source_desc.DepthOrArraySize != destination_desc.DepthOrArraySize ||
+      source_desc.MipLevels != destination_desc.MipLevels ||
+      source_desc.Format != destination_desc.Format ||
+      source_desc.SampleDesc.Count != destination_desc.SampleDesc.Count ||
+      source_desc.SampleDesc.Quality != destination_desc.SampleDesc.Quality ||
+      source_desc.Flags != destination_desc.Flags ||
+      source_desc.Layout != destination_desc.Layout) {
+    return false;
+  }
+  command_processor_.PushTransitionBarrier(
+      source_resource, source.SetResourceState(D3D12_RESOURCE_STATE_COPY_SOURCE),
+      D3D12_RESOURCE_STATE_COPY_SOURCE);
+  command_processor_.PushTransitionBarrier(
+      destination, destination_before, D3D12_RESOURCE_STATE_COPY_DEST);
+  command_processor_.SubmitBarriers();
+  command_processor_.GetDeferredCommandList().D3DCopyResource(
+      destination, source_resource);
+  command_processor_.PushTransitionBarrier(
+      source_resource, source.SetResourceState(shader_read_state),
+      shader_read_state);
+  command_processor_.PushTransitionBarrier(
+      destination, D3D12_RESOURCE_STATE_COPY_DEST, destination_after);
+  return true;
+}
