+    REXGPU_INFO(
+        "DOAX2 owned-unit state pair restarted: recipe={:016X} frame={} exact pipeline/root identity changed; fresh draw requires an identical immutable pipeline boundary",
+        key, serial);
+    owned_unit_snapshot_.Clear();
+  }
+  if (draw.constants_index >=
+      interpolation_frame_recording_.vertex_constants.size())
+    return;
+  OwnedRenderStateSnapshot state;
+  state.guest_swap_serial = serial;
+  state.vertex_constants =
+      interpolation_frame_recording_.vertex_constants[draw.constants_index];
+  if (draw.pixel_constants_index != UINT32_MAX) {
+    if (draw.pixel_constants_index >=
+        interpolation_frame_recording_.pixel_constants.size())
+      return;
+    state.pixel_constants =
+        interpolation_frame_recording_.pixel_constants[draw.pixel_constants_index];
+  }
+  std::copy_n(register_file_->values, RegisterFile::kRegisterCount,
+              state.registers.begin());
+  state.system_constants = system_constants_;
+  state.viewport = ff_viewport_;
+  state.scissor = ff_scissor_;
+  std::copy_n(ff_blend_factor_, state.blend_factor.size(),
+              state.blend_factor.begin());
+  state.stencil_reference = ff_stencil_ref_;
+
+  if (!owned_unit_snapshot_.state_count) {
+    owned_unit_snapshot_.recipe_key = key;
+    owned_unit_snapshot_.guest_swap_serial = serial;
+    owned_unit_snapshot_.draw = draw;
+    std::unordered_map<uint32_t, uint32_t> vertex_ranges;
+    std::unordered_map<uint32_t, uint32_t> index_ranges;
+    std::unordered_map<uint32_t, uint32_t> texture_ranges;
+    auto add_range = [](auto& ranges, uint32_t address, uint32_t size) {
+      if (!size) return;
+      auto [it, inserted] = ranges.emplace(address, size);
+      if (!inserted) it->second = std::max(it->second, size);
+    };
+    for (size_t word = 0; word + 1 < draw.vertex_fetch_words.size();
+         word += 2) {
+      xenos::xe_gpu_vertex_fetch_t fetch{};
+      fetch.dword_0 = draw.vertex_fetch_words[word];
+      fetch.dword_1 = draw.vertex_fetch_words[word + 1];
+      add_range(vertex_ranges, fetch.address << 2, fetch.size << 2);
+    }
+    if (draw.index_buffer_type == uint8_t(PrimitiveProcessor::kGuestDMA))
+      add_range(index_ranges, draw.guest_index_base, draw.index_bytes);
+    auto add_texture_keys = [&](const auto& keys, bool pixel) {
+      for (size_t i = 0; i < keys.size(); ++i) {
+        const auto& texture = keys[i];
+        if (composite_unit && pixel && texture.IsValid() &&
+            texture.GetGuestBaseAddress() ==
+                draw.texture_srv_keys_pixel[0].GetGuestBaseAddress()) {
+          continue;
+        }
+        if (!texture.IsValid()) continue;
+        add_range(texture_ranges, texture.GetGuestBaseAddress(),
+                  texture.GetGuestBaseSize());
+        add_range(texture_ranges, texture.GetGuestMipAddress(),
+                  texture.GetGuestMipsSize());
+      }
+    };
+    add_texture_keys(draw.texture_srv_keys_vertex, false);
+    add_texture_keys(draw.texture_srv_keys_pixel, true);
+
+    uint64_t content_hash = 14695981039346656037ull;
+    auto copy_ranges = [&](const auto& sources, auto& destination) {
+      for (const auto& [address, size] : sources) {
+        const uint8_t* source = memory_->TranslatePhysical(address);
+        if (!source) return false;
+        OwnedGuestRangeSnapshot range;
+        range.guest_address = address;
+        range.bytes.resize(size);
+        std::memcpy(range.bytes.data(), source, size);
+        for (uint8_t value : range.bytes)
+          content_hash = (content_hash ^ value) * 1099511628211ull;
+        destination.push_back(std::move(range));
+      }
+      return true;
+    };
+    if (!copy_ranges(vertex_ranges, owned_unit_snapshot_.vertex_ranges) ||
+        !copy_ranges(index_ranges, owned_unit_snapshot_.index_ranges) ||
+        !copy_ranges(texture_ranges, owned_unit_snapshot_.texture_ranges)) {
+      REXGPU_WARN(
+          "DOAX2 owned-unit snapshot rejected: recipe={:016X} contained an untranslated guest range",
+          key);
+      owned_unit_snapshot_.Clear();
+      return;
+    }
+    owned_unit_snapshot_.content_hash = content_hash;
+  }
+
+  if (composite_unit && owned_unit_snapshot_.state_count == 1) {
+    // The guest ping-pong address is frame-specific. Build the fresh root
+    // packet and geometry from N+1's actual fetch/binding state, not N's
+    // stale guest addresses. This composite has no guest index or texture
+    // ranges; its pixel inputs are separately owned GPU-produced copies.
+    if (!owned_unit_snapshot_.index_ranges.empty() ||
+        !owned_unit_snapshot_.texture_ranges.empty()) {
+      REXGPU_WARN("DOAX2 owned composite state rejected: unexpected guest index/texture ranges");
+      owned_unit_snapshot_.Clear();
+      return;
+    }
+    std::unordered_map<uint32_t, uint32_t> vertex_ranges;
+    for (size_t word = 0; word + 1 < draw.vertex_fetch_words.size();
+         word += 2) {
+      xenos::xe_gpu_vertex_fetch_t fetch{};
+      fetch.dword_0 = draw.vertex_fetch_words[word];
+      fetch.dword_1 = draw.vertex_fetch_words[word + 1];
+      const uint32_t address = fetch.address << 2;
+      const uint32_t size = fetch.size << 2;
+      if (!size || size > (1u << 20)) {
+        REXGPU_WARN("DOAX2 owned composite state rejected: invalid N+1 vertex range address={:08X} size={}",
+                    address, size);
+        owned_unit_snapshot_.Clear();
+        return;
+      }
+      auto [it, inserted] = vertex_ranges.emplace(address, size);
+      if (!inserted) it->second = std::max(it->second, size);
+    }
+    std::vector<OwnedGuestRangeSnapshot> next_vertex_ranges;
+    next_vertex_ranges.reserve(vertex_ranges.size());
+    uint64_t content_hash = 14695981039346656037ull;
+    for (const auto& [address, size] : vertex_ranges) {
+      const uint8_t* source = memory_->TranslatePhysical(address);
+      if (!source) {
+        REXGPU_WARN("DOAX2 owned composite state rejected: N+1 vertex address={:08X} is untranslated",
+                    address);
+        owned_unit_snapshot_.Clear();
+        return;
+      }
+      OwnedGuestRangeSnapshot range;
+      range.guest_address = address;
+      range.bytes.resize(size);
+      std::memcpy(range.bytes.data(), source, size);
+      for (uint8_t value : range.bytes)
+        content_hash = (content_hash ^ value) * 1099511628211ull;
+      next_vertex_ranges.push_back(std::move(range));
+    }
+    owned_unit_snapshot_.vertex_ranges = std::move(next_vertex_ranges);
+    owned_unit_snapshot_.content_hash = content_hash;
+    owned_unit_snapshot_.draw = draw;
+  }
+  owned_unit_snapshot_.states[owned_unit_snapshot_.state_count++] =
+      std::move(state);
+  if (owned_unit_snapshot_.state_count < 2) {
+    REXGPU_INFO(
+        "DOAX2 owned-unit state pair: selected_frame={} recipe={:016X} state=N frame={} captured; awaiting adjacent N+1 state, no submission",
+        owned_unit_snapshot_selected_frame_, key, serial);
+    return;
+  }
+  owned_unit_snapshot_.complete = true;
+
+  uint64_t vertex_bytes = 0, index_bytes = 0, texture_bytes = 0;
+  for (const auto& range : owned_unit_snapshot_.vertex_ranges)
+    vertex_bytes += range.bytes.size();
+  for (const auto& range : owned_unit_snapshot_.index_ranges)
+    index_bytes += range.bytes.size();
+  for (const auto& range : owned_unit_snapshot_.texture_ranges)
+    texture_bytes += range.bytes.size();
+  const auto& state_n = owned_unit_snapshot_.states[0];
+  const auto& state_n1 = owned_unit_snapshot_.states[1];
+  size_t changed_constant_words = 0;
+  size_t interpolated_transform_words = 0;
+  owned_unit_snapshot_.midpoint_vertex_values =
+      state_n1.vertex_constants.values;
+  size_t packed_value = 0;
+  for (uint32_t map_word = 0; map_word < 4; ++map_word) {
+    uint64_t remaining = state_n1.vertex_constants.register_map[map_word];
+    uint32_t bit;
+    while (rex::bit_scan_forward(remaining, &bit)) {
+      remaining &= ~(UINT64_C(1) << bit);
+      const uint32_t constant = (map_word << 6) + bit;
+      const bool interpolate_transform =
+          constant <= 3 || (constant >= 17 && constant <= 20) ||
+          (constant >= 37 && constant <= 40) || constant >= 84;
+      for (uint32_t component = 0; component < 4;
+           ++component, ++packed_value) {
+        if (packed_value >= state_n.vertex_constants.values.size() ||
+            packed_value >= state_n1.vertex_constants.values.size())
+          break;
+        const uint32_t old_word = state_n.vertex_constants.values[packed_value];
+        const uint32_t new_word = state_n1.vertex_constants.values[packed_value];
