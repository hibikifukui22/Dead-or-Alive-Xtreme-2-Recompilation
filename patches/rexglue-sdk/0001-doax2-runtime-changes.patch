+        auto global_lock = global_critical_region_.Acquire();
+        uint64_t& written_block = system_page_flags_written_by_guest_[page >> 6];
+        const uint64_t page_bit = uint64_t(1) << (page & 63);
+        written_by_guest = (written_block & page_bit) != 0;
+        written_block &= ~page_bit;
+      }
+      // Compare the contents with the last upload (never 0 - unknown).
+      const uint64_t hash =
+          XXH3_64bits(memory_.TranslatePhysical(page << page_size_log2_), page_size) | 1;
+      const uint64_t last_hash = page_upload_hashes_[page];
+      const bool changed = last_hash != hash;
+      page_upload_hashes_[page] = hash;
+      if (changed && last_hash && !written_by_guest &&
+          !page_blocks_refresh_every_frame_[page >> 6]) {
+        // Modified bypassing the access callbacks (such as through another
+        // view of physical memory): recheck the whole block every frame.
+        page_blocks_refresh_every_frame_[page >> 6] = 1;
+        REXGPU_INFO("Shared memory: {:08X} written bypassing access callbacks, rechecking "
+                    "its {} KB block every frame",
+                    page << page_size_log2_, (64u << page_size_log2_) >> 10);
+      }
+      if (changed) {
+        if (changed_start == UINT32_MAX) {
+          changed_start = page;
+        }
+      } else if (changed_start != UINT32_MAX) {
+        upload_ranges_changed_.emplace_back(changed_start, page - changed_start);
+        changed_start = UINT32_MAX;
+      }
+    }
+    if (changed_start != UINT32_MAX) {
+      upload_ranges_changed_.emplace_back(changed_start, range_end - changed_start);
+    }
+  }
+  upload_ranges_.swap(upload_ranges_changed_);
+}
+
+void SharedMemory::ForgetInvalidatedUploadPageHashes() {
+  // The hash was taken before the copy: a page written by the guest in
+  // between (invalidated again) may have been uploaded with other data.
+  auto global_lock = global_critical_region_.Acquire();
+  for (const std::pair<uint32_t, uint32_t>& range : upload_ranges_) {
+    for (uint32_t page = range.first; page < range.first + range.second; ++page) {
+      if (!(system_page_flags_valid_[page >> 6] & (uint64_t(1) << (page & 63)))) {
+        page_upload_hashes_[page] = 0;
+      }
+    }
+  }
+}
+
+void SharedMemory::ForgetUploadPageHashes(uint32_t page_first, uint32_t page_last) {
+  if (page_upload_hashes_.empty()) {
+    return;
+  }
+  std::fill(page_upload_hashes_.begin() + page_first, page_upload_hashes_.begin() + page_last + 1,
+            uint64_t(0));
 }
 
