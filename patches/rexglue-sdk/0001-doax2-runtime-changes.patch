+std::pair<uint32_t, uint32_t> TextureCache::Doax2PartialRowsForEvent(
+    const Texture& texture) const {
+  constexpr std::pair<uint32_t, uint32_t> kWhole{0, UINT32_MAX};
+  const Doax2PartialResolve& partial = doax2_partial_resolve_;
+  if (!partial.active) return kWhole;
+  const TextureKey& key = texture.key();
+  if (key.dimension != xenos::DataDimension::k2DOrStacked || key.depth_or_array_size_minus_1 ||
+      !key.tiled || key.mip_max_level || key.pitch != partial.pitch_div_32 ||
+      (key.base_page << 12) != partial.base) {
+    return kWhole;
+  }
+  const FormatInfo* format_info = FormatInfo::Get(key.format);
+  if (format_info->block_width != 1 || format_info->block_height != 1 ||
+      (uint32_t(1) << partial.bpp_log2) != format_info->bytes_per_block()) {
+    return kWhole;
+  }
+  return {partial.row_first, partial.row_end};
+}
+
+void TextureCache::Doax2OnTextureInvalidated(const Texture& texture) {
+  if (doax2_direct_resolve_.texture == &texture) {
+    doax2_direct_valid_.insert(&texture);
+  }
+  const std::pair<uint32_t, uint32_t> rows = Doax2PartialRowsForEvent(texture);
+  auto it = doax2_partial_rows_.find(&texture);
+  if (it == doax2_partial_rows_.end()) {
+    doax2_partial_rows_.emplace(&texture, rows);
+  } else {
+    Doax2MergeRows(it->second, rows);
+  }
+}
+
+void TextureCache::Doax2PartialGlobalWatch(const std::unique_lock<std::recursive_mutex>& global_lock,
+                                           void* context, uint32_t address_first,
+                                           uint32_t address_last, bool invalidated_by_gpu) {
+  auto& cache = *static_cast<TextureCache*>(context);
+  const Doax2PartialResolve& partial = cache.doax2_partial_resolve_;
+  const bool partial_event = partial.active && address_first >= (partial.start & ~uint32_t(4095)) &&
+                             address_last < ((partial.end + 4095) & ~uint32_t(4095));
+  // Any other write into a direct-resolved texture's memory makes it reload.
+  const Doax2DirectResolve& direct = cache.doax2_direct_resolve_;
+  for (auto it = cache.doax2_direct_valid_.begin(); it != cache.doax2_direct_valid_.end();) {
+    const Texture* texture = *it;
+    const uint32_t base = texture->key().base_page << 12;
+    const uint32_t end = base + texture->GetGuestBaseSize();
+    const bool own_event = direct.texture == texture &&
+                           address_first >= (direct.start & ~uint32_t(4095)) &&
+                           address_last < ((direct.end + 4095) & ~uint32_t(4095));
+    if (address_last >= base && address_first < end && !own_event) {
+      it = cache.doax2_direct_valid_.erase(it);
+    } else {
+      ++it;
+    }
+  }
+  for (auto& [texture, rows] : cache.doax2_partial_rows_) {
+    if (rows.second == UINT32_MAX) continue;
+    const uint32_t base = texture->key().base_page << 12;
+    const uint32_t end = base + texture->GetGuestBaseSize();
+    if (address_last < base || address_first >= end) continue;
+    Doax2MergeRows(rows, partial_event ? cache.Doax2PartialRowsForEvent(*texture)
+                                       : std::pair<uint32_t, uint32_t>{0, UINT32_MAX});
+  }
+}
+
+TextureCache::Texture* TextureCache::Doax2FindDirectResolveTexture(uint32_t base,
+                                                                   uint32_t pitch_div_32,
+                                                                   xenos::TextureFormat format,
+                                                                   uint32_t endianness,
+                                                                   uint32_t x0, uint32_t y0,
+                                                                   uint32_t x1, uint32_t y1) {
+  base &= 0x1FFFFFFF;
+  if (base & 4095) {
+    return nullptr;
+  }
+  auto global_lock = global_critical_region_.Acquire();
+  for (auto& [key, texture] : textures_) {
+    if ((key.base_page << 12) != base || key.format != format || key.pitch != pitch_div_32 ||
+        key.dimension != xenos::DataDimension::k2DOrStacked || key.depth_or_array_size_minus_1 ||
+        !key.tiled || key.mip_max_level || !key.scaled_resolve ||
+        uint32_t(key.endianness) != endianness || key.signed_separate) {
+      continue;
+    }
+    if (x0 >= key.GetWidth() || y0 >= key.GetHeight()) {
+      continue;
+    }
+    // The resolve must fit (up to its 8-pixel alignment): a smaller texture at
+    // the same address must not take it, the rest would be lost.
+    if (x1 > ((key.GetWidth() + 7) & ~uint32_t(7)) ||
+        y1 > ((key.GetHeight() + 7) & ~uint32_t(7))) {
+      continue;
+    }
+    if (!texture->base_outdated(global_lock) || doax2_direct_valid_.count(texture.get()) ||
+        (!x0 && !y0 && x1 >= key.GetWidth() && y1 >= key.GetHeight())) {
+      return texture.get();
+    }
+  }
+  // Diagnostics: why the textures at this base don't qualify (once per kind).
+  static std::unordered_set<std::string> reported;
+  if (reported.size() < 64) {
+    for (auto& [key, texture] : textures_) {
+      if ((key.base_page << 12) != base) continue;
+      std::string why = fmt::format(
+          "base {:08X}: fmt {} (want {}) pitch {} (want {}) dim {} layers {} tiled {} mips {} "
+          "scaled {} endian {} (want {}) signed {} outdated {} direct_valid {} {}x{}",
+          base, uint32_t(key.format), uint32_t(format), uint32_t(key.pitch), pitch_div_32,
+          uint32_t(key.dimension), uint32_t(key.depth_or_array_size_minus_1), uint32_t(key.tiled),
+          uint32_t(key.mip_max_level), uint32_t(key.scaled_resolve), uint32_t(key.endianness),
+          endianness, uint32_t(key.signed_separate), texture->base_outdated(global_lock),
+          doax2_direct_valid_.count(texture.get()), key.GetWidth(), key.GetHeight());
+      if (reported.insert(why).second) {
+        REXGPU_INFO("DOAX2 direct resolve target: {}", why);
+      }
+    }
+  }
+  return nullptr;
+}
+
+void TextureCache::Doax2BeginDirectResolve(uint32_t extent_start, uint32_t extent_length) {
+  Texture* texture = doax2_direct_pending_;
+  doax2_direct_pending_ = nullptr;
+  if (!texture) {
+    return;
+  }
+  if (!doax2_partial_global_watch_) {
+    doax2_partial_global_watch_ =
+        shared_memory().RegisterGlobalWatch(Doax2PartialGlobalWatch, this);
+  }
+  auto global_lock = global_critical_region_.Acquire();
+  doax2_direct_resolve_.texture = texture;
+  doax2_direct_resolve_.start = extent_start & 0x1FFFFFFF;
+  doax2_direct_resolve_.end = doax2_direct_resolve_.start + extent_length;
+  // Outdated already (an earlier direct resolve, or this one covers the whole
+  // texture): the watch won't fire again.
+  if (texture->base_outdated(global_lock)) {
+    doax2_direct_valid_.insert(texture);
+  }
+}
+
+void TextureCache::Doax2EndDirectResolve() {
+  auto global_lock = global_critical_region_.Acquire();
+  doax2_direct_resolve_.texture = nullptr;
+}
+
+bool TextureCache::Doax2TakeDirectValid(const Texture& texture) {
+  auto global_lock = global_critical_region_.Acquire();
+  return doax2_direct_valid_.erase(&texture) != 0;
+}
+
+std::pair<uint32_t, uint32_t> TextureCache::Doax2TakePartialRows(const Texture& texture) {
+  auto global_lock = global_critical_region_.Acquire();
+  auto it = doax2_partial_rows_.find(&texture);
+  if (it == doax2_partial_rows_.end()) return {0, 0};
+  const std::pair<uint32_t, uint32_t> rows = it->second;
+  doax2_partial_rows_.erase(it);
+  return rows.second == UINT32_MAX ? std::pair<uint32_t, uint32_t>{0, 0} : rows;
+}
+
+void TextureCache::Doax2AddLazyResolve(uint32_t extent_start, uint32_t extent_length,
+                                       uint32_t x0, uint32_t y0, uint32_t width,
+                                       uint32_t height) {
+  Texture* texture = doax2_direct_pending_;
+  if (!texture) {
+    return;
+  }
+  // Earlier lazy texels of the texture covered by these are written by this.
+  doax2_lazy_resolves_.erase(
+      std::remove_if(doax2_lazy_resolves_.begin(), doax2_lazy_resolves_.end(),
+                     [&](const Doax2LazyResolve& lazy) {
+                       return lazy.texture == texture && lazy.x0 >= x0 && lazy.y0 >= y0 &&
+                              lazy.x0 + lazy.width <= x0 + width &&
+                              lazy.y0 + lazy.height <= y0 + height;
+                     }),
+      doax2_lazy_resolves_.end());
+  const uint32_t start = extent_start & 0x1FFFFFFF;
+  Doax2LazyResolve lazy = {};
+  lazy.texture = texture;
+  lazy.start = start;
+  lazy.end = start + extent_length;
+  lazy.x0 = x0;
+  lazy.y0 = y0;
+  lazy.width = width;
+  lazy.height = height;
+  doax2_lazy_resolves_.push_back(lazy);
+}
+
+void TextureCache::Doax2WriteBackLazyResolves(uint32_t start, uint32_t end) {
+  if (doax2_lazy_resolves_.empty()) {
+    return;
+  }
+  const uint32_t length = end - start;
+  start &= 0x1FFFFFFF;
+  end = start + length;
+  for (size_t i = 0; i < doax2_lazy_resolves_.size();) {
+    const Doax2LazyResolve lazy = doax2_lazy_resolves_[i];
+    if (lazy.start < end && start < lazy.end) {
+      doax2_lazy_resolves_.erase(doax2_lazy_resolves_.begin() + i);
+      Doax2WriteLazyResolve(lazy);
+    } else {
+      ++i;
+    }
+  }
+}
+
+void TextureCache::Doax2LazyResolveOverwritten(uint32_t extent_start, uint32_t extent_length,
+                                               uint32_t base, uint32_t pitch_div_32,
+                                               uint32_t bpp_log2, bool rect_known, uint32_t x0,
+                                               uint32_t y0, uint32_t x1, uint32_t y1) {
+  if (doax2_lazy_resolves_.empty()) {
+    return;
+  }
+  const uint32_t start = extent_start & 0x1FFFFFFF;
+  const uint32_t end = start + extent_length;
+  base &= 0x1FFFFFFF;
+  for (size_t i = 0; i < doax2_lazy_resolves_.size();) {
+    Doax2LazyResolve& lazy = doax2_lazy_resolves_[i];
+    if (lazy.texture == doax2_direct_pending_ || lazy.start >= end || start >= lazy.end) {
+      ++i;
+      continue;
+    }
+    // All of its texels overwritten (the same layout): nothing to write back.
+    const TextureKey& key = lazy.texture->key();
+    if (rect_known && base == (key.base_page << 12) && pitch_div_32 == key.pitch &&
+        bpp_log2 == 2 && x0 <= lazy.x0 && y0 <= lazy.y0 && x1 >= lazy.x0 + lazy.width &&
+        y1 >= lazy.y0 + lazy.height) {
+      doax2_lazy_resolves_.erase(doax2_lazy_resolves_.begin() + i);
+      continue;
+    }
+    if (rect_known && (base & 4095) == 0 && lazy.dead_count < kDoax2MaxDeadRects) {
+      Doax2DeadRect& dead = lazy.dead[lazy.dead_count++];
+      dead.offset = int32_t(base - (lazy.texture->key().base_page << 12));
+      dead.pitch_div_32 = pitch_div_32;
+      dead.bpp_log2 = bpp_log2;
+      dead.x0 = x0;
+      dead.y0 = y0;
+      dead.x1 = x1;
+      dead.y1 = y1;
+      ++i;
+      continue;
+    }
+    // Not trackable: the older texels go to the memory first.
+    const Doax2LazyResolve write_back = lazy;
+    doax2_lazy_resolves_.erase(doax2_lazy_resolves_.begin() + i);
+    Doax2WriteLazyResolve(write_back);
+  }
+}
+
+void TextureCache::Doax2ForgetTexture(const Texture& texture) {
+  if (!doax2_lazy_resolves_.empty()) {
+    // Only when destroying all textures (eviction writes them back first).
+    doax2_lazy_resolves_.erase(
+        std::remove_if(doax2_lazy_resolves_.begin(), doax2_lazy_resolves_.end(),
+                       [&](const Doax2LazyResolve& lazy) { return lazy.texture == &texture; }),
+        doax2_lazy_resolves_.end());
+  }
+  auto global_lock = global_critical_region_.Acquire();
+  doax2_partial_rows_.erase(&texture);
+  doax2_direct_valid_.erase(&texture);
+  if (doax2_direct_pending_ == &texture) {
+    doax2_direct_pending_ = nullptr;
+  }
+  if (doax2_direct_resolve_.texture == &texture) {
+    doax2_direct_resolve_.texture = nullptr;
+  }
 }
 
