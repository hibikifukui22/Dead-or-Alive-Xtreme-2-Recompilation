+bool D3D12TextureCache::DescribeActiveTextureResource(
+    uint32_t fetch_constant_index,
+    ActiveTextureResourceInfo& info_out) const {
+  info_out = {};
+  if (fetch_constant_index >= xenos::kTextureFetchConstantCount) return false;
+  const TextureBinding* binding = GetValidTextureBinding(fetch_constant_index);
+  if (!binding || !binding->texture) return false;
+  const auto& texture = static_cast<const D3D12Texture&>(*binding->texture);
+  ID3D12Resource* resource = texture.resource();
+  if (!resource) return false;
+  info_out.identity = reinterpret_cast<uintptr_t>(resource);
+  info_out.description = resource->GetDesc();
+  info_out.state = texture.resource_state();
+  info_out.signed_resource_separate =
+      binding->texture_signed && binding->texture_signed != binding->texture;
+  info_out.base_load_generation = texture.base_load_generation();
+  info_out.last_base_load_serial = texture.last_base_load_serial();
+  info_out.outdated_mask = texture.outdated_mask();
+  return true;
+}
