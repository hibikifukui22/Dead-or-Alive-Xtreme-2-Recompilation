+        const auto& a = *reinterpret_cast<const SetDescriptorHeapsArguments*>(stream);
+        ID3D12DescriptorHeap* heaps[2];
+        UINT count = 0;
+        if (a.cbv_srv_uav_descriptor_heap) heaps[count++] = a.cbv_srv_uav_descriptor_heap;
+        if (a.sampler_descriptor_heap) heaps[count++] = a.sampler_descriptor_heap;
+        command_list->SetDescriptorHeaps(count, heaps);
+      } break;
+      case Command::kD3DSetPipelineState:
+        current_pipeline_state = *reinterpret_cast<ID3D12PipelineState* const*>(stream);
+        // External pipelines don't carry guest shader-side-effect metadata.
+        // They are never accepted as private scene producers.
+        current_pipeline_side_effect_free = false;
+        if (current_pipeline_state) command_list->SetPipelineState(current_pipeline_state);
+        break;
+      case Command::kSetPipelineStateHandle: {
+        void* pipeline_handle = *reinterpret_cast<void* const*>(stream);
+        current_pipeline_state =
+            command_processor_.GetD3D12PipelineByHandle(pipeline_handle);
+        current_pipeline_side_effect_free =
+            command_processor_.IsD3D12PipelineGraphicsReplaySideEffectFree(
+                pipeline_handle);
+        if (current_pipeline_state) command_list->SetPipelineState(current_pipeline_state);
+      } break;
+      case Command::kD3DSetSamplePositions:
+        if (command_list_1) {
+          const auto& a = *reinterpret_cast<const D3DSetSamplePositionsArguments*>(stream);
+          command_list_1->SetSamplePositions(
