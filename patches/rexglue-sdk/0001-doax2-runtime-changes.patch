+    }
+    vertex_index = std::min(max_index, std::max(min_index, (vertex_index + index_offset) & 0xFFFFFF));
+    sink.Reset();
+    shader_interpreter_.temp_registers()[0] = float(vertex_index);
+    shader_interpreter_.Execute();
+    if ((sink.vertex_kill().has_value() && (sink.vertex_kill().value() & ~(UINT32_C(1) << 31))) ||
+        !sink.position_x().has_value() || !sink.position_y().has_value()) {
+      valid = false;
+      break;
+    }
+    float x = sink.position_x().value(), y = sink.position_y().value();
+    if (clipped) {
+      // Not near- / far-clipped: 0 <= z <= w (Direct3D convention).
+      if (!sink.position_z().has_value() || !sink.position_w().has_value() ||
+          !(sink.position_z().value() >= 0.0f) ||
+          !(sink.position_z().value() <= sink.position_w().value())) {
+        valid = false;
+        break;
+      }
+    }
+    if (!pa_cl_vte_cntl.vtx_xy_fmt) {
+      if (!sink.position_w().has_value() || !(sink.position_w().value() > 0.0f)) {
+        valid = false;
+        break;
+      }
+      x /= sink.position_w().value();
+      y /= sink.position_w().value();
+    }
+    xs[i] = x * x_scale + x_offset + screen_x;
+    ys[i] = y * y_scale + y_offset + screen_y;
+    if (!std::isfinite(xs[i]) || !std::isfinite(ys[i])) {
+      valid = false;
+    }
+  }
+  shader_interpreter_.SetExportSink(nullptr);
+  if (!valid) {
+    return false;
+  }
+  const float x0 = *std::min_element(xs, xs + count), x1 = *std::max_element(xs, xs + count);
+  const float y0 = *std::min_element(ys, ys + count), y1 = *std::max_element(ys, ys + count);
+  // Clipped to the viewport ([-1, 1] in normalized device coordinates).
+  float clip_x0 = x0, clip_x1 = x1, clip_y0 = y0, clip_y1 = y1;
+  if (clipped) {
+    clip_x0 = std::max(clip_x0, x_offset - std::abs(x_scale) + screen_x);
+    clip_x1 = std::min(clip_x1, x_offset + std::abs(x_scale) + screen_x);
+    clip_y0 = std::max(clip_y0, y_offset - std::abs(y_scale) + screen_y);
+    clip_y1 = std::min(clip_y1, y_offset + std::abs(y_scale) + screen_y);
+  }
+  if (!rectangle_list) {
+    // Every vertex must be a corner of the bounding rectangle, and the
+    // triangles must not leave a gap: each one has three distinct corners, and
+    // the two of them differ (then they are the two halves of the rectangle).
+    auto corner = [&](uint32_t i) -> int {
+      const bool left_side = xs[i] == x0, right_side = xs[i] == x1;
+      const bool top_side = ys[i] == y0, bottom_side = ys[i] == y1;
+      if ((!left_side && !right_side) || (!top_side && !bottom_side)) {
+        return -1;
+      }
+      return (right_side ? 1 : 0) | (bottom_side ? 2 : 0);
+    };
+    int corners[6];
+    for (uint32_t i = 0; i < count; ++i) {
+      corners[i] = corner(i);
+      if (corners[i] < 0) {
+        return false;
+      }
+    }
+    if (prim_type == xenos::PrimitiveType::kQuadList) {
+      if ((1 << corners[0] | 1 << corners[1] | 1 << corners[2] | 1 << corners[3]) != 0xF) {
+        return false;
+      }
+    } else {
+      int triangles[2][3];
+      for (int t = 0; t < 2; ++t) {
+        for (int v = 0; v < 3; ++v) {
+          int index;
+          if (prim_type == xenos::PrimitiveType::kTriangleList) {
+            index = t * 3 + v;
+          } else if (prim_type == xenos::PrimitiveType::kTriangleStrip) {
+            index = t + v;
+          } else {
+            index = v ? t + v : 0;  // fan
+          }
+          triangles[t][v] = corners[index];
+        }
+      }
+      int masks[2];
+      for (int t = 0; t < 2; ++t) {
+        masks[t] = 1 << triangles[t][0] | 1 << triangles[t][1] | 1 << triangles[t][2];
+        if (__builtin_popcount(masks[t]) != 3) {
+          return false;
+        }
+      }
+      // Two different 3-corner triangles of a rectangle cover it only if they
+      // are split along the same diagonal: the corners each one misses are
+      // opposite (0 and 3, or 1 and 2).
+      const int missing0 = 0xF & ~masks[0], missing1 = 0xF & ~masks[1];
+      if (!((missing0 | missing1) == 0x9 || (missing0 | missing1) == 0x6)) {
+        return false;
+      }
+    }
+  }
+  // Pixels whose centers (px + 0.5) are within [x0, x1) x [y0, y1).
+  left = int32_t(std::ceil(clip_x0 - 0.5f));
+  right = int32_t(std::ceil(clip_x1 - 0.5f));
+  top = int32_t(std::ceil(clip_y0 - 0.5f));
+  bottom = int32_t(std::ceil(clip_y1 - 0.5f));
+  return left < right && top < bottom;
+}
+
+bool DrawExtentEstimator::EstimateVertexBounds(const Shader& vertex_shader, uint32_t max_indices,
+                                               int32_t& left, int32_t& top, int32_t& right,
+                                               int32_t& bottom) {
+  const RegisterFile& regs = register_file_;
+  auto vgt_draw_initiator = regs.Get<reg::VGT_DRAW_INITIATOR>();
+  const xenos::PrimitiveType prim_type = vgt_draw_initiator.prim_type;
+  const uint32_t count = vgt_draw_initiator.num_indices;
+  if (!count || count > max_indices || prim_type == xenos::PrimitiveType::kPointList) {
+    return false;
+  }
+  if (vgt_draw_initiator.source_select != xenos::SourceSelect::kDMA &&
+      vgt_draw_initiator.source_select != xenos::SourceSelect::kAutoIndex) {
+    return false;
+  }
+  if (xenos::IsMajorModeExplicit(vgt_draw_initiator.major_mode, prim_type) &&
+      regs.Get<reg::VGT_OUTPUT_PATH_CNTL>().path_select ==
+          xenos::VGTOutputPath::kTessellationEnable) {
+    return false;
+  }
+  if (!vertex_shader.is_ucode_analyzed() || !ShaderInterpreter::CanInterpretShader(vertex_shader)) {
+    return false;
+  }
+  auto vgt_dma_size = regs.Get<reg::VGT_DMA_SIZE>();
+  const void* index_buffer = nullptr;
+  xenos::Endian index_endian = vgt_dma_size.swap_mode;
+  const bool index_16 = vgt_draw_initiator.index_size == xenos::IndexFormat::kInt16;
+  if (vgt_draw_initiator.source_select == xenos::SourceSelect::kDMA) {
+    if (vgt_dma_size.num_words < count) {
+      return false;
+    }
+    uint32_t index_buffer_base = regs[XE_GPU_REG_VGT_DMA_BASE];
+    if (index_16) {
+      if (index_endian == xenos::Endian::k8in32) {
+        index_endian = xenos::Endian::k8in16;
+      } else if (index_endian == xenos::Endian::k16in32) {
+        index_endian = xenos::Endian::kNone;
+      }
+      index_buffer_base &= ~uint32_t(sizeof(uint16_t) - 1);
+    } else {
+      index_buffer_base &= ~uint32_t(sizeof(uint32_t) - 1);
+    }
+    index_buffer = memory_.TranslatePhysical(index_buffer_base);
+  }
+  auto pa_su_sc_mode_cntl = regs.Get<reg::PA_SU_SC_MODE_CNTL>();
+  const uint32_t reset_index = regs.Get<reg::VGT_MULTI_PRIM_IB_RESET_INDX>().reset_indx;
+  const uint32_t index_offset = regs.Get<reg::VGT_INDX_OFFSET>().indx_offset;
+  const uint32_t min_index = regs.Get<reg::VGT_MIN_VTX_INDX>().min_indx;
+  const uint32_t max_index = regs.Get<reg::VGT_MAX_VTX_INDX>().max_indx;
+  auto pa_cl_vte_cntl = regs.Get<reg::PA_CL_VTE_CNTL>();
+  const float x_scale =
+      pa_cl_vte_cntl.vport_x_scale_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XSCALE) : 1.0f;
+  const float x_offset =
+      pa_cl_vte_cntl.vport_x_offset_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XOFFSET) : 0.0f;
+  const float y_scale =
+      pa_cl_vte_cntl.vport_y_scale_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YSCALE) : 1.0f;
+  const float y_offset =
+      pa_cl_vte_cntl.vport_y_offset_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YOFFSET) : 0.0f;
+  float screen_x = 0.0f, screen_y = 0.0f;
+  if (regs.Get<reg::PA_SU_VTX_CNTL>().pix_center == xenos::PixelCenter::kD3DZero) {
+    screen_x += 0.5f;
+    screen_y += 0.5f;
+  }
+  if (pa_su_sc_mode_cntl.vtx_window_offset_enable) {
+    auto pa_sc_window_offset = regs.Get<reg::PA_SC_WINDOW_OFFSET>();
+    screen_x += float(pa_sc_window_offset.window_x_offset);
+    screen_y += float(pa_sc_window_offset.window_y_offset);
+  }
+  float x0 = FLT_MAX, y0 = FLT_MAX, x1 = -FLT_MAX, y1 = -FLT_MAX;
+  // Rectangle lists: the implied fourth corner of each triple.
+  const bool rectangle_list = prim_type == xenos::PrimitiveType::kRectangleList;
+  float triple_x[3], triple_y[3];
+  // Lists: per primitive, skipping zero-area ones (draw nothing; games
+  // collapse unused quads to a point).
+  const uint32_t list_size = prim_type == xenos::PrimitiveType::kTriangleList ? 3
+                             : prim_type == xenos::PrimitiveType::kQuadList   ? 4
+                             : rectangle_list                                  ? 3
+                                                                               : 0;
+  float prim_x0 = FLT_MAX, prim_y0 = FLT_MAX, prim_x1 = -FLT_MAX, prim_y1 = -FLT_MAX;
+  uint32_t prim_vertices = 0;
+  shader_interpreter_.SetShader(vertex_shader);
+  PositionYExportSink sink;
+  shader_interpreter_.SetExportSink(&sink);
+  bool valid = true;
+  for (uint32_t i = 0; i < count; ++i) {
+    uint32_t vertex_index = i;
+    if (index_buffer) {
+      vertex_index = index_16 ? uint32_t(static_cast<const uint16_t*>(index_buffer)[i])
+                              : static_cast<const uint32_t*>(index_buffer)[i];
+      vertex_index = xenos::GpuSwap(vertex_index, index_endian) & 0xFFFFFF;
+      if (pa_su_sc_mode_cntl.multi_prim_ib_ena && vertex_index == reset_index) {
+        if (list_size) {
+          valid = false;
+          break;
+        }
+        continue;
+      }
+    }
+    vertex_index = std::min(max_index, std::max(min_index, (vertex_index + index_offset) & 0xFFFFFF));
+    sink.Reset();
+    shader_interpreter_.temp_registers()[0] = float(vertex_index);
+    shader_interpreter_.Execute();
+    if ((sink.vertex_kill().has_value() && (sink.vertex_kill().value() & ~(UINT32_C(1) << 31))) ||
+        !sink.position_x().has_value() || !sink.position_y().has_value()) {
+      valid = false;
+      break;
+    }
+    float x = sink.position_x().value(), y = sink.position_y().value();
+    if (!pa_cl_vte_cntl.vtx_xy_fmt) {
+      if (!sink.position_w().has_value() || !(sink.position_w().value() > 0.0f)) {
+        valid = false;
+        break;
+      }
+      x /= sink.position_w().value();
+      y /= sink.position_w().value();
+    }
+    x = x * x_scale + x_offset + screen_x;
+    y = y * y_scale + y_offset + screen_y;
+    if (!std::isfinite(x) || !std::isfinite(y)) {
+      valid = false;
+      break;
+    }
+    if (!list_size) {
+      x0 = std::min(x0, x);
+      x1 = std::max(x1, x);
+      y0 = std::min(y0, y);
+      y1 = std::max(y1, y);
+    } else {
+      prim_x0 = std::min(prim_x0, x);
+      prim_x1 = std::max(prim_x1, x);
+      prim_y0 = std::min(prim_y0, y);
+      prim_y1 = std::max(prim_y1, y);
+    }
+    if (rectangle_list) {
+      triple_x[i % 3] = x;
+      triple_y[i % 3] = y;
+      if (i % 3 == 2) {
+        for (uint32_t c = 0; c < 3; ++c) {
+          const float fx = triple_x[(c + 1) % 3] + triple_x[(c + 2) % 3] - triple_x[c];
+          const float fy = triple_y[(c + 1) % 3] + triple_y[(c + 2) % 3] - triple_y[c];
+          prim_x0 = std::min(prim_x0, fx);
+          prim_x1 = std::max(prim_x1, fx);
+          prim_y0 = std::min(prim_y0, fy);
+          prim_y1 = std::max(prim_y1, fy);
+        }
+      }
+    }
+    if (list_size && ++prim_vertices == list_size) {
+      if (prim_x1 > prim_x0 && prim_y1 > prim_y0) {
+        x0 = std::min(x0, prim_x0);
+        x1 = std::max(x1, prim_x1);
+        y0 = std::min(y0, prim_y0);
+        y1 = std::max(y1, prim_y1);
+      }
+      prim_vertices = 0;
+      prim_x0 = prim_y0 = FLT_MAX;
+      prim_x1 = prim_y1 = -FLT_MAX;
+    }
+  }
+  shader_interpreter_.SetExportSink(nullptr);
+  if (!valid) {
+    return false;
+  }
+  if (x0 > x1 || y0 > y1) {
+    // Nothing drawn.
+    left = top = right = bottom = 0;
+    return true;
+  }
+  // Two pixels of margin for lines, rounding and the MSAA sample positions.
+  const float limit = 16384.0f;
+  left = int32_t(std::floor(std::max(x0, -limit))) - 2;
+  top = int32_t(std::floor(std::max(y0, -limit))) - 2;
+  right = int32_t(std::ceil(std::min(x1, limit))) + 2;
+  bottom = int32_t(std::ceil(std::min(y1, limit))) + 2;
+  return true;
+}
+
+bool DrawExtentEstimator::EstimateVertexBoundsCached(const Shader& vertex_shader,
+                                                     uint32_t max_indices, int32_t& left,
+                                                     int32_t& top, int32_t& right,
+                                                     int32_t& bottom) {
+  const RegisterFile& regs = register_file_;
+  auto vgt_draw_initiator = regs.Get<reg::VGT_DRAW_INITIATOR>();
+  if (!vgt_draw_initiator.num_indices || vgt_draw_initiator.num_indices > max_indices) {
+    return false;
+  }
+  std::vector<uint64_t>& parts = bounds_key_parts_;
+  parts.clear();
+  parts.push_back(vertex_shader.ucode_data_hash());
+  for (uint32_t reg_index :
+       {XE_GPU_REG_VGT_DRAW_INITIATOR, XE_GPU_REG_VGT_DMA_SIZE,
+        XE_GPU_REG_VGT_INDX_OFFSET, XE_GPU_REG_VGT_MIN_VTX_INDX, XE_GPU_REG_VGT_MAX_VTX_INDX,
+        XE_GPU_REG_VGT_MULTI_PRIM_IB_RESET_INDX, XE_GPU_REG_VGT_OUTPUT_PATH_CNTL,
+        XE_GPU_REG_PA_SU_SC_MODE_CNTL, XE_GPU_REG_PA_CL_VTE_CNTL, XE_GPU_REG_PA_CL_VPORT_XSCALE,
+        XE_GPU_REG_PA_CL_VPORT_XOFFSET, XE_GPU_REG_PA_CL_VPORT_YSCALE,
+        XE_GPU_REG_PA_CL_VPORT_YOFFSET, XE_GPU_REG_PA_SC_WINDOW_OFFSET, XE_GPU_REG_PA_SU_VTX_CNTL,
+        XE_GPU_REG_SQ_VS_CONST}) {
+    parts.push_back(regs[reg_index]);
+  }
+  // Float constants the vertex shader reads (all it can address with dynamic
+  // addressing), bool and loop constants.
+  auto vs_const = regs.Get<reg::SQ_VS_CONST>();
+  const uint32_t const_first = std::min(uint32_t(vs_const.base), uint32_t(512));
+  const uint32_t const_end = std::min(const_first + uint32_t(vs_const.size) + 1, uint32_t(512));
+  const Shader::ConstantRegisterMap& constant_map = vertex_shader.constant_register_map();
+  if (constant_map.float_dynamic_addressing) {
+    parts.push_back(XXH3_64bits(&regs[XE_GPU_REG_SHADER_CONSTANT_000_X + 4 * const_first],
+                                sizeof(uint32_t) * 4 * (const_end - const_first)));
+  } else {
+    for (uint32_t i = 0; i < 4; ++i) {
+      uint64_t bits = constant_map.float_bitmap[i];
+      uint32_t bit;
+      while (rex::bit_scan_forward(bits, &bit)) {
+        bits &= ~(uint64_t(1) << bit);
+        const uint32_t index = const_first + i * 64 + bit;
+        if (index >= const_end) break;
+        const uint32_t* value = &regs[XE_GPU_REG_SHADER_CONSTANT_000_X + 4 * index];
+        parts.push_back(uint64_t(value[0]) | (uint64_t(value[1]) << 32));
+        parts.push_back(uint64_t(value[2]) | (uint64_t(value[3]) << 32));
+      }
+    }
+  }
+  parts.push_back(XXH3_64bits(&regs[XE_GPU_REG_SHADER_CONSTANT_BOOL_000_031], sizeof(uint32_t) * 8));
+  parts.push_back(XXH3_64bits(&regs[XE_GPU_REG_SHADER_CONSTANT_LOOP_00], sizeof(uint32_t) * 32));
+  // Index data.
+  if (vgt_draw_initiator.source_select == xenos::SourceSelect::kDMA) {
+    const uint32_t index_size =
+        vgt_draw_initiator.index_size == xenos::IndexFormat::kInt16 ? 2 : 4;
+    const uint32_t index_base = regs[XE_GPU_REG_VGT_DMA_BASE] & ~(index_size - 1);
+    parts.push_back(XXH3_64bits(memory_.TranslatePhysical(index_base),
+                                size_t(vgt_draw_initiator.num_indices) * index_size));
+  }
+  // Vertex fetches read only within their fetch constant's buffer: hash it
+  // whole if small, otherwise the vertices the indices reference (shared
+  // dynamic buffers).
+  constexpr uint32_t kWholeBufferBytes = 16 * 1024;
+  uint32_t vertex_min = UINT32_MAX, vertex_max = 0;
+  bool vertex_range_known = false;
+  auto compute_vertex_range = [&]() {
+    vertex_range_known = true;
+    auto vgt_dma_size = regs.Get<reg::VGT_DMA_SIZE>();
+    const uint32_t index_offset = regs.Get<reg::VGT_INDX_OFFSET>().indx_offset;
+    const uint32_t min_index = regs.Get<reg::VGT_MIN_VTX_INDX>().min_indx;
+    const uint32_t max_index = regs.Get<reg::VGT_MAX_VTX_INDX>().max_indx;
+    const bool dma = vgt_draw_initiator.source_select == xenos::SourceSelect::kDMA;
+    const bool index_16 = vgt_draw_initiator.index_size == xenos::IndexFormat::kInt16;
+    xenos::Endian index_endian = vgt_dma_size.swap_mode;
+    if (index_16) {
+      if (index_endian == xenos::Endian::k8in32) {
+        index_endian = xenos::Endian::k8in16;
+      } else if (index_endian == xenos::Endian::k16in32) {
+        index_endian = xenos::Endian::kNone;
+      }
+    }
+    const void* indices =
+        dma ? memory_.TranslatePhysical(regs[XE_GPU_REG_VGT_DMA_BASE] & ~uint32_t(index_16 ? 1 : 3))
+            : nullptr;
+    for (uint32_t i = 0; i < vgt_draw_initiator.num_indices; ++i) {
+      uint32_t vertex_index = i;
+      if (indices) {
+        vertex_index = index_16 ? uint32_t(static_cast<const uint16_t*>(indices)[i])
+                                : static_cast<const uint32_t*>(indices)[i];
+        vertex_index = xenos::GpuSwap(vertex_index, index_endian) & 0xFFFFFF;
+      }
+      vertex_index = std::min(max_index, std::max(min_index, (vertex_index + index_offset) & 0xFFFFFF));
+      vertex_min = std::min(vertex_min, vertex_index);
+      vertex_max = std::max(vertex_max, vertex_index);
+    }
+  };
+  for (const Shader::VertexBinding& binding : vertex_shader.vertex_bindings()) {
+    const xenos::xe_gpu_vertex_fetch_t fetch = regs.GetVertexFetch(binding.fetch_constant);
+    // The contents, not the address (dynamic vertex buffers move every frame).
+    parts.push_back(uint64_t(fetch.dword_1));
+    const uint32_t bytes = uint32_t(fetch.size) * 4;
+    const uint8_t* data = static_cast<const uint8_t*>(
+        memory_.TranslatePhysical(uint32_t(fetch.address) << 2));
+    if (bytes <= kWholeBufferBytes) {
+      if (bytes) {
+        parts.push_back(XXH3_64bits(data, bytes));
+      }
+      continue;
+    }
+    if (!vertex_range_known) {
+      compute_vertex_range();
+    }
+    const uint64_t stride_bytes = uint64_t(binding.stride_words) * 4;
+    if (!stride_bytes) {
+      return EstimateVertexBounds(vertex_shader, max_indices, left, top, right, bottom);
+    }
+    const uint64_t first = uint64_t(vertex_min) * stride_bytes;
+    const uint64_t end = std::min(uint64_t(bytes), (uint64_t(vertex_max) + 1) * stride_bytes);
+    parts.push_back(first);
+    if (end > first) {
+      if (end - first > 64 * 1024) {
+        return EstimateVertexBounds(vertex_shader, max_indices, left, top, right, bottom);
+      }
+      parts.push_back(XXH3_64bits(data + first, size_t(end - first)));
+    }
+  }
+  const uint64_t key = XXH3_64bits(parts.data(), parts.size() * sizeof(uint64_t));
+  auto it = bounds_cache_.find(key);
+  if (it == bounds_cache_.end()) {
+    CachedBounds bounds{};
+    bounds.valid = EstimateVertexBounds(vertex_shader, max_indices, bounds.left, bounds.top,
+                                        bounds.right, bounds.bottom);
+    if (bounds_cache_.size() >= 16384) {
+      bounds_cache_.clear();
+    }
+    it = bounds_cache_.emplace(key, bounds).first;
+  }
+  const CachedBounds& bounds = it->second;
+  left = bounds.left;
+  top = bounds.top;
+  right = bounds.right;
+  bottom = bounds.bottom;
+  return bounds.valid;
+}
