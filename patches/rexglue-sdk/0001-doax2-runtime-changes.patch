+void D3D12RenderTargetCache::SelectDoax2SecondFrameFrontbufferSource(
+    uint32_t frontbuffer_ptr) {
+  doax2_frontbuffer_source_ = nullptr;
+  doax2_frontbuffer_resolve_base_ = 0;
+  const Doax2ResolveSource* matched = nullptr;
+  // Prefer the exact copy base used by the swap packet. If the title points
+  // inside an allocation, fall back to the resolved byte extent.
+  for (auto it = doax2_resolve_sources_.rbegin(); it != doax2_resolve_sources_.rend(); ++it) {
+    if (it->base == frontbuffer_ptr) {
+      matched = &*it;
+      break;
+    }
+  }
+  if (!matched) {
+    const uint64_t ptr = frontbuffer_ptr;
+    for (auto it = doax2_resolve_sources_.rbegin(); it != doax2_resolve_sources_.rend(); ++it) {
+      const uint64_t start = it->extent_start;
+      const uint64_t end = start + it->extent_length;
+      if (ptr >= start && ptr < end) {
+        matched = &*it;
+        break;
+      }
+    }
+  }
+  static uint64_t selection_count = 0;
+  ++selection_count;
+  if (matched && matched->contributors == 1 && matched->color) {
+    doax2_frontbuffer_source_ = matched->color;
+    doax2_frontbuffer_resolve_base_ = matched->base;
+  }
+  if (selection_count <= 8 || (selection_count % 120) == 0) {
+    REXGPU_INFO(
+        "DOAX2 final-color source: count={} frontbuffer={:08X} matched={} resolve_base={:08X} extent={:08X}+{:X} contributors={} color_key={:08X} backing={}",
+        selection_count, frontbuffer_ptr, matched != nullptr,
+        matched ? matched->base : 0, matched ? matched->extent_start : 0,
+        matched ? matched->extent_length : 0, matched ? matched->contributors : 0,
+        doax2_frontbuffer_source_ ? doax2_frontbuffer_source_->key().key : 0,
+        doax2_frontbuffer_source_
+            ? static_cast<void*>(doax2_frontbuffer_source_->resource())
+            : nullptr);
+  }
+}
