+    if (target.is_depth) {
+      command_list->ClearDepthStencilView(
+          target.replacement, D3D12_CLEAR_FLAG_DEPTH | D3D12_CLEAR_FLAG_STENCIL,
+          target.depth_clear, 0, 0, nullptr);
