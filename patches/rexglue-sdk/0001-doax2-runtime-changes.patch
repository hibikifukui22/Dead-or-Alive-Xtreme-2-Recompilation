+namespace rex::audio {
+namespace {
+
+constexpr int kOutputSampleRate = 48000;
+// The licensed MP3 masters are substantially hotter than DOAX2's XACT mix.
+// Match the title soundtrack's intended headroom before applying its 0..1
+// music-volume control.
+constexpr float kTitleMusicBaseGain = 0.25f;
+
+std::string AvErrorString(int error) {
+  char text[AV_ERROR_MAX_STRING_SIZE] = {};
+  av_strerror(error, text, sizeof(text));
+  return text;
+}
+
+bool AppendDecodedFrame(const AVFrame& frame, std::vector<float>& stereo,
+                        int& sample_rate_out) {
+  const auto format = static_cast<AVSampleFormat>(frame.format);
+  const int channel_count = std::max(frame.channels, 1);
+  if (frame.nb_samples <= 0 || !frame.extended_data || !frame.extended_data[0]) {
+    return true;
+  }
+  if (!sample_rate_out) {
+    sample_rate_out = frame.sample_rate;
+  } else if (sample_rate_out != frame.sample_rate) {
+    REXAPU_ERROR("XMP MP3 changed sample rate mid-stream: {} -> {}", sample_rate_out,
+                 frame.sample_rate);
+    return false;
+  }
+
+  const bool planar = av_sample_fmt_is_planar(format) != 0;
+  const AVSampleFormat packed_format = planar ? av_get_packed_sample_fmt(format) : format;
+  if (packed_format != AV_SAMPLE_FMT_FLT && packed_format != AV_SAMPLE_FMT_S16 &&
+      packed_format != AV_SAMPLE_FMT_S32) {
+    REXAPU_ERROR("XMP MP3 decoder returned unsupported sample format {}",
+                 av_get_sample_fmt_name(format) ? av_get_sample_fmt_name(format) : "?");
+    return false;
+  }
+
+  auto read_sample = [&](int sample, int channel) -> float {
+    channel = std::min(channel, channel_count - 1);
+    const int data_channel = planar ? channel : 0;
+    const int data_index = planar ? sample : sample * channel_count + channel;
+    const uint8_t* data = frame.extended_data[data_channel];
+    switch (packed_format) {
+      case AV_SAMPLE_FMT_FLT:
+        return reinterpret_cast<const float*>(data)[data_index];
+      case AV_SAMPLE_FMT_S16:
+        return static_cast<float>(reinterpret_cast<const int16_t*>(data)[data_index]) /
+               32768.0f;
+      case AV_SAMPLE_FMT_S32:
+        return static_cast<float>(reinterpret_cast<const int32_t*>(data)[data_index]) /
+               2147483648.0f;
+      default:
+        return 0.0f;
+    }
+  };
+
+  const size_t old_size = stereo.size();
+  stereo.resize(old_size + static_cast<size_t>(frame.nb_samples) * 2);
+  float* destination = stereo.data() + old_size;
+  for (int i = 0; i < frame.nb_samples; ++i) {
+    destination[i * 2] = read_sample(i, 0);
+    destination[i * 2 + 1] = read_sample(i, channel_count > 1 ? 1 : 0);
+  }
+  return true;
+}
+
+bool DecodeMp3(const memory::MappedMemory& encoded, std::vector<float>& output) {
+  const AVCodec* codec = avcodec_find_decoder(AV_CODEC_ID_MP3);
+  if (!codec) {
+    REXAPU_ERROR("XMP MP3 decoder is unavailable");
+    return false;
+  }
+  AVCodecParserContext* parser = av_parser_init(AV_CODEC_ID_MP3);
+  AVCodecContext* context = avcodec_alloc_context3(codec);
+  AVPacket* packet = av_packet_alloc();
+  AVFrame* frame = av_frame_alloc();
+  if (!parser || !context || !packet || !frame) {
+    REXAPU_ERROR("XMP MP3 decoder allocation failed");
+    if (parser) av_parser_close(parser);
+    avcodec_free_context(&context);
+    av_packet_free(&packet);
+    av_frame_free(&frame);
+    return false;
+  }
+
+  int result = avcodec_open2(context, codec, nullptr);
+  if (result < 0) {
+    REXAPU_ERROR("XMP MP3 decoder open failed: {}", AvErrorString(result));
+    av_parser_close(parser);
+    avcodec_free_context(&context);
+    av_packet_free(&packet);
+    av_frame_free(&frame);
+    return false;
+  }
+
+  // FFmpeg parsers may read a small amount beyond the supplied buffer. Keep a
+  // zero-padded private copy so mapped title files never need writable padding.
+  std::vector<uint8_t> padded(encoded.size() + AV_INPUT_BUFFER_PADDING_SIZE, 0);
+  std::memcpy(padded.data(), encoded.data(), encoded.size());
+  size_t input_offset = 0;
+  // DOAX2's licensed songs carry ID3v2 metadata. Skip the synchsafe-sized tag
+  // explicitly so the raw MPEG parser never submits it as a bogus MP3 packet.
+  if (encoded.size() >= 10 && !std::memcmp(padded.data(), "ID3", 3)) {
+    const size_t tag_size = (size_t(padded[6] & 0x7F) << 21) |
+                            (size_t(padded[7] & 0x7F) << 14) |
+                            (size_t(padded[8] & 0x7F) << 7) | size_t(padded[9] & 0x7F);
+    input_offset = 10 + tag_size + ((padded[5] & 0x10) ? 10 : 0);
+    if (input_offset >= encoded.size()) {
+      REXAPU_ERROR("XMP MP3 contains an invalid ID3v2 tag size");
+      av_parser_close(parser);
+      avcodec_free_context(&context);
+      av_packet_free(&packet);
+      av_frame_free(&frame);
+      return false;
+    }
+  }
+  const uint8_t* input = padded.data() + input_offset;
+  size_t remaining = encoded.size() - input_offset;
+  int source_sample_rate = 0;
+  std::vector<float> source_stereo;
+
+  auto receive_frames = [&]() -> bool {
+    while (true) {
+      const int receive_result = avcodec_receive_frame(context, frame);
+      if (receive_result == AVERROR(EAGAIN) || receive_result == AVERROR_EOF) {
+        return true;
+      }
+      if (receive_result < 0) {
+        REXAPU_ERROR("XMP MP3 frame receive failed: {}", AvErrorString(receive_result));
+        return false;
+      }
+      if (!AppendDecodedFrame(*frame, source_stereo, source_sample_rate)) {
+        return false;
+      }
+      av_frame_unref(frame);
+    }
+  };
+
+  bool success = true;
+  while (remaining) {
+    uint8_t* packet_data = nullptr;
+    int packet_size = 0;
+    const int chunk_size =
+        static_cast<int>(std::min<size_t>(remaining, std::numeric_limits<int>::max()));
+    const int consumed = av_parser_parse2(parser, context, &packet_data, &packet_size, input,
+                                          chunk_size, AV_NOPTS_VALUE, AV_NOPTS_VALUE, 0);
+    if (consumed < 0) {
+      REXAPU_ERROR("XMP MP3 parser failed: {}", AvErrorString(consumed));
+      success = false;
+      break;
+    }
+    if (!consumed && !packet_size) {
+      REXAPU_ERROR("XMP MP3 parser made no progress");
+      success = false;
+      break;
+    }
+    input += consumed;
+    remaining -= static_cast<size_t>(consumed);
+    if (!packet_size) {
+      continue;
+    }
+    packet->data = packet_data;
+    packet->size = packet_size;
+    result = avcodec_send_packet(context, packet);
+    // ID3 and other leading metadata may be emitted by the raw MPEG parser as
+    // a non-audio packet. Skip it and continue searching for the first valid
+    // frame rather than rejecting an otherwise valid title song.
+    if (result == AVERROR_INVALIDDATA) {
+      continue;
+    }
+    if (result < 0 && result != AVERROR(EAGAIN)) {
+      REXAPU_ERROR("XMP MP3 packet submit failed: {}", AvErrorString(result));
+      success = false;
+      break;
+    }
+    if (!receive_frames()) {
+      success = false;
+      break;
+    }
+  }
+  if (success) {
+    avcodec_send_packet(context, nullptr);
+    success = receive_frames();
+  }
+
+  av_parser_close(parser);
+  avcodec_free_context(&context);
+  av_packet_free(&packet);
+  av_frame_free(&frame);
+
+  if (!success || source_stereo.empty() || source_sample_rate <= 0) {
+    return false;
+  }
+  if (source_sample_rate == kOutputSampleRate) {
+    output = std::move(source_stereo);
+    return true;
+  }
+
+  SDL_AudioSpec source_spec = {};
+  source_spec.format = SDL_AUDIO_F32LE;
+  source_spec.channels = 2;
+  source_spec.freq = source_sample_rate;
+  SDL_AudioSpec destination_spec = source_spec;
+  destination_spec.freq = kOutputSampleRate;
+  uint8_t* converted = nullptr;
+  int converted_bytes = 0;
+  const size_t source_bytes_size = source_stereo.size() * sizeof(float);
+  if (source_bytes_size > static_cast<size_t>(std::numeric_limits<int>::max()) ||
+      !SDL_ConvertAudioSamples(&source_spec,
+                               reinterpret_cast<const uint8_t*>(source_stereo.data()),
+                               static_cast<int>(source_bytes_size), &destination_spec, &converted,
+                               &converted_bytes)) {
+    REXAPU_ERROR("XMP MP3 resampling failed: {}", SDL_GetError());
+    SDL_free(converted);
+    return false;
+  }
+  output.resize(static_cast<size_t>(converted_bytes) / sizeof(float));
+  std::memcpy(output.data(), converted, static_cast<size_t>(converted_bytes));
+  SDL_free(converted);
+  return !output.empty();
+}
+
+class TitlePlaylistPlayer {
+ public:
+  TitlePlaylistPlayer() : worker_([this] { WorkerMain(); }) {}
+  ~TitlePlaylistPlayer() {
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      shutdown_ = true;
+      ++generation_;
+    }
+    condition_.notify_all();
+    if (worker_.joinable()) {
+      worker_.join();
+    }
+  }
+
+  bool Play(std::vector<TitlePlaylistTrack> tracks, size_t first_track) {
+    tracks.erase(std::remove_if(tracks.begin(), tracks.end(), [](const TitlePlaylistTrack& track) {
+                   return !track.encoded_data || !track.encoded_data->data() ||
+                          !track.encoded_data->size();
+                 }),
+                 tracks.end());
+    if (tracks.empty()) {
+      return false;
+    }
+    std::lock_guard<std::mutex> lock(mutex_);
+    tracks_ = std::move(tracks);
+    playing_ = true;
+    paused_ = false;
+    mixed_stereo_frames_ = 0;
+    notify_decode_ = false;
+    RequestDecodeLocked(std::min(first_track, tracks_.size() - 1));
+    return true;
+  }
+
+  bool Adopt(std::vector<TitlePlaylistTrack> tracks, size_t current_track) {
+    if (tracks.empty() || current_track >= tracks.size()) {
+      return false;
+    }
+    std::lock_guard<std::mutex> lock(mutex_);
+    tracks_ = std::move(tracks);
+    playing_ = true;
+    if (decoding_ || decode_requested_ || pcm_.empty()) {
+      // The song was still being decoded for the old list: decode it again
+      // under its new index.
+      notify_decode_ = false;
+      RequestDecodeLocked(current_track);
+    } else {
+      requested_track_ = current_track;
+      decoded_track_ = current_track;
+    }
+    return true;
+  }
+
+  void SetTrackChangedCallback(std::function<void(size_t)> callback) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    track_changed_ = std::move(callback);
+  }
+
+  void Continue() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!tracks_.empty()) {
+      playing_ = true;
+      paused_ = false;
+      if (pcm_.empty() && !decoding_ && !decode_requested_) {
+        RequestDecodeLocked(requested_track_);
+      }
+    }
+  }
+
+  void Pause() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (playing_) {
+      paused_ = true;
+    }
+  }
+
+  void Stop() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    ++generation_;
+    tracks_.clear();
+    pcm_.clear();
+    pcm_frame_ = 0;
+    playing_ = false;
+    paused_ = false;
+    decode_requested_ = false;
+    decode_failed_ = false;
+  }
+
+  void Next() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!tracks_.empty()) {
+      playing_ = true;
+      paused_ = false;
+      // Title-initiated: the title refreshes its song information itself.
+      notify_decode_ = false;
+      RequestDecodeLocked((requested_track_ + 1) % tracks_.size());
+    }
+  }
+
+  void Previous() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!tracks_.empty()) {
+      playing_ = true;
+      paused_ = false;
+      notify_decode_ = false;
+      RequestDecodeLocked((requested_track_ + tracks_.size() - 1) % tracks_.size());
+    }
+  }
+
+  void SetVolume(float volume) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    volume_ = std::clamp(volume, 0.0f, 1.0f);
+  }
+
+  void Mix(float* output, size_t frame_count, uint8_t channel_count) {
+    if (!output || frame_count == 0 || channel_count < 2) {
+      return;
+    }
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!playing_ || paused_ || pcm_.empty()) {
+      return;
+    }
+    const size_t pcm_frame_count = pcm_.size() / 2;
+    const size_t available = pcm_frame_count - std::min(pcm_frame_, pcm_frame_count);
+    const size_t to_mix = std::min(frame_count, available);
+    for (size_t i = 0; i < to_mix; ++i) {
+      const float gain = kTitleMusicBaseGain * volume_;
+      const float left = pcm_[(pcm_frame_ + i) * 2] * gain;
+      const float right = pcm_[(pcm_frame_ + i) * 2 + 1] * gain;
+      output[i * channel_count] = std::clamp(output[i * channel_count] + left, -1.0f, 1.0f);
+      output[i * channel_count + 1] =
+          std::clamp(output[i * channel_count + 1] + right, -1.0f, 1.0f);
+    }
+    pcm_frame_ += to_mix;
+    mixed_stereo_frames_ += to_mix;
+    if (pcm_frame_ >= pcm_frame_count && !tracks_.empty()) {
+      notify_decode_ = true;
+      RequestDecodeLocked((decoded_track_ + 1) % tracks_.size());
+    }
+  }
+
+  TitlePlaylistDiagnostics Diagnostics() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return TitlePlaylistDiagnostics{generation_,
+                                    tracks_.size(),
+                                    requested_track_,
+                                    decoded_track_,
+                                    pcm_.size() / 2,
+                                    mixed_stereo_frames_,
+                                    volume_,
+                                    kTitleMusicBaseGain * volume_,
+                                    playing_,
+                                    paused_,
+                                    decoding_ || decode_requested_,
+                                    decode_failed_};
+  }
+
+ private:
+  void RequestDecodeLocked(size_t track) {
+    if (tracks_.empty()) {
+      return;
+    }
+    ++generation_;
+    requested_track_ = track % tracks_.size();
+    pcm_.clear();
+    pcm_frame_ = 0;
+    decode_failed_ = false;
+    decode_requested_ = true;
+    condition_.notify_one();
+  }
+
+  void WorkerMain() {
+    while (true) {
+      std::shared_ptr<memory::MappedMemory> encoded;
+      std::string name;
+      size_t track = 0;
+      uint64_t generation = 0;
+      {
+        std::unique_lock<std::mutex> lock(mutex_);
+        condition_.wait(lock, [&] { return shutdown_ || decode_requested_; });
+        if (shutdown_) {
+          return;
+        }
+        generation = generation_;
+        track = requested_track_;
+        encoded = tracks_[track].encoded_data;
+        name = tracks_[track].name;
+        decode_requested_ = false;
+        decoding_ = true;
+      }
+
+      std::vector<float> decoded;
+      const bool success = encoded && DecodeMp3(*encoded, decoded);
+      std::function<void(size_t)> notify;
+      {
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (generation != generation_) {
+          if (!decode_requested_) {
+            decoding_ = false;
+          }
+          continue;
+        }
+        decoding_ = false;
+        decode_failed_ = !success;
+        if (success) {
+          decoded_track_ = track;
+          pcm_ = std::move(decoded);
+          pcm_frame_ = 0;
+          REXAPU_INFO("XMP title music decoded: track={} name='{}' frames={} rate={}Hz",
+                      track, name, pcm_.size() / 2, kOutputSampleRate);
+          if (notify_decode_) {
+            notify = track_changed_;
+          }
+          notify_decode_ = false;
+        } else {
+          REXAPU_ERROR("XMP title music decode failed: track={} name='{}'", track, name);
+        }
+      }
+      if (notify) {
+        notify(track);
+      }
+    }
+  }
+
+  std::mutex mutex_;
+  std::condition_variable condition_;
+  std::thread worker_;
+  bool shutdown_ = false;
+  bool playing_ = false;
+  bool paused_ = false;
+  bool decode_requested_ = false;
+  bool decoding_ = false;
+  bool decode_failed_ = false;
+  // The next decoded song was not chosen by the title (end of song): report
+  // it so the title refreshes its song information once.
+  bool notify_decode_ = false;
+  std::function<void(size_t)> track_changed_;
+  float volume_ = 1.0f;
+  uint64_t generation_ = 0;
+  std::vector<TitlePlaylistTrack> tracks_;
+  size_t requested_track_ = 0;
+  size_t decoded_track_ = 0;
+  std::vector<float> pcm_;
+  size_t pcm_frame_ = 0;
+  size_t mixed_stereo_frames_ = 0;
+};
+
+TitlePlaylistPlayer& Player() {
+  static TitlePlaylistPlayer player;
+  return player;
+}
+
+}  // namespace
+
+bool PlayTitlePlaylist(std::vector<TitlePlaylistTrack> tracks, size_t first_track) {
+  return Player().Play(std::move(tracks), first_track);
+}
+
+bool AdoptTitlePlaylist(std::vector<TitlePlaylistTrack> tracks, size_t current_track) {
+  return Player().Adopt(std::move(tracks), current_track);
+}
+
+void SetTitlePlaylistTrackChangedCallback(std::function<void(size_t)> callback) {
+  Player().SetTrackChangedCallback(std::move(callback));
+}
+
+void ContinueTitlePlaylist() { Player().Continue(); }
+void PauseTitlePlaylist() { Player().Pause(); }
+void StopTitlePlaylist() { Player().Stop(); }
+void NextTitlePlaylistTrack() { Player().Next(); }
+void PreviousTitlePlaylistTrack() { Player().Previous(); }
+void SetTitlePlaylistVolume(float volume) { Player().SetVolume(volume); }
