+  for (uint32_t i = 0; i < 1 + xenos::kMaxColorRenderTargets; ++i) {
+    if (!targets[i]) {
+      continue;
+    }
+    const auto* target = static_cast<const D3D12RenderTarget*>(targets[i]);
+    const D3D12_RESOURCE_DESC desc = target->resource()->GetDesc();
+    width = std::min(width, uint32_t(desc.Width));
+    height = std::min(height, desc.Height);
+    found = true;
+  }
+  if (found) {
+    width_out = width;
+    height_out = height;
+  }
+  return found;
