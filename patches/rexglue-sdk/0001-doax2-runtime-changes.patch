+bool RenderTargetCache::DescribeUniformTileOwner(uint32_t first_tile,
+                                                 uint32_t end_tile,
+                                                 uint32_t& key_out) const {
+  key_out = 0;
+  if (first_tile >= end_tile || end_tile > xenos::kEdramTileCount ||
+      ownership_ranges_.empty()) return false;
+  auto it = ownership_ranges_.upper_bound(first_tile);
+  if (it == ownership_ranges_.begin()) return false;
+  --it;
+  uint32_t next = first_tile;
+  while (next < end_tile) {
+    if (it == ownership_ranges_.end() || it->first > next ||
+        it->second.end_tiles <= next || it->second.render_target.IsEmpty())
+      return false;
+    const uint32_t owner = it->second.render_target.key;
+    if (key_out && key_out != owner) {
+      key_out = 0;
+      return false;
+    }
+    key_out = owner;
+    next = std::min(end_tile, it->second.end_tiles);
+    if (next < end_tile) ++it;
+  }
+  return true;
+}
