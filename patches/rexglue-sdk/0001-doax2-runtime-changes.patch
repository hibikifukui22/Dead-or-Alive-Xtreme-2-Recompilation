+      ? kCompositeRecipe
+      : GetOwnedRenderUnitRecipeKey(interpolation_frame_recording_, draw);
+  if (!composite_unit && key != owned_unit_snapshot_target_recipe_) return;
+  if (owned_unit_snapshot_.state_count &&
+      owned_unit_snapshot_.states[owned_unit_snapshot_.state_count - 1]
+              .guest_swap_serial == serial) {
+    return;
+  }
+  if (owned_unit_snapshot_.state_count == 1 &&
+      owned_unit_snapshot_.states[0].guest_swap_serial + 1 != serial) {
+    REXGPU_INFO(
+        "DOAX2 owned-unit state pair restarted: recipe={:016X} previous_frame={} next_occurrence={}; adjacency required",
+        key, owned_unit_snapshot_.states[0].guest_swap_serial, serial);
+    owned_unit_snapshot_.Clear();
+  }
+  if (owned_unit_snapshot_.state_count == 1 &&
+      (owned_unit_snapshot_.draw.pipeline_handle != draw.pipeline_handle ||
