+    if (cleared) {
+      width = std::max(width, std::min(rect_x2, (cleared[2] >> 18) + 1));
+      height = std::max(height, std::min(rect_y2, ((cleared[2] >> 3) & 0x7FFF) + 1));
+    }
+  }
+  info = draw_util::ResolveInfo();
+  info.rb_copy_control.value = 0;
+  info.rb_copy_control.color_clear_enable = uint32_t(clear_color);
+  info.rb_copy_control.depth_clear_enable = uint32_t(clear_depth);
+  info.coordinate_info.width_div_8 =
+      (width + xenos::kResolveAlignmentPixels - 1) >> xenos::kResolveAlignmentPixelsLog2;
+  info.height_div_8 =
+      (height + xenos::kResolveAlignmentPixels - 1) >> xenos::kResolveAlignmentPixelsLog2;
+  if (clear_depth) {
+    reg::RB_DEPTH_INFO depth_info;
+    depth_info.value = ds[1];
+    info.depth_edram_info.pitch_tiles = pitch_tiles;
+    info.depth_edram_info.msaa_samples = msaa;
+    info.depth_edram_info.is_depth = 1;
+    info.depth_edram_info.base_tiles = depth_info.depth_base;
+    info.depth_edram_info.format = uint32_t(depth_info.depth_format);
+    info.depth_original_base = depth_info.depth_base;
+    const float depth = std::clamp(z, 0.0f, 1.0f);
+    const uint32_t depth_guest =
+        depth_info.depth_format == xenos::DepthRenderTargetFormat::kD24S8
+            ? std::min(uint32_t(double(depth) * 0xFFFFFF + 0.5), uint32_t(0xFFFFFF))
+            : xenos::Float32To20e4(depth, true);
+    info.rb_depth_clear = (depth_guest << 8) | (stencil & 0xFF);
+  }
+  if (clear_color) {
+    reg::RB_COLOR_INFO color_info;
+    color_info.value = rt0[1];
+    if (color_info.color_format != xenos::ColorRenderTargetFormat::k_8_8_8_8) {
+      return false;
+    }
+    info.color_edram_info.pitch_tiles = pitch_tiles;
+    info.color_edram_info.msaa_samples = msaa;
+    info.color_edram_info.base_tiles = color_info.color_base;
+    info.color_edram_info.format = uint32_t(color_info.color_format);
+    info.color_original_base = color_info.color_base;
+    uint32_t packed = 0;
+    for (uint32_t i = 0; i < 4; ++i) {
+      packed |= uint32_t(std::clamp(color[i], 0.0f, 1.0f) * 255.0f + 0.5f) << (8 * i);
+    }
+    info.rb_color_clear = packed;
+  }
+  return true;
+}
+
+// The game clears the surfaces of a tiled section (one tile in size) just
+// before BeginTiling; the collapsed pass then draws to full-size render
+// targets, which would get the cleared values by ownership transfers. Repeat
+// the clear at the full size instead (if at most one draw - D3D's tiny
+// point draw - came in between).
+void CommandProcessor::ClearCollapsedTilingSurfaces() {
+  if (!last_native_clear_valid_ || draws_since_native_clear_ > 1) {
+    return;
+  }
+  last_native_clear_valid_ = false;
+  const NativeTiling& tiling = native_tiling_;
+  draw_util::ResolveInfo info = last_native_clear_;
+  draw_util::ResolveEdramInfo& edram =
+      info.IsClearingDepth() ? info.depth_edram_info : info.color_edram_info;
+  const uint32_t samples_x_log2 = uint32_t(edram.msaa_samples >= xenos::MsaaSamples::k4X);
+  auto pitch_tiles = [&](uint32_t pixels) {
+    return ((pixels << samples_x_log2) + (xenos::kEdramTileWidthSamples - 1)) /
+           xenos::kEdramTileWidthSamples;
+  };
+  if (edram.pitch_tiles != pitch_tiles(tiling.tile_right) ||
+      info.coordinate_info.width_div_8 * 8 < tiling.tile_right) {
+    return;
+  }
+  const uint32_t pitch = pitch_tiles(tiling.union_right);
+  if (info.IsClearingDepth()) {
+    info.depth_edram_info.pitch_tiles = pitch;
+  }
+  if (info.IsClearingColor()) {
+    info.color_edram_info.pitch_tiles = pitch << info.color_edram_info.format_is_64bpp;
+  }
+  info.coordinate_info.width_div_8 = (tiling.union_right + 7) >> 3;
+  info.height_div_8 = std::max(info.height_div_8, (tiling.union_bottom + 7) >> 3);
+  native_clears_ += IssueNativeClear(info, last_native_clear_keep_stencil_);
+}
+
+bool CommandProcessor::IssueNativeClear(draw_util::ResolveInfo& info, bool keep_stencil) {
+  return false;
+}
+
+bool CommandProcessor::DrawNeedsOverrides() const {
+  return NativeTilingCollapsing() ||
+         (REXCVAR_GET(gpu_force_1x_msaa) && !native_in_clear_ &&
+          register_file_->Get<reg::RB_SURFACE_INFO>().msaa_samples != xenos::MsaaSamples::k1X);
+}
+
+// A draw or resolve with register overrides: collapsed tiling (see
+// UpdateNativeTiling) and MSAA off (gpu_force_1x_msaa: multisampled surfaces
+// drawn and resolved single-sampled; not D3D's clear draws, which alias
+// surfaces with other sample counts - their uniform values reach the
+// single-sampled render targets through the EDRAM ownership transfers).
+bool CommandProcessor::IssueDrawWithOverrides(xenos::PrimitiveType prim_type, uint32_t index_count,
+                                              IndexBufferInfo* index_buffer_info,
+                                              bool major_mode_explicit) {
+  const NativeTiling& tiling = native_tiling_;
+  RegisterFile& regs = *register_file_;
+  const uint32_t saved_surface = regs[XE_GPU_REG_RB_SURFACE_INFO];
+  const uint32_t saved_window_br = regs[XE_GPU_REG_PA_SC_WINDOW_SCISSOR_BR];
+  const uint32_t saved_screen_br = regs[XE_GPU_REG_PA_SC_SCREEN_SCISSOR_BR];
+  if (REXCVAR_GET(gpu_force_1x_msaa) && !native_in_clear_) {
+    reg::RB_SURFACE_INFO surface_info;
+    surface_info.value = saved_surface;
+    surface_info.msaa_samples = xenos::MsaaSamples::k1X;
+    regs[XE_GPU_REG_RB_SURFACE_INFO] = surface_info.value;
+  }
+  if (!NativeTilingCollapsing()) {
+    const bool result = IssueDraw(prim_type, index_count, index_buffer_info, major_mode_explicit);
+    regs[XE_GPU_REG_RB_SURFACE_INFO] = saved_surface;
+    return result;
+  }
+  // Widen what is the first tile's edge to the edge of all tiles.
+  auto widen = [](uint32_t value, uint32_t mask, uint32_t shift, uint32_t from, uint32_t to) {
+    return ((value >> shift) & mask) == from ? (value & ~(mask << shift)) | (to << shift) : value;
+  };
+  regs[XE_GPU_REG_RB_SURFACE_INFO] = widen(regs[XE_GPU_REG_RB_SURFACE_INFO], 0x3FFF, 0,
+                                           tiling.tile_right, tiling.union_right);
+  for (uint32_t reg : {uint32_t(XE_GPU_REG_PA_SC_WINDOW_SCISSOR_BR),
+                       uint32_t(XE_GPU_REG_PA_SC_SCREEN_SCISSOR_BR)}) {
+    regs[reg] = widen(widen(regs[reg], 0x7FFF, 0, tiling.tile_right, tiling.union_right), 0x7FFF,
+                      16, tiling.tile_bottom, tiling.union_bottom);
+  }
+  draw_util::NativeTilingResolve& resolve = draw_util::native_tiling_resolve;
+  resolve.active = true;
+  resolve.tile_right = tiling.tile_right;
+  resolve.tile_bottom = tiling.tile_bottom;
+  resolve.union_right = tiling.union_right;
+  resolve.union_bottom = tiling.union_bottom;
+  const bool result = IssueDraw(prim_type, index_count, index_buffer_info, major_mode_explicit);
+  resolve.active = false;
+  regs[XE_GPU_REG_RB_SURFACE_INFO] = saved_surface;
+  regs[XE_GPU_REG_PA_SC_WINDOW_SCISSOR_BR] = saved_window_br;
+  regs[XE_GPU_REG_PA_SC_SCREEN_SCISSOR_BR] = saved_screen_br;
+  return result;
+}
