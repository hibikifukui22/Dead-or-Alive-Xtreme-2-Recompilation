+            std::isfinite(new_value)) {
+          owned_unit_snapshot_.midpoint_vertex_values[packed_value] =
+              std::bit_cast<uint32_t>((old_value + new_value) * 0.5f);
+          ++interpolated_transform_words;
+        }
+      }
+    }
+  }
+
+  // Materialize the complete owned input packet through ReXGlue's existing
+  // frame-fenced upload pool. These slices are not bound or submitted yet;
+  // this proves that reconstruction can leave guest memory and native CBVs
+  // before any private draw is attempted.
+  OwnedRenderUnitUploadPacket upload_packet;
+  upload_packet.frame = frame_current_;
+  upload_packet.submission_at_allocation = submission_current_;
+  auto upload = [&](const void* source, size_t size, size_t alignment,
+                    D3D12_GPU_VIRTUAL_ADDRESS& address,
+                    ID3D12Resource** resource_out = nullptr,
+                    size_t* resource_offset_out = nullptr) {
+    if (!source || !size) return false;
+    uint8_t* destination = constant_buffer_pool_->Request(
+        frame_current_, size, alignment, resource_out, resource_offset_out,
+        &address);
+    if (!destination) return false;
+    std::memcpy(destination, source, size);
+    upload_packet.total_bytes += size;
+    return true;
+  };
+  // A translated shader can have no float constants while its bindless root
+  // signature still contains both CBV slots. Supply private, zero-filled CBVs
+  // instead of treating the empty register map as an incomplete snapshot.
+  const std::array<uint8_t, D3D12_CONSTANT_BUFFER_DATA_PLACEMENT_ALIGNMENT>
+      empty_constants{};
+  const size_t vertex_constant_bytes =
+      owned_unit_snapshot_.midpoint_vertex_values.size() * sizeof(uint32_t);
+  const size_t pixel_constant_bytes =
+      state_n1.pixel_constants.values.size() * sizeof(uint32_t);
+  bool uploads_complete =
+      upload(vertex_constant_bytes
+                 ? static_cast<const void*>(
+                       owned_unit_snapshot_.midpoint_vertex_values.data())
+                 : static_cast<const void*>(empty_constants.data()),
+             vertex_constant_bytes ? vertex_constant_bytes
+                                   : empty_constants.size(),
+             D3D12_CONSTANT_BUFFER_DATA_PLACEMENT_ALIGNMENT,
+             upload_packet.midpoint_constants) &&
+      upload(pixel_constant_bytes
+                 ? static_cast<const void*>(state_n1.pixel_constants.values.data())
+                 : static_cast<const void*>(empty_constants.data()),
+             pixel_constant_bytes ? pixel_constant_bytes
+                                  : empty_constants.size(),
+             D3D12_CONSTANT_BUFFER_DATA_PLACEMENT_ALIGNMENT,
+             upload_packet.pixel_constants) &&
+      upload(&state_n1.system_constants, sizeof(state_n1.system_constants),
+             D3D12_CONSTANT_BUFFER_DATA_PLACEMENT_ALIGNMENT,
+             upload_packet.system_constants);
+  constexpr size_t kBoolLoopConstantsSize = (8 + 32) * sizeof(uint32_t);
+  constexpr size_t kFetchConstantsSize = 32 * 6 * sizeof(uint32_t);
+  uploads_complete &= upload(
+      &state_n1.registers[XE_GPU_REG_SHADER_CONSTANT_BOOL_000_031],
+      kBoolLoopConstantsSize, D3D12_CONSTANT_BUFFER_DATA_PLACEMENT_ALIGNMENT,
+      upload_packet.bool_loop_constants);
+  uploads_complete &= upload(
+      &state_n1.registers[XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0],
+      kFetchConstantsSize, D3D12_CONSTANT_BUFFER_DATA_PLACEMENT_ALIGNMENT,
+      upload_packet.fetch_constants);
+  auto upload_ranges = [&](const auto& ranges, auto& slices) {
+    for (const auto& range : ranges) {
+      OwnedRenderUnitUploadSlice slice;
+      slice.size = range.bytes.size();
+      slice.source_guest_address = range.guest_address;
+      ID3D12Resource* resource = nullptr;
+      size_t resource_offset = 0;
+      if (!upload(range.bytes.data(), range.bytes.size(), 16,
+                  slice.gpu_address, &resource, &resource_offset))
+        return false;
+      slice.resource = resource;
+      slice.resource_offset = resource_offset;
+      slices.push_back(slice);
+    }
+    return true;
+  };
+  uploads_complete &= upload_ranges(owned_unit_snapshot_.vertex_ranges,
+                                    upload_packet.vertex_ranges);
+  uploads_complete &= upload_ranges(owned_unit_snapshot_.index_ranges,
+                                    upload_packet.index_ranges);
+  uploads_complete &= upload_ranges(owned_unit_snapshot_.texture_ranges,
+                                    upload_packet.texture_ranges);
+  std::vector<std::pair<D3D12_GPU_VIRTUAL_ADDRESS,
+                        D3D12_GPU_VIRTUAL_ADDRESS>>
+      upload_intervals;
+  auto add_interval = [&](D3D12_GPU_VIRTUAL_ADDRESS address, uint64_t size) {
+    if (address && size) upload_intervals.emplace_back(address, address + size);
+  };
+  add_interval(upload_packet.midpoint_constants,
+               vertex_constant_bytes ? vertex_constant_bytes
+                                     : empty_constants.size());
+  add_interval(upload_packet.pixel_constants,
+               pixel_constant_bytes ? pixel_constant_bytes
+                                    : empty_constants.size());
+  add_interval(upload_packet.system_constants,
+               sizeof(state_n1.system_constants));
+  add_interval(upload_packet.bool_loop_constants, kBoolLoopConstantsSize);
+  add_interval(upload_packet.fetch_constants, kFetchConstantsSize);
+  auto add_slices = [&](const auto& slices) {
+    for (const auto& slice : slices)
+      add_interval(slice.gpu_address, slice.size);
+  };
+  add_slices(upload_packet.vertex_ranges);
+  add_slices(upload_packet.index_ranges);
+  add_slices(upload_packet.texture_ranges);
+  std::sort(upload_intervals.begin(), upload_intervals.end());
+  upload_packet.independent_ranges = uploads_complete;
+  for (size_t i = 1; i < upload_intervals.size(); ++i)
+    upload_packet.independent_ranges &=
+        upload_intervals[i - 1].second <= upload_intervals[i].first;
+  upload_packet.complete = uploads_complete &&
+                           upload_packet.independent_ranges &&
+                           upload_packet.midpoint_constants !=
+                               state_n1.vertex_constants.address;
+  owned_unit_upload_packet_ = std::move(upload_packet);
+
+  size_t changed_register_words = 0;
+  for (size_t i = 0; i < state_n.registers.size(); ++i)
+    changed_register_words += state_n.registers[i] != state_n1.registers[i];
+  const bool fixed_output_state_equal =
+      std::memcmp(&state_n.viewport, &state_n1.viewport,
+                  sizeof(state_n.viewport)) == 0 &&
+      std::memcmp(&state_n.scissor, &state_n1.scissor,
+                  sizeof(state_n.scissor)) == 0 &&
+      state_n.blend_factor == state_n1.blend_factor &&
+      state_n.stencil_reference == state_n1.stencil_reference;
+  REXGPU_INFO(
+      "DOAX2 owned-unit snapshot: selected_frame={} frames_N_N1={}/{} recipe={:016X} complete=yes vertex_ranges={}/{}B index_ranges={}/{}B texture_ranges={}/{}B vertex_constants={}B pixel_constants={}B changed_vertex_words={} midpoint_transform_words={} changed_gpu_register_words={} fixed_output_state_equal={} primitive={}->{} vertices={}->{} index_type={} content_hash={:016X}; two CPU-owned states and midpoint, no descriptor/resource retained and no submission",
+      owned_unit_snapshot_selected_frame_, state_n.guest_swap_serial,
+      state_n1.guest_swap_serial,
+      key, owned_unit_snapshot_.vertex_ranges.size(), vertex_bytes,
+      owned_unit_snapshot_.index_ranges.size(), index_bytes,
+      owned_unit_snapshot_.texture_ranges.size(), texture_bytes,
+      state_n.vertex_constants.values.size() * sizeof(uint32_t),
+      state_n.pixel_constants.values.size() * sizeof(uint32_t),
+      changed_constant_words, interpolated_transform_words,
+      changed_register_words, fixed_output_state_equal,
+      draw.guest_primitive_type, draw.host_primitive_type,
+      draw.guest_draw_vertex_count, draw.host_draw_vertex_count,
+      draw.index_buffer_type, owned_unit_snapshot_.content_hash);
+  REXGPU_INFO(
+      "DOAX2 owned-unit GPU upload packet: frame={} submission_at_allocation={} complete={} independent_ranges={} total_bytes={} slices={} midpoint_gpu={:016X} native_N1_cbv={:016X} distinct_from_native={}; existing frame-fenced ReXGlue upload pool, not bound and no private submission",
+      owned_unit_upload_packet_.frame,
+      owned_unit_upload_packet_.submission_at_allocation,
+      owned_unit_upload_packet_.complete,
+      owned_unit_upload_packet_.independent_ranges,
+      owned_unit_upload_packet_.total_bytes, upload_intervals.size(),
+      owned_unit_upload_packet_.midpoint_constants,
+      state_n1.vertex_constants.address,
+      owned_unit_upload_packet_.midpoint_constants !=
+          state_n1.vertex_constants.address);
+}
+
+void D3D12CommandProcessor::TryCaptureOwnedRenderGroupUnit(
+    const InterpolationDrawBinding& draw, size_t draw_ordinal) {
+  if (owned_render_group_slots_.empty()) return;
+  const uint64_t draw_recipe =
+      GetOwnedRenderUnitRecipeKey(interpolation_frame_recording_, draw);
+  OwnedRenderGroupSlot* slot = nullptr;
+  for (auto& candidate : owned_render_group_slots_) {
+    if (candidate.recipe_key == draw_recipe && !candidate.snapshot.complete) {
+      slot = &candidate;
+      break;
+    }
+  }
+  if (!slot) return;
+  OwnedRenderUnitSnapshot& snapshot = slot->snapshot;
+  const uint64_t serial = doax2_transform_trace_swap_serial + 1;
+  if (snapshot.state_count &&
+      snapshot.states[snapshot.state_count - 1].guest_swap_serial == serial) {
+    return;
+  }
+  if (snapshot.state_count == 1 &&
+      snapshot.states[0].guest_swap_serial + 1 != serial) {
+    snapshot.Clear();
+  }
+  if (snapshot.state_count == 1 &&
+      (snapshot.draw.pipeline_handle != draw.pipeline_handle ||
+       snapshot.draw.root_signature != draw.root_signature)) {
+    snapshot.Clear();
+  }
+  if (draw.constants_index >=
+      interpolation_frame_recording_.vertex_constants.size()) {
+    return;
+  }
+
+  OwnedRenderStateSnapshot state;
+  state.guest_swap_serial = serial;
+  state.vertex_constants =
+      interpolation_frame_recording_.vertex_constants[draw.constants_index];
+  if (draw.pixel_constants_index != UINT32_MAX) {
+    if (draw.pixel_constants_index >=
+        interpolation_frame_recording_.pixel_constants.size()) {
+      return;
+    }
+    state.pixel_constants = interpolation_frame_recording_.pixel_constants
+                                [draw.pixel_constants_index];
+  }
+  std::copy_n(register_file_->values, RegisterFile::kRegisterCount,
+              state.registers.begin());
+  state.system_constants = system_constants_;
+  state.viewport = ff_viewport_;
+  state.scissor = ff_scissor_;
+  std::copy_n(ff_blend_factor_, state.blend_factor.size(),
+              state.blend_factor.begin());
+  state.stencil_reference = ff_stencil_ref_;
+
+  if (!snapshot.state_count) {
+    snapshot.recipe_key = slot->recipe_key;
+    snapshot.guest_swap_serial = serial;
+    snapshot.draw = draw;
+    std::unordered_map<uint32_t, uint32_t> vertex_ranges;
+    std::unordered_map<uint32_t, uint32_t> index_ranges;
+    std::unordered_map<uint32_t, uint32_t> texture_ranges;
+    auto add_range = [](auto& ranges, uint32_t address, uint32_t size) {
+      if (!size) return;
+      auto [it, inserted] = ranges.emplace(address, size);
+      if (!inserted) it->second = std::max(it->second, size);
+    };
+    for (size_t word = 0; word + 1 < draw.vertex_fetch_words.size();
+         word += 2) {
+      xenos::xe_gpu_vertex_fetch_t fetch{};
+      fetch.dword_0 = draw.vertex_fetch_words[word];
+      fetch.dword_1 = draw.vertex_fetch_words[word + 1];
+      add_range(vertex_ranges, fetch.address << 2, fetch.size << 2);
+    }
+    if (draw.index_buffer_type == uint8_t(PrimitiveProcessor::kGuestDMA)) {
+      add_range(index_ranges, draw.guest_index_base, draw.index_bytes);
+    }
+    auto add_textures = [&](const auto& keys) {
+      for (const auto& texture : keys) {
+        if (!texture.IsValid()) continue;
+        add_range(texture_ranges, texture.GetGuestBaseAddress(),
+                  texture.GetGuestBaseSize());
+        add_range(texture_ranges, texture.GetGuestMipAddress(),
+                  texture.GetGuestMipsSize());
+      }
+    };
+    add_textures(draw.texture_srv_keys_vertex);
+    add_textures(draw.texture_srv_keys_pixel);
+    uint64_t content_hash = 14695981039346656037ull;
+    auto copy_ranges = [&](const auto& ranges, auto& destination) {
+      for (const auto& [address, size] : ranges) {
+        const uint8_t* source = memory_->TranslatePhysical(address);
+        if (!source) return false;
+        OwnedGuestRangeSnapshot range;
+        range.guest_address = address;
+        range.bytes.resize(size);
+        std::memcpy(range.bytes.data(), source, size);
+        for (uint8_t value : range.bytes) {
+          content_hash = (content_hash ^ value) * 1099511628211ull;
+        }
+        destination.push_back(std::move(range));
+      }
+      return true;
+    };
+    if (!copy_ranges(vertex_ranges, snapshot.vertex_ranges) ||
+        !copy_ranges(index_ranges, snapshot.index_ranges) ||
+        !copy_ranges(texture_ranges, snapshot.texture_ranges)) {
+      snapshot.Clear();
+      return;
+    }
+    snapshot.content_hash = content_hash;
+  }
+
+  slot->captured_draw_ordinals[snapshot.state_count] = draw_ordinal;
+  snapshot.states[snapshot.state_count++] = std::move(state);
+  if (snapshot.state_count < 2) return;
+  snapshot.complete = true;
+  const auto& state_n = snapshot.states[0];
+  const auto& state_n1 = snapshot.states[1];
+  snapshot.midpoint_vertex_values = state_n1.vertex_constants.values;
+  size_t packed_value = 0;
+  size_t interpolated_words = 0;
+  for (uint32_t map_word = 0; map_word < 4; ++map_word) {
+    uint64_t remaining = state_n1.vertex_constants.register_map[map_word];
+    uint32_t bit;
+    while (rex::bit_scan_forward(remaining, &bit)) {
+      remaining &= ~(UINT64_C(1) << bit);
+      const uint32_t constant = (map_word << 6) + bit;
+      const bool interpolate =
+          constant <= 3 || (constant >= 17 && constant <= 20) ||
+          (constant >= 37 && constant <= 40) || constant >= 84;
+      for (uint32_t component = 0; component < 4;
+           ++component, ++packed_value) {
+        if (packed_value >= state_n.vertex_constants.values.size() ||
+            packed_value >= state_n1.vertex_constants.values.size()) {
+          break;
+        }
+        const float old_value = std::bit_cast<float>(
+            state_n.vertex_constants.values[packed_value]);
+        const float new_value = std::bit_cast<float>(
+            state_n1.vertex_constants.values[packed_value]);
+        if (interpolate && std::isfinite(old_value) &&
+            std::isfinite(new_value)) {
+          snapshot.midpoint_vertex_values[packed_value] =
+              std::bit_cast<uint32_t>((old_value + new_value) * 0.5f);
+          ++interpolated_words;
+        }
+      }
+    }
+  }
+  REXGPU_INFO(
+      "DOAX2 owned render-group unit captured: group_frame={} selected_ordinal={} captured_ordinals={}/{} recipe={:016X} frames_N_N1={}/{} vertices={} midpoint_words={} vertex_ranges={} index_ranges={} texture_ranges={}; CPU snapshots only, no descriptors or submission",
+      owned_render_group_selected_frame_, slot->draw_ordinal,
+      slot->captured_draw_ordinals[0], slot->captured_draw_ordinals[1],
+      slot->recipe_key,
+      state_n.guest_swap_serial, state_n1.guest_swap_serial,
+      draw.host_draw_vertex_count, interpolated_words,
+      snapshot.vertex_ranges.size(), snapshot.index_ranges.size(),
+      snapshot.texture_ranges.size());
+}
+
+void D3D12CommandProcessor::TryPrepareOwnedRenderGroup() {
+  if (!owned_render_group_completion_logged_ ||
+      owned_render_group_prepare_attempted_ ||
+      owned_render_group_slots_.empty()) {
+    return;
+  }
+  owned_render_group_prepare_attempted_ = true;
+  bool group_complete = true;
+  uint64_t total_upload_bytes = 0;
+  uint64_t logical_guest_upload_bytes = 0;
+  uint64_t unique_guest_upload_bytes = 0;
+  std::unordered_map<uint64_t, OwnedRenderUnitUploadSlice>
+      shared_guest_uploads;
+  for (auto& slot : owned_render_group_slots_) {
+    auto& snapshot = slot.snapshot;
+    auto& packet = slot.packet;
+    const auto& state_n1 = snapshot.states[1];
+    packet.frame = frame_current_;
+    packet.submission_at_allocation = submission_current_;
+    std::vector<std::pair<D3D12_GPU_VIRTUAL_ADDRESS,
+                          D3D12_GPU_VIRTUAL_ADDRESS>> intervals;
+    auto upload = [&](const void* source, size_t size, size_t alignment,
+                      D3D12_GPU_VIRTUAL_ADDRESS& address,
+                      ID3D12Resource** resource_out = nullptr,
+                      size_t* resource_offset_out = nullptr) {
+      if (!source || !size) return false;
+      uint8_t* destination = constant_buffer_pool_->Request(
+          frame_current_, size, alignment, resource_out, resource_offset_out,
+          &address);
+      if (!destination) return false;
+      std::memcpy(destination, source, size);
+      packet.total_bytes += size;
+      intervals.emplace_back(address, address + size);
+      return true;
+    };
+    bool complete =
+        upload(snapshot.midpoint_vertex_values.data(),
+               snapshot.midpoint_vertex_values.size() * sizeof(uint32_t),
+               D3D12_CONSTANT_BUFFER_DATA_PLACEMENT_ALIGNMENT,
+               packet.midpoint_constants) &&
+        upload(state_n1.pixel_constants.values.data(),
+               state_n1.pixel_constants.values.size() * sizeof(uint32_t),
+               D3D12_CONSTANT_BUFFER_DATA_PLACEMENT_ALIGNMENT,
+               packet.pixel_constants) &&
+        upload(&state_n1.system_constants, sizeof(state_n1.system_constants),
+               D3D12_CONSTANT_BUFFER_DATA_PLACEMENT_ALIGNMENT,
+               packet.system_constants);
+    constexpr size_t kBoolLoopConstantsSize = (8 + 32) * sizeof(uint32_t);
+    constexpr size_t kFetchConstantsSize = 32 * 6 * sizeof(uint32_t);
+    complete &= upload(
+        &state_n1.registers[XE_GPU_REG_SHADER_CONSTANT_BOOL_000_031],
+        kBoolLoopConstantsSize,
+        D3D12_CONSTANT_BUFFER_DATA_PLACEMENT_ALIGNMENT,
+        packet.bool_loop_constants);
+    complete &= upload(
+        &state_n1.registers[XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0],
+        kFetchConstantsSize, D3D12_CONSTANT_BUFFER_DATA_PLACEMENT_ALIGNMENT,
+        packet.fetch_constants);
+    auto attach_shared_ranges = [&](const auto& ranges, auto& slices) {
+      for (const auto& range : ranges) {
+        if (!range.bytes.size() || range.bytes.size() > UINT32_MAX) return false;
+        uint64_t key = 14695981039346656037ull;
+        for (uint8_t value : range.bytes) {
+          key = (key ^ value) * 1099511628211ull;
+        }
+        key = (key ^ range.guest_address) * 1099511628211ull;
+        key = (key ^ uint32_t(range.bytes.size())) * 1099511628211ull;
+        auto existing = shared_guest_uploads.find(key);
+        if (existing == shared_guest_uploads.end()) {
+          OwnedRenderUnitUploadSlice shared_slice;
+          shared_slice.size = range.bytes.size();
+          shared_slice.source_guest_address = range.guest_address;
+          shared_slice.content_hash = 14695981039346656037ull;
+          for (uint8_t value : range.bytes) {
+            shared_slice.content_hash =
+                (shared_slice.content_hash ^ value) * 1099511628211ull;
+          }
+          ID3D12Resource* resource = nullptr;
+          size_t offset = 0;
+          uint8_t* destination = constant_buffer_pool_->Request(
+              frame_current_, range.bytes.size(), 16, &resource, &offset,
+              &shared_slice.gpu_address);
+          if (!destination) return false;
+          std::memcpy(destination, range.bytes.data(), range.bytes.size());
+          shared_slice.resource = resource;
+          shared_slice.resource_offset = offset;
+          unique_guest_upload_bytes += range.bytes.size();
+          existing =
+              shared_guest_uploads.emplace(key, std::move(shared_slice)).first;
+        }
+        const OwnedRenderUnitUploadSlice& slice = existing->second;
+        slices.push_back(slice);
+        packet.total_bytes += slice.size;
+        logical_guest_upload_bytes += slice.size;
+        intervals.emplace_back(slice.gpu_address,
+                               slice.gpu_address + slice.size);
+      }
+      return true;
+    };
+    complete &=
+        attach_shared_ranges(snapshot.vertex_ranges, packet.vertex_ranges);
+    complete &=
+        attach_shared_ranges(snapshot.index_ranges, packet.index_ranges);
+    complete &=
+        attach_shared_ranges(snapshot.texture_ranges, packet.texture_ranges);
+    std::sort(intervals.begin(), intervals.end());
+    packet.independent_ranges = complete;
+    for (size_t i = 1; i < intervals.size(); ++i) {
+      packet.independent_ranges &= intervals[i - 1].second <= intervals[i].first;
+    }
+    packet.complete = complete && packet.independent_ranges &&
+                      packet.midpoint_constants !=
+                          state_n1.vertex_constants.address;
+    group_complete &= packet.complete;
+    total_upload_bytes += packet.total_bytes;
+  }
+  if (!group_complete) {
+    REXGPU_WARN(
+        "DOAX2 owned render-group preparation rejected: one or more private upload packets were incomplete");
+    owned_render_group_slots_.clear();
+    owned_render_group_selected_frame_ = 0;
+    owned_render_group_completion_logged_ = false;
+    owned_render_group_prepare_attempted_ = false;
+    return;
+  }
+
+  uint64_t required_sampler_descriptors = 0;
+  for (const auto& slot : owned_render_group_slots_) {
+    required_sampler_descriptors +=
+        slot.snapshot.draw.samplers_vertex.size() +
+        slot.snapshot.draw.samplers_pixel.size();
+  }
+  if (required_sampler_descriptors > kSamplerHeapSize) {
+    REXGPU_WARN(
+        "DOAX2 owned render-group preparation rejected: private sampler requirement={} exceeds hardware-bounded heap capacity={}",
+        required_sampler_descriptors, kSamplerHeapSize);
+    owned_render_group_slots_.clear();
+    owned_render_group_selected_frame_ = 0;
+    owned_render_group_completion_logged_ = false;
+    owned_render_group_prepare_attempted_ = false;
+    return;
+  }
+  D3D12_DESCRIPTOR_HEAP_DESC sampler_heap_desc{};
+  sampler_heap_desc.Type = D3D12_DESCRIPTOR_HEAP_TYPE_SAMPLER;
+  sampler_heap_desc.NumDescriptors =
+      std::max<uint32_t>(1, uint32_t(required_sampler_descriptors));
+  sampler_heap_desc.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE;
+  ID3D12Device* device = GetD3D12Provider().GetDevice();
+  owned_render_group_sampler_heap_.Reset();
+  if (FAILED(device->CreateDescriptorHeap(
+          &sampler_heap_desc,
+          IID_PPV_ARGS(&owned_render_group_sampler_heap_)))) {
+    REXGPU_WARN(
+        "DOAX2 owned render-group preparation rejected: private sampler heap allocation failed for {} descriptors",
+        required_sampler_descriptors);
+    owned_render_group_slots_.clear();
+    owned_render_group_selected_frame_ = 0;
+    owned_render_group_completion_logged_ = false;
+    owned_render_group_prepare_attempted_ = false;
+    return;
+  }
+  owned_render_group_sampler_cpu_start_ =
+      owned_render_group_sampler_heap_->GetCPUDescriptorHandleForHeapStart();
+  owned_render_group_sampler_gpu_start_ =
+      owned_render_group_sampler_heap_->GetGPUDescriptorHandleForHeapStart();
+  owned_render_group_sampler_capacity_ =
+      sampler_heap_desc.NumDescriptors;
+  owned_render_group_sampler_allocated_ = 0;
+
+  // Reuse the already-proven unit builders one slot at a time. Only their
+  // host-side construction context is exchanged; every resulting descriptor,
+  // texture and geometry allocation remains owned by the slot's packet.
+  owned_render_group_building_root_packets_ = true;
+  for (auto& slot : owned_render_group_slots_) {
+    owned_unit_snapshot_ = std::move(slot.snapshot);
+    owned_unit_upload_packet_ = std::move(slot.packet);
+    TryCreateOwnedRenderUnitTextures();
+    TryCreateOwnedRenderUnitGeometry();
+    TryCreateOwnedRenderUnitRootPacket();
+    slot.snapshot = std::move(owned_unit_snapshot_);
+    slot.packet = std::move(owned_unit_upload_packet_);
+    owned_unit_snapshot_ = {};
+    owned_unit_upload_packet_ = {};
+    group_complete &= slot.packet.root_packet_complete;
+  }
+  owned_render_group_building_root_packets_ = false;
+  if (group_complete) {
+    auto& first = owned_render_group_slots_.front();
+    owned_unit_snapshot_ = std::move(first.snapshot);
+    owned_unit_upload_packet_ = std::move(first.packet);
+    TryCreateOwnedRenderUnitOutput();
+    first.snapshot = std::move(owned_unit_snapshot_);
+    first.packet = std::move(owned_unit_upload_packet_);
+    owned_unit_snapshot_ = {};
+    owned_unit_upload_packet_ = {};
+    group_complete &= first.packet.output_complete;
+  }
+  owned_render_group_prepared_ = group_complete;
+  if (!REXCVAR_GET(d3d12_doax2_owned_output_continuous) ||
+      (owned_render_group_selected_frame_ % 120) == 0) REXGPU_INFO(
+      "DOAX2 owned render-group GPU preparation: units={} complete={} logical_upload_bytes={} logical_guest_bytes={} unique_guest_upload_bytes={} shared_guest_ranges={} deduplicated_guest_bytes={} root_packets={} shared_output={} private_samplers={}/{}; fresh per-unit constants/descriptors/geometry, identical snapshot ranges shared by address, size and content, private sampler heap and one private color/depth target, no draw yet",
+      owned_render_group_slots_.size(), owned_render_group_prepared_,
+      total_upload_bytes, logical_guest_upload_bytes,
+      unique_guest_upload_bytes,
+      shared_guest_uploads.size(),
+      logical_guest_upload_bytes > unique_guest_upload_bytes
+          ? logical_guest_upload_bytes - unique_guest_upload_bytes
+          : 0,
+      std::count_if(owned_render_group_slots_.begin(),
+                    owned_render_group_slots_.end(), [](const auto& slot) {
+                      return slot.packet.root_packet_complete;
+                    }),
+      owned_render_group_slots_.front().packet.output_complete,
+      owned_render_group_sampler_allocated_,
+      owned_render_group_sampler_capacity_);
+  if (!owned_render_group_prepared_) {
+    const size_t discarded_units = owned_render_group_slots_.size();
+    owned_render_group_slots_.clear();
+    owned_render_group_sampler_heap_.Reset();
+    owned_render_group_sampler_cpu_start_ = {};
+    owned_render_group_sampler_gpu_start_ = {};
+    owned_render_group_sampler_capacity_ = 0;
+    owned_render_group_sampler_allocated_ = 0;
+    owned_render_group_selected_frame_ = 0;
+    owned_render_group_completion_logged_ = false;
+    owned_render_group_prepare_attempted_ = false;
+    REXGPU_WARN(
+        "DOAX2 owned render-group GPU preparation rollback: discarded_units={}; incomplete private packets released atomically before submission",
+        discarded_units);
+  }
+}
+
+void D3D12CommandProcessor::TryDrawOwnedRenderGroup() {
+  if (!owned_render_group_prepared_ || owned_render_group_draw_attempted_ ||
+      owned_render_group_slots_.empty()) {
+    return;
+  }
+  owned_render_group_draw_attempted_ = true;
+  auto& output = owned_render_group_slots_.front().packet;
+  if (!submission_open_ || !bindless_resources_used_ ||
+      !owned_render_group_sampler_heap_ ||
+      !output.output_color_resource || !output.output_depth_resource ||
+      !output.output_rtv_heap || !output.output_dsv_heap ||
+      output.output_samples != 1 ||
+      output.output_color_format != DXGI_FORMAT_R8G8B8A8_UNORM) {
+    REXGPU_WARN(
+        "DOAX2 owned render-group draw rejected: submission_open={} bindless={} color={} depth={} samples={} format={}",
+        submission_open_, bindless_resources_used_,
+        output.output_color_resource != nullptr,
+        output.output_depth_resource != nullptr, output.output_samples,
+        uint32_t(output.output_color_format));
+    return;
+  }
+  ID3D12Device* device = GetD3D12Provider().GetDevice();
+  const bool verify_color =
+      !REXCVAR_GET(d3d12_doax2_owned_output_continuous) ||
+      (owned_render_group_selected_frame_ % 120) == 0;
+  if (verify_color) {
+    const D3D12_RESOURCE_DESC color_desc =
+        output.output_color_resource->GetDesc();
+    device->GetCopyableFootprints(
+        &color_desc, 0, 1, 0, &output.color_readback_footprint,
+        &output.color_readback_rows, &output.color_readback_row_size,
+        &output.color_readback_size);
+    D3D12_RESOURCE_DESC readback_desc{};
+    readback_desc.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+    readback_desc.Width = output.color_readback_size;
+    readback_desc.Height = 1;
+    readback_desc.DepthOrArraySize = 1;
+    readback_desc.MipLevels = 1;
+    readback_desc.SampleDesc.Count = 1;
+    readback_desc.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    if (!output.color_readback_size ||
+        FAILED(device->CreateCommittedResource(
+            &ui::d3d12::util::kHeapPropertiesReadback,
+            D3D12_HEAP_FLAG_NONE, &readback_desc,
+            D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+            IID_PPV_ARGS(&output.color_readback)))) {
+      REXGPU_WARN(
+          "DOAX2 owned render-group draw rejected: color readback allocation failed");
+      return;
+    }
+  }
+  SubmitBarriers();
+  const D3D12_CPU_DESCRIPTOR_HANDLE rtv =
+      output.output_rtv_heap->GetCPUDescriptorHandleForHeapStart();
+  const D3D12_CPU_DESCRIPTOR_HANDLE dsv =
+      output.output_dsv_heap->GetCPUDescriptorHandleForHeapStart();
+  uint64_t total_vertices = 0;
+  for (auto& slot : owned_render_group_slots_) {
+    auto& packet = slot.packet;
+    const auto& draw = slot.snapshot.draw;
+    deferred_command_list_.SetDescriptorHeaps(view_bindless_heap_,
+                                               owned_render_group_sampler_heap_.Get());
+    deferred_command_list_.D3DSetPipelineState(packet.pipeline_state);
+    deferred_command_list_.D3DSetGraphicsRootSignature(packet.root_signature);
+    deferred_command_list_.D3DSetGraphicsRootConstantBufferView(
+        kRootParameter_Bindless_FetchConstants,
+        packet.geometry_fetch_constants);
+    deferred_command_list_.D3DSetGraphicsRootConstantBufferView(
+        kRootParameter_Bindless_FloatConstantsVertex,
+        packet.midpoint_constants);
+    deferred_command_list_.D3DSetGraphicsRootConstantBufferView(
+        kRootParameter_Bindless_FloatConstantsPixel, packet.pixel_constants);
+    deferred_command_list_.D3DSetGraphicsRootConstantBufferView(
+        kRootParameter_Bindless_DescriptorIndicesPixel,
+        packet.descriptor_indices_pixel);
+    deferred_command_list_.D3DSetGraphicsRootConstantBufferView(
+        kRootParameter_Bindless_DescriptorIndicesVertex,
+        packet.descriptor_indices_vertex);
+    deferred_command_list_.D3DSetGraphicsRootConstantBufferView(
+        kRootParameter_Bindless_SystemConstants, packet.system_constants);
+    deferred_command_list_.D3DSetGraphicsRootConstantBufferView(
+        kRootParameter_Bindless_BoolLoopConstants,
+        packet.bool_loop_constants);
+    deferred_command_list_.D3DSetGraphicsRootDescriptorTable(
+        kRootParameter_Bindless_SharedMemory,
+        packet.geometry_descriptor_table);
+    deferred_command_list_.D3DSetGraphicsRootDescriptorTable(
+        kRootParameter_Bindless_SamplerHeap, packet.sampler_heap);
+    deferred_command_list_.D3DSetGraphicsRootDescriptorTable(
+        kRootParameter_Bindless_ViewHeap, packet.view_heap);
+    deferred_command_list_.D3DOMSetRenderTargets(1, &rtv, FALSE, &dsv);
+    deferred_command_list_.RSSetViewport(packet.viewport);
+    deferred_command_list_.RSSetScissorRect(packet.scissor);
+    deferred_command_list_.D3DOMSetBlendFactor(packet.blend_factor.data());
+    deferred_command_list_.D3DOMSetStencilRef(packet.stencil_reference);
+    deferred_command_list_.D3DIASetPrimitiveTopology(packet.primitive_topology);
+    if (draw.index_buffer_type == uint8_t(PrimitiveProcessor::kGuestDMA)) {
+      deferred_command_list_.D3DIASetIndexBuffer(&packet.geometry_index_view);
+      deferred_command_list_.D3DDrawIndexedInstanced(
+          draw.host_draw_vertex_count, 1, 0, 0, 0);
+    } else {
+      // Only kNone reaches this prepared path. Match the native non-indexed
+      // draw; never use an index view retained from another owned packet.
+      deferred_command_list_.D3DIASetIndexBuffer(nullptr);
+      deferred_command_list_.D3DDrawInstanced(
+          draw.host_draw_vertex_count, 1, 0, 0);
+    }
+    total_vertices += draw.host_draw_vertex_count;
+  }
+  PushTransitionBarrier(output.output_color_resource.Get(),
+                        D3D12_RESOURCE_STATE_RENDER_TARGET,
+                        D3D12_RESOURCE_STATE_COPY_SOURCE);
+  SubmitBarriers();
+  if (verify_color) {
+    D3D12_TEXTURE_COPY_LOCATION destination{};
+    destination.pResource = output.color_readback.Get();
+    destination.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+    destination.PlacedFootprint = output.color_readback_footprint;
+    D3D12_TEXTURE_COPY_LOCATION source{};
+    source.pResource = output.output_color_resource.Get();
+    source.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    source.SubresourceIndex = 0;
+    deferred_command_list_.D3DCopyTextureRegion(
+        &destination, 0, 0, 0, &source, nullptr);
+  }
+  owned_render_group_submission_ = submission_current_;
+  if (!EndSubmission(false)) {
+    REXGPU_WARN("DOAX2 owned render-group submission failed");
+    return;
+  }
+  owned_render_group_draw_pending_ = true;
+  output.color_readback_pending = verify_color;
+  output.draw_submission = owned_render_group_submission_;
+  output.output_protecting_submission = owned_render_group_submission_;
+  const auto& target_keys =
+      owned_render_group_slots_.front().snapshot.draw.bound_render_target_keys;
+  const bool mailbox_candidate =
+      (REXCVAR_GET(d3d12_doax2_owned_output_mailbox_stage) ||
+       REXCVAR_GET(d3d12_doax2_owned_output_mailbox_present)) &&
+      !owned_render_group_mailbox_source_ &&
+      target_keys[0] == 0x002082D0 && target_keys[1] == 0x00008000 &&
+      output.output_width == 2560 && output.output_height == 1440;
+  if (mailbox_candidate) {
+    owned_render_group_mailbox_source_ = output.output_color_resource;
+    owned_render_group_mailbox_source_width_ = output.output_width;
+    owned_render_group_mailbox_source_height_ = output.output_height;
+    owned_render_group_mailbox_source_submission_ =
+        owned_render_group_submission_;
+    REXGPU_INFO(
+        "DOAX2 owned final-color mailbox armed: source_submission={} source={} size={}x{} target_keys={:08X}/{:08X}; independent reconstructed resource retained for clean mailbox consumption",
+        owned_render_group_mailbox_source_submission_,
+        static_cast<void*>(owned_render_group_mailbox_source_.Get()),
+        owned_render_group_mailbox_source_width_,
+        owned_render_group_mailbox_source_height_, target_keys[0],
+        target_keys[1]);
+  }
+  resources_for_deletion_.emplace_back(
+      owned_render_group_submission_, output.output_color_resource.Detach());
+  resources_for_deletion_.emplace_back(
+      owned_render_group_submission_, output.output_depth_resource.Detach());
+  if (!REXCVAR_GET(d3d12_doax2_owned_output_continuous) ||
+      (owned_render_group_selected_frame_ % 120) == 0) REXGPU_INFO(
+      "DOAX2 owned render-group submitted: units={} vertices={} submission={}; ordered fresh draws share one private color/depth target, no native descriptor/command replay, not presented, no simulation tick",
+      owned_render_group_slots_.size(), total_vertices,
+      owned_render_group_submission_);
+  if (mailbox_candidate &&
+      !REXCVAR_GET(d3d12_doax2_owned_output_continuous)) {
+    // Until every remaining global-heap dependency has been proven immutable,
+    // don't allow native recording to overlap the first presentation-sized
+    // reconstructed candidate. This is deliberately scoped to the diagnostic
+    // mailbox checkpoint; smaller offscreen groups retain asynchronous fence
+    // behavior. CheckSubmissionFence also performs the color proof and retires
+    // all one-use descriptors only after completion is actually observed.
+    const uint64_t candidate_submission = owned_render_group_submission_;
+    REXGPU_INFO(
+        "DOAX2 owned final-color fence gate: awaiting source_submission={} before native recording resumes; diagnostic isolation only",
+        candidate_submission);
+    CheckSubmissionFence(candidate_submission);
+    if (submission_completed_ >= candidate_submission) {
+      REXGPU_INFO(
+          "DOAX2 owned final-color fence gate complete: source_submission={} completed_submission={}; reconstructed display output and all per-unit descriptor tables finished before native recording resumed",
+          candidate_submission, submission_completed_);
+    } else {
+      const HRESULT reason =
+          GetD3D12Provider().GetDevice()->GetDeviceRemovedReason();
+      REXGPU_ERROR(
+          "DOAX2 owned final-color fence gate failed: source_submission={} completed_submission={} device_reason=0x{:08X}",
+          candidate_submission, submission_completed_,
+          static_cast<uint32_t>(reason));
+      if (FAILED(reason)) {
+        LogDeviceRemovalDiagnostics(GetD3D12Provider().GetDevice(), reason);
+      }
+    }
+  }
+}
+
+void D3D12CommandProcessor::TryCreateOwnedRenderUnitTextures() {
+  if (!owned_unit_snapshot_.complete || !owned_unit_upload_packet_.complete ||
+      owned_unit_upload_packet_.textures_attempted || !texture_cache_) {
+    return;
+  }
+  owned_unit_upload_packet_.textures_attempted = true;
+  std::vector<D3D12TextureCache::OwnedSnapshotSource> sources;
+  sources.reserve(owned_unit_upload_packet_.texture_ranges.size());
+  for (const OwnedRenderUnitUploadSlice& slice :
+       owned_unit_upload_packet_.texture_ranges) {
+    if (!slice.resource || !slice.size || slice.size > UINT32_MAX) continue;
+    sources.push_back(D3D12TextureCache::OwnedSnapshotSource{
+        slice.resource.Get(), slice.resource_offset, slice.source_guest_address,
+        uint32_t(slice.size), slice.content_hash});
+  }
+  std::vector<D3D12TextureCache::TextureSRVKey> keys;
+  keys.reserve(owned_unit_snapshot_.draw.texture_srv_keys_vertex.size() +
+               owned_unit_snapshot_.draw.texture_srv_keys_pixel.size());
+  keys.insert(keys.end(),
+              owned_unit_snapshot_.draw.texture_srv_keys_vertex.begin(),
+              owned_unit_snapshot_.draw.texture_srv_keys_vertex.end());
+  keys.insert(keys.end(),
+              owned_unit_snapshot_.draw.texture_srv_keys_pixel.begin(),
+              owned_unit_snapshot_.draw.texture_srv_keys_pixel.end());
+
+  const bool composite_draw =
+      REXCVAR_GET(d3d12_doax2_owned_composite_draw) &&
+      owned_unit_snapshot_.recipe_key == 0xC0517E0000000001ull;
+  const size_t pixel_texture_offset =
+      owned_unit_snapshot_.draw.texture_srv_keys_vertex.size();
+  std::vector<size_t> composite_source_indices;
+  if (composite_draw) {
+    const auto& pixel_keys =
+        owned_unit_snapshot_.draw.texture_srv_keys_pixel;
+    const auto& pixel_bindings =
+        owned_unit_snapshot_.draw.texture_bindings_pixel;
+    if (pixel_keys.empty() || pixel_keys.size() != pixel_bindings.size() ||
+        !pixel_keys[0].IsValid()) {
+      REXGPU_WARN("DOAX2 owned composite draw rejected: stage=source_binding");
+      return;
+    }
+    const uint32_t source_base = pixel_keys[0].GetGuestBaseAddress();
+    for (size_t i = 0; i < pixel_keys.size(); ++i) {
+      if (!pixel_keys[i].IsValid() ||
+          pixel_keys[i].GetGuestBaseAddress() != source_base) continue;
+      if (pixel_keys[i].host_swizzle != pixel_keys[0].host_swizzle) {
+        REXGPU_WARN(
+            "DOAX2 owned composite draw rejected: stage=source_view_variant binding={} signed={} swizzle={:08X} first_swizzle={:08X}",
+            i, pixel_bindings[i].is_signed, pixel_keys[i].host_swizzle,
+            pixel_keys[0].host_swizzle);
+        return;
+      }
+      composite_source_indices.push_back(pixel_texture_offset + i);
+    }
+    if (composite_source_indices.empty()) {
+      REXGPU_WARN("DOAX2 owned composite draw rejected: stage=no_source_slots");
+      return;
+    }
+    // This source is produced by the native GPU, not guest memory. The
+    // snapshot texture builder must not try to reconstruct it from an
+    // uncaptured guest range; the fenced private copy supplies its view.
+    for (size_t index : composite_source_indices) keys[index] = {};
+  }
+
+  D3D12TextureCache::OwnedSnapshotTextureResult result;
+  const size_t valid_key_count =
+      std::count_if(keys.begin(), keys.end(), [](const auto& key) {
+        return key.IsValid();
+      });
+  const bool null_texture_only = valid_key_count == 0;
+  if (null_texture_only) {
+    // A translated shader may retain texture binding slots even though all of
+    // the draw's fetch keys are invalid. This is a complete input set: the
+    // normal bindless path supplies immutable system null SRVs for those
+    // slots. Preserve one UINT32_MAX entry per binding so the fresh root
+    // packet resolves the correct dimension-specific null descriptor. Do not
+    // weaken the failure for a valid key whose guest backing wasn't captured.
+    result.unsigned_descriptor_indices.assign(keys.size(), UINT32_MAX);
+    result.signed_descriptor_indices.assign(keys.size(), UINT32_MAX);
+    result.complete = true;
+    owned_unit_upload_packet_.textures_complete = true;
+  } else {
+    owned_unit_upload_packet_.textures_complete =
+        texture_cache_->CreateOwnedSnapshotTextures(keys, sources, result);
+  }
+  if (composite_draw && owned_unit_upload_packet_.textures_complete) {
+    const auto& expected_key =
+        owned_unit_snapshot_.draw.texture_srv_keys_pixel[0];
+    const uint64_t expected_frame =
+        owned_unit_snapshot_.states[1].guest_swap_serial;
+    bool source_found = false;
+    const auto& pixel_bindings =
+        owned_unit_snapshot_.draw.texture_bindings_pixel;
+    const uint32_t descriptor_size =
+        GetD3D12Provider().GetViewDescriptorSize();
+    for (const auto& bank : owned_composite_source_banks_) {
+      if (bank.frame != expected_frame || !bank.texture ||
+          !bank.private_srv.ptr || !bank.private_signed_srv.ptr ||
+          !bank.lease ||
+          bank.texture_state !=
+              (D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE |
+               D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE) ||
+          bank.host_swizzle != expected_key.host_swizzle ||
+          bank.private_srv.ptr < view_bindless_heap_gpu_start_.ptr ||
+          !descriptor_size) {
+        continue;
+      }
+      const uint64_t offset =
+          bank.private_srv.ptr - view_bindless_heap_gpu_start_.ptr;
+      if (offset % descriptor_size ||
+          offset / descriptor_size > UINT32_MAX ||
+          composite_source_indices.back() >=
+              result.unsigned_descriptor_indices.size()) {
+        continue;
+      }
+      const uint64_t signed_offset =
+          bank.private_signed_srv.ptr - view_bindless_heap_gpu_start_.ptr;
+      if (bank.private_signed_srv.ptr < view_bindless_heap_gpu_start_.ptr ||
+          signed_offset % descriptor_size ||
+          signed_offset / descriptor_size > UINT32_MAX ||
+          composite_source_indices.back() >=
+              result.signed_descriptor_indices.size()) {
+        continue;
+      }
+      for (size_t index : composite_source_indices) {
+        if (pixel_bindings[index - pixel_texture_offset].is_signed) {
+          result.signed_descriptor_indices[index] =
+              uint32_t(signed_offset / descriptor_size);
+        } else {
+          result.unsigned_descriptor_indices[index] =
+              uint32_t(offset / descriptor_size);
+        }
+      }
+      source_found = true;
+      REXGPU_INFO(
+          "DOAX2 owned composite draw source bound: frame={} bank_resource={:016X} private_srv={:016X} private_signed_srv={:016X} unsigned_index={} signed_index={} slots={} protecting_submission={}; fresh owned source, no native descriptor retained",
+          expected_frame, reinterpret_cast<uintptr_t>(bank.texture.Get()),
+          bank.private_srv.ptr, bank.private_signed_srv.ptr,
+          uint32_t(offset / descriptor_size),
+          uint32_t(signed_offset / descriptor_size),
+          composite_source_indices.size(),
+          submission_current_);
+      break;
+    }
+    if (!source_found) {
+      owned_unit_upload_packet_.textures_complete = false;
+      REXGPU_WARN(
+          "DOAX2 owned composite draw rejected: stage=owned_source_unavailable frame={}",
+          expected_frame);
+    }
+  }
+  owned_unit_upload_packet_.texture_resources = result.resources_created;
+  owned_unit_upload_packet_.texture_views = result.views_created;
+  owned_unit_upload_packet_.texture_unsigned_indices =
+      std::move(result.unsigned_descriptor_indices);
+  owned_unit_upload_packet_.texture_signed_indices =
+      std::move(result.signed_descriptor_indices);
+  if (!REXCVAR_GET(d3d12_doax2_owned_output_continuous) ||
+      !owned_render_group_building_root_packets_ ||
+      (owned_render_group_selected_frame_ % 120) == 0) {
+    REXGPU_INFO(
+      "DOAX2 owned-unit texture reconstruction: frame={} recipe={:016X} complete={} requested_keys={} valid_keys={} null_texture_only={} source_ranges={} source_bytes={} resources={} views={} cache_hits={} cache_misses={} distinct_resources={} protecting_submission={}; content-identical snapshots reuse persistent private textures/SRVs, misses use private upload sources and normal ReXGlue detile/format conversion",
+      frame_current_, owned_unit_snapshot_.recipe_key,
+      owned_unit_upload_packet_.textures_complete, keys.size(), valid_key_count,
+      null_texture_only, sources.size(),
+      result.bytes_of_guest_backing, result.resources_created,
+      result.views_created, result.cache_hits, result.cache_misses,
+      result.distinct_resources, submission_current_);
+  }
+}
+
+void D3D12CommandProcessor::TryCreateOwnedRenderUnitGeometry() {
+  auto& packet = owned_unit_upload_packet_;
+  if (!owned_unit_snapshot_.complete || !packet.textures_complete ||
+      packet.geometry_attempted) {
+    return;
+  }
+  packet.geometry_attempted = true;
+  const auto& draw = owned_unit_snapshot_.draw;
+  const bool indexed =
+      draw.index_buffer_type == uint8_t(PrimitiveProcessor::kGuestDMA);
+  const bool nonindexed =
+      draw.index_buffer_type == uint8_t(PrimitiveProcessor::kNone);
+  const bool has_vertex_fetches = std::any_of(
+      draw.vertex_fetch_mask.begin(), draw.vertex_fetch_mask.end(),
+      [](uint32_t mask) { return mask != 0; });
+  if ((!indexed && !nonindexed) ||
+      (indexed && (packet.vertex_ranges.empty() ||
+                   packet.index_ranges.size() != 1)) ||
+      (nonindexed && (!packet.index_ranges.empty() ||
+                      (has_vertex_fetches && packet.vertex_ranges.empty())))) {
+    REXGPU_WARN(
+        "DOAX2 owned-unit geometry reconstruction rejected: index_type={} vertex_ranges={} index_ranges={} vertex_fetches={}; requires exact guest-DMA index data or native kNone draw",
+        draw.index_buffer_type, packet.vertex_ranges.size(),
+        packet.index_ranges.size(), has_vertex_fetches);
+    return;
+  }
+
+  struct PackedRange {
+    uint32_t guest_address;
+    uint64_t offset;
+    uint64_t size;
+  };
+  std::vector<PackedRange> packed_vertex_ranges;
+  uint64_t geometry_size = 0;
+  for (const OwnedRenderUnitUploadSlice& slice : packet.vertex_ranges) {
+    if (!slice.resource || !slice.size) return;
+    geometry_size = rex::align(geometry_size,
+                               uint64_t(D3D12_RAW_UAV_SRV_BYTE_ALIGNMENT));
+    packed_vertex_ranges.push_back(
+        {slice.source_guest_address, geometry_size, slice.size});
+    geometry_size += slice.size;
+  }
+  geometry_size = rex::align(geometry_size, uint64_t(4));
+  const uint64_t index_offset = geometry_size;
+  const OwnedRenderUnitUploadSlice* index_slice =
+      indexed ? &packet.index_ranges.front() : nullptr;
+  if (index_slice) {
+    if (!index_slice->resource || !index_slice->size) return;
+    geometry_size += index_slice->size;
+  }
+  // A fetch-free shader still requires a private raw-SRV table for the root
+  // signature, but never reads this dummy allocation.
+  geometry_size = rex::align(geometry_size,
+                             uint64_t(D3D12_RAW_UAV_SRV_BYTE_ALIGNMENT));
+  geometry_size = std::max<uint64_t>(
+      geometry_size, D3D12_RAW_UAV_SRV_BYTE_ALIGNMENT);
+  if (geometry_size > UINT32_MAX) return;
+
+  // Validate and remap every N+1 fetch before recording *any* GPU command.
+  // A late reject after CopyBufferRegion would release the local destination
+  // while the deferred list still refers to it.
+  constexpr size_t kFetchConstantWordCount = 32 * 6;
+  std::array<uint32_t, kFetchConstantWordCount> remapped_fetch_constants{};
+  std::copy_n(
+      &owned_unit_snapshot_.states[1]
+           .registers[XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0],
+      remapped_fetch_constants.size(), remapped_fetch_constants.begin());
+  uint32_t remapped_fetches = 0;
+  for (uint32_t mask_word = 0; mask_word < draw.vertex_fetch_mask.size();
+       ++mask_word) {
+    uint32_t remaining = draw.vertex_fetch_mask[mask_word];
+    uint32_t bit;
+    while (rex::bit_scan_forward(remaining, &bit)) {
+      remaining &= ~(UINT32_C(1) << bit);
+      const uint32_t fetch_index = mask_word * 32 + bit;
+      if (fetch_index >= 96) return;
+      xenos::xe_gpu_vertex_fetch_t fetch{};
+      std::memcpy(&fetch, &remapped_fetch_constants[fetch_index * 2],
+                  sizeof(fetch));
+      const uint32_t guest_address = fetch.address << 2;
+      const PackedRange* packed = nullptr;
+      for (const PackedRange& candidate : packed_vertex_ranges) {
+        if (candidate.guest_address == guest_address &&
+            candidate.size >= (uint64_t(fetch.size) << 2)) {
+          packed = &candidate;
+          break;
+        }
+      }
+      if (!packed || (packed->offset & 3)) {
+        REXGPU_WARN(
+            "DOAX2 owned-unit geometry rejected before GPU recording: frame={} fetch={} guest_address={:08X} bytes={} captured_vertex_ranges={}",
+            owned_unit_snapshot_.states[1].guest_swap_serial, fetch_index,
+            guest_address, uint64_t(fetch.size) << 2,
+            packed_vertex_ranges.size());
+        return;
+      }
+      fetch.address = uint32_t(packed->offset >> 2);
+      std::memcpy(&remapped_fetch_constants[fetch_index * 2], &fetch,
+                  sizeof(fetch));
+      ++remapped_fetches;
+    }
+  }
+
+  uint64_t geometry_cache_key = 14695981039346656037ull;
+  auto mix_geometry_key = [&](uint64_t value) {
+    geometry_cache_key =
+        (geometry_cache_key ^ value) * 1099511628211ull;
+  };
+  mix_geometry_key(owned_unit_snapshot_.recipe_key);
+  for (const auto& source : packet.vertex_ranges) {
+    mix_geometry_key(source.source_guest_address);
+    mix_geometry_key(source.size);
+    mix_geometry_key(source.content_hash);
+  }
+  mix_geometry_key(draw.index_buffer_type);
+  if (index_slice) {
+    mix_geometry_key(index_slice->source_guest_address);
+    mix_geometry_key(index_slice->size);
+    mix_geometry_key(index_slice->content_hash);
+  }
+
+  Microsoft::WRL::ComPtr<ID3D12Resource> geometry_buffer;
+  D3D12_GPU_DESCRIPTOR_HANDLE geometry_descriptor_table{};
+  const auto& provider = GetD3D12Provider();
+  ID3D12Device* device = provider.GetDevice();
+  auto geometry_cached = owned_geometry_cache_.find(geometry_cache_key);
+  const bool geometry_cache_hit =
+      geometry_cached != owned_geometry_cache_.end() &&
+      geometry_cached->second.geometry_size == geometry_size &&
+      geometry_cached->second.index_offset == index_offset &&
+      geometry_cached->second.resource &&
+      geometry_cached->second.descriptor_table.ptr;
+  if (geometry_cache_hit) {
+    geometry_cached->second.last_submission = submission_current_;
+    geometry_buffer = geometry_cached->second.resource;
+    geometry_descriptor_table = geometry_cached->second.descriptor_table;
+  } else {
+    D3D12_RESOURCE_DESC buffer_desc;
+    ui::d3d12::util::FillBufferResourceDesc(
+        buffer_desc, geometry_size, D3D12_RESOURCE_FLAG_NONE);
+    if (FAILED(device->CreateCommittedResource(
+            &ui::d3d12::util::kHeapPropertiesDefault,
+            provider.GetHeapFlagCreateNotZeroed(), &buffer_desc,
+            D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+            IID_PPV_ARGS(&geometry_buffer)))) {
+      return;
+    }
+  }
+
+  // The complete fetch block was validated and remapped before allocation.
+  D3D12_GPU_VIRTUAL_ADDRESS remapped_fetch_address = 0;
+  uint8_t* remapped_fetch_upload = constant_buffer_pool_->Request(
+      frame_current_, sizeof(remapped_fetch_constants),
+      D3D12_CONSTANT_BUFFER_DATA_PLACEMENT_ALIGNMENT, nullptr, nullptr,
+      &remapped_fetch_address);
+  if (!remapped_fetch_upload) return;
+  std::memcpy(remapped_fetch_upload, remapped_fetch_constants.data(),
+              sizeof(remapped_fetch_constants));
+
+  if (!geometry_cache_hit) {
+    // The SRV/null-UAV table is persistent and private, just like its backing
+    // buffer. It is never overwritten with another frame's resource.
+    ui::d3d12::util::DescriptorCpuGpuHandlePair
+        owned_geometry_descriptors[2];
+    if (!RequestPersistentViewBindlessDescriptors(
+            uint32_t(rex::countof(owned_geometry_descriptors)),
+            owned_geometry_descriptors)) {
+      return;
+    }
+    ui::d3d12::util::CreateBufferRawSRV(
+        device, owned_geometry_descriptors[0].first, geometry_buffer.Get(),
+        uint32_t(geometry_size));
+    ui::d3d12::util::CreateBufferRawUAV(
+        device, owned_geometry_descriptors[1].first, nullptr, 0);
+    geometry_descriptor_table = owned_geometry_descriptors[0].second;
+  }
+
+  D3D12_INDEX_BUFFER_VIEW index_view{};
+  if (indexed) {
+    index_view.BufferLocation =
+        geometry_buffer->GetGPUVirtualAddress() + index_offset;
+    index_view.SizeInBytes = draw.host_draw_vertex_count *
+                             (draw.host_index_format ==
+                                      uint8_t(xenos::IndexFormat::kInt16)
+                                  ? sizeof(uint16_t)
+                                  : sizeof(uint32_t));
+    if (index_view.SizeInBytes > index_slice->size) return;
+    index_view.Format =
+        draw.host_index_format == uint8_t(xenos::IndexFormat::kInt16)
+            ? DXGI_FORMAT_R16_UINT
+            : DXGI_FORMAT_R32_UINT;
+  }
+
+  if (!geometry_cache_hit) {
+    for (size_t i = 0; i < packet.vertex_ranges.size(); ++i) {
+      const auto& source = packet.vertex_ranges[i];
+      deferred_command_list_.D3DCopyBufferRegion(
+          geometry_buffer.Get(), packed_vertex_ranges[i].offset,
+          source.resource.Get(), source.resource_offset, source.size);
+    }
+    if (index_slice) {
+      deferred_command_list_.D3DCopyBufferRegion(
+          geometry_buffer.Get(), index_offset, index_slice->resource.Get(),
+          index_slice->resource_offset, index_slice->size);
+    }
+    const D3D12_RESOURCE_STATES geometry_read_state =
+        D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE |
+        (indexed ? D3D12_RESOURCE_STATE_INDEX_BUFFER :
+                   D3D12_RESOURCE_STATE_COMMON);
+    PushTransitionBarrier(geometry_buffer.Get(), D3D12_RESOURCE_STATE_COPY_DEST,
+                          geometry_read_state);
+    owned_geometry_cache_[geometry_cache_key] = OwnedGeometryCacheEntry{
+        submission_current_, geometry_size, index_offset, geometry_buffer,
+        geometry_descriptor_table};
+  }
+
+  packet.geometry_complete =
+      remapped_fetches != 0 || (nonindexed && !has_vertex_fetches);
+  packet.geometry_protecting_submission = submission_current_;
+  packet.geometry_bytes = geometry_size;
+  packet.geometry_vertex_ranges = uint32_t(packed_vertex_ranges.size());
+  packet.geometry_index_ranges = indexed ? 1 : 0;
+  packet.geometry_remapped_fetches = remapped_fetches;
+  packet.geometry_fetch_constants = remapped_fetch_address;
+  packet.geometry_buffer_address = geometry_buffer->GetGPUVirtualAddress();
+  packet.geometry_descriptor_table = geometry_descriptor_table;
+  packet.geometry_index_view = index_view;
+  if (!REXCVAR_GET(d3d12_doax2_owned_output_continuous) ||
+      !owned_render_group_building_root_packets_ ||
+      (owned_render_group_selected_frame_ % 120) == 0) {
+    REXGPU_INFO(
+      "DOAX2 owned-unit geometry reconstruction: frame={} recipe={:016X} complete={} cache_hit={} cache_entries={} private_buffer_bytes={} vertex_ranges={} index_ranges={} remapped_fetches={} fetch_cbv={:016X} raw_srv_table={:016X} index_gpu={:016X} index_bytes={} distinct_from_guest={} private_descriptor_pair=true protecting_submission={}; persistent private default-heap geometry and descriptors, private fetch addresses, unbound and no second draw",
+      frame_current_, owned_unit_snapshot_.recipe_key, packet.geometry_complete,
+      geometry_cache_hit, owned_geometry_cache_.size(),
+      packet.geometry_bytes, packet.geometry_vertex_ranges,
+      packet.geometry_index_ranges, packet.geometry_remapped_fetches,
+      packet.geometry_fetch_constants, packet.geometry_descriptor_table.ptr,
+      packet.geometry_index_view.BufferLocation,
+      packet.geometry_index_view.SizeInBytes,
+      packet.geometry_buffer_address != shared_memory_->GetGPUAddress(),
+      packet.geometry_protecting_submission);
+  }
+}
+
+void D3D12CommandProcessor::TryCreateOwnedRenderUnitRootPacket() {
+  auto& packet = owned_unit_upload_packet_;
+  if (!owned_unit_snapshot_.complete || !packet.geometry_complete ||
+      packet.root_packet_attempted) {
+    return;
+  }
+  packet.root_packet_attempted = true;
+  const InterpolationDrawBinding& draw = owned_unit_snapshot_.draw;
+  const OwnedRenderStateSnapshot& state = owned_unit_snapshot_.states[1];
+  const bool private_group_sampler_heap =
+      owned_render_group_building_root_packets_ &&
+      owned_render_group_sampler_heap_;
+  const bool sampler_heap_available =
+      private_group_sampler_heap || sampler_bindless_heap_current_;
+  if (!draw.bindless_descriptors || !draw.pipeline_handle ||
+      !draw.root_signature || !sampler_heap_available ||
+      packet.texture_unsigned_indices.size() !=
+          draw.texture_srv_keys_vertex.size() +
+              draw.texture_srv_keys_pixel.size() ||
+      packet.texture_signed_indices.size() !=
+          packet.texture_unsigned_indices.size()) {
+    REXGPU_WARN(
+        "DOAX2 owned-unit root packet rejected: bindless={} pipeline_handle={} root_signature={} sampler_heap={} texture_indices={}/{} expected={}",
+        draw.bindless_descriptors, draw.pipeline_handle != nullptr,
+        draw.root_signature != nullptr,
+        sampler_heap_available,
+        packet.texture_unsigned_indices.size(),
+        packet.texture_signed_indices.size(),
+        draw.texture_srv_keys_vertex.size() +
+            draw.texture_srv_keys_pixel.size());
+    return;
+  }
+
+  packet.pipeline_state =
+      pipeline_cache_->GetD3D12PipelineByHandle(draw.pipeline_handle);
+  packet.root_signature = draw.root_signature;
+  if (!packet.pipeline_state) {
+    REXGPU_WARN(
+        "DOAX2 owned-unit root packet rejected: stage=pipeline_resolution frame={} recipe={:016X}; exact pipeline handle exists but has no compiled D3D12 PSO",
+        frame_current_, owned_unit_snapshot_.recipe_key);
+    return;
+  }
+
+  auto allocate_sampler_indices = [&](const auto& parameters,
+                                      std::vector<uint32_t>& indices) {
+    uint32_t& allocated = private_group_sampler_heap
+                              ? owned_render_group_sampler_allocated_
+                              : sampler_bindless_heap_allocated_;
+    const uint32_t capacity = private_group_sampler_heap
+                                  ? owned_render_group_sampler_capacity_
+                                  : kSamplerHeapSize;
+    const D3D12_CPU_DESCRIPTOR_HANDLE cpu_start =
+        private_group_sampler_heap ? owned_render_group_sampler_cpu_start_
+                                   : sampler_bindless_heap_cpu_start_;
+    if (parameters.size() > size_t(capacity - allocated)) {
+      return false;
+    }
+    indices.reserve(parameters.size());
+    const auto& provider = GetD3D12Provider();
+    for (const D3D12TextureCache::SamplerParameters& sampler : parameters) {
+      const uint32_t index = allocated++;
+      texture_cache_->WriteSampler(
+          sampler, provider.OffsetSamplerDescriptor(
+                       cpu_start, index));
+      indices.push_back(index);
+    }
+    return true;
+  };
+  if (!allocate_sampler_indices(draw.samplers_vertex,
+                                packet.sampler_indices_vertex) ||
+      !allocate_sampler_indices(draw.samplers_pixel,
+                                packet.sampler_indices_pixel)) {
+    REXGPU_WARN(
+        "DOAX2 owned-unit root packet rejected: stage=fresh_samplers requested={} available={}",
+        draw.samplers_vertex.size() + draw.samplers_pixel.size(),
+        (private_group_sampler_heap
+             ? owned_render_group_sampler_capacity_ -
+                   owned_render_group_sampler_allocated_
+             : kSamplerHeapSize - sampler_bindless_heap_allocated_));
+    return;
+  }
+
+  auto build_descriptor_indices = [&](const auto& texture_bindings,
+                                      size_t texture_offset,
+                                      const auto& sampler_bindings,
+                                      const auto& sampler_indices,
+                                      D3D12_GPU_VIRTUAL_ADDRESS& address) {
+    if (texture_bindings.size() + texture_offset >
+            packet.texture_unsigned_indices.size() ||
+        sampler_bindings.size() != sampler_indices.size()) {
+      return false;
+    }
+    uint32_t count = 1;
+    for (const auto& binding : texture_bindings)
+      count = std::max(count, binding.bindless_descriptor_index + 1);
+    for (const auto& binding : sampler_bindings)
+      count = std::max(count, binding.bindless_descriptor_index + 1);
+    uint32_t* values = reinterpret_cast<uint32_t*>(constant_buffer_pool_->Request(
+        frame_current_, size_t(count) * sizeof(uint32_t),
+        D3D12_CONSTANT_BUFFER_DATA_PLACEMENT_ALIGNMENT, nullptr, nullptr,
+        &address));
+    if (!values) return false;
+    std::fill_n(values, count, 0);
+    for (size_t i = 0; i < texture_bindings.size(); ++i) {
+      const auto& binding = texture_bindings[i];
+      const uint32_t absolute_index =
+          binding.is_signed
+              ? packet.texture_signed_indices[texture_offset + i]
+              : packet.texture_unsigned_indices[texture_offset + i];
+      uint32_t resolved_index = absolute_index;
+      if (resolved_index == UINT32_MAX) {
+        // Match the normal bindless path exactly for an invalid/incompatible
+        // or unavailable signed view. Null descriptors are immutable system
+        // descriptors, not references retained from the native draw.
+        switch (binding.dimension) {
+          case xenos::FetchOpDimension::k3DOrStacked:
+            resolved_index =
+                uint32_t(SystemBindlessView::kNullTexture3D);
+            break;
+          case xenos::FetchOpDimension::kCube:
+            resolved_index =
+                uint32_t(SystemBindlessView::kNullTextureCube);
+            break;
+          default:
+            resolved_index =
+                uint32_t(SystemBindlessView::kNullTexture2DArray);
+            break;
+        }
+      }
+      values[binding.bindless_descriptor_index] =
+          resolved_index -
+          uint32_t(SystemBindlessView::kUnboundedSRVsStart);
+    }
+    for (size_t i = 0; i < sampler_bindings.size(); ++i)
+      values[sampler_bindings[i].bindless_descriptor_index] =
+          sampler_indices[i];
+    packet.total_bytes += size_t(count) * sizeof(uint32_t);
+    return true;
+  };
+  if (!build_descriptor_indices(
+          draw.texture_bindings_vertex, 0, draw.sampler_bindings_vertex,
+          packet.sampler_indices_vertex, packet.descriptor_indices_vertex) ||
+      !build_descriptor_indices(
+          draw.texture_bindings_pixel, draw.texture_bindings_vertex.size(),
+          draw.sampler_bindings_pixel, packet.sampler_indices_pixel,
+          packet.descriptor_indices_pixel)) {
+    REXGPU_WARN(
+        "DOAX2 owned-unit root packet rejected: stage=descriptor_index_cbvs vertex_bindings={}/{} pixel_bindings={}/{} texture_indices={}",
+        draw.texture_bindings_vertex.size(),
+        draw.sampler_bindings_vertex.size(),
+        draw.texture_bindings_pixel.size(),
+        draw.sampler_bindings_pixel.size(),
+        packet.texture_unsigned_indices.size());
+    return;
+  }
+
+  if (draw.host_vertex_shader_type !=
+      uint8_t(Shader::HostVertexShaderType::kVertex)) {
+    switch (xenos::PrimitiveType(draw.host_primitive_type)) {
+      case xenos::PrimitiveType::kTriangleList:
+        packet.primitive_topology =
+            D3D_PRIMITIVE_TOPOLOGY_3_CONTROL_POINT_PATCHLIST;
+        break;
+      case xenos::PrimitiveType::kQuadList:
+        packet.primitive_topology =
+            D3D_PRIMITIVE_TOPOLOGY_4_CONTROL_POINT_PATCHLIST;
+        break;
+      case xenos::PrimitiveType::kTrianglePatch:
+        packet.primitive_topology =
+            draw.tessellation_mode == uint8_t(xenos::TessellationMode::kAdaptive)
+                ? D3D_PRIMITIVE_TOPOLOGY_3_CONTROL_POINT_PATCHLIST
+                : D3D_PRIMITIVE_TOPOLOGY_1_CONTROL_POINT_PATCHLIST;
+        break;
+      case xenos::PrimitiveType::kQuadPatch:
+        packet.primitive_topology =
+            draw.tessellation_mode == uint8_t(xenos::TessellationMode::kAdaptive)
+                ? D3D_PRIMITIVE_TOPOLOGY_4_CONTROL_POINT_PATCHLIST
+                : D3D_PRIMITIVE_TOPOLOGY_1_CONTROL_POINT_PATCHLIST;
+        break;
+      default:
+        return;
+    }
+  } else {
+    switch (xenos::PrimitiveType(draw.host_primitive_type)) {
+      case xenos::PrimitiveType::kPointList:
+        packet.primitive_topology = D3D_PRIMITIVE_TOPOLOGY_POINTLIST;
+        break;
+      case xenos::PrimitiveType::kLineList:
+        packet.primitive_topology = D3D_PRIMITIVE_TOPOLOGY_LINELIST;
+        break;
+      case xenos::PrimitiveType::kLineStrip:
+        packet.primitive_topology = D3D_PRIMITIVE_TOPOLOGY_LINESTRIP;
+        break;
+      case xenos::PrimitiveType::kTriangleList:
+      case xenos::PrimitiveType::kRectangleList:
+        packet.primitive_topology = D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST;
+        break;
+      case xenos::PrimitiveType::kTriangleStrip:
+        packet.primitive_topology = D3D_PRIMITIVE_TOPOLOGY_TRIANGLESTRIP;
+        break;
+      case xenos::PrimitiveType::kQuadList:
+        packet.primitive_topology = D3D_PRIMITIVE_TOPOLOGY_LINELIST_ADJ;
+        break;
+      default:
+        return;
+    }
+  }
+  packet.viewport = state.viewport;
+  packet.scissor = state.scissor;
+  packet.blend_factor = state.blend_factor;
+  packet.stencil_reference = state.stencil_reference;
+  packet.sampler_heap = private_group_sampler_heap
+                            ? owned_render_group_sampler_gpu_start_
+                            : sampler_bindless_heap_gpu_start_;
+  packet.view_heap = view_bindless_heap_gpu_start_;
+  packet.root_packet_complete =
+      packet.midpoint_constants && packet.pixel_constants &&
+      packet.system_constants && packet.bool_loop_constants &&
+      packet.geometry_fetch_constants && packet.descriptor_indices_vertex &&
+      packet.descriptor_indices_pixel && packet.geometry_descriptor_table.ptr &&
+      packet.sampler_heap.ptr && packet.view_heap.ptr &&
+      packet.primitive_topology != D3D_PRIMITIVE_TOPOLOGY_UNDEFINED;
+  if (!REXCVAR_GET(d3d12_doax2_owned_output_continuous) ||
+      !owned_render_group_building_root_packets_ ||
+      (owned_render_group_selected_frame_ % 120) == 0) {
+    REXGPU_INFO(
+      "DOAX2 owned-unit root packet: frame={} recipe={:016X} complete={} pso={} root_signature={} root_cbvs=7 vertex_textures={} pixel_textures={} vertex_samplers={} pixel_samplers={} private_texture_indices={} private_sampler_indices={} raw_geometry_table={:016X} sampler_heap={:016X} view_heap={:016X} topology={} viewport={}x{} scissor={}x{} rt_bits={:02X} rt_formats={:08X}/{:08X}/{:08X}/{:08X}/{:08X} protecting_submission={}; complete fresh binding description, unbound and no second draw",
+      frame_current_, owned_unit_snapshot_.recipe_key,
+      packet.root_packet_complete, packet.pipeline_state != nullptr,
+      packet.root_signature != nullptr, draw.texture_bindings_vertex.size(),
+      draw.texture_bindings_pixel.size(), draw.sampler_bindings_vertex.size(),
+      draw.sampler_bindings_pixel.size(),
+      packet.texture_unsigned_indices.size(),
+      packet.sampler_indices_vertex.size() +
+          packet.sampler_indices_pixel.size(),
+      packet.geometry_descriptor_table.ptr, packet.sampler_heap.ptr,
+      packet.view_heap.ptr, uint32_t(packet.primitive_topology),
+      packet.viewport.Width, packet.viewport.Height,
+      packet.scissor.right - packet.scissor.left,
+      packet.scissor.bottom - packet.scissor.top,
+      draw.bound_render_target_bits, draw.bound_render_target_formats[0],
+      draw.bound_render_target_formats[1],
+      draw.bound_render_target_formats[2],
+      draw.bound_render_target_formats[3],
+      draw.bound_render_target_formats[4], submission_current_);
+  }
+}
+
+void D3D12CommandProcessor::TryCreateOwnedRenderUnitOutput() {
+  auto& packet = owned_unit_upload_packet_;
+  if (!packet.root_packet_complete || packet.output_attempted) return;
+  packet.output_attempted = true;
+  const InterpolationDrawBinding& draw = owned_unit_snapshot_.draw;
+  // The composite may bind color target 0 without depth. Never provide it an
+  // inherited DSV; both supported paths own every attachment they bind.
+  const bool has_depth = draw.bound_render_target_bits == 0x3;
+  if (!has_depth && draw.bound_render_target_bits != 0x2) {
+    REXGPU_WARN(
+        "DOAX2 owned-unit output rejected: rt_bits={:02X}; isolated boundary supports color target 0 with optional depth only",
+        draw.bound_render_target_bits);
+    return;
+  }
+  packet.output_width = uint32_t(std::ceil(packet.viewport.Width));
+  packet.output_height = uint32_t(std::ceil(packet.viewport.Height));
+  if (!packet.output_width || !packet.output_height ||
+      packet.output_width > D3D12_REQ_TEXTURE2D_U_OR_V_DIMENSION ||
+      packet.output_height > D3D12_REQ_TEXTURE2D_U_OR_V_DIMENSION) {
+    return;
+  }
+  reg::RB_SURFACE_INFO surface_info{};
+  surface_info.value = owned_unit_snapshot_.states[1]
+                           .registers[XE_GPU_REG_RB_SURFACE_INFO];
+  packet.output_samples = uint32_t(1) << uint32_t(surface_info.msaa_samples);
+  if (packet.output_samples == 2 &&
+      !render_target_cache_->msaa_2x_supported()) {
+    packet.output_samples = 4;
+  }
+  const auto color_format = xenos::ColorRenderTargetFormat(
+      draw.bound_render_target_formats[1]);
+  const auto depth_format = xenos::DepthRenderTargetFormat(
+      draw.bound_render_target_formats[0]);
+  packet.output_color_format =
+      render_target_cache_->GetColorDrawDXGIFormat(color_format);
+  packet.output_depth_format = has_depth
+      ? D3D12RenderTargetCache::GetDepthDSVDXGIFormat(depth_format)
+      : DXGI_FORMAT_UNKNOWN;
+  const DXGI_FORMAT depth_resource_format = has_depth
+      ? D3D12RenderTargetCache::GetDepthResourceDXGIFormat(depth_format)
+      : DXGI_FORMAT_UNKNOWN;
+  if (packet.output_color_format == DXGI_FORMAT_UNKNOWN ||
+      (has_depth && (packet.output_depth_format == DXGI_FORMAT_UNKNOWN ||
+                     depth_resource_format == DXGI_FORMAT_UNKNOWN))) {
+    return;
+  }
+
+  ID3D12Device* device = GetD3D12Provider().GetDevice();
+  D3D12_DESCRIPTOR_HEAP_DESC heap_desc{};
+  heap_desc.NumDescriptors = 1;
+  heap_desc.Type = D3D12_DESCRIPTOR_HEAP_TYPE_RTV;
+  if (FAILED(device->CreateDescriptorHeap(
+          &heap_desc, IID_PPV_ARGS(&packet.output_rtv_heap)))) {
+    return;
+  }
+  if (has_depth) {
+    heap_desc.Type = D3D12_DESCRIPTOR_HEAP_TYPE_DSV;
+    if (FAILED(device->CreateDescriptorHeap(
+            &heap_desc, IID_PPV_ARGS(&packet.output_dsv_heap)))) {
+      return;
+    }
+  }
+
+  D3D12_RESOURCE_DESC resource_desc{};
+  resource_desc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+  resource_desc.Width = packet.output_width;
+  resource_desc.Height = packet.output_height;
+  resource_desc.DepthOrArraySize = 1;
+  resource_desc.MipLevels = 1;
+  resource_desc.SampleDesc.Count = packet.output_samples;
+  resource_desc.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+  resource_desc.Format = packet.output_color_format;
+  resource_desc.Flags = D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET;
+  D3D12_CLEAR_VALUE color_clear{};
+  color_clear.Format = packet.output_color_format;
+  const auto& provider = GetD3D12Provider();
+  if (FAILED(device->CreateCommittedResource(
+          &ui::d3d12::util::kHeapPropertiesDefault,
+          provider.GetHeapFlagCreateNotZeroed(), &resource_desc,
+          D3D12_RESOURCE_STATE_RENDER_TARGET, &color_clear,
+          IID_PPV_ARGS(&packet.output_color_resource)))) {
+    return;
+  }
+  const D3D12_CPU_DESCRIPTOR_HANDLE rtv =
+      packet.output_rtv_heap->GetCPUDescriptorHandleForHeapStart();
+  device->CreateRenderTargetView(packet.output_color_resource.Get(), nullptr,
+                                 rtv);
+
+  if (has_depth) {
+    resource_desc.Format = depth_resource_format;
+    resource_desc.Flags = D3D12_RESOURCE_FLAG_ALLOW_DEPTH_STENCIL;
+    D3D12_CLEAR_VALUE depth_clear{};
+    depth_clear.Format = packet.output_depth_format;
+    depth_clear.DepthStencil.Depth =
+        depth_format == xenos::DepthRenderTargetFormat::kD24S8 ? 1.0f : 0.0f;
+    if (FAILED(device->CreateCommittedResource(
+            &ui::d3d12::util::kHeapPropertiesDefault,
+            provider.GetHeapFlagCreateNotZeroed(), &resource_desc,
+            D3D12_RESOURCE_STATE_DEPTH_WRITE, &depth_clear,
+            IID_PPV_ARGS(&packet.output_depth_resource)))) {
+      return;
+    }
+    const D3D12_CPU_DESCRIPTOR_HANDLE dsv =
+        packet.output_dsv_heap->GetCPUDescriptorHandleForHeapStart();
+    D3D12_DEPTH_STENCIL_VIEW_DESC dsv_desc{};
+    dsv_desc.Format = packet.output_depth_format;
+    dsv_desc.ViewDimension = packet.output_samples > 1
+                                 ? D3D12_DSV_DIMENSION_TEXTURE2DMS
+                                 : D3D12_DSV_DIMENSION_TEXTURE2D;
+    device->CreateDepthStencilView(packet.output_depth_resource.Get(),
+                                   &dsv_desc, dsv);
+    deferred_command_list_.D3DClearDepthStencilView(
+        dsv, D3D12_CLEAR_FLAG_DEPTH | D3D12_CLEAR_FLAG_STENCIL,
+        depth_clear.DepthStencil.Depth, 0, 0, nullptr);
+  }
+
+  const float transparent_black[4] = {};
+  deferred_command_list_.D3DClearRenderTargetView(
+      rtv, transparent_black, 0, nullptr);
+  packet.output_color_identity =
+      reinterpret_cast<uintptr_t>(packet.output_color_resource.Get());
+  packet.output_depth_identity =
+      reinterpret_cast<uintptr_t>(packet.output_depth_resource.Get());
+  packet.output_protecting_submission = submission_current_;
+  packet.output_complete = packet.output_color_resource &&
+                           (!has_depth ||
+                            (packet.output_depth_resource &&
+                             packet.output_color_resource.Get() !=
+                                 packet.output_depth_resource.Get()));
+  if (!REXCVAR_GET(d3d12_doax2_owned_output_continuous) ||
+      (owned_render_group_selected_frame_ % 120) == 0) {
+    REXGPU_INFO(
+      "DOAX2 owned-unit private output: frame={} recipe={:016X} complete={} size={}x{} samples={} color_dxgi={} depth_dxgi={} color_identity={:016X} depth_identity={:016X} distinct_resources={} protecting_submission={}; fresh RTV/DSV heaps and independently backed attachments cleared through the live command list, not bound to a draw and not presented",
+      frame_current_, owned_unit_snapshot_.recipe_key, packet.output_complete,
+      packet.output_width, packet.output_height, packet.output_samples,
+      uint32_t(packet.output_color_format),
+      uint32_t(packet.output_depth_format), packet.output_color_identity,
+      packet.output_depth_identity,
+      packet.output_color_identity != packet.output_depth_identity,
+      packet.output_protecting_submission);
+  }
+}
+
+void D3D12CommandProcessor::TryDrawOwnedRenderUnit() {
+  auto& packet = owned_unit_upload_packet_;
+  if (!packet.output_complete || packet.draw_attempted) return;
+  packet.draw_attempted = true;
+  const InterpolationDrawBinding& draw = owned_unit_snapshot_.draw;
+  const bool has_depth = draw.bound_render_target_bits == 0x3;
+  if (!submission_open_ || !bindless_resources_used_ ||
+      draw.shader_side_effects || !packet.output_color_resource ||
+      (has_depth && (!packet.output_depth_resource ||
+                     !packet.output_dsv_heap)) ||
+      !packet.output_rtv_heap || !view_bindless_heap_ ||
+      !sampler_bindless_heap_current_ || !draw.host_draw_vertex_count ||
+      (draw.index_buffer_type == uint8_t(PrimitiveProcessor::kGuestDMA) &&
+       packet.geometry_index_view.SizeInBytes == 0) ||
+      (draw.index_buffer_type != uint8_t(PrimitiveProcessor::kGuestDMA) &&
+       draw.index_buffer_type != uint8_t(PrimitiveProcessor::kNone))) {
+    REXGPU_WARN(
+        "DOAX2 owned-unit draw rejected: submission_open={} bindless={} side_effects={} color={} depth={} heaps={} draw_vertices={} index_bytes={}",
+        submission_open_, bindless_resources_used_, draw.shader_side_effects,
+        packet.output_color_resource != nullptr,
+        packet.output_depth_resource != nullptr,
+        packet.output_rtv_heap != nullptr &&
+            (!has_depth || packet.output_dsv_heap != nullptr),
+        draw.host_draw_vertex_count, packet.geometry_index_view.SizeInBytes);
+    return;
+  }
+  if (packet.output_samples != 1 ||
+      packet.output_color_format != DXGI_FORMAT_R8G8B8A8_UNORM) {
+    REXGPU_WARN(
+        "DOAX2 owned-unit draw rejected: first color proof requires single-sample R8G8B8A8 output, samples={} format={}",
+        packet.output_samples, uint32_t(packet.output_color_format));
+    return;
+  }
+
+  ID3D12Device* device = GetD3D12Provider().GetDevice();
+  D3D12_QUERY_HEAP_DESC query_heap_desc{};
+  query_heap_desc.Type = D3D12_QUERY_HEAP_TYPE_PIPELINE_STATISTICS;
+  query_heap_desc.Count = 1;
+  D3D12_RESOURCE_DESC query_readback_desc{};
+  query_readback_desc.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+  query_readback_desc.Width = sizeof(D3D12_QUERY_DATA_PIPELINE_STATISTICS);
+  query_readback_desc.Height = 1;
+  query_readback_desc.DepthOrArraySize = 1;
+  query_readback_desc.MipLevels = 1;
+  query_readback_desc.SampleDesc.Count = 1;
+  query_readback_desc.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+  if (FAILED(device->CreateQueryHeap(
+          &query_heap_desc,
+          IID_PPV_ARGS(&packet.draw_statistics_heap))) ||
+      FAILED(device->CreateCommittedResource(
+          &ui::d3d12::util::kHeapPropertiesReadback, D3D12_HEAP_FLAG_NONE,
+          &query_readback_desc, D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+          IID_PPV_ARGS(&packet.draw_statistics_readback)))) {
+    packet.draw_statistics_heap.Reset();
+    packet.draw_statistics_readback.Reset();
+    REXGPU_WARN(
+        "DOAX2 owned-unit draw rejected: private pipeline-statistics allocation failed");
+    return;
+  }
+  const D3D12_RESOURCE_DESC color_desc =
+      packet.output_color_resource->GetDesc();
+  device->GetCopyableFootprints(
+      &color_desc, 0, 1, 0, &packet.color_readback_footprint,
+      &packet.color_readback_rows, &packet.color_readback_row_size,
+      &packet.color_readback_size);
+  D3D12_RESOURCE_DESC color_readback_desc{};
+  color_readback_desc.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+  color_readback_desc.Width = packet.color_readback_size;
+  color_readback_desc.Height = 1;
+  color_readback_desc.DepthOrArraySize = 1;
+  color_readback_desc.MipLevels = 1;
+  color_readback_desc.SampleDesc.Count = 1;
+  color_readback_desc.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+  if (!packet.color_readback_size ||
+      FAILED(device->CreateCommittedResource(
+          &ui::d3d12::util::kHeapPropertiesReadback, D3D12_HEAP_FLAG_NONE,
+          &color_readback_desc, D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+          IID_PPV_ARGS(&packet.color_readback)))) {
+    packet.color_readback.Reset();
+    REXGPU_WARN(
+        "DOAX2 owned-unit draw rejected: private color readback allocation failed");
+    return;
+  }
+
+  // Geometry copies and their transition were recorded while constructing the
+  // packet. Flush the pending barrier here so it executes before this draw.
+  SubmitBarriers();
+
+  const D3D12_CPU_DESCRIPTOR_HANDLE rtv =
+      packet.output_rtv_heap->GetCPUDescriptorHandleForHeapStart();
+  const D3D12_CPU_DESCRIPTOR_HANDLE dsv = has_depth
+      ? packet.output_dsv_heap->GetCPUDescriptorHandleForHeapStart()
+      : D3D12_CPU_DESCRIPTOR_HANDLE{};
+  deferred_command_list_.SetDescriptorHeaps(view_bindless_heap_,
+                                             sampler_bindless_heap_current_);
+  deferred_command_list_.D3DSetPipelineState(packet.pipeline_state);
+  deferred_command_list_.D3DSetGraphicsRootSignature(packet.root_signature);
+  deferred_command_list_.D3DSetGraphicsRootConstantBufferView(
+      kRootParameter_Bindless_FetchConstants,
+      packet.geometry_fetch_constants);
+  deferred_command_list_.D3DSetGraphicsRootConstantBufferView(
+      kRootParameter_Bindless_FloatConstantsVertex,
+      packet.midpoint_constants);
+  deferred_command_list_.D3DSetGraphicsRootConstantBufferView(
+      kRootParameter_Bindless_FloatConstantsPixel, packet.pixel_constants);
+  deferred_command_list_.D3DSetGraphicsRootConstantBufferView(
+      kRootParameter_Bindless_DescriptorIndicesPixel,
+      packet.descriptor_indices_pixel);
+  deferred_command_list_.D3DSetGraphicsRootConstantBufferView(
+      kRootParameter_Bindless_DescriptorIndicesVertex,
+      packet.descriptor_indices_vertex);
+  deferred_command_list_.D3DSetGraphicsRootConstantBufferView(
+      kRootParameter_Bindless_SystemConstants, packet.system_constants);
+  deferred_command_list_.D3DSetGraphicsRootConstantBufferView(
+      kRootParameter_Bindless_BoolLoopConstants,
+      packet.bool_loop_constants);
+  deferred_command_list_.D3DSetGraphicsRootDescriptorTable(
+      kRootParameter_Bindless_SharedMemory,
+      packet.geometry_descriptor_table);
+  deferred_command_list_.D3DSetGraphicsRootDescriptorTable(
+      kRootParameter_Bindless_SamplerHeap, packet.sampler_heap);
+  deferred_command_list_.D3DSetGraphicsRootDescriptorTable(
+      kRootParameter_Bindless_ViewHeap, packet.view_heap);
+  deferred_command_list_.D3DOMSetRenderTargets(
+      1, &rtv, FALSE, has_depth ? &dsv : nullptr);
+  deferred_command_list_.RSSetViewport(packet.viewport);
+  deferred_command_list_.RSSetScissorRect(packet.scissor);
+  deferred_command_list_.D3DOMSetBlendFactor(packet.blend_factor.data());
+  deferred_command_list_.D3DOMSetStencilRef(packet.stencil_reference);
+  deferred_command_list_.D3DIASetPrimitiveTopology(packet.primitive_topology);
+  deferred_command_list_.D3DBeginQuery(packet.draw_statistics_heap.Get(),
+                                       D3D12_QUERY_TYPE_PIPELINE_STATISTICS, 0);
+  if (draw.index_buffer_type == uint8_t(PrimitiveProcessor::kGuestDMA)) {
+    deferred_command_list_.D3DIASetIndexBuffer(&packet.geometry_index_view);
+    deferred_command_list_.D3DDrawIndexedInstanced(
+        draw.host_draw_vertex_count, 1, 0, 0, 0);
+  } else {
+    deferred_command_list_.D3DIASetIndexBuffer(nullptr);
+    deferred_command_list_.D3DDrawInstanced(
+        draw.host_draw_vertex_count, 1, 0, 0);
+  }
+  deferred_command_list_.D3DEndQuery(packet.draw_statistics_heap.Get(),
+                                     D3D12_QUERY_TYPE_PIPELINE_STATISTICS, 0);
+  deferred_command_list_.D3DResolveQueryData(
+      packet.draw_statistics_heap.Get(), D3D12_QUERY_TYPE_PIPELINE_STATISTICS,
+      0, 1, packet.draw_statistics_readback.Get(), 0);
+  PushTransitionBarrier(packet.output_color_resource.Get(),
+                        D3D12_RESOURCE_STATE_RENDER_TARGET,
+                        D3D12_RESOURCE_STATE_COPY_SOURCE);
+  SubmitBarriers();
+  D3D12_TEXTURE_COPY_LOCATION color_copy_destination{};
+  color_copy_destination.pResource = packet.color_readback.Get();
+  color_copy_destination.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+  color_copy_destination.PlacedFootprint = packet.color_readback_footprint;
+  D3D12_TEXTURE_COPY_LOCATION color_copy_source{};
+  color_copy_source.pResource = packet.output_color_resource.Get();
+  color_copy_source.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+  color_copy_source.SubresourceIndex = 0;
+  deferred_command_list_.D3DCopyTextureRegion(
+      &color_copy_destination, 0, 0, 0, &color_copy_source, nullptr);
+  packet.draw_recorded = true;
+  packet.draw_submission = submission_current_;
+
+  // Close immediately after the isolated draw. IssueSwap will open a fresh
+  // command list, resetting ReXGlue's cached native bindings before normal
+  // output routing. This prevents the private PSO, roots and targets from
+  // leaking into the native renderer.
+  packet.draw_submitted = EndSubmission(false);
+  if (packet.draw_submitted) {
+    packet.draw_statistics_pending = true;
+    packet.color_readback_pending = true;
+    packet.output_protecting_submission = packet.draw_submission;
+    resources_for_deletion_.emplace_back(
+        packet.draw_submission, packet.output_color_resource.Detach());
+    if (has_depth) {
+      resources_for_deletion_.emplace_back(
+          packet.draw_submission, packet.output_depth_resource.Detach());
+    }
+  }
+  REXGPU_INFO(
+      "DOAX2 owned-unit isolated draw: frame={} recipe={:016X} recorded={} submitted={} draw_vertices={} index_bytes={} midpoint_cbv={:016X} color_identity={:016X} depth_identity={:016X} submission={}; one fresh reconstructed draw into private attachments, not resolved or presented, no simulation tick",
+      frame_current_, owned_unit_snapshot_.recipe_key, packet.draw_recorded,
+      packet.draw_submitted, draw.host_draw_vertex_count,
+      packet.geometry_index_view.SizeInBytes, packet.midpoint_constants,
+      packet.output_color_identity, packet.output_depth_identity,
+      packet.draw_submission);
+  if (packet.draw_submitted) {
+    uint32_t free_bank = uint32_t(owned_unit_in_flight_banks_.size());
+    for (uint32_t bank_index = 0;
+         bank_index < owned_unit_in_flight_banks_.size(); ++bank_index) {
+      if (!owned_unit_in_flight_banks_[bank_index].occupied) {
+        free_bank = bank_index;
+        break;
+      }
+    }
+    if (free_bank == owned_unit_in_flight_banks_.size()) {
+      REXGPU_ERROR(
+          "DOAX2 owned-unit bank invariant failed: submitted unit has no free ownership bank; reconstruction is halted rather than releasing a live packet");
+      return;
+    }
+    auto& bank = owned_unit_in_flight_banks_[free_bank];
+    bool other_bank_occupied = false;
+    bool other_bank_fence_pending = false;
+    bool backing_distinct = true;
+    for (uint32_t bank_index = 0;
+         bank_index < owned_unit_in_flight_banks_.size(); ++bank_index) {
+      if (bank_index == free_bank ||
+          !owned_unit_in_flight_banks_[bank_index].occupied) {
+        continue;
+      }
+      const auto& other = owned_unit_in_flight_banks_[bank_index];
+      other_bank_occupied = true;
+      other_bank_fence_pending |=
+          other.packet.draw_submission > submission_completed_;
+      backing_distinct &=
+          packet.output_color_identity != other.packet.output_color_identity &&
+          (!packet.output_depth_identity || !other.packet.output_depth_identity ||
+           packet.output_depth_identity != other.packet.output_depth_identity) &&
+          packet.color_readback.Get() != other.packet.color_readback.Get() &&
+          packet.draw_statistics_readback.Get() !=
+              other.packet.draw_statistics_readback.Get();
+    }
+    ++bank.generation;
+    bank.occupied = true;
+    bank.snapshot = std::move(owned_unit_snapshot_);
+    bank.packet = std::move(owned_unit_upload_packet_);
+    ++owned_unit_dynamic_submissions_;
+    REXGPU_INFO(
+        "DOAX2 owned-unit bank acquired: bank={} generation={} submitted_cycle={} submission={} color_identity={:016X} depth_identity={:016X} other_bank_occupied={} other_bank_fence_pending={} backing_distinct={}; packet ownership transferred after submission and cannot be reused before its observed fence",
+        free_bank, bank.generation, owned_unit_dynamic_submissions_,
+        bank.packet.draw_submission, bank.packet.output_color_identity,
+        bank.packet.output_depth_identity, other_bank_occupied,
+        other_bank_fence_pending, backing_distinct);
+    owned_unit_snapshot_ = {};
+    owned_unit_upload_packet_ = {};
+    owned_unit_snapshot_target_recipe_ = 0;
+
+    bool another_bank_free = false;
+    for (const auto& candidate_bank : owned_unit_in_flight_banks_) {
+      another_bank_free |= !candidate_bank.occupied;
+    }
+    if (owned_unit_dynamic_submissions_ < 4 && another_bank_free) {
+      owned_unit_snapshot_target_recipe_ = bank.snapshot.recipe_key;
+      owned_unit_snapshot_selected_frame_ = doax2_transform_trace_swap_serial;
+      REXGPU_INFO(
+          "DOAX2 owned-unit two-bank immediate rearm: submitted_cycles={} completed_proofs={} target_recipe={:016X} current_frame={}; next adjacent pair may be built without releasing the submitted bank",
+          owned_unit_dynamic_submissions_, owned_unit_dynamic_proofs_,
+          bank.snapshot.recipe_key, doax2_transform_trace_swap_serial);
+    }
+  }
+}
