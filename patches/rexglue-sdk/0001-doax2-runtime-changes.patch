+DeferredCommandList::GraphicsOnlyReplayResult DeferredCommandList::ExecuteGraphicsOnly(
+    ID3D12GraphicsCommandList* command_list, ID3D12GraphicsCommandList1* command_list_1,
+    const GraphicsOnlyReplayOptions& options) {
+  GraphicsOnlyReplayResult result;
+  if (!options.render_target_overrides || options.render_target_overrides->empty()) return result;
+  auto find_target = [&](D3D12_CPU_DESCRIPTOR_HANDLE source, bool depth)
+      -> const GraphicsRenderTargetOverride* {
+    for (const auto& target : *options.render_target_overrides) {
+      if (target.is_depth == depth && target.source.ptr == source.ptr) return &target;
+    }
+    return nullptr;
+  };
+  // Private targets have no inherited contents. Clear only their descriptors;
+  // no operation in this path is permitted to reference a native target.
+  const FLOAT black[4] = {};
