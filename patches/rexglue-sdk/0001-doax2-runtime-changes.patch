+          ? shared_memory_->DescribeRangeOrigin(key.GetGuestBaseAddress(),
+                                                key.GetGuestBaseSize())
+          : SharedMemory::RangeOrigin{};
+      const bool tracked_version_edge =
+          producer_resolve != SIZE_MAX && available &&
+          uploaded_after_producer && !info.outdated_mask &&
+          !prior_memexport_draws &&
+          !interpolation_frame_recording_.audit_missing_vertex_constants &&
+          origin.valid_range && origin.pages &&
+          origin.valid_pages == origin.pages &&
+          origin.gpu_written_pages == origin.pages &&
+          desc.Dimension == D3D12_RESOURCE_DIMENSION_TEXTURE2D &&
+          desc.Format == DXGI_FORMAT_R8G8B8A8_TYPELESS &&
+          desc.Width == 1280 && desc.Height == 720 &&
+          desc.DepthOrArraySize == 1 && desc.MipLevels == 1 &&
+          desc.SampleDesc.Count == 1 &&
+          desc.Flags == D3D12_RESOURCE_FLAG_NONE;
+      const bool tracked_regional_version_edge = regional_read.complete &&
+          regional_uploaded_after_all && regional_single_source_owner &&
+          available && !info.outdated_mask && !prior_memexport_draws &&
+          !interpolation_frame_recording_.audit_missing_vertex_constants &&
+          origin.valid_range && origin.pages &&
+          origin.valid_pages == origin.pages &&
+          origin.gpu_written_pages == origin.pages &&
+          desc.Dimension == D3D12_RESOURCE_DIMENSION_TEXTURE2D &&
+          desc.Format == DXGI_FORMAT_R8G8B8A8_TYPELESS &&
+          desc.Width == 1280 && desc.Height == 720 &&
+          desc.DepthOrArraySize == 1 && desc.MipLevels == 1 &&
+          desc.SampleDesc.Count == 1 &&
+          desc.Flags == D3D12_RESOURCE_FLAG_NONE;
+      REXGPU_INFO(
+          "DOAX2 decoded texture producer candidate: frame={} ordinal={} fetch={} guest_base={:08X} binding_bytes={} exact_binding_layout={} overlapping_resolves={} producer_event={} producer_serial={} native_identity={:016X} active_available={} base_load_generation={} base_load_serial_before_producer={} active_base_load_serial={} uploaded_after_producer={} outdated_mask={} origin_valid={} pages={} valid_pages={} gpu_written_pages={} prior_memexport_draws={} tracked_version_edge={} scope=exact_full_rgba8_D3D12_shared_memory no_private_frame=true",
+          doax2_transform_trace_swap_serial + 1,
+          interpolation_frame_recording_.draws.size(), fetch_index,
+          key.GetGuestBaseAddress(), key.GetGuestBaseSize(),
+          exact_binding_layout, overlapping_resolves, producer_resolve,
+          producer_serial, info.identity, available,
+          info.base_load_generation, base_load_serial_before_producer,
+          info.last_base_load_serial, uploaded_after_producer,
+          info.outdated_mask,
+          origin.valid_range, origin.pages, origin.valid_pages,
+          origin.gpu_written_pages, prior_memexport_draws,
+          tracked_version_edge);
+      REXGPU_INFO(
+          "DOAX2 decoded texture regional candidate: frame={} ordinal={} guest_base={:08X} regional_writes={} unsupported_overlaps={} complete={} missing_pixels={} producer_versions=[{}] uploaded_after_all={} single_source_owner={} tracked_regional_version_edge={} native_available={} origin_gpu_pages={}/{} no_private_frame=true publishable=false",
+          doax2_transform_trace_swap_serial + 1,
+          interpolation_frame_recording_.draws.size(),
+          key.GetGuestBaseAddress(), regional_writes,
+          regional_unsupported, regional_read.complete,
+          regional_read.missing_pixels,
+          regional_versions_text.str(), regional_uploaded_after_all,
+          regional_single_source_owner, tracked_regional_version_edge,
+          available, origin.gpu_written_pages, origin.pages);
+      REXGPU_INFO(
+          "DOAX2 candidate audit composite source: frame={} ordinal={} fetch={} guest_base={:08X} native_resource_available={} native_identity={:016X} dimension={} format={} width={} height={} depth_or_array={} mips={} samples={} state={} signed_separate={}; read-only identity, never retained, no ownership claim",
+          doax2_transform_trace_swap_serial + 1,
+          interpolation_frame_recording_.draws.size(), fetch_index,
+          key.GetGuestBaseAddress(), available, info.identity,
+          uint32_t(desc.Dimension), uint32_t(desc.Format), desc.Width,
+          desc.Height, desc.DepthOrArraySize, desc.MipLevels,
+          desc.SampleDesc.Count, uint32_t(info.state),
