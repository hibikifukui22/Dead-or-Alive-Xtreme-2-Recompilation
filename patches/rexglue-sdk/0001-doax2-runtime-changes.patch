+      case Command::kD3DSetGraphicsRootConstantBufferView: {
+        const auto& a = *reinterpret_cast<const SetRootConstantBufferViewArguments*>(stream);
+        D3D12_GPU_VIRTUAL_ADDRESS address = a.buffer_location;
+        if (options.constant_buffer_overrides) {
+          for (const auto& override_binding : *options.constant_buffer_overrides) {
