+bool DrawWritesColorOpaquely(const RegisterFile& regs, const Shader* pixel_shader,
+                             uint32_t normalized_color_mask) {
+  if (!pixel_shader || !normalized_color_mask || pixel_shader->kills_pixels() ||
+      pixel_shader->writes_depth()) {
+    return false;
+  }
+  auto rb_colorcontrol = regs.Get<reg::RB_COLORCONTROL>();
+  if ((rb_colorcontrol.alpha_test_enable &&
+       rb_colorcontrol.alpha_func != xenos::CompareFunction::kAlways) ||
+      rb_colorcontrol.alpha_to_mask_enable) {
+    return false;
+  }
+  auto pa_su_sc_mode_cntl = regs.Get<reg::PA_SU_SC_MODE_CNTL>();
+  if (pa_su_sc_mode_cntl.cull_front || pa_su_sc_mode_cntl.cull_back ||
+      pa_su_sc_mode_cntl.poly_mode != xenos::PolygonModeEnable::kDisabled ||
+      (regs[XE_GPU_REG_PA_SC_AA_MASK] & 0xF) != 0xF) {
+    return false;
+  }
+  for (uint32_t i = 0; i < xenos::kMaxColorRenderTargets; ++i) {
+    const uint32_t mask = (normalized_color_mask >> (4 * i)) & 0xF;
+    if (!mask) {
+      continue;
+    }
+    // The result must not depend on what is in the render target: the
+    // destination factor is zero, the source factor does not read the
+    // destination, and the operation is source + / - 0.
+    auto blend = regs.Get<reg::RB_BLENDCONTROL>(reg::RB_BLENDCONTROL::rt_register_indices[i]);
+    auto source_only = [](xenos::BlendFactor source, xenos::BlendOp op,
+                          xenos::BlendFactor dest) {
+      return dest == xenos::BlendFactor::kZero &&
+             (op == xenos::BlendOp::kAdd || op == xenos::BlendOp::kSubtract) &&
+             source != xenos::BlendFactor::kDstColor &&
+             source != xenos::BlendFactor::kOneMinusDstColor &&
+             source != xenos::BlendFactor::kDstAlpha &&
+             source != xenos::BlendFactor::kOneMinusDstAlpha &&
+             source != xenos::BlendFactor::kSrcAlphaSaturate;
+    };
+    if (mask != 0xF ||
+        !source_only(blend.color_srcblend, blend.color_comb_fcn, blend.color_destblend) ||
+        !source_only(blend.alpha_srcblend, blend.alpha_comb_fcn, blend.alpha_destblend)) {
+      return false;
+    }
+  }
+  return true;
+}
