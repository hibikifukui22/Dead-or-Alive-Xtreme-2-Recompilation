+// DOAX2 performance timing (xenos60): per-frame command-processor cost of
+// guest draws, copies (resolves) and submissions, reported every 300 swaps
+// with the idle/WAIT_REG_MEM time from the base command processor.
+namespace {
+struct Doax2CpStats {
+  uint64_t draw_ns = 0, draws = 0, copy_ns = 0, copies = 0, submit_ns = 0, submits = 0;
+  uint64_t fence_wait_ns = 0, fence_waits = 0, queries = 0, query_wait_ns = 0;
+  uint64_t replay_ns = 0, execute_ns = 0, splits = 0, split_blocked = 0;
+};
+// GPU timestamps around every submission (ring indexed by submission number);
+// summed per 300-swap window when the submission fence has passed them.
+struct Doax2GpuTimestamps {
+  static constexpr uint32_t kSlots = 512;
+  Microsoft::WRL::ComPtr<ID3D12QueryHeap> heap;
+  Microsoft::WRL::ComPtr<ID3D12Resource> readback;
+  const uint64_t* mapping = nullptr;
+  uint64_t frequency = 0;
+  uint64_t first_unread = 0, last_written = 0;
+  bool failed = false;
+  double window_gpu_ms = 0;
+  uint64_t window_submissions = 0;
+  bool Ensure(ID3D12Device* device, ID3D12CommandQueue* queue, D3D12_HEAP_FLAGS heap_flags) {
+    if (mapping) return true;
+    if (failed) return false;
+    failed = true;
+    D3D12_QUERY_HEAP_DESC heap_desc{D3D12_QUERY_HEAP_TYPE_TIMESTAMP, kSlots * 2, 0};
+    if (FAILED(device->CreateQueryHeap(&heap_desc, IID_PPV_ARGS(&heap)))) return false;
+    D3D12_RESOURCE_DESC buffer_desc;
+    ui::d3d12::util::FillBufferResourceDesc(buffer_desc, sizeof(uint64_t) * kSlots * 2,
+                                            D3D12_RESOURCE_FLAG_NONE);
+    if (FAILED(device->CreateCommittedResource(&ui::d3d12::util::kHeapPropertiesReadback, heap_flags,
+                                               &buffer_desc, D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+                                               IID_PPV_ARGS(&readback))))
+      return false;
+    D3D12_RANGE range{0, sizeof(uint64_t) * kSlots * 2};
+    void* mapped = nullptr;
+    if (FAILED(readback->Map(0, &range, &mapped))) return false;
+    if (FAILED(queue->GetTimestampFrequency(&frequency)) || !frequency) return false;
+    mapping = static_cast<const uint64_t*>(mapped);
+    failed = false;
+    return true;
+  }
+  void Collect(uint64_t completed) {
+    if (!mapping || completed == UINT64_MAX) return;
+    if (last_written >= kSlots && first_unread + kSlots <= last_written)
+      first_unread = last_written - kSlots + 1;
+    for (; first_unread && first_unread <= std::min(completed, last_written); ++first_unread) {
+      const uint32_t slot = uint32_t(first_unread % kSlots);
+      const uint64_t begin = mapping[slot * 2], end = mapping[slot * 2 + 1];
+      if (end > begin) {
+        window_gpu_ms += double(end - begin) * 1000.0 / double(frequency);
+        ++window_submissions;
+      }
+    }
+  }
+};
+Doax2GpuTimestamps doax2_gpu_ts;
+
+// Sampling profiler for the command processor thread (diagnostics): suspends
+// the thread ~1 kHz, unwinds up to kDepth frames, and periodically logs the
+// hottest leaf and inclusive functions (module!symbol+offset).
+struct Doax2CpSampler {
+  static constexpr int kDepth = 24;
+  HANDLE target = nullptr;
+  bool started = false;
+  void Start() {
+    if (started) return;
+    started = true;
+    target = OpenThread(THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_INFORMATION, FALSE,
+                        GetCurrentThreadId());
+    if (!target) return;
+    std::thread([this]() { Run(); }).detach();
+  }
+  static std::string Name(uint64_t address) {
+    alignas(SYMBOL_INFO) char buffer[sizeof(SYMBOL_INFO) + 256] = {};
+    auto* symbol = reinterpret_cast<SYMBOL_INFO*>(buffer);
+    symbol->SizeOfStruct = sizeof(SYMBOL_INFO);
+    symbol->MaxNameLen = 255;
+    char module_name[MAX_PATH] = "?";
+    HMODULE module = nullptr;
+    if (GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                           reinterpret_cast<LPCSTR>(address), &module) && module) {
+      char path[MAX_PATH] = {};
+      GetModuleFileNameA(module, path, MAX_PATH);
+      const char* slash = std::strrchr(path, 0x5C);
+      std::snprintf(module_name, sizeof(module_name), "%s", slash ? slash + 1 : path);
+    }
+    DWORD64 displacement = 0;
+    if (SymFromAddr(GetCurrentProcess(), address, &displacement, symbol))
+      return fmt::format("{}!{}+0x{:X}", module_name, symbol->Name, displacement);
+    return fmt::format("{}+0x{:X}", module_name,
+                       module ? address - reinterpret_cast<uint64_t>(module) : address);
+  }
+  static uint64_t FunctionStart(uint64_t pc) {
+    DWORD64 image_base = 0;
+    const auto* entry = RtlLookupFunctionEntry(pc, &image_base, nullptr);
+    return entry ? image_base + entry->BeginAddress : pc;
+  }
+  void Run() {
+    SymSetOptions(SYMOPT_UNDNAME | SYMOPT_DEFERRED_LOADS);
+    // Symbols from the game folder only: a null path would fall back to
+    // _NT_SYMBOL_PATH, which can name an internet symbol server.
+    char symbol_path[MAX_PATH] = {};
+    GetModuleFileNameA(nullptr, symbol_path, MAX_PATH);
+    if (char* slash = std::strrchr(symbol_path, 0x5C)) *slash = 0;
+    SymInitialize(GetCurrentProcess(), symbol_path, TRUE);
+    std::unordered_map<uint64_t, uint32_t> leaf, inclusive, modules;
+    uint64_t pcs[kDepth];
+    uint32_t samples = 0;
+    auto window_start = std::chrono::steady_clock::now();
+    for (;;) {
+      Sleep(1);
+      int depth = 0;
+      if (SuspendThread(target) == DWORD(-1)) return;
+      CONTEXT context{};
+      context.ContextFlags = CONTEXT_FULL;
+      if (GetThreadContext(target, &context)) {
+        for (; depth < kDepth && context.Rip; ++depth) {
+          pcs[depth] = context.Rip;
+          DWORD64 image_base = 0;
+          auto* entry = RtlLookupFunctionEntry(context.Rip, &image_base, nullptr);
+          if (!entry) {
+            if (!context.Rsp) break;
+            context.Rip = *reinterpret_cast<const DWORD64*>(context.Rsp);
+            context.Rsp += 8;
+          } else {
+            void* handler_data = nullptr;
+            DWORD64 establisher = 0;
+            RtlVirtualUnwind(UNW_FLAG_NHANDLER, image_base, context.Rip, entry, &context, &handler_data,
+                             &establisher, nullptr);
+          }
+        }
+      }
+      ResumeThread(target);
+      if (!depth) continue;
+      ++samples;
+      ++leaf[FunctionStart(pcs[0])];
+      HMODULE module = nullptr;
+      GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                         reinterpret_cast<LPCSTR>(pcs[0]), &module);
+      ++modules[reinterpret_cast<uint64_t>(module)];
+      uint64_t seen[kDepth];
+      int unique = 0;
+      for (int i = 0; i < depth; ++i) {
+        const uint64_t function = FunctionStart(pcs[i]);
+        bool duplicate = false;
+        for (int j = 0; j < unique; ++j) duplicate |= seen[j] == function;
+        if (duplicate) continue;
+        seen[unique++] = function;
+        ++inclusive[function];
+      }
+      if (std::chrono::steady_clock::now() - window_start < std::chrono::seconds(10)) continue;
+      auto top = [](const std::unordered_map<uint64_t, uint32_t>& map, size_t count) {
+        std::vector<std::pair<uint32_t, uint64_t>> sorted;
+        for (const auto& [address, hits] : map) sorted.push_back({hits, address});
+        std::sort(sorted.rbegin(), sorted.rend());
+        if (sorted.size() > count) sorted.resize(count);
+        return sorted;
+      };
+      REXGPU_INFO("DOAX2 CP sampler: {} samples in 10 s", samples);
+      for (const auto& [hits, address] : top(modules, 8))
+        REXGPU_INFO("DOAX2 CP sampler module {:5.1f}%: {}", 100.0 * hits / samples,
+                    address ? Name(address) : std::string("?"));
+      for (const auto& [hits, address] : top(leaf, 30))
+        REXGPU_INFO("DOAX2 CP sampler leaf {:5.1f}%: {}", 100.0 * hits / samples, Name(address));
+      for (const auto& [hits, address] : top(inclusive, 60))
+        REXGPU_INFO("DOAX2 CP sampler incl {:5.1f}%: {}", 100.0 * hits / samples, Name(address));
+      leaf.clear();
+      inclusive.clear();
+      modules.clear();
+      samples = 0;
+      window_start = std::chrono::steady_clock::now();
+    }
+  }
+};
+Doax2CpSampler doax2_cp_sampler;
+
+// GPU time by category inside the command lists (timestamps around render
+// target updates/transfers, texture requests/loads and resolves); the rest
+// of the GPU busy time is the guest draws themselves.
+struct Doax2GpuSections {
+  static constexpr uint32_t kEntries = 65536;
+  static constexpr int kCategories = 3;
+  Microsoft::WRL::ComPtr<ID3D12QueryHeap> heap;
+  Microsoft::WRL::ComPtr<ID3D12Resource> readback;
+  const uint64_t* mapping = nullptr;
+  uint64_t frequency = 0;
+  bool failed = false;
+  uint32_t cursor = 0;
+  struct Pending { uint64_t submission; uint32_t index; int category; };
+  std::deque<Pending> pending;
+  std::array<double, kCategories> window_ms{};
+  std::array<uint64_t, kCategories> window_count{};
+  bool Ensure(ID3D12Device* device, ID3D12CommandQueue* queue, D3D12_HEAP_FLAGS heap_flags) {
+    if (mapping) return true;
+    if (failed) return false;
+    failed = true;
+    D3D12_QUERY_HEAP_DESC heap_desc{D3D12_QUERY_HEAP_TYPE_TIMESTAMP, kEntries, 0};
+    if (FAILED(device->CreateQueryHeap(&heap_desc, IID_PPV_ARGS(&heap)))) return false;
+    D3D12_RESOURCE_DESC buffer_desc;
+    ui::d3d12::util::FillBufferResourceDesc(buffer_desc, sizeof(uint64_t) * kEntries, D3D12_RESOURCE_FLAG_NONE);
+    if (FAILED(device->CreateCommittedResource(&ui::d3d12::util::kHeapPropertiesReadback, heap_flags,
+                                               &buffer_desc, D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+                                               IID_PPV_ARGS(&readback))))
+      return false;
+    D3D12_RANGE range{0, sizeof(uint64_t) * kEntries};
+    void* mapped = nullptr;
+    if (FAILED(readback->Map(0, &range, &mapped))) return false;
+    if (FAILED(queue->GetTimestampFrequency(&frequency)) || !frequency) return false;
+    mapping = static_cast<const uint64_t*>(mapped);
+    failed = false;
+    return true;
+  }
+  void Collect(uint64_t completed) {
+    if (!mapping || completed == UINT64_MAX) return;
+    while (!pending.empty() && pending.front().submission <= completed) {
+      const Pending& entry = pending.front();
+      const uint64_t begin = mapping[entry.index], end = mapping[entry.index + 1];
+      if (end >= begin) {
+        window_ms[entry.category] += double(end - begin) * 1000.0 / double(frequency);
+        ++window_count[entry.category];
+      }
+      pending.pop_front();
+    }
+    while (pending.size() > kEntries / 4) pending.pop_front();
+  }
+};
+Doax2GpuSections doax2_gpu_sections;
+Doax2CpStats doax2_cp_frame, doax2_cp_window;
+struct Doax2CpMaxima {
+  double frame_ms = 0, draw_ms = 0, copy_ms = 0, busy_ms = 0;
+  uint64_t draws = 0;
+};
+Doax2CpMaxima doax2_cp_max;
+// Per-draw stage timing: 0 setup/shader analysis, 1 primitive processing,
+// 2 render target update, 3 pipeline, 4 textures, 5 constants+bindings,
+// 6 interpolation recording (audit), 7 vertex buffers/shared memory,
+// 8 topology + draw submission.
+constexpr int kDoax2DrawStages = 9;
+std::array<uint64_t, kDoax2DrawStages> doax2_stage_ns{};
+struct Doax2DrawStages {
+  std::array<std::chrono::steady_clock::time_point, kDoax2DrawStages> marks{};
+  int last = 0;
+  Doax2DrawStages() { marks[0] = std::chrono::steady_clock::now(); }
+  void Mark(int stage) {
+    const auto now = std::chrono::steady_clock::now();
+    doax2_stage_ns[last] += uint64_t(
+        std::chrono::duration_cast<std::chrono::nanoseconds>(now - marks[last]).count());
+    marks[stage] = now;
+    last = stage;
+  }
+  ~Doax2DrawStages() { Mark(last); }
+};
+struct Doax2ScopeTimer {
+  uint64_t& ns;
+  std::chrono::steady_clock::time_point start = std::chrono::steady_clock::now();
+  explicit Doax2ScopeTimer(uint64_t& total) : ns(total) {}
+  ~Doax2ScopeTimer() {
+    ns += uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now() - start).count());
+  }
+};
+}  // namespace
