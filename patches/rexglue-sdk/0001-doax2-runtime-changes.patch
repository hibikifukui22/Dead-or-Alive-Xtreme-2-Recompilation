diff --git a/include/rex/graphics/render_composition_plan.h b/include/rex/graphics/render_composition_plan.h
new file mode 100644
index 0000000..d976cc9
--- /dev/null
+++ b/include/rex/graphics/render_composition_plan.h
@@ -0,0 +1,49 @@
+#pragma once
+#include "render_region_versions.h"
+#include <span>
+
+namespace rex::graphics::render_audit {
+// A declared producer image covers this logical region, with its own origin
+// at (0,0). These are IDs/layouts, not retained native descriptors or resources.
+struct ProducerRegion { uint64_t version; Rect logical_region; };
+struct RegionCopy { uint64_t version; Rect source; Rect destination; };
+enum class PlanStatus { kReadyMetadata, kIncompleteCoverage, kMissingProducer,
+                        kAmbiguousProducer, kInvalidProducerRegion, kTooManyCopies };
+struct CompositionPlan {
+  PlanStatus status = PlanStatus::kIncompleteCoverage;
+  std::vector<RegionCopy> copies;
+};
+// Pure metadata plan. A caller must separately provide independently backed
+// producer images, compatible formats/sample counts, fresh views, transitions,
+// and existing FrameBanks fence protection before issuing any GPU work.
+inline CompositionPlan BuildCompositionPlan(
+    const RegionVersions& versions, Rect requested,
+    std::span<const ProducerRegion> producers, size_t max_copies = 1024) {
+  CompositionPlan plan;
+  const auto read=versions.Read(requested);
+  if (!read.complete) return plan;
+  if (read.pieces.size()>max_copies) { plan.status=PlanStatus::kTooManyCopies; return plan; }
+  auto fail=[&](PlanStatus status) { plan.status=status; plan.copies.clear(); return plan; };
+  for (const auto& piece : read.pieces) {
+    const ProducerRegion* source=nullptr;
+    for (const auto& producer : producers) {
+      if (producer.version!=piece.version) continue;
+      if (source) return fail(PlanStatus::kAmbiguousProducer);
+      source=&producer;
+    }
+    if (!source) return fail(PlanStatus::kMissingProducer);
+    const auto s=source->logical_region, d=piece.rect;
+    if (s.left>=s.right || s.top>=s.bottom || d.left<s.left || d.top<s.top ||
+        d.right>s.right || d.bottom>s.bottom) return fail(PlanStatus::kInvalidProducerRegion);
+    plan.copies.push_back({piece.version,
+        {d.left-s.left,d.top-s.top,d.right-s.left,d.bottom-s.top},d});
+  }
+  // Destination regions are disjoint; deterministic order aids reproducibility.
+  std::sort(plan.copies.begin(),plan.copies.end(),[](const auto& a,const auto& b) {
+    if (a.destination.top!=b.destination.top) return a.destination.top<b.destination.top;
+    return a.destination.left<b.destination.left;
+  });
+  plan.status=PlanStatus::kReadyMetadata;
+  return plan;
+}
+}  // namespace rex::graphics::render_audit
diff --git a/include/rex/graphics/render_operation_sequence.h b/include/rex/graphics/render_operation_sequence.h
new file mode 100644
index 0000000..c26f891
--- /dev/null
+++ b/include/rex/graphics/render_operation_sequence.h
@@ -0,0 +1,54 @@
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <span>
+#include <vector>
+
+namespace rex::graphics::render_audit {
+
+// Exact attachment identity; unlike recipe matching this must not merge on a
+// hash collision. This sequence is diagnostic, not a replayable GPU stream.
+using Target = std::array<uint32_t, 11>;  // mask, 5 keys, 5 formats
+enum class Kind { kDrawSpan, kResolve };
+struct Operation {
+  Kind kind;
+  size_t first_draw;
+  size_t draw_count;
+  size_t resolve_index;
+};
+struct Sequence {
+  bool valid = false;
+  std::vector<Operation> operations;
+};
+
+// Every resolve is a boundary, even failed/empty/clear-only resolves. Multiple
+// events at one ordinal retain source order. No claim about unrecorded queries,
+// CPU writes, EDRAM owners, or content completeness is made here.
+inline Sequence BuildSequence(std::span<const Target> targets,
+                              std::span<const size_t> resolve_before_draw) {
+  Sequence result;
+  size_t last = 0;
+  for (size_t boundary : resolve_before_draw) {
+    if (boundary < last || boundary > targets.size()) return result;
+    last = boundary;
+  }
+  size_t draw = 0;
+  auto append_draws = [&](size_t end) {
+    while (draw < end) {
+      const size_t first = draw++;
+      while (draw < end && targets[draw] == targets[first]) ++draw;
+      result.operations.push_back({Kind::kDrawSpan, first, draw - first, SIZE_MAX});
+    }
+  };
+  for (size_t event = 0; event < resolve_before_draw.size(); ++event) {
+    const size_t boundary = resolve_before_draw[event];
+    append_draws(boundary);
+    result.operations.push_back({Kind::kResolve, boundary, 0, event});
+  }
+  append_draws(targets.size());
+  result.valid = true;
+  return result;
+}
+}  // namespace rex::graphics::render_audit
