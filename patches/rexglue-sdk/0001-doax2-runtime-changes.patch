+// The raw scaled bytes of the last armed frame resolve. Store (GPU thread) only copies them; the
+// untiling, crop and PNG encoding run on the writer thread so a photo doesn't stall a frame.
+struct Pending {
+  Resolve resolve;
+  std::vector<uint8_t> raw;
+  std::chrono::steady_clock::time_point time;
+};
+std::mutex g_mutex;
+Pending g_pending;
+int32_t g_last_request = 0;
+
+uint32_t ApplyEndian(uint32_t v, xenos::Endian128 endian) {
+  switch (endian) {
+    case xenos::Endian128::k8in16:
+      return ((v & 0x00FF00FFu) << 8) | ((v >> 8) & 0x00FF00FFu);
+    case xenos::Endian128::k8in32:
+      return rex::byte_swap(v);
+    case xenos::Endian128::k16in32:
+      return (v << 16) | (v >> 16);
+    default:
+      return v;
+  }
+}
+
+// PNG without compression (stored deflate blocks); used where WIC is missing.
+bool WriteStoredPng(const std::filesystem::path& path, const Image& image) {
+  auto crc_table = [] {
+    std::array<uint32_t, 256> t{};
+    for (uint32_t n = 0; n < 256; ++n) {
+      uint32_t c = n;
+      for (int k = 0; k < 8; ++k) c = (c & 1) ? 0xEDB88320u ^ (c >> 1) : c >> 1;
+      t[n] = c;
+    }
+    return t;
+  }();
+  std::FILE* f = std::fopen(path.string().c_str(), "wb");
+  if (!f) return false;
+  auto put32 = [](std::vector<uint8_t>& v, uint32_t x) {
+    for (int s = 24; s >= 0; s -= 8) v.push_back(uint8_t(x >> s));
+  };
+  auto chunk = [&](const char* type, const std::vector<uint8_t>& data) {
+    std::vector<uint8_t> out;
+    put32(out, uint32_t(data.size()));
+    out.insert(out.end(), type, type + 4);
+    out.insert(out.end(), data.begin(), data.end());
+    uint32_t c = 0xFFFFFFFFu;
+    for (size_t i = 4; i < out.size(); ++i) c = crc_table[(c ^ out[i]) & 0xFF] ^ (c >> 8);
+    put32(out, c ^ 0xFFFFFFFFu);
+    std::fwrite(out.data(), 1, out.size(), f);
+  };
+  static const uint8_t sig[8] = {0x89, 'P', 'N', 'G', 0x0D, 0x0A, 0x1A, 0x0A};
+  std::fwrite(sig, 1, 8, f);
+  std::vector<uint8_t> ihdr;
+  put32(ihdr, image.width);
+  put32(ihdr, image.height);
+  ihdr.insert(ihdr.end(), {8, 2, 0, 0, 0});
+  chunk("IHDR", ihdr);
+  std::vector<uint8_t> raw;
+  raw.reserve(size_t(image.width * 3 + 1) * image.height);
+  for (uint32_t y = 0; y < image.height; ++y) {
+    raw.push_back(0);
+    const uint8_t* row = image.rgb.data() + size_t(y) * image.width * 3;
+    raw.insert(raw.end(), row, row + image.width * 3);
+  }
+  std::vector<uint8_t> z = {0x78, 0x01};
+  uint32_t a = 1, b = 0;
+  for (uint8_t x : raw) {
+    a = (a + x) % 65521;
+    b = (b + a) % 65521;
+  }
+  for (size_t pos = 0; pos < raw.size() || pos == 0;) {
+    const size_t n = std::min<size_t>(65535, raw.size() - pos);
+    const bool last = pos + n >= raw.size();
+    z.push_back(last ? 1 : 0);
+    z.push_back(uint8_t(n));
+    z.push_back(uint8_t(n >> 8));
+    z.push_back(uint8_t(~n));
+    z.push_back(uint8_t(~n >> 8));
+    z.insert(z.end(), raw.begin() + pos, raw.begin() + pos + n);
+    pos += n;
+    if (last) break;
+  }
+  put32(z, (b << 16) | a);
+  chunk("IDAT", z);
+  chunk("IEND", {});
+  std::fclose(f);
+  return true;
+}
+
+#if defined(_WIN32)
+bool WriteWicPng(const std::filesystem::path& path, const Image& image) {
+  const HRESULT init = CoInitializeEx(nullptr, COINIT_MULTITHREADED);
+  bool ok = false;
+  IWICImagingFactory* factory = nullptr;
+  IWICStream* stream = nullptr;
+  IWICBitmapEncoder* encoder = nullptr;
+  IWICBitmapFrameEncode* frame = nullptr;
+  // WIC wants BGR.
+  std::vector<uint8_t> bgr(image.rgb.size());
+  for (size_t i = 0; i + 2 < image.rgb.size(); i += 3) {
+    bgr[i] = image.rgb[i + 2];
+    bgr[i + 1] = image.rgb[i + 1];
+    bgr[i + 2] = image.rgb[i];
+  }
+  do {
+    if (FAILED(CoCreateInstance(CLSID_WICImagingFactory, nullptr, CLSCTX_INPROC_SERVER,
+                                IID_PPV_ARGS(&factory))))
+      break;
+    if (FAILED(factory->CreateStream(&stream))) break;
+    if (FAILED(stream->InitializeFromFilename(path.wstring().c_str(), GENERIC_WRITE))) break;
+    if (FAILED(factory->CreateEncoder(GUID_ContainerFormatPng, nullptr, &encoder))) break;
+    if (FAILED(encoder->Initialize(stream, WICBitmapEncoderNoCache))) break;
+    if (FAILED(encoder->CreateNewFrame(&frame, nullptr))) break;
+    if (FAILED(frame->Initialize(nullptr))) break;
+    if (FAILED(frame->SetSize(image.width, image.height))) break;
+    WICPixelFormatGUID format = GUID_WICPixelFormat24bppBGR;
+    if (FAILED(frame->SetPixelFormat(&format)) || format != GUID_WICPixelFormat24bppBGR) break;
+    if (FAILED(frame->WritePixels(image.height, image.width * 3, UINT(bgr.size()), bgr.data())))
+      break;
+    if (FAILED(frame->Commit()) || FAILED(encoder->Commit())) break;
+    ok = true;
+  } while (false);
+  if (frame) frame->Release();
+  if (encoder) encoder->Release();
+  if (stream) stream->Release();
+  if (factory) factory->Release();
+  if (SUCCEEDED(init)) CoUninitialize();
+  return ok;
+}
+#endif
+
+// FXAA (after Timothy Lottes' FXAA 3.11 "quality" path) on the CPU, for the saved photo only.
+void ApplyFxaa(Image& image) {
+  const int w = int(image.width), h = int(image.height);
+  if (w < 3 || h < 3) return;
+  const std::vector<uint8_t>& src = image.rgb;
+  std::vector<float> luma(size_t(w) * h);
+  for (size_t i = 0; i < luma.size(); ++i) {
+    const uint8_t* p = &src[i * 3];
+    luma[i] = (0.299f * p[0] + 0.587f * p[1] + 0.114f * p[2]) * (1.0f / 255.0f);
+  }
+  auto L = [&](int x, int y) {
+    x = std::clamp(x, 0, w - 1);
+    y = std::clamp(y, 0, h - 1);
+    return luma[size_t(y) * w + x];
+  };
+  // Bilinear, pixel centres at integer coordinates.
+  auto LB = [&](float x, float y) {
+    const float fx = std::floor(x), fy = std::floor(y);
+    const int x0 = int(fx), y0 = int(fy);
+    const float ax = x - fx, ay = y - fy;
+    return (L(x0, y0) * (1 - ax) + L(x0 + 1, y0) * ax) * (1 - ay) +
+           (L(x0, y0 + 1) * (1 - ax) + L(x0 + 1, y0 + 1) * ax) * ay;
+  };
+  auto C = [&](int x, int y, int c) {
+    x = std::clamp(x, 0, w - 1);
+    y = std::clamp(y, 0, h - 1);
+    return float(src[(size_t(y) * w + x) * 3 + c]);
+  };
+  std::vector<uint8_t> out = src;
+  static constexpr float kSteps[] = {1.5f, 2.0f, 2.0f, 2.0f, 2.0f, 4.0f, 8.0f};
+  for (int y = 0; y < h; ++y) {
+    for (int x = 0; x < w; ++x) {
+      const float M = L(x, y);
+      float N = L(x, y - 1), S = L(x, y + 1);
+      const float W = L(x - 1, y), E = L(x + 1, y);
+      const float max_l = std::max({M, N, S, W, E}), min_l = std::min({M, N, S, W, E});
+      const float range = max_l - min_l;
+      if (range < std::max(0.0625f, max_l * 0.125f)) continue;
+      const float NW = L(x - 1, y - 1), NE = L(x + 1, y - 1), SW = L(x - 1, y + 1),
+                  SE = L(x + 1, y + 1);
+      const float edge_horz = std::abs(NW + SW - 2 * W) + 2 * std::abs(N + S - 2 * M) +
+                              std::abs(NE + SE - 2 * E);
+      const float edge_vert = std::abs(NW + NE - 2 * N) + 2 * std::abs(W + E - 2 * M) +
+                              std::abs(SW + SE - 2 * S);
+      const bool horz_span = edge_horz >= edge_vert;
+      const float subpix_a = 2 * (N + S + W + E) + (NW + NE + SW + SE);
+      if (!horz_span) {
+        N = W;
+        S = E;
+      }
+      const float gradient_n = N - M, gradient_s = S - M;
+      const bool pair_n = std::abs(gradient_n) >= std::abs(gradient_s);
+      const float gradient = std::max(std::abs(gradient_n), std::abs(gradient_s));
+      const float length_sign = pair_n ? -1.0f : 1.0f;
+      const float luma_nn = (pair_n ? N : S) + M;
+      const float subpix_c = std::clamp(std::abs(subpix_a / 12.0f - M) / range, 0.0f, 1.0f);
+      float bx = float(x), by = float(y);
+      if (horz_span) by += length_sign * 0.5f; else bx += length_sign * 0.5f;
+      const float ox = horz_span ? 1.0f : 0.0f, oy = horz_span ? 0.0f : 1.0f;
+      float nx = bx - ox, ny = by - oy, px = bx + ox, py = by + oy;
+      const float half_nn = luma_nn * 0.5f;
+      float end_n = LB(nx, ny) - half_nn, end_p = LB(px, py) - half_nn;
+      const float gradient_scaled = gradient * 0.25f;
+      bool done_n = std::abs(end_n) >= gradient_scaled, done_p = std::abs(end_p) >= gradient_scaled;
+      for (float step : kSteps) {
+        if (done_n && done_p) break;
+        if (!done_n) {
+          nx -= ox * step;
+          ny -= oy * step;
+          end_n = LB(nx, ny) - half_nn;
+          done_n = std::abs(end_n) >= gradient_scaled;
+        }
+        if (!done_p) {
+          px += ox * step;
+          py += oy * step;
+          end_p = LB(px, py) - half_nn;
+          done_p = std::abs(end_p) >= gradient_scaled;
+        }
+      }
+      const float dst_n = horz_span ? float(x) - nx : float(y) - ny;
+      const float dst_p = horz_span ? px - float(x) : py - float(y);
+      const bool m_lt_zero = M - half_nn < 0.0f;
+      const bool good_n = (end_n < 0.0f) != m_lt_zero, good_p = (end_p < 0.0f) != m_lt_zero;
+      const bool direction_n = dst_n < dst_p;
+      const float dst = std::min(dst_n, dst_p);
+      const float span = dst_n + dst_p;
+      const bool good = direction_n ? good_n : good_p;
+      const float pixel_offset = good && span > 0.0f ? 0.5f - dst / span : 0.0f;
+      const float subpix_d = (-2.0f * subpix_c + 3.0f) * subpix_c * subpix_c;
+      const float subpix_h = subpix_d * subpix_d * 0.75f;
+      const float offset = std::max(pixel_offset, subpix_h) * length_sign;
+      // Blend toward the neighbour across the edge by the offset.
+      const int qx = horz_span ? x : x + int(length_sign), qy = horz_span ? y + int(length_sign) : y;
+      const float t = std::abs(offset);
+      for (int c = 0; c < 3; ++c) {
+        const float v = C(x, y, c) * (1.0f - t) + C(qx, qy, c) * t;
+        out[(size_t(y) * w + x) * 3 + c] = uint8_t(std::clamp(v + 0.5f, 0.0f, 255.0f));
+      }
+    }
+  }
+  image.rgb = std::move(out);
+}
+
+// Area-average downscale by `factor` (> 1) in linear light: real supersampling of the render.
+void Downscale(Image& image, double factor) {
+  const uint32_t ow = uint32_t(double(image.width) / factor + 0.5);
+  const uint32_t oh = uint32_t(double(image.height) / factor + 0.5);
+  if (!ow || !oh || ow >= image.width || oh >= image.height) return;
+  std::array<float, 256> to_linear;
+  for (int i = 0; i < 256; ++i) {
+    const float c = float(i) / 255.0f;
+    to_linear[i] = c <= 0.04045f ? c / 12.92f : std::pow((c + 0.055f) / 1.055f, 2.4f);
+  }
+  auto to_srgb = [](float l) {
+    l = std::clamp(l, 0.0f, 1.0f);
+    const float c = l <= 0.0031308f ? l * 12.92f : 1.055f * std::pow(l, 1.0f / 2.4f) - 0.055f;
+    return uint8_t(c * 255.0f + 0.5f);
+  };
+  // Per output coordinate: the source pixels it covers and their coverage weights.
+  struct Tap { uint32_t index; float weight; };
+  auto taps = [](uint32_t in, uint32_t out) {
+    std::vector<std::vector<Tap>> t(out);
+    const double s = double(in) / double(out);
+    for (uint32_t o = 0; o < out; ++o) {
+      const double a = o * s, b = (o + 1) * s;
+      for (uint32_t i = uint32_t(a); i < std::min<uint32_t>(in, uint32_t(std::ceil(b))); ++i) {
+        const double cover = std::min(b, double(i + 1)) - std::max(a, double(i));
+        if (cover > 0) t[o].push_back({i, float(cover / s)});
+      }
+    }
+    return t;
+  };
+  const auto tx = taps(image.width, ow), ty = taps(image.height, oh);
+  // Horizontal pass into linear floats, then vertical pass back to sRGB.
+  std::vector<float> mid(size_t(ow) * image.height * 3);
+  for (uint32_t y = 0; y < image.height; ++y) {
+    const uint8_t* row = &image.rgb[size_t(y) * image.width * 3];
+    for (uint32_t x = 0; x < ow; ++x) {
+      float acc[3] = {};
+      for (const Tap& t : tx[x])
+        for (int c = 0; c < 3; ++c) acc[c] += to_linear[row[t.index * 3 + c]] * t.weight;
+      for (int c = 0; c < 3; ++c) mid[(size_t(y) * ow + x) * 3 + c] = acc[c];
+    }
+  }
+  std::vector<uint8_t> out(size_t(ow) * oh * 3);
+  for (uint32_t y = 0; y < oh; ++y) {
+    for (uint32_t x = 0; x < ow; ++x) {
+      float acc[3] = {};
+      for (const Tap& t : ty[y])
+        for (int c = 0; c < 3; ++c) acc[c] += mid[(size_t(t.index) * ow + x) * 3 + c] * t.weight;
+      for (int c = 0; c < 3; ++c) out[(size_t(y) * ow + x) * 3 + c] = to_srgb(acc[c]);
+    }
+  }
+  image.rgb = std::move(out);
+  image.width = ow;
+  image.height = oh;
+}
+
+void WritePng(std::filesystem::path path, Image image, bool fxaa, bool supersample) {
+  if (fxaa) ApplyFxaa(image);
+  // 1.5x down: 3x render -> 2x photo, 2x -> 1.33x; a 1x render has nothing to supersample.
+  if (supersample && image.scale >= 2) Downscale(image, 1.5);
+  std::error_code ec;
+  std::filesystem::create_directories(path.parent_path(), ec);
+  bool ok = false;
+#if defined(_WIN32)
+  ok = WriteWicPng(path, image);
+#endif
+  if (!ok) ok = WriteStoredPng(path, image);
+  if (ok) {
+    REXGPU_INFO("hires capture: saved {}x{} {}", image.width, image.height, path.string());
+  } else {
+    REXGPU_ERROR("hires capture: could not write {}", path.string());
+  }
+}
