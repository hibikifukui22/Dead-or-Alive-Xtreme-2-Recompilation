+// Predicated tiling (D3D BeginTiling / EndTiling): the game's command buffer
+// between the markers is replayed once per tile, each replay selecting its
+// tile's bins, with surfaces the size of one tile and the window offset moving
+// the frame under it. With host render targets there is no EDRAM size limit,
+// so the first replay is drawn at the size of all tiles together (surface
+// pitch and scissors widened, resolves of the first tile widened to the whole
+// area) and the later replays are skipped.
+void CommandProcessor::UpdateNativeTiling(uint32_t kind, const uint32_t* values, uint32_t count) {
+  NativeTiling& tiling = native_tiling_;
+  switch (kind) {
+    case 3: {  // BeginTiling: tile count, then x1 y1 x2 y2 per tile.
+      const uint32_t tiles = count ? values[0] : 0;
+      if (tiling.active && tiling.ended && tiles == tiling.tile_count &&
+          tiling.pass + 1 < tiles) {
+        // The next tile's replay of the same section.
+        ++tiling.pass;
+        tiling.ended = false;
+        return;
+      }
+      tiling = NativeTiling();
+      tiling.active = true;
+      tiling.tile_count = tiles;
+      if (!REXCVAR_GET(gpu_native_tiling) || tiles < 2 || tiles > 4 || count < 1 + 4 * tiles) {
+        return;
+      }
+      const uint32_t* tile0 = values + 1;
+      if (tile0[0] || tile0[1] || tile0[2] <= tile0[0] || tile0[3] <= tile0[1]) {
+        return;
+      }
+      tiling.tile_right = tile0[2];
+      tiling.tile_bottom = tile0[3];
+      for (uint32_t i = 0; i < tiles; ++i) {
+        tiling.union_right = std::max(tiling.union_right, values[1 + 4 * i + 2]);
+        tiling.union_bottom = std::max(tiling.union_bottom, values[1 + 4 * i + 3]);
+      }
+      // Bins of all tiles (tile i: bins 2i and 2i + 1, as the game's resolves
+      // are predicated) for the draws of the collapsed pass.
+      tiling.bins = (uint64_t(1) << (2 * tiles)) - 1;
+      tiling.collapse = tiling.union_right <= xenos::kTexture2DCubeMaxWidthHeight &&
+                        tiling.union_bottom <= xenos::kTexture2DCubeMaxWidthHeight;
+      if (tiling.collapse) {
+        ClearCollapsedTilingSurfaces();
+      }
+      return;
+    }
+    case 4:  // EndTiling (before its per-tile resolves).
+      if (tiling.active) {
+        tiling.ended = true;
+      }
+      return;
+    case 1:  // Render target / depth surface change: after the last replay, the section is over.
+    case 2:
+      if (tiling.active && tiling.ended) {
+        tiling = NativeTiling();
+      }
+      return;
+    default:
