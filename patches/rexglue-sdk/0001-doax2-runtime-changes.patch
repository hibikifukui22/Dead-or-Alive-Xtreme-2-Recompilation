+}  // namespace
+
+namespace {
+bool IsFrameResolve(const RegisterFile& regs) {
+  const auto info = regs.Get<reg::RB_COPY_DEST_INFO>();
+  const auto pitch = regs.Get<reg::RB_COPY_DEST_PITCH>();
+  if (info.copy_dest_format != xenos::ColorFormat::k_8_8_8_8) return false;
+  if (info.copy_dest_array) return false;
+  // The game resolves depth (as 8888) to the same 1280x720 target just before the colour copy;
+  // only colour resolves are pictures.
+  if (regs.Get<reg::RB_COPY_CONTROL>().copy_src_select >= xenos::kMaxColorRenderTargets) return false;
+  const uint32_t width = uint32_t(std::max(1, REXCVAR_GET(hires_resolve_capture_width)));
+  const uint32_t rows = uint32_t(std::max(1, REXCVAR_GET(hires_resolve_capture_height)));
+  if (pitch.copy_dest_pitch != rex::align(width, 32u)) return false;
+  if (pitch.copy_dest_height < rows || pitch.copy_dest_height > rex::align(rows, 32u)) return false;
+  return true;
+}
+}  // namespace
+
+namespace {
+// Set by ReadbackWanted for the resolve it was asked about (GPU thread only).
+bool g_force_full = false;
+
+// hires_resolve_capture_arm last consumed by a capture (GPU thread only).
+int32_t g_consumed_arm = 0;
+
+// Whether the title has armed a capture that no resolve has taken yet.
+bool ArmPending() {
+  static bool arm_seen = false;
+  const int32_t arm = REXCVAR_GET(hires_resolve_capture_arm);
+  if (!arm_seen) {
+    // The starting value (from the command line) arms nothing.
+    arm_seen = true;
+    g_consumed_arm = arm;
+  }
+  return arm != g_consumed_arm;
+}
+
+// The album thumbnail: a 64x64 colour k_8_8_8_8 resolve made once per photo, just before the
+// shot (DOAX2), read by the CPU and passed to XamContentSetThumbnail.
+bool IsThumbnailResolve(const RegisterFile& regs) {
+  const auto info = regs.Get<reg::RB_COPY_DEST_INFO>();
+  const auto pitch = regs.Get<reg::RB_COPY_DEST_PITCH>();
+  return info.copy_dest_format == xenos::ColorFormat::k_8_8_8_8 && !info.copy_dest_array &&
+         regs.Get<reg::RB_COPY_CONTROL>().copy_src_select < xenos::kMaxColorRenderTargets &&
+         pitch.copy_dest_pitch == 64 && pitch.copy_dest_height == 64;
+}
+}  // namespace
+
+bool ReadbackWanted(const RegisterFile& regs) {
+  g_force_full = false;
+  const bool frame = IsFrameResolve(regs);
+  if (frame && REXCVAR_GET(hires_resolve_capture) && ArmPending()) {
+    // The frame the photo PNG is taken from: copy it in full (a resolve trimmed to the changed
+    // rectangle would leave the rest of the PNG black) and wait for it. Once per photo.
+    g_force_full = true;
+  }
+  if (!REXCVAR_GET(readback_resolve_frame_only)) return true;
+  if (frame) return true;
+  if (IsThumbnailResolve(regs)) {
+    // One-off: it needs this resolve's data, not the previous one that "fast" readback
+    // returns, so wait for the GPU (rare and tiny).
+    g_force_full = true;
+    return true;
+  }
+  return false;
+}
+
+bool ForceFullReadback() { return g_force_full; }
+
+bool Prepare(const RegisterFile& regs, uint32_t written_address, uint32_t written_length,
+             uint32_t scale_x, uint32_t scale_y, Resolve& out) {
+  if (!REXCVAR_GET(hires_resolve_capture)) return false;
+  const auto info = regs.Get<reg::RB_COPY_DEST_INFO>();
+  const auto pitch = regs.Get<reg::RB_COPY_DEST_PITCH>();
+  if (!IsFrameResolve(regs)) return false;
+  const uint32_t width = uint32_t(std::max(1, REXCVAR_GET(hires_resolve_capture_width)));
+  const uint32_t rows = uint32_t(std::max(1, REXCVAR_GET(hires_resolve_capture_height)));
+  // Armed captures: only the first matching resolve after each arm. Nothing is kept until the
+  // title changes the arm value - keeping every frame costs a full GPU sync per resolve.
+  if (!ArmPending()) return false;
+  g_consumed_arm = REXCVAR_GET(hires_resolve_capture_arm);
+  out.dest_base = regs[XE_GPU_REG_RB_COPY_DEST_BASE];
+  out.pitch = pitch.copy_dest_pitch;
+  out.height = pitch.copy_dest_height;
+  out.width = width;
+  out.rows = rows;
+  out.written_address = written_address;
+  out.written_length = written_length;
+  out.endian = xenos::Endian128(uint32_t(info.copy_dest_endian));
+  out.swap = info.copy_dest_swap != 0;
+  out.scale_x = std::max(1u, scale_x);
+  out.scale_y = std::max(1u, scale_y);
+  return true;
+}
+
+namespace {
+Image Untile(const Resolve& r, const uint8_t* data, size_t size) {
+  const uint32_t sx = r.scale_x, sy = r.scale_y, sxy = sx * sy;
+  Image image;
+  image.width = r.width * sx;
+  image.height = r.rows * sy;
+  image.rgb.assign(size_t(image.width) * image.height * 3, 0);
+  // Resolution-scaled tiled addressing (32bpp), as in the resolve / texture load shaders and
+  // doax2_lazy_write_back.cs.glsl: host pixels form groups of 4x1; the sx * sy host groups
+  // covering one 4x1 guest group are stored contiguously (index = x_in_guest * sy + y_in_guest),
+  // 16 bytes each, at the guest group's tiled address * sx * sy.
+  uint64_t filled = 0;
+  for (uint32_t hy = 0; hy < image.height; ++hy) {
+    const uint32_t gy = hy / sy;
+    const uint32_t in_y = hy - gy * sy;
+    for (uint32_t hx = 0; hx < image.width; ++hx) {
+      const uint32_t host_group_x = hx >> 2;
+      const uint32_t guest_group_x = host_group_x / sx;
+      const uint32_t in_x = host_group_x - guest_group_x * sx;
+      const int64_t addr = int64_t(r.dest_base) +
+                           texture_util::GetTiledOffset2D(int32_t(guest_group_x << 2), int32_t(gy),
+                                                          r.pitch, 2);
+      const int64_t rel = addr - int64_t(r.written_address);
+      if (rel < 0 || rel + 16 > int64_t(r.written_length)) continue;
+      const size_t src = size_t(rel) * sxy + size_t(in_x * sy + in_y) * 16 + size_t(hx & 3) * 4;
+      if (src + 4 > size) continue;
+      uint32_t v;
+      std::memcpy(&v, data + src, 4);
+      v = ApplyEndian(v, r.endian);
+      const uint8_t c0 = uint8_t(v), c1 = uint8_t(v >> 8), c2 = uint8_t(v >> 16);
+      uint8_t* px = image.rgb.data() + (size_t(hy) * image.width + hx) * 3;
+      px[0] = r.swap ? c2 : c0;
+      px[1] = c1;
+      px[2] = r.swap ? c0 : c2;
+      ++filled;
+    }
+  }
+  const double aspect = REXCVAR_GET(hires_resolve_capture_aspect);
+  if (aspect > 0.0 && image.height) {
+    uint32_t w = image.width, h = image.height;
+    if (double(w) / double(h) > aspect) {
+      w = uint32_t(double(h) * aspect + 0.5);
+    } else {
+      h = uint32_t(double(w) / aspect + 0.5);
+    }
+    w = std::min(w, image.width);
+    h = std::min(h, image.height);
+    const uint32_t x0 = (image.width - w) / 2, y0 = (image.height - h) / 2;
+    std::vector<uint8_t> cropped(size_t(w) * h * 3);
+    for (uint32_t y = 0; y < h; ++y)
+      std::memcpy(cropped.data() + size_t(y) * w * 3,
+                  image.rgb.data() + (size_t(y + y0) * image.width + x0) * 3, size_t(w) * 3);
+    image.rgb = std::move(cropped);
+    image.width = w;
+    image.height = h;
+  }
+  image.scale = std::min(sx, sy);
+  static int logged = 0;
+  if (logged++ < 8)
+    REXGPU_INFO("hires capture: kept {}x{} (scale {}x{}, {} of {} pixels, endian {}, swap {})",
+                image.width, image.height, sx, sy, filled, uint64_t(image.width) * image.height,
+                uint32_t(r.endian), r.swap);
+  return image;
+}
+
+void UntileAndWrite(std::filesystem::path path, Pending pending, bool fxaa, bool supersample) {
+  Image image = Untile(pending.resolve, pending.raw.data(), pending.raw.size());
+  pending.raw = {};
+  WritePng(std::move(path), std::move(image), fxaa, supersample);
+}
+}  // namespace
+
+void Store(const Resolve& r, const uint8_t* data, size_t size) {
+  if (!data || !size) return;
+  Pending pending;
+  pending.resolve = r;
+  pending.raw.assign(data, data + size);
+  pending.time = std::chrono::steady_clock::now();
+  std::lock_guard lock(g_mutex);
+  g_pending = std::move(pending);
+}
+
+void Poll() {
+  const int32_t request = REXCVAR_GET(hires_resolve_capture_request);
+  if (request == g_last_request) return;
+  g_last_request = request;
+  const std::string path = REXCVAR_GET(hires_resolve_capture_path);
+  if (path.empty()) return;
+  Pending pending;
+  {
+    std::lock_guard lock(g_mutex);
+    pending = std::move(g_pending);
+    g_pending = {};
+  }
+  if (pending.raw.empty() ||
+      std::chrono::steady_clock::now() - pending.time > std::chrono::seconds(60)) {
+    REXGPU_WARN("hires capture: no recent capture for {}", path);
+    return;
+  }
+  std::thread(UntileAndWrite, std::filesystem::u8path(path), std::move(pending),
+              REXCVAR_GET(hires_resolve_capture_fxaa), REXCVAR_GET(hires_resolve_capture_supersample))
+      .detach();
+}
+
+}  // namespace rex::graphics::hires_capture
