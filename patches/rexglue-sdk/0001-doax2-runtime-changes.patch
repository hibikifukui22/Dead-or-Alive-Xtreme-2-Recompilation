+  void* handle = adrenotools_open_libvulkan(RTLD_NOW, ADRENOTOOLS_DRIVER_CUSTOM, nullptr,
+                                            hook_dir.c_str(), driver_dir.c_str(),
+                                            driver_name.c_str(), nullptr, nullptr);
+  if (!handle) {
+    const char* error = dlerror();
+    REXLOG_ERROR("Custom Vulkan driver failed to load, using the system driver: {}",
