+static bool WriteOwnedCompositeBmp(const std::filesystem::path& path,
+                                   const uint8_t* pixels, uint32_t width,
+                                   uint32_t height, uint32_t row_pitch) {
+  if (!pixels || !width || !height || width > 4096 || height > 4096 ||
+      row_pitch < uint64_t(width) * 4) return false;
+  std::error_code error;
+  std::filesystem::create_directories(path.parent_path(), error);
+  if (error) return false;
+  std::ofstream file(path, std::ios::binary);
+  if (!file) return false;
+  std::array<uint8_t, 54> header{};
+  auto put16 = [&](size_t offset, uint16_t value) {
+    header[offset] = uint8_t(value);
+    header[offset + 1] = uint8_t(value >> 8);
+  };
+  auto put32 = [&](size_t offset, uint32_t value) {
+    for (size_t i = 0; i < 4; ++i)
+      header[offset + i] = uint8_t(value >> (i * 8));
+  };
+  const uint32_t image_bytes = width * height * 4;
+  header[0] = 'B';
+  header[1] = 'M';
+  put32(2, 54 + image_bytes);
+  put32(10, 54);
+  put32(14, 40);
+  put32(18, width);
+  put32(22, height);
+  put16(26, 1);
+  put16(28, 32);
+  put32(34, image_bytes);
+  file.write(reinterpret_cast<const char*>(header.data()), header.size());
+  std::vector<uint8_t> row(size_t(width) * 4);
+  for (uint32_t y = height; y != 0; --y) {
+    const uint8_t* source = pixels + size_t(y - 1) * row_pitch;
+    for (uint32_t x = 0; x < width; ++x) {
+      row[size_t(x) * 4 + 0] = source[size_t(x) * 4 + 2];
+      row[size_t(x) * 4 + 1] = source[size_t(x) * 4 + 1];
+      row[size_t(x) * 4 + 2] = source[size_t(x) * 4 + 0];
+      row[size_t(x) * 4 + 3] = source[size_t(x) * 4 + 3];
+    }
+    file.write(reinterpret_cast<const char*>(row.data()), row.size());
+  }
+  return file.good();
+}
