+      } break;
+      case Command::kD3DSetGraphicsRootShaderResourceView: {
+        const auto& a = *reinterpret_cast<const SetRootConstantBufferViewArguments*>(stream);
+        command_list->SetGraphicsRootShaderResourceView(a.root_parameter_index, a.buffer_location);
+      } break;
+      case Command::kD3DSetGraphicsRootUnorderedAccessView: {
+        const auto& a = *reinterpret_cast<const SetRootConstantBufferViewArguments*>(stream);
+        command_list->SetGraphicsRootUnorderedAccessView(a.root_parameter_index, a.buffer_location);
+      } break;
+      case Command::kD3DSetGraphicsRootSignature:
+        command_list->SetGraphicsRootSignature(
