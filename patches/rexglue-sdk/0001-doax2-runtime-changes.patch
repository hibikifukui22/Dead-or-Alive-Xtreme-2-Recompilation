+// XMP song information as DOAX2 reads it (82745260): handle at +0, then at
+// +576 title, artist, album, album artist and genre as 40-character
+// (80-byte) zero-terminated fields, track number +976, duration +980,
+// format +984.
+void XmpApp::WriteSongInfo(uint8_t* info, const Song& song) {
+  constexpr size_t kText = 4 + 572, kTextChars = 40;
+  memory::store_and_swap<uint32_t>(info + 0, song.handle);
+  const std::u16string* fields[] = {&song.name, &song.artist, &song.album, &song.album_artist,
+                                    &song.genre};
+  for (size_t i = 0; i < 5; ++i) {
+    uint8_t* field = info + kText + i * kTextChars * 2;
+    std::memset(field, 0, kTextChars * 2);
+    const std::u16string_view text(fields[i]->data(),
+                                   std::min(fields[i]->size(), kTextChars - 1));
+    memory::store_and_swap<std::u16string_view>(field, text);
+  }
+  memory::store_and_swap<uint32_t>(info + kText + 400, song.track_number);
+  memory::store_and_swap<uint32_t>(info + kText + 404, song.duration_ms);
+  memory::store_and_swap<uint32_t>(info + kText + 408, static_cast<uint32_t>(song.format));
+}
