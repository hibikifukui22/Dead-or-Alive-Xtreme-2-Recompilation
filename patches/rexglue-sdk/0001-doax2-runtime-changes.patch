+namespace {
+// DOAX2 incremental resolve state. EDRAM tiles are stamped with the current
+// epoch when a draw claims them, a transfer writes them or a resolve clears
+// them; each resolve destination remembers its full resolve info and the
+// epoch of its last resolve. Protected by the global critical region (the
+// destination watch runs from memory access handlers).
+struct Doax2ResolveRecord {
+  draw_util::ResolveInfo info;
+  uint64_t epoch = 0;
+  bool valid = false;
+};
+struct Doax2IncrementalResolve {
+  uint64_t epoch = 1;
+  std::array<uint64_t, xenos::kEdramTileCount> tile_epoch{};
+  std::unordered_map<uint64_t, Doax2ResolveRecord> records;
+  uint64_t in_resolve_key = 0;
+  SharedMemory::GlobalWatchHandle watch = nullptr;
+  uint64_t full = 0, partial = 0, skipped = 0, partial_rows = 0, full_rows = 0;
+  void Stamp(uint32_t first_tile, uint32_t end_tile) {
+    for (uint32_t tile = first_tile; tile < end_tile; ++tile) tile_epoch[tile % xenos::kEdramTileCount] = epoch;
+  }
+  void StampSpan(uint32_t base, uint32_t row_length, uint32_t rows, uint32_t pitch) {
+    for (uint32_t row = 0; row < rows; ++row) Stamp(base + row * pitch, base + row * pitch + row_length);
+  }
+  static void Watch(const std::unique_lock<std::recursive_mutex>& global_lock, void* context,
+                    uint32_t address_first, uint32_t address_last, bool invalidated_by_gpu) {
+    auto& state = *static_cast<Doax2IncrementalResolve*>(context);
+    for (auto& [key, record] : state.records) {
+      if (!record.valid || key == state.in_resolve_key) continue;
+      const uint32_t start = record.info.copy_dest_extent_start & 0x1FFFFFFF;
+      const uint32_t end = start + record.info.copy_dest_extent_length;
+      if (address_last >= start && address_first < end) record.valid = false;
+    }
+  }
+};
+Doax2IncrementalResolve doax2_incremental;
+rex::thread::global_critical_region doax2_incremental_region;
+// F7 toggles the mode at runtime (A/B testing); every toggle drops all
+// records so state from a disabled period can never be trusted.
+bool doax2_incremental_on = true;
+bool Doax2IncrementalEnabled() {
+  if (!REXCVAR_GET(d3d12_doax2_incremental_resolve)) return false;
+  static bool f7_was_down = false;
+  const bool f7_down = (GetAsyncKeyState(VK_F7) & 0x8000) != 0;
+  if (f7_down && !f7_was_down) {
+    auto global_lock = doax2_incremental_region.Acquire();
+    doax2_incremental_on = !doax2_incremental_on;
+    doax2_incremental.records.clear();
+    REXGPU_INFO("DOAX2 incremental resolve toggled by F7: {}", doax2_incremental_on ? "ON" : "OFF");
+  }
+  f7_was_down = f7_down;
+  return doax2_incremental_on;
+}
