+void D3D12CommandProcessor::AwaitAsyncSubmissions() {
+  if (!submission_thread_.joinable()) {
+    return;
+  }
+  std::unique_lock<std::mutex> lock(submission_mutex_);
+  submission_done_.wait(lock, [this]() { return !submissions_in_flight_; });
