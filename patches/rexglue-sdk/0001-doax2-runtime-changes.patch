+void SharedMemory::SetSystemPageBlocksValidWithGpuDataWritten(bool all_pages) {
   auto global_lock = global_critical_region_.Acquire();
 
   // Pages that are valid only because the CPU uploaded them lose their valid
-  // bit here, so the next frame re-reads them from guest memory.
-  system_page_flags_valid_ = system_page_flags_valid_and_gpu_written_;
+  // bit here, so the next frame re-reads them from guest memory (games may
+  // write memory bypassing the access callbacks).
+  const uint32_t interval =
+      uint32_t(std::max(REXCVAR_GET(gpu_page_state_refresh_interval), int32_t(1)));
+  if (all_pages || interval <= 1 || !REXCVAR_GET(gpu_shared_memory_skip_unchanged_uploads) ||
+      page_blocks_refresh_every_frame_.size() != num_system_page_flags_) {
+    system_page_flags_valid_ = system_page_flags_valid_and_gpu_written_;
+    return;
+  }
+  // With content hashes, such writes are detected: blocks where they were seen
+  // are rechecked every frame, others in a rotating 1 / interval of the pages
+  // (finding new blocks with such writes within the interval).
+  const uint32_t phase = page_state_refresh_frame_++ % interval;
+  uint64_t recheck_pages = 0;
+  for (uint32_t page = phase; page < 64; page += interval) {
+    recheck_pages |= uint64_t(1) << page;
+  }
+  const bool verify = REXCVAR_GET(gpu_page_state_verify) && !page_upload_hashes_.empty();
+  uint32_t verified = 0, stale = 0;
+  for (uint32_t i = 0; i < num_system_page_flags_; ++i) {
+    const uint64_t cpu_uploaded =
+        system_page_flags_valid_[i] & ~system_page_flags_valid_and_gpu_written_[i];
+    if (cpu_uploaded) {
+      system_page_flags_valid_[i] &=
+          ~(page_blocks_refresh_every_frame_[i] ? cpu_uploaded : (cpu_uploaded & recheck_pages));
+      if (verify) {
+        // Pages staying valid (not rechecked next frame) must still have
+        // their uploaded contents.
+        uint64_t kept = system_page_flags_valid_[i] & cpu_uploaded;
+        uint32_t bit;
+        while (rex::bit_scan_forward(kept, &bit)) {
+          kept &= ~(uint64_t(1) << bit);
+          const uint32_t page = (i << 6) + bit;
+          const uint64_t last_hash = page_upload_hashes_[page];
+          if (!last_hash) {
+            continue;
+          }
+          ++verified;
+          const uint64_t hash = XXH3_64bits(memory_.TranslatePhysical(page << page_size_log2_),
+                                            size_t(1) << page_size_log2_) |
+                                1;
+          if (hash != last_hash) {
+            if (++stale <= 8) {
+              REXGPU_WARN("Shared memory verify: page {:08X} stale (changed without callbacks)",
+                          page << page_size_log2_);
+            }
+          }
+        }
+      }
+    }
+  }
+  if (verify) {
+    static uint64_t total_verified = 0, total_stale = 0, frames = 0;
+    total_verified += verified;
+    total_stale += stale;
+    if (!(++frames % 300)) {
+      REXGPU_INFO("Shared memory verify: {} stale of {} kept pages over 300 frames", total_stale,
+                  total_verified);
+      total_verified = total_stale = 0;
+    }
+  }
 }
 
