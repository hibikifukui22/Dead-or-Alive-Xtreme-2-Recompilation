+bool D3D12RenderTargetCache::Doax2DrawBounds(const Shader& vertex_shader, int32_t& left,
+                                             int32_t& top, int32_t& right, int32_t& bottom) {
+  // A collapsed native tiling pass draws the union of the tiles, wider than
+  // the registers say.
+  if (command_processor_.Doax2NativeTilingCollapsing()) {
+    return false;
+  }
+  const RegisterFile& regs = register_file();
+  draw_util::Scissor scissor;
+  draw_util::GetScissor(regs, scissor, true);
+  left = int32_t(scissor.offset[0]);
+  top = int32_t(scissor.offset[1]);
+  right = left + int32_t(scissor.extent[0]);
+  bottom = top + int32_t(scissor.extent[1]);
+  auto intersect = [&](int32_t l, int32_t t, int32_t r, int32_t b) {
+    left = std::max(left, l);
+    top = std::max(top, t);
+    right = std::min(right, r);
+    bottom = std::min(bottom, b);
+  };
+  if (!regs.Get<reg::PA_CL_CLIP_CNTL>().clip_disable) {
+    // Clipped to the viewport (the host viewport also scissors).
+    auto vte = regs.Get<reg::PA_CL_VTE_CNTL>();
+    if (vte.vport_x_scale_ena && vte.vport_x_offset_ena && vte.vport_y_scale_ena &&
