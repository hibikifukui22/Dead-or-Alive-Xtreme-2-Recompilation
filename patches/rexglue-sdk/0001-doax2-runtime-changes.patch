+      case Command::kD3DOMSetRenderTargets: {
+        const auto& args = *reinterpret_cast<const D3DOMSetRenderTargetsArguments*>(stream);
+        target_active = false;
+        // The prototype intentionally accepts only the dominant ordinary
+        // single-color pass. MRT and targetless work remain native-only.
+        if (args.num_render_target_descriptors == 1) {
+          const auto* color = find_target(args.render_target_descriptors[0], false);
+          const auto* depth = args.depth_stencil
+                                  ? find_target(args.depth_stencil_descriptor, true)
+                                  : nullptr;
+          if (color && (!args.depth_stencil || depth)) {
+            D3D12_CPU_DESCRIPTOR_HANDLE color_handle = color->replacement;
+            D3D12_CPU_DESCRIPTOR_HANDLE depth_handle{};
