+void VulkanCommandProcessor::PassTimingBegin(const VkExtent2D& host_extent, const VkExtent2D& area,
+                                             bool transfer) {
+  if (!pass_timing_active_ || pass_timings_.size() >= 500) {
+    return;
+  }
+  if (pass_timings_.empty()) {
+    deferred_command_buffer_.CmdVkResetQueryPool(pass_timing_pool_, 0, 1000);
+    deferred_command_buffer_.CmdVkResetQueryPool(draw_timing_pool_, 0, 6000);
+  }
+  const RegisterFile& regs = *register_file_;
+  PassTiming& timing = pass_timings_.emplace_back();
+  timing.host_extent = host_extent;
+  timing.area = area;
+  timing.draws = 0;
+  timing.samples = 1u << uint32_t(regs.Get<reg::RB_SURFACE_INFO>().msaa_samples);
+  timing.color_info = regs[XE_GPU_REG_RB_COLOR_INFO];
+  timing.transfer = transfer;
+  deferred_command_buffer_.CmdVkWriteTimestamp(VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT,
+                                               pass_timing_pool_,
+                                               uint32_t(pass_timings_.size() - 1) * 2);
+  pass_timing_open_ = true;
+}
+
+void VulkanCommandProcessor::PassTimingEnd() {
+  if (!pass_timing_open_) {
+    return;
+  }
+  pass_timing_open_ = false;
+  deferred_command_buffer_.CmdVkWriteTimestamp(VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT,
+                                               pass_timing_pool_,
+                                               uint32_t(pass_timings_.size() - 1) * 2 + 1);
+}
+
+void VulkanCommandProcessor::FinishPassTiming() {
+  pass_timing_active_ = false;
+  if (!BeginSubmission(true)) {
+    return;
+  }
+  SubmitBarriers(true);
+  EndRenderPass();
+  const uint32_t count = uint32_t(pass_timings_.size());
+  if (!AwaitAllQueueOperationsCompletion() || !count) {
+    pass_timings_.clear();
+    return;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  std::vector<uint64_t> stamps(size_t(count) * 2);
+  VkResult result = dfn.vkGetQueryPoolResults(
+      vulkan_device->device(), pass_timing_pool_, 0, count * 2, stamps.size() * sizeof(uint64_t),
+      stamps.data(), sizeof(uint64_t), VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WAIT_BIT);
+  if (result != VK_SUCCESS) {
+    REXGPU_ERROR("DOAX2 pass timing: failed to read the timestamps ({})", int32_t(result));
+    pass_timings_.clear();
+    return;
+  }
+  const double to_ms = double(vulkan_device->properties().timestampPeriod) / 1000000.0;
+  struct Bucket {
+    double ms = 0.0;
+    uint64_t pixels = 0;
+    uint32_t passes = 0;
+    uint32_t draws = 0;
+  };
+  std::map<std::string, Bucket> buckets;
+  double pass_ms = 0.0, gap_ms = 0.0;
+  for (uint32_t i = 0; i < count; ++i) {
+    const PassTiming& timing = pass_timings_[i];
+    const double ms = double(stamps[size_t(i) * 2 + 1] - stamps[size_t(i) * 2]) * to_ms;
+    pass_ms += ms;
+    if (i) {
+      gap_ms += double(stamps[size_t(i) * 2] - stamps[size_t(i) * 2 - 1]) * to_ms;
+    }
+    Bucket& bucket = buckets[fmt::format(
+        "{} target {}x{} area {}x{} {}x color {:08X}", timing.transfer ? "copy" : "draw",
+        timing.host_extent.width, timing.host_extent.height, timing.area.width, timing.area.height,
+        timing.samples, timing.color_info)];
+    bucket.ms += ms;
+    bucket.pixels += uint64_t(timing.area.width) * timing.area.height;
+    ++bucket.passes;
+    bucket.draws += timing.draws;
+  }
+  REXGPU_INFO("DOAX2 pass timing: {} passes {:.2f} ms, between passes {:.2f} ms, span {:.2f} ms",
+              count, pass_ms, gap_ms, double(stamps.back() - stamps.front()) * to_ms);
+  if (!draw_timings_.empty()) {
+    std::vector<uint64_t> draw_stamps(draw_timings_.size() * 2);
+    if (dfn.vkGetQueryPoolResults(vulkan_device->device(), draw_timing_pool_, 0,
+                                  uint32_t(draw_stamps.size()),
+                                  draw_stamps.size() * sizeof(uint64_t), draw_stamps.data(),
+                                  sizeof(uint64_t),
+                                  VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WAIT_BIT) == VK_SUCCESS) {
+      struct ShaderBucket {
+        double ms = 0.0;
+        uint64_t vertices = 0;
+        uint32_t draws = 0;
+        uint32_t vertex_dwords = 0;
+        uint32_t pixel_dwords = 0;
+      };
+      std::map<std::pair<uint64_t, uint64_t>, ShaderBucket> shaders;
+      double draw_ms = 0.0;
+      uint64_t vertices = 0;
+      for (size_t i = 0; i < draw_timings_.size(); ++i) {
+        const DrawTiming& timing = draw_timings_[i];
+        const double ms = double(draw_stamps[i * 2 + 1] - draw_stamps[i * 2]) * to_ms;
+        ShaderBucket& bucket = shaders[{timing.vertex_shader, timing.pixel_shader}];
+        bucket.ms += ms;
+        bucket.vertices += timing.vertices;
+        ++bucket.draws;
+        bucket.vertex_dwords = timing.vertex_dwords;
+        bucket.pixel_dwords = timing.pixel_dwords;
+        draw_ms += ms;
+        vertices += timing.vertices;
+      }
+      REXGPU_INFO("DOAX2 draw timing: {} draws {:.2f} ms, {} vertices, {} shader pairs",
+                  draw_timings_.size(), draw_ms, vertices, shaders.size());
+      std::vector<std::pair<double, std::pair<uint64_t, uint64_t>>> sorted_shaders;
+      for (const auto& shader : shaders) {
+        sorted_shaders.emplace_back(shader.second.ms, shader.first);
+      }
+      std::sort(sorted_shaders.rbegin(), sorted_shaders.rend());
+      for (size_t i = 0; i < sorted_shaders.size() && i < 20; ++i) {
+        const ShaderBucket& bucket = shaders[sorted_shaders[i].second];
+        REXGPU_INFO(
+            "DOAX2 draw timing: {:.2f} ms {} draws {} vertices VS {:016X} ({} dwords) PS {:016X} "
+            "({} dwords)",
+            bucket.ms, bucket.draws, bucket.vertices, sorted_shaders[i].second.first,
+            bucket.vertex_dwords, sorted_shaders[i].second.second, bucket.pixel_dwords);
+      }
+    }
+    draw_timings_.clear();
+  }
+  std::vector<std::pair<double, uint32_t>> gaps;
+  for (uint32_t i = 1; i < count; ++i) {
+    gaps.emplace_back(double(stamps[size_t(i) * 2] - stamps[size_t(i) * 2 - 1]) * to_ms, i);
+  }
+  std::sort(gaps.rbegin(), gaps.rend());
+  for (size_t i = 0; i < gaps.size() && i < 10; ++i) {
+    const PassTiming& before = pass_timings_[gaps[i].second - 1];
+    const PassTiming& after = pass_timings_[gaps[i].second];
+    REXGPU_INFO(
+        "DOAX2 pass timing: gap {:.2f} ms at pass {}: after {} {}x{} {}x draws {}, before {} "
+        "{}x{} {}x draws {}",
+        gaps[i].first, gaps[i].second, before.transfer ? "copy" : "draw", before.area.width,
+        before.area.height, before.samples, before.draws, after.transfer ? "copy" : "draw",
+        after.area.width, after.area.height, after.samples, after.draws);
+  }
+  std::vector<std::pair<double, const std::string*>> sorted;
+  for (const auto& bucket : buckets) {
+    sorted.emplace_back(bucket.second.ms, &bucket.first);
+  }
+  std::sort(sorted.rbegin(), sorted.rend());
+  for (size_t i = 0; i < sorted.size() && i < 16; ++i) {
+    const Bucket& bucket = buckets[*sorted[i].second];
+    REXGPU_INFO("DOAX2 pass timing: {:.2f} ms {} passes {} draws {:.1f} MP: {}", bucket.ms,
+                bucket.passes, bucket.draws, double(bucket.pixels) / 1000000.0, *sorted[i].second);
+  }
+  pass_timings_.clear();
+}
+
+void VulkanCommandProcessor::AddMemoryCheckRange(uint32_t address, uint32_t size, bool is_index) {
+  if (!memory_check_armed_ || !size || memory_check_ranges_.size() >= 512 ||
+      uint64_t(address) + size > SharedMemory::kBufferSize) {
+    return;
+  }
+  for (const MemoryCheckRange& range : memory_check_ranges_) {
+    if (range.address == address && range.size == size) {
+      return;
+    }
+  }
+  memory_check_ranges_.push_back({address, size, is_index});
+}
+
+void VulkanCommandProcessor::RunMemoryCheck() {
+  std::vector<MemoryCheckRange> ranges;
+  ranges.swap(memory_check_ranges_);
+  memory_check_armed_ = false;
+  memory_check_vertex_shaders_.clear();
+  constexpr uint64_t kMaxBytes = 32 * 1024 * 1024;
+  uint64_t total_size = 0;
+  size_t range_count = 0;
+  for (; range_count < ranges.size(); ++range_count) {
+    if (total_size + ranges[range_count].size > kMaxBytes) {
+      break;
+    }
+    total_size += ranges[range_count].size;
+  }
+  ranges.resize(range_count);
+  if (ranges.empty() || !BeginSubmission(true)) {
+    vs_capture_read_address_ = 0;
+    return;
+  }
+  constexpr uint32_t kCaptureSize = 4096 * 48 * sizeof(uint32_t);
+  const uint32_t capture_address = vs_capture_read_address_;
+  vs_capture_read_address_ = 0;
+  const uint64_t ranges_size = total_size;
+  if (capture_address) {
+    total_size += kCaptureSize;
+  }
+
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  VkBuffer readback_buffer = VK_NULL_HANDLE;
+  VkDeviceMemory readback_memory = VK_NULL_HANDLE;
+  uint32_t readback_memory_type = UINT32_MAX;
+  VkDeviceSize readback_memory_size = 0;
+  if (!ui::vulkan::util::CreateDedicatedAllocationBuffer(
+          vulkan_device, total_size, VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+          ui::vulkan::util::MemoryPurpose::kReadback, readback_buffer, readback_memory,
+          &readback_memory_type, &readback_memory_size)) {
+    REXGPU_ERROR("DOAX2 gpu memory check: failed to create the readback buffer");
+    return;
+  }
+  shared_memory_->Use(VulkanSharedMemory::Usage::kRead);
+  if (capture_address) {
+    PushBufferMemoryBarrier(shared_memory_->buffer(), capture_address, kCaptureSize,
+                            VK_PIPELINE_STAGE_VERTEX_SHADER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                            VK_ACCESS_SHADER_WRITE_BIT, VK_ACCESS_TRANSFER_READ_BIT);
+  }
+  SubmitBarriers(true);
+  if (capture_address) {
+    VkBufferCopy region = {};
+    region.srcOffset = capture_address;
+    region.dstOffset = ranges_size;
+    region.size = kCaptureSize;
+    deferred_command_buffer_.CmdVkCopyBuffer(shared_memory_->buffer(), readback_buffer, 1, &region);
+  }
+  VkDeviceSize offset = 0;
+  for (const MemoryCheckRange& range : ranges) {
+    VkBufferCopy region = {};
+    region.srcOffset = range.address;
+    region.dstOffset = offset;
+    region.size = range.size;
+    deferred_command_buffer_.CmdVkCopyBuffer(shared_memory_->buffer(), readback_buffer, 1, &region);
+    offset += range.size;
+  }
+  PushBufferMemoryBarrier(readback_buffer, 0, total_size, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                          VK_PIPELINE_STAGE_HOST_BIT, VK_ACCESS_TRANSFER_WRITE_BIT,
+                          VK_ACCESS_HOST_READ_BIT);
+  void* mapping = nullptr;
+  if (AwaitAllQueueOperationsCompletion() &&
+      dfn.vkMapMemory(device, readback_memory, 0, VK_WHOLE_SIZE, 0, &mapping) == VK_SUCCESS) {
+    if (!(vulkan_device->memory_types().host_coherent & (uint32_t(1) << readback_memory_type))) {
+      VkMappedMemoryRange mapped_range = {};
+      mapped_range.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+      mapped_range.memory = readback_memory;
+      mapped_range.size = VK_WHOLE_SIZE;
+      dfn.vkInvalidateMappedMemoryRanges(device, 1, &mapped_range);
+    }
+    {
+      // Guest data hashes, to compare with a run on another machine.
+      std::vector<MemoryCheckRange> sorted = ranges;
+      std::sort(sorted.begin(), sorted.end(),
+                [](const MemoryCheckRange& a, const MemoryCheckRange& b) {
+                  return a.address < b.address;
+                });
+      std::string hashes;
+      for (size_t i = 0; i < sorted.size() && i < 48; ++i) {
+        const uint8_t* data = memory_->TranslatePhysical<const uint8_t*>(sorted[i].address);
+        uint64_t hash = UINT64_C(14695981039346656037);
+        for (uint32_t j = 0; j < sorted[i].size; ++j) {
+          hash = (hash ^ data[j]) * UINT64_C(1099511628211);
+        }
+        hashes += fmt::format(" {:08X}+{}={:016X}", sorted[i].address, sorted[i].size, hash);
+      }
+      REXGPU_INFO("DOAX2 guest data hashes:{}", hashes);
+    }
+    if (capture_address) {
+      const uint32_t* capture = reinterpret_cast<const uint32_t*>(
+          reinterpret_cast<const uint8_t*>(mapping) + ranges_size);
+      uint32_t written = 0, zero = 0, non_finite = 0, behind = 0, compared = 0, different = 0,
+               shown = 0;
+      for (uint32_t index = 0; index < 4096; ++index) {
+        const uint32_t* slot = capture + index * 48;
+        if (slot[45] != 0xCAFE0001) {
+          continue;
+        }
+        ++written;
+        float position[4];
+        std::memcpy(position, &slot[40], sizeof(position));
+        const bool is_finite = std::isfinite(position[0]) && std::isfinite(position[1]) &&
+                               std::isfinite(position[2]) && std::isfinite(position[3]);
+        const bool is_zero = !position[0] && !position[1] && !position[3];
+        non_finite += !is_finite;
+        zero += is_zero;
+        behind += position[3] <= 0.0f;
+        bool is_different = false;
+        if (slot[44] == index && vs_capture_positions_.size() == 4096 * 4 &&
+            !std::isnan(vs_capture_positions_[index * 4 + 3])) {
+          ++compared;
+          for (uint32_t i = 0; i < 4; ++i) {
+            float expected = vs_capture_positions_[index * 4 + i];
+            is_different = is_different || !(std::fabs(expected - position[i]) <=
+                                             0.002f * std::max(1.0f, std::fabs(expected)));
+          }
+          different += is_different;
+        }
+        if ((is_different || !is_finite || is_zero) && shown < 6) {
+          ++shown;
+          REXGPU_INFO("DOAX2 capture bad vertex [{}] gpu {},{},{},{} cpu {},{},{},{}", slot[44],
+                      position[0], position[1], position[2], position[3],
+                      vs_capture_positions_[index * 4], vs_capture_positions_[index * 4 + 1],
+                      vs_capture_positions_[index * 4 + 2], vs_capture_positions_[index * 4 + 3]);
+        }
+      }
+      REXGPU_INFO(
+          "DOAX2 capture scan VS {:016X}: written {} compared {} different {} zero {} "
+          "non-finite {} behind camera {}",
+          vs_capture_read_shader_, written, compared, different, zero, non_finite, behind);
+      for (uint32_t index : vs_capture_indices_) {
+        const uint32_t* slot = capture + (index & 4095) * 48;
+        std::string registers;
+        for (uint32_t i = 0; i < 44; ++i) {
+          float value;
+          std::memcpy(&value, &slot[i], sizeof(value));
+          registers += fmt::format("{}{:.4f}", (i & 3) ? "," : (i == 40 ? " pos" : " r"), value);
+        }
+        REXGPU_INFO("DOAX2 capture gpu VS {:016X} [{}] slot index {} marker {:08X}{}",
+                    vs_capture_read_shader_, index, slot[44], slot[45], registers);
+      }
+    }
+    uint32_t matches[2] = {}, differs[2] = {}, zeros[2] = {}, samples = 0;
+    const uint8_t* gpu = reinterpret_cast<const uint8_t*>(mapping);
+    for (const MemoryCheckRange& range : ranges) {
+      const uint8_t* cpu = memory_->TranslatePhysical<const uint8_t*>(range.address);
+      if (!std::memcmp(gpu, cpu, range.size)) {
+        ++matches[range.is_index];
+      } else {
+        ++differs[range.is_index];
+        uint32_t first_difference = 0, different_bytes = 0;
+        bool all_zero = true;
+        for (uint32_t i = range.size; i-- > 0;) {
+          all_zero = all_zero && !gpu[i];
+          if (gpu[i] != cpu[i]) {
+            first_difference = i;
+            ++different_bytes;
+          }
+        }
+        zeros[range.is_index] += all_zero;
+        if (samples < 8) {
+          ++samples;
+          std::string gpu_hex, cpu_hex;
+          for (uint32_t i = first_difference; i < std::min(first_difference + 16, range.size); ++i) {
+            gpu_hex += fmt::format("{:02X}", gpu[i]);
+            cpu_hex += fmt::format("{:02X}", cpu[i]);
+          }
+          REXGPU_INFO(
+              "DOAX2 gpu memory check: {} {:08X}+{}: {} bytes differ, first at +{}: gpu {} cpu {}",
+              range.is_index ? "index" : "vertex", range.address, range.size, different_bytes,
+              first_difference, gpu_hex, cpu_hex);
+        }
+      }
+      gpu += range.size;
+    }
+    REXGPU_INFO(
