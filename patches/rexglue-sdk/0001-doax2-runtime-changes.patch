+bool D3D12Presenter::CompareGuestOutputWitnesses(const GuestOutputWitness& before,
+                                                 const GuestOutputWitness& after,
+                                                 uint64_t& hash_out) {
+  if (!before.readback || !after.readback || before.size != after.size ||
+      before.row_bytes != after.row_bytes ||
+      before.footprint.Footprint.Height != after.footprint.Footprint.Height) return false;
+  void* mappings[2]{};
+  D3D12_RANGE ranges[2] = {{0, SIZE_T(before.size)}, {0, SIZE_T(after.size)}};
+  bool equal = SUCCEEDED(before.readback->Map(0, &ranges[0], &mappings[0])) &&
+               SUCCEEDED(after.readback->Map(0, &ranges[1], &mappings[1]));
+  hash_out = 14695981039346656037ull;
+  if (equal) {
+    for (UINT row = 0; row < before.footprint.Footprint.Height; ++row) {
+      const size_t a_offset = size_t(before.footprint.Offset) +
+          size_t(row) * before.footprint.Footprint.RowPitch;
+      const size_t b_offset = size_t(after.footprint.Offset) +
+          size_t(row) * after.footprint.Footprint.RowPitch;
+      const auto* a = static_cast<const uint8_t*>(mappings[0]) + a_offset;
+      const auto* b = static_cast<const uint8_t*>(mappings[1]) + b_offset;
+      if (std::memcmp(a, b, size_t(before.row_bytes))) equal = false;
+      for (size_t i = 0; i < size_t(before.row_bytes); ++i)
+        hash_out = (hash_out ^ a[i]) * 1099511628211ull;
+    }
+  }
+  const D3D12_RANGE no_write{0, 0};
+  if (mappings[0]) before.readback->Unmap(0, &no_write);
+  if (mappings[1]) after.readback->Unmap(0, &no_write);
+  return equal;
+}
