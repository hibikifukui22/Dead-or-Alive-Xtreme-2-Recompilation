+// DOAX2 dirty-rectangle resolves (see RenderTargetCache::Doax2PrepareResolve).
+// EDRAM tiles are stamped with the current epoch when a draw can touch them,
+// a transfer writes them or a clear clears them; each resolve destination
+// remembers its full resolve info and the epoch of its last resolve.
+// Protected by the global critical region (the destination watch runs from
+// memory access handlers).
+namespace {
+struct Doax2ResolveRecord {
+  draw_util::ResolveInfo info;
+  uint64_t epoch = 0;
+  bool valid = false;
+};
+struct Doax2Incremental {
+  uint64_t epoch = 1;
+  std::array<uint64_t, xenos::kEdramTileCount> tile_epoch{};
+  std::unordered_map<uint64_t, Doax2ResolveRecord> records;
+  uint64_t in_resolve_key = 0;
+  bool partial_texture_reload = false;
+  SharedMemory::GlobalWatchHandle watch = nullptr;
+  uint64_t full = 0, partial = 0, skipped = 0, partial_area = 0, full_area = 0;
+  void Stamp(uint32_t first_tile, uint32_t end_tile) {
+    for (uint32_t tile = first_tile; tile < end_tile; ++tile) {
+      tile_epoch[tile % xenos::kEdramTileCount] = epoch;
+    }
+  }
+  static void Watch(const std::unique_lock<std::recursive_mutex>& global_lock, void* context,
+                    uint32_t address_first, uint32_t address_last, bool invalidated_by_gpu) {
+    auto& state = *static_cast<Doax2Incremental*>(context);
+    for (auto& [key, record] : state.records) {
+      if (!record.valid || key == state.in_resolve_key) continue;
+      const uint32_t start = record.info.copy_dest_extent_start & 0x1FFFFFFF;
+      const uint32_t end = start + record.info.copy_dest_extent_length;
+      if (address_last >= start && address_first < end) record.valid = false;
+    }
+  }
+};
+Doax2Incremental doax2_incremental_shared;
+rex::thread::global_critical_region doax2_incremental_shared_region;
+
+}  // namespace
+
+// Pixels of a render target in [left, right) x [top, bottom) to tiles within
+// [first_tile, end_tile) (claims beyond the EDRAM end are split into a wrapped
+// piece).
+void RenderTargetCache::Doax2StampKeyRect(RenderTargetKey key, int32_t left, int32_t top,
+                                          int32_t right, int32_t bottom, uint32_t first_tile,
+                                          uint32_t end_tile) {
+  const uint32_t pitch = key.GetPitchTiles();
+  left = std::max(left, int32_t(0));
+  top = std::max(top, int32_t(0));
+  if (!pitch || right <= left || bottom <= top) {
+    return;
+  }
+  const bool is_64bpp =
+      !key.is_depth &&
+      xenos::IsColorRenderTargetFormat64bpp(xenos::ColorRenderTargetFormat(key.resource_format));
+  const int32_t tile_width =
+      int32_t(xenos::kEdramTileWidthSamples >>
+              uint32_t(key.msaa_samples >= xenos::MsaaSamples::k4X)) >>
+      int32_t(is_64bpp);
+  const int32_t tile_height = int32_t(xenos::kEdramTileHeightSamples >>
+                                      uint32_t(key.msaa_samples >= xenos::MsaaSamples::k2X));
+  const uint32_t column_first = uint32_t(left / tile_width);
+  const uint32_t column_last = std::min(uint32_t((right - 1) / tile_width), pitch - 1);
+  const uint32_t row_first = uint32_t(top / tile_height);
+  const uint32_t row_last =
+      std::min(uint32_t((bottom - 1) / tile_height), xenos::kEdramTileCount / pitch + 1);
+  for (uint32_t row = row_first; row <= row_last; ++row) {
+    for (uint32_t column = column_first; column <= column_last; ++column) {
+      const uint32_t tile = key.base_tiles + row * pitch + column;
+      if (tile < first_tile || tile >= end_tile) {
+        const uint32_t wrapped = tile % xenos::kEdramTileCount;
+        if (wrapped < first_tile || wrapped >= end_tile) continue;
+      }
+      doax2_incremental_shared.tile_epoch[tile % xenos::kEdramTileCount] =
+          doax2_incremental_shared.epoch;
+    }
+  }
+}
+
+bool RenderTargetCache::Doax2IncrementalActive() const {
+  return REXCVAR_GET(d3d12_doax2_incremental_resolve) && GetPath() == Path::kHostRenderTargets;
+}
+
+void RenderTargetCache::Doax2MarkDraw(const Shader& vertex_shader, bool native_tiling_collapsing) {
+  if (!Doax2IncrementalActive()) {
+    return;
+  }
+  // The pixels the draw can touch: scissor, viewport (with clipping) and the
+  // vertices of small draws; unknown for collapsed native tiling passes
+  // (they draw the union of the tiles, wider than the registers say).
+  bool bounded = !native_tiling_collapsing;
+  int32_t left = 0, top = 0, right = 0, bottom = 0;
+  if (bounded) {
+    const RegisterFile& regs = register_file();
+    draw_util::Scissor scissor;
+    draw_util::GetScissor(regs, scissor, true);
+    left = int32_t(scissor.offset[0]);
+    top = int32_t(scissor.offset[1]);
+    right = left + int32_t(scissor.extent[0]);
+    bottom = top + int32_t(scissor.extent[1]);
+    auto intersect = [&](int32_t l, int32_t t, int32_t r, int32_t b) {
+      left = std::max(left, l);
+      top = std::max(top, t);
+      right = std::min(right, r);
+      bottom = std::min(bottom, b);
+    };
+    if (!regs.Get<reg::PA_CL_CLIP_CNTL>().clip_disable) {
+      auto vte = regs.Get<reg::PA_CL_VTE_CNTL>();
+      if (vte.vport_x_scale_ena && vte.vport_x_offset_ena && vte.vport_y_scale_ena &&
+          vte.vport_y_offset_ena) {
+        float x = 0.5f, y = 0.5f;
+        if (regs.Get<reg::PA_SU_SC_MODE_CNTL>().vtx_window_offset_enable) {
+          auto window_offset = regs.Get<reg::PA_SC_WINDOW_OFFSET>();
+          x += float(window_offset.window_x_offset);
+          y += float(window_offset.window_y_offset);
+        }
+        const float x_scale = std::abs(regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XSCALE));
+        const float y_scale = std::abs(regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YSCALE));
+        const float x_offset = regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XOFFSET) + x;
+        const float y_offset = regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YOFFSET) + y;
+        if (std::isfinite(x_scale) && std::isfinite(y_scale) && std::isfinite(x_offset) &&
+            std::isfinite(y_offset) && x_scale < 16384.0f && y_scale < 16384.0f &&
+            std::abs(x_offset) < 16384.0f && std::abs(y_offset) < 16384.0f) {
+          intersect(int32_t(std::floor(x_offset - x_scale)) - 2,
+                    int32_t(std::floor(y_offset - y_scale)) - 2,
+                    int32_t(std::ceil(x_offset + x_scale)) + 2,
+                    int32_t(std::ceil(y_offset + y_scale)) + 2);
+        }
+      }
+    }
+    int32_t vertex_left, vertex_top, vertex_right, vertex_bottom;
+    if (draw_extent_estimator().EstimateVertexBoundsCached(vertex_shader, 64, vertex_left,
+                                                          vertex_top, vertex_right,
+                                                          vertex_bottom)) {
+      intersect(vertex_left, vertex_top, vertex_right, vertex_bottom);
+    }
+    if (left >= right || top >= bottom) {
+      left = top = right = bottom = 0;
+    }
+  }
+  auto global_lock = doax2_incremental_shared_region.Acquire();
+  for (size_t i = 0; i < last_update_claim_count_; ++i) {
+    const UpdateClaim& claim = last_update_claims_[i];
+    if (bounded) {
+      RenderTargetKey key;
+      key.key = claim.key;
+      Doax2StampKeyRect(key, left, top, right, bottom, claim.first_tile, claim.end_tile);
+    } else {
+      doax2_incremental_shared.Stamp(claim.first_tile, claim.end_tile);
+    }
+  }
+}
+
+void RenderTargetCache::Doax2MarkTransfersAndClear(
+    uint32_t render_target_count, RenderTarget* const* render_targets,
+    const std::vector<Transfer>* render_target_transfers,
+    const Transfer::Rectangle* resolve_clear_rectangle) {
+  if (!Doax2IncrementalActive()) {
+    return;
+  }
+  auto global_lock = doax2_incremental_shared_region.Acquire();
+  for (uint32_t i = 0; i < render_target_count; ++i) {
+    if (!render_targets[i]) continue;
+    for (const Transfer& transfer : render_target_transfers[i]) {
+      doax2_incremental_shared.Stamp(transfer.start_tiles, transfer.end_tiles);
+    }
+    if (resolve_clear_rectangle) {
+      const int32_t x = int32_t(resolve_clear_rectangle->x_pixels);
+      const int32_t y = int32_t(resolve_clear_rectangle->y_pixels);
+      Doax2StampKeyRect(render_targets[i]->key(), x, y,
+                        x + int32_t(resolve_clear_rectangle->width_pixels),
+                        y + int32_t(resolve_clear_rectangle->height_pixels), 0,
+                        2 * xenos::kEdramTileCount);
+    }
+  }
+}
+
+bool RenderTargetCache::Doax2PrepareResolve(const memory::Memory& memory,
+                                            SharedMemory& shared_memory,
+                                            TextureCache& texture_cache,
+                                            draw_util::ResolveInfo& resolve_info,
+                                            bool fixed_rg16_truncated,
+                                            bool fixed_rgba16_truncated) {
+  if (Doax2IncrementalActive() && (resolve_info.IsClearingDepth() || resolve_info.IsClearingColor())) {
+    // Clearing resolves are never recorded, so the order does not matter.
+    auto global_lock = doax2_incremental_shared_region.Acquire();
+    uint32_t base, row_length, rows;
+    const auto stamp_span = [&](const draw_util::ResolveEdramInfo& edram_info) {
+      draw_util::GetResolveEdramTileSpan(edram_info, resolve_info.coordinate_info,
+                                         resolve_info.height_div_8, base, row_length, rows);
+      for (uint32_t row = 0; row < rows; ++row) {
+        doax2_incremental_shared.Stamp(base + row * edram_info.pitch_tiles,
+                                       base + row * edram_info.pitch_tiles + row_length);
+      }
+    };
+    if (resolve_info.IsClearingDepth()) stamp_span(resolve_info.depth_edram_info);
+    if (resolve_info.IsClearingColor()) stamp_span(resolve_info.color_edram_info);
+  }
+  if (!Doax2IncrementalActive() || !resolve_info.copy_dest_extent_length ||
+      resolve_info.IsCopyingDepth() || resolve_info.IsClearingDepth() ||
+      resolve_info.IsClearingColor() || !resolve_info.coordinate_info.width_div_8 ||
+      !resolve_info.height_div_8) {
+    return true;
+  }
+  if (!doax2_incremental_shared.watch) {
+    doax2_incremental_shared.watch =
+        shared_memory.RegisterGlobalWatch(Doax2Incremental::Watch, &doax2_incremental_shared);
+  }
+  const uint64_t key =
+      (uint64_t(resolve_info.copy_dest_base) << 32) | resolve_info.copy_dest_extent_start;
+  auto global_lock = doax2_incremental_shared_region.Acquire();
+  Doax2ResolveRecord& record = doax2_incremental_shared.records[key];
+  bool partial = false, skip = false;
+  draw_util::Doax2ResolveClip clip;
+  // A one-off resolve the CPU reads back (a photo's album thumbnail) is always copied in full:
+  // its draws are identical from photo to photo (only the texture differs), and if their
+  // estimated bounds miss the target, the copy would be skipped and the CPU would read the
+  // previous photo's thumbnail (issue #13, Vulkan).
+  const bool force_full = hires_capture::ForceFullReadback();
+  if (record.valid && std::memcmp(&record.info, &resolve_info, sizeof(resolve_info)) == 0) {
+    uint32_t base, row_length, rows, pitch;
+    resolve_info.GetCopyEdramTileSpan(base, row_length, rows, pitch);
+    int32_t row_min = INT32_MAX, row_max = -1, column_min = INT32_MAX, column_max = -1;
+    for (uint32_t row = 0; row < rows; ++row) {
+      for (uint32_t column = 0; column < row_length; ++column) {
+        if (doax2_incremental_shared
+                .tile_epoch[(base + row * pitch + column) % xenos::kEdramTileCount] >
+            record.epoch) {
+          row_min = std::min(row_min, int32_t(row));
+          row_max = std::max(row_max, int32_t(row));
+          column_min = std::min(column_min, int32_t(column));
+          column_max = std::max(column_max, int32_t(column));
+        }
+      }
+    }
+    if (row_max < 0) {
+      skip = true;
+    } else {
+      const xenos::MsaaSamples msaa = resolve_info.color_edram_info.msaa_samples;
+      const int32_t tile_width =
+          int32_t(xenos::kEdramTileWidthSamples >> uint32_t(msaa >= xenos::MsaaSamples::k4X)) >>
+          int32_t(resolve_info.color_edram_info.format_is_64bpp);
+      const int32_t tile_height =
+          int32_t(xenos::kEdramTileHeightSamples >> uint32_t(msaa >= xenos::MsaaSamples::k2X));
+      const int32_t offset_x = int32_t(resolve_info.coordinate_info.edram_offset_x_div_8 * 8);
+      const int32_t offset_y = int32_t(resolve_info.coordinate_info.edram_offset_y_div_8 * 8);
+      const int32_t width = int32_t(resolve_info.coordinate_info.width_div_8 * 8);
+      const int32_t height = int32_t(resolve_info.height_div_8 * 8);
+      clip.left = std::max(column_min * tile_width - offset_x, 0);
+      clip.right = std::min((column_max + 1) * tile_width - offset_x, width);
+      clip.top = std::max(row_min * tile_height - offset_y, 0);
+      clip.bottom = std::min((row_max + 1) * tile_height - offset_y, height);
+      // The half-pixel offset fill of the scaled resolve shader is relative to
+      // the resolved rectangle: keep the clip on the edge it fills, or drop the
+      // fill if the clip leaves both (interior pixels are not filled in a full
+      // resolve either).
+      if (clip.left >= 8 && clip.top >= 8) {
+        clip.keep_fill = false;
+      } else {
+        if (clip.left < 8) clip.left = 0;
+        if (clip.top < 8) clip.top = 0;
+        if (clip.left && !clip.top) clip.left = 0;
+        if (clip.top && !clip.left) clip.top = 0;
+      }
+      partial = clip.left > 0 || clip.top > 0 || clip.right < width - 7 || clip.bottom < height - 7;
+    }
+  }
+  if (force_full && (skip || partial)) {
+    static int logged = 0;
+    if (logged++ < 16) {
+      REXGPU_INFO("DOAX2 incremental resolve: read-back resolve at {:08X} would have been {}; "
+                  "copied in full",
+                  resolve_info.copy_dest_extent_start, skip ? "skipped" : "clipped");
+    }
+    skip = false;
+    partial = false;
+  }
+  record.info = resolve_info;
+  record.epoch = doax2_incremental_shared.epoch++;
+  record.valid = true;
+  if (skip) {
+    ++doax2_incremental_shared.skipped;
+  } else if (partial) {
+    ++doax2_incremental_shared.partial;
+    doax2_incremental_shared.partial_area +=
+        uint64_t(clip.right - clip.left) * (clip.bottom - clip.top);
+    doax2_incremental_shared.full_area +=
+        uint64_t(resolve_info.coordinate_info.width_div_8 * 8) * (resolve_info.height_div_8 * 8);
+  } else {
+    ++doax2_incremental_shared.full;
+  }
+  const uint64_t total = doax2_incremental_shared.full + doax2_incremental_shared.partial +
+                         doax2_incremental_shared.skipped;
+  if (total % 3000 == 0) {
+    REXGPU_INFO(
+        "DOAX2 incremental resolves: {} skipped (unchanged), {} partial ({:.0f}% of the area), {} "
+        "full",
+        doax2_incremental_shared.skipped, doax2_incremental_shared.partial,
+        doax2_incremental_shared.full_area
+            ? 100.0 * double(doax2_incremental_shared.partial_area) /
+                  double(doax2_incremental_shared.full_area)
+            : 0.0,
+        doax2_incremental_shared.full);
+  }
+  if (skip) {
+    return false;
+  }
+  doax2_incremental_shared.in_resolve_key = key;
+  // Textures at the destination reload only the rows the resolve writes - the
+  // changed rectangle, or for a full resolve its own rows (a resolve often
+  // covers only a part of the texture).
+  draw_util::Doax2ResolveClip rows_clip;
+  if (partial) {
+    rows_clip = clip;
+  } else {
+    rows_clip.right = rows_clip.bottom = INT32_C(1) << 20;
+  }
+  const draw_util::ResolveInfo full_info = resolve_info;
+  if (!draw_util::GetResolveInfo(register_file(), memory, draw_resolution_scale_x(),
+                                 draw_resolution_scale_y(), fixed_rg16_truncated,
+                                 fixed_rgba16_truncated, resolve_info, &rows_clip) ||
+      !resolve_info.coordinate_info.width_div_8 || !resolve_info.height_div_8 ||
+      (!partial && std::memcmp(&full_info, &resolve_info, sizeof(resolve_info)) != 0)) {
+    resolve_info = full_info;
+    return true;
+  }
+  const xenos::TextureFormat dest_format =
+      xenos::TextureFormat(full_info.copy_dest_info.copy_dest_format);
+  const uint32_t dest_bytes = FormatInfo::Get(dest_format)->bits_per_pixel >> 3;
+  if (dest_bytes && !full_info.copy_dest_info.copy_dest_array) {
+    // Destination texture rows are the resolve's y coordinates.
+    texture_cache.Doax2BeginPartialResolve(
+        register_file()[XE_GPU_REG_RB_COPY_DEST_BASE],
+        full_info.copy_dest_coordinate_info.pitch_aligned_div_32, rex::log2_floor(dest_bytes),
+        uint32_t(std::max(rows_clip.y0, 0)), uint32_t(std::max(rows_clip.y1, 0)),
+        resolve_info.copy_dest_extent_start, resolve_info.copy_dest_extent_length);
+    doax2_incremental_shared.partial_texture_reload = true;
+  }
+  return true;
+}
+
+void RenderTargetCache::Doax2EndResolve(TextureCache& texture_cache) {
+  bool partial_texture_reload;
+  {
+    auto global_lock = doax2_incremental_shared_region.Acquire();
+    doax2_incremental_shared.in_resolve_key = 0;
+    partial_texture_reload = doax2_incremental_shared.partial_texture_reload;
+    doax2_incremental_shared.partial_texture_reload = false;
+  }
+  if (partial_texture_reload) {
+    texture_cache.Doax2EndPartialResolve();
+  }
+}
