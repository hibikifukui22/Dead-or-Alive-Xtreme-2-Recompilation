+
+// Saves the callee-saved registers (x19-x30, d8-d15) on the current stack,
+// stores sp to *from_sp, switches to to_sp and restores the same layout.
+extern "C" void rex_fiber_switch(void** from_sp, void* to_sp);
+asm(R"(
+  .text
+  .global rex_fiber_switch
+  .type rex_fiber_switch, %function
+  .p2align 2
+rex_fiber_switch:
