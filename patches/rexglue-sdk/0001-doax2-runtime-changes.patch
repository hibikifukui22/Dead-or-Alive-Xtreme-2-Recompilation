+// CPU-only, fail-closed lineage of host RT contents and EDRAM tile ownership.
+// A version identifies content produced by one event, not an owned GPU
+// allocation. The caller must supply events in their real execution order and
+// prove every draw footprint, sampled input, conversion and resolve layout.
+// This graph never retains or submits a native GPU resource or descriptor.
+class OwnerLineage {
+ public:
+  static constexpr uint32_t kEdramTiles = 2048;
+  enum class Kind {
+    kOwnedSeed, kUnknownSeed, kTransfer, kDraw, kClear, kResolve,
+    kTextureConsumer
+  };
+  enum class Failure {
+    kNone, kMissingSourceVersion, kUnprovenInput, kUnprovenConversion,
+    kUnprovenResolveLayout, kInvalidRegion, kWrongOwner,
+    kAmbiguousOwnership
+  };
+  struct Producer {
+    uint64_t version = 0;
+    Kind kind = Kind::kUnknownSeed;
+    uint32_t resource_key = 0;
+    uint32_t source_key = 0;
+    uint32_t first_tile = 0, end_tile = 0;
+    size_t draw_ordinal = SIZE_MAX;
+    std::vector<uint64_t> dependencies;
+    std::vector<uint32_t> owner_keys;
+    Failure failure = Failure::kNone;
+  };
+  struct Trace {
+    bool complete = false;
+    uint64_t missing_output_pixels = 0;
+    std::vector<uint64_t> versions;
+    std::vector<uint64_t> failed_versions;
+    std::vector<uint32_t> terminal_owner_keys;
+  };
+  struct TransferPlan {
+    uint32_t source = 0, destination = 0;
+    uint32_t first_tile = 0, end_tile = 0;
+    bool conversion_proven = false;
+  };
+  struct ClaimPlan {
+    uint32_t destination = 0;
+    uint32_t first_tile = 0, end_tile = 0;
+  };
+  struct BatchResult {
+    bool valid = false;
+    size_t transfers = 0, unknown_claim_pieces = 0;
+  };
+
+  explicit OwnerLineage(uint32_t output_width = 1280,
+                        uint32_t output_height = 720)
+      : owners_(kEdramTiles, 1), output_(output_width, output_height) {
+    producers_.push_back({});  // Version zero is never a producer.
+  }
+
+  const Producer* Find(uint64_t version) const {
+    return version && version < producers_.size() ? &producers_[version] : nullptr;
+  }
+
+  // A seed is acceptable only after the caller has separately established
+  // independent backing, a valid content snapshot and its protecting fence.
+  uint64_t Seed(uint32_t key, uint32_t first, uint32_t end,
+                bool independently_owned, bool becomes_owner = true) {
+    if (!Valid(key, first, end)) return 0;
+    const uint64_t id = Add(independently_owned ? Kind::kOwnedSeed : Kind::kUnknownSeed,
+                            key, 0, first, end, SIZE_MAX, {},
+                            independently_owned ? Failure::kNone : Failure::kUnprovenInput);
+    if (!Resource(key).Write(Tiles(first, end), id) ||
+        (becomes_owner && !owners_.Write(Tiles(first, end), uint64_t(key) + 1)))
+      producers_[id].failure = Failure::kInvalidRegion;
+    return id;
+  }
+
+  // A bind/claim with no transfer changes ownership but does not establish
+  // valid pixels. Its unknown version is replaced only by a proven complete
+  // clear or full overwrite; a read-modify-write draw stays incomplete.
+  uint64_t ClaimUnknown(uint32_t key, uint32_t first, uint32_t end) {
+    return Seed(key, first, end, false);
+  }
+
+  // After the batch's source transfers have been applied, complete the
+  // draw-time ownership claim. Preserve tiles that were already owned by the
+  // destination; never invent content for gaps or a changed owner without a
+  // corresponding transfer. Claims are not GPU writes by themselves.
+  std::vector<uint64_t> ClaimRemainderUnknown(uint32_t key, uint32_t first,
+                                              uint32_t end) {
+    std::vector<uint64_t> unknowns;
+    if (!Valid(key, first, end)) return unknowns;
+    RegionRead owners = owners_.Read(Tiles(first, end));
+    std::sort(owners.pieces.begin(), owners.pieces.end(),
+              [](const RegionVersion& a, const RegionVersion& b) {
+                return a.rect.left < b.rect.left;
+              });
+    uint32_t next = first;
+    for (const auto& piece : owners.pieces) {
+      if (next < piece.rect.left)
+        unknowns.push_back(ClaimUnknown(key, next, piece.rect.left));
+      if (piece.version != uint64_t(key) + 1)
+        unknowns.push_back(ClaimUnknown(key, piece.rect.left,
+                                        piece.rect.right));
+      next = piece.rect.right;
+    }
+    if (next < end) unknowns.push_back(ClaimUnknown(key, next, end));
+    return unknowns;
+  }
+
+  // A recorded transfer source identifies the prior owner, but not its
+  // pixels. Fill only previously unobserved ownership gaps with failing
+  // unknown-content seeds; never replace a conflicting recorded owner.
+  void BootstrapUnknownTransferSource(uint32_t key, uint32_t first,
+                                      uint32_t end) {
+    if (!Valid(key, first, end)) return;
+    RegionRead owners = owners_.Read(Tiles(first, end));
+    std::sort(owners.pieces.begin(), owners.pieces.end(),
+              [](const RegionVersion& a, const RegionVersion& b) {
+                return a.rect.left < b.rect.left;
+              });
+    uint32_t next = first;
+    for (const auto& piece : owners.pieces) {
+      if (next < piece.rect.left) Seed(key, next, piece.rect.left, false);
+      next = piece.rect.right;
+    }
+    if (next < end) Seed(key, next, end, false);
+  }
+
+  // Normalize one draw-boundary ownership batch. ReXGlue records claims
+  // before scheduling their transfers; content lineage must do the reverse.
+  // Reject non-disjoint or unclaimed transfers rather than guessing order.
+  BatchResult ApplyOwnershipBatch(std::span<const TransferPlan> transfers,
+                                  std::span<const ClaimPlan> claims) {
+    BatchResult result;
+    for (const auto& claim : claims)
+      if (!Valid(claim.destination, claim.first_tile, claim.end_tile))
+        return result;
+    for (size_t i = 0; i < claims.size(); ++i)
+      for (size_t j = i + 1; j < claims.size(); ++j)
+        if (claims[i].first_tile < claims[j].end_tile &&
+            claims[j].first_tile < claims[i].end_tile)
+          return result;
+    for (const auto& transfer : transfers) {
+      if (!Valid(transfer.source, transfer.first_tile, transfer.end_tile) ||
+          !Valid(transfer.destination, transfer.first_tile, transfer.end_tile))
+        return result;
+      bool covered = false;
+      for (const auto& claim : claims)
+        covered |= claim.destination == transfer.destination &&
+                   claim.first_tile <= transfer.first_tile &&
+                   claim.end_tile >= transfer.end_tile;
+      if (!covered) return result;
+    }
+    for (size_t i = 0; i < transfers.size(); ++i)
+      for (size_t j = i + 1; j < transfers.size(); ++j)
+        if (transfers[i].destination == transfers[j].destination &&
+            transfers[i].first_tile < transfers[j].end_tile &&
+            transfers[j].first_tile < transfers[i].end_tile)
+          return result;
+    for (const auto& transfer : transfers) {
+      BootstrapUnknownTransferSource(transfer.source, transfer.first_tile,
+                                     transfer.end_tile);
+      Transfer(transfer.source, transfer.destination, transfer.first_tile,
+               transfer.end_tile, transfer.conversion_proven);
+      ++result.transfers;
+    }
+    for (const auto& claim : claims)
+      result.unknown_claim_pieces +=
+          ClaimRemainderUnknown(claim.destination, claim.first_tile,
+                                claim.end_tile).size();
+    result.valid = true;
+    return result;
+  }
+
+  uint64_t Transfer(uint32_t source, uint32_t destination, uint32_t first,
+                    uint32_t end, bool conversion_proven) {
+    if (!Valid(source, first, end) || !Valid(destination, first, end)) return 0;
+    const RegionRead read = Resource(source).Read(Tiles(first, end));
+    const RegionRead owners = owners_.Read(Tiles(first, end));
+    const bool source_owns_all = owners.complete &&
+        owners.versions.size() == 1 && owners.versions[0] == uint64_t(source) + 1;
+    const uint64_t id = Add(Kind::kTransfer, destination, source, first, end,
+                            SIZE_MAX, read.versions,
+                            !source_owns_all ? Failure::kWrongOwner
+                            : !read.complete ? Failure::kMissingSourceVersion
+                            : !conversion_proven ? Failure::kUnprovenConversion
+                            : Failure::kNone);
+    if (!Resource(destination).Write(Tiles(first, end), id) ||
+        !owners_.Write(Tiles(first, end), uint64_t(destination) + 1))
+      producers_[id].failure = Failure::kInvalidRegion;
+    return id;
+  }
+
+  // A draw is conservatively read-modify-write unless a full overwrite has
+  // been independently proven. External texture, pose, shader and descriptor
+  // inputs must each have a producer supplied in input_versions; otherwise
+  // inputs_proven must be false. A caller must not guess the written tiles.
+  uint64_t Draw(uint32_t target, uint32_t first, uint32_t end,
+                size_t ordinal, std::span<const uint64_t> input_versions,
+                bool inputs_proven, bool full_overwrite_proven = false) {
+    if (!Valid(target, first, end)) return 0;
+    std::vector<uint64_t> deps(input_versions.begin(), input_versions.end());
+    Failure failure = inputs_proven ? Failure::kNone : Failure::kUnprovenInput;
+    const RegionRead owners = owners_.Read(Tiles(first, end));
+    if (!owners.complete || owners.versions.size() != 1 ||
+        owners.versions[0] != uint64_t(target) + 1)
+      failure = Failure::kWrongOwner;
+    if (!full_overwrite_proven) {
+      const RegionRead prior = Resource(target).Read(Tiles(first, end));
+      deps.insert(deps.end(), prior.versions.begin(), prior.versions.end());
+      if (!prior.complete && failure == Failure::kNone)
+        failure = Failure::kMissingSourceVersion;
+    }
+    for (const uint64_t input : input_versions)
+      if (!Find(input)) failure = Failure::kMissingSourceVersion;
+    const uint64_t id = Add(Kind::kDraw, target, 0, first, end, ordinal,
+                            std::move(deps), failure);
+    if (!Resource(target).Write(Tiles(first, end), id) ||
+        !owners_.Write(Tiles(first, end), uint64_t(target) + 1))
+      producers_[id].failure = Failure::kInvalidRegion;
+    return id;
+  }
+
+  uint64_t Clear(uint32_t target, uint32_t first, uint32_t end,
+                 bool complete_clear_proven) {
+    if (!Valid(target, first, end)) return 0;
+    const uint64_t id = Add(Kind::kClear, target, 0, first, end, SIZE_MAX, {},
+                            complete_clear_proven ? Failure::kNone
+                                                  : Failure::kUnprovenInput);
+    if (!Resource(target).Write(Tiles(first, end), id) ||
+        !owners_.Write(Tiles(first, end), uint64_t(target) + 1))
+      producers_[id].failure = Failure::kInvalidRegion;
+    return id;
+  }
+
+  // Resolve from the actual current tile owners to one decoded output region.
+  // The output layout contract must be proven separately (tiling, pitch,
+  // sample selection, destination rectangle and any intervening writes).
+  uint64_t Resolve(uint32_t first, uint32_t end, Rect output_rect,
+                   bool layout_proven) {
+    if (!ValidTileRange(first, end)) return 0;
+    const RegionRead owners = owners_.Read(Tiles(first, end));
+    std::vector<uint64_t> deps;
+    Failure failure = !owners.complete ? Failure::kMissingSourceVersion
+                      : !layout_proven ? Failure::kUnprovenResolveLayout
+                      : Failure::kNone;
+    std::vector<uint32_t> owner_keys;
+    for (const auto& piece : owners.pieces) {
+      const uint32_t key = uint32_t(piece.version - 1);
+      owner_keys.push_back(key);
+      const RegionRead content = Resource(key).Read(piece.rect);
+      deps.insert(deps.end(), content.versions.begin(), content.versions.end());
+      if (!content.complete) failure = Failure::kMissingSourceVersion;
+    }
+    const uint64_t id = Add(Kind::kResolve, 0, 0, first, end, SIZE_MAX,
+                            std::move(deps), failure);
+    std::sort(owner_keys.begin(), owner_keys.end());
+    owner_keys.erase(std::unique(owner_keys.begin(), owner_keys.end()),
+                     owner_keys.end());
+    producers_[id].owner_keys = std::move(owner_keys);
+    if (!output_.Write(output_rect, id))
+      producers_[id].failure = Failure::kInvalidRegion;
+    return id;
+  }
+
+  // A resolved intermediate texture is a distinct logical guest image. A
+  // later draw receives a texture-consumer producer, never a retained native
+  // descriptor or an assumed guest-memory snapshot of GPU-produced pixels.
+  uint64_t ResolveTexture(uint32_t texture_key, uint32_t width, uint32_t height,
+                          uint32_t first, uint32_t end, Rect texture_rect,
+                          bool layout_proven) {
+    if (!texture_key || !width || !height || !ValidTileRange(first, end)) return 0;
+    auto [it, inserted] = textures_.try_emplace(texture_key, width, height);
+    if (!inserted && (texture_sizes_[texture_key].first != width ||
+                      texture_sizes_[texture_key].second != height)) return 0;
+    texture_sizes_[texture_key] = {width, height};
+    const RegionRead owners = owners_.Read(Tiles(first, end));
+    std::vector<uint64_t> deps;
+    Failure failure = !owners.complete ? Failure::kMissingSourceVersion
+                      : !layout_proven ? Failure::kUnprovenResolveLayout
+                      : Failure::kNone;
+    std::vector<uint32_t> owner_keys;
+    for (const auto& piece : owners.pieces) {
+      const uint32_t key = uint32_t(piece.version - 1);
+      owner_keys.push_back(key);
+      const RegionRead content = Resource(key).Read(piece.rect);
+      deps.insert(deps.end(), content.versions.begin(), content.versions.end());
+      if (!content.complete) failure = Failure::kMissingSourceVersion;
+    }
+    const uint64_t id = Add(Kind::kResolve, texture_key, 0, first, end,
+                            SIZE_MAX, std::move(deps), failure);
+    std::sort(owner_keys.begin(), owner_keys.end());
+    owner_keys.erase(std::unique(owner_keys.begin(), owner_keys.end()),
+                     owner_keys.end());
+    producers_[id].owner_keys = std::move(owner_keys);
+    if (!it->second.Write(texture_rect, id))
+      producers_[id].failure = Failure::kInvalidRegion;
+    return id;
+  }
+
+  uint64_t ConsumeTexture(uint32_t texture_key, Rect texture_rect,
+                          bool binding_and_lifetime_proven) {
+    auto it = textures_.find(texture_key);
+    if (it == textures_.end()) return 0;
+    const RegionRead read = it->second.Read(texture_rect);
+    const uint64_t id = Add(Kind::kTextureConsumer, texture_key, 0, 0, 0,
+                            SIZE_MAX, read.versions,
+                            !read.complete ? Failure::kMissingSourceVersion
+                            : !binding_and_lifetime_proven ? Failure::kUnprovenInput
+                            : Failure::kNone);
+    return id;
+  }
+
+  Trace TraceOutput(Rect output_rect) const {
+    Trace result;
+    const RegionRead read = output_.Read(output_rect);
+    result.missing_output_pixels = read.missing_pixels;
+    result.complete = read.complete;
+    std::vector<bool> visited(producers_.size());
+    std::vector<uint64_t> pending(read.versions.begin(), read.versions.end());
+    while (!pending.empty()) {
+      const uint64_t id = pending.back();
+      pending.pop_back();
+      const Producer* producer = Find(id);
+      if (!producer) { result.complete = false; continue; }
+      if (visited[id]) continue;
+      visited[id] = true;
+      result.versions.push_back(id);
+      if (producer->failure != Failure::kNone) {
+        result.complete = false;
+        result.failed_versions.push_back(id);
+      }
+      if (producer->kind == Kind::kResolve)
+        result.terminal_owner_keys.insert(result.terminal_owner_keys.end(),
+                                          producer->owner_keys.begin(),
+                                          producer->owner_keys.end());
+      pending.insert(pending.end(), producer->dependencies.begin(),
+                     producer->dependencies.end());
+    }
+    std::sort(result.terminal_owner_keys.begin(), result.terminal_owner_keys.end());
+    result.terminal_owner_keys.erase(
+        std::unique(result.terminal_owner_keys.begin(),
+                    result.terminal_owner_keys.end()),
+        result.terminal_owner_keys.end());
+    return result;
+  }
+
+ private:
+  static Rect Tiles(uint32_t first, uint32_t end) { return {first, 0, end, 1}; }
+  static bool ValidTileRange(uint32_t first, uint32_t end) {
+    return first < end && end <= kEdramTiles;
+  }
+  static bool Valid(uint32_t key, uint32_t first, uint32_t end) {
+    return key && ValidTileRange(first, end);
+  }
+  RegionVersions& Resource(uint32_t key) {
+    auto [it, inserted] = contents_.try_emplace(key, kEdramTiles, 1);
+    return it->second;
+  }
+  uint64_t Add(Kind kind, uint32_t key, uint32_t source, uint32_t first,
+               uint32_t end, size_t ordinal, std::vector<uint64_t> deps,
+               Failure failure) {
+    std::sort(deps.begin(), deps.end());
+    deps.erase(std::unique(deps.begin(), deps.end()), deps.end());
+    const uint64_t id = producers_.size();
+    producers_.push_back({id, kind, key, source, first, end, ordinal,
+                          std::move(deps), {}, failure});
+    return id;
+  }
+
+  RegionVersions owners_;
+  RegionVersions output_;
+  std::unordered_map<uint32_t, RegionVersions> contents_;
+  std::unordered_map<uint32_t, RegionVersions> textures_;
+  std::unordered_map<uint32_t, std::pair<uint32_t, uint32_t>> texture_sizes_;
+  std::vector<Producer> producers_;
+};
+
+}  // namespace rex::graphics::render_audit
diff --git a/include/rex/graphics/render_region_versions.h b/include/rex/graphics/render_region_versions.h
new file mode 100644
index 0000000..1001c04
--- /dev/null
+++ b/include/rex/graphics/render_region_versions.h
@@ -0,0 +1,79 @@
+#pragma once
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <utility>
+#include <vector>
+
+namespace rex::graphics::render_audit {
+struct Rect {
+  uint32_t left, top, right, bottom;
+};
+struct RegionVersion { Rect rect; uint64_t version; };
+struct RegionRead {
+  bool complete = false;
+  uint64_t missing_pixels = 0;
+  std::vector<uint64_t> versions;
+  // Clipped, disjoint pieces used to assemble the requested logical region.
+  std::vector<RegionVersion> pieces;
+};
+// CPU provenance only. Caller must first prove a common logical texture layout.
+// Versions identify producers, not descriptors, resource ownership, or fences.
+// No byte-range alias inference or implicit native-resource retention occurs.
+class RegionVersions {
+ public:
+  RegionVersions(uint32_t width, uint32_t height, size_t max_regions = 1024)
+      : width_(width), height_(height), max_regions_(max_regions) {}
+  void Invalidate() { regions_.clear(); }
+  bool Write(Rect rect, uint64_t version) {
+    if (!Valid(rect) || !version) { Invalidate(); return false; }
+    std::vector<RegionVersion> next;
+    auto add = [&](Rect r, uint64_t v) {
+      if (r.left < r.right && r.top < r.bottom) next.push_back({r, v});
+    };
+    for (const auto& old : regions_) {
+      const auto cut = Intersect(old.rect, rect);
+      if (!Area(cut)) { next.push_back(old); continue; }
+      add({old.rect.left, old.rect.top, old.rect.right, cut.top}, old.version);
+      add({old.rect.left, cut.bottom, old.rect.right, old.rect.bottom}, old.version);
+      add({old.rect.left, cut.top, cut.left, cut.bottom}, old.version);
+      add({cut.right, cut.top, old.rect.right, cut.bottom}, old.version);
+    }
+    next.push_back({rect, version});
+    if (next.size() > max_regions_) { Invalidate(); return false; }
+    regions_ = std::move(next);
+    return true;
+  }
+  RegionRead Read(Rect rect) const {
+    RegionRead result;
+    if (!Valid(rect)) return result;
+    result.missing_pixels = Area(rect);
+    for (const auto& region : regions_) {
+      const auto area = Area(Intersect(region.rect, rect));
+      if (!area) continue;
+      result.missing_pixels -= area;
+      result.versions.push_back(region.version);
+      result.pieces.push_back({Intersect(region.rect, rect), region.version});
+    }
+    std::sort(result.versions.begin(), result.versions.end());
+    result.versions.erase(std::unique(result.versions.begin(), result.versions.end()), result.versions.end());
+    result.complete = result.missing_pixels == 0;
+    return result;
+  }
+ private:
+  static Rect Intersect(Rect a, Rect b) {
+    return {std::max(a.left,b.left), std::max(a.top,b.top),
+            std::min(a.right,b.right), std::min(a.bottom,b.bottom)};
+  }
+  static uint64_t Area(Rect r) {
+    return r.left < r.right && r.top < r.bottom
+        ? uint64_t(r.right-r.left)*(r.bottom-r.top) : 0;
+  }
+  bool Valid(Rect r) const {
+    return Area(r) && r.right <= width_ && r.bottom <= height_;
+  }
+  uint32_t width_, height_;
+  size_t max_regions_;
+  std::vector<RegionVersion> regions_;
+};
+}  // namespace rex::graphics::render_audit
