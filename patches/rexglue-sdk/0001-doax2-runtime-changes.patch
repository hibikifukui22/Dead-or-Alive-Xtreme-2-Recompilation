+bool VulkanCommandProcessor::UpdateRenderArea(
+    const VulkanRenderTargetCache::Framebuffer* framebuffer, VkExtent2D required_extent,
+    bool same_pass, VkExtent2D& render_area_out) {
+  VkExtent2D area = framebuffer->host_extent;
+  if (REXCVAR_GET(vulkan_tight_render_area) && required_extent.width != UINT32_MAX) {
+    constexpr uint32_t kAlignment = 64;
+    area.width = std::min(
+        area.width, (std::max(required_extent.width, 1u) + kAlignment - 1) & ~(kAlignment - 1));
+    area.height = std::min(
+        area.height, (std::max(required_extent.height, 1u) + kAlignment - 1) & ~(kAlignment - 1));
+  }
+  if (same_pass) {
+    if (area.width <= current_render_area_.width && area.height <= current_render_area_.height) {
+      return false;
+    }
+    // A later draw goes outside the pass: restart it, larger. Rarely more than
+    // once, as a pass normally starts with its largest draw.
+    if (++render_area_grows_ >= 3) {
+      area = framebuffer->host_extent;
+    } else {
+      area.width = std::max(area.width, current_render_area_.width);
+      area.height = std::max(area.height, current_render_area_.height);
+    }
+  } else {
+    render_area_grows_ = 0;
+  }
+  current_render_area_ = area;
+  render_area_out = area;
+  ++render_area_stat_passes_;
+  render_area_stat_pixels_ += uint64_t(area.width) * area.height;
+  render_area_stat_full_pixels_ +=
+      uint64_t(framebuffer->host_extent.width) * framebuffer->host_extent.height;
+  return true;
+}
