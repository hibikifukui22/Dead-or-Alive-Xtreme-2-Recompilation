+  for (uint32_t value : draw.texture_fetch_words) mix(value);
+  field = 2;
+  for (uint32_t value : draw.vertex_fetch_words) mix(value);
+  field = 3;
+  auto mix_texture_keys = [&](const auto& keys) {
+    for (const auto& key : keys) {
+      mix(key.GetIdentityHash());
+      mix(key.GetGuestBaseAddress());
+      mix(key.GetGuestMipAddress());
+      mix(key.GetGuestBaseSize());
+      mix(key.GetGuestMipsSize());
+      mix(key.host_swizzle);
+      mix(key.swizzled_signs);
+      mix(key.IsValid());
+    }
+  };
+  mix_texture_keys(draw.texture_srv_keys_vertex);
+  mix_texture_keys(draw.texture_srv_keys_pixel);
+  auto mix_texture_bindings = [&](const auto& bindings) {
+    for (const auto& binding : bindings) {
+      field = 4;
+      mix(binding.bindless_descriptor_index);
+      field = 5;
+      mix(binding.fetch_constant);
+      mix(uint32_t(binding.dimension));
+      mix(binding.is_signed);
+    }
+  };
+  mix_texture_bindings(draw.texture_bindings_vertex);
+  mix_texture_bindings(draw.texture_bindings_pixel);
+  field = 5;
+  for (const auto& sampler : draw.samplers_vertex) mix(sampler.value);
+  for (const auto& sampler : draw.samplers_pixel) mix(sampler.value);
+  auto mix_sampler_bindings = [&](const auto& bindings) {
+    for (const auto& binding : bindings) {
+      field = 4;
+      mix(binding.bindless_descriptor_index);
+      field = 5;
+      mix(binding.fetch_constant);
+      mix(uint32_t(binding.mag_filter));
+      mix(uint32_t(binding.min_filter));
+      mix(uint32_t(binding.mip_filter));
+      mix(uint32_t(binding.aniso_filter));
+    }
+  };
+  mix_sampler_bindings(draw.sampler_bindings_vertex);
+  mix_sampler_bindings(draw.sampler_bindings_pixel);
+  field = 6;
+  mix(draw.guest_index_base);
+  mix(draw.index_bytes);
+  mix(draw.index_buffer_type);
+  mix(draw.guest_primitive_type);
+  mix(draw.host_primitive_type);
+  mix(draw.host_vertex_shader_type);
+  mix(draw.tessellation_mode);
+  mix(draw.host_index_format);
+  mix(draw.host_shader_index_endian);
+  mix(draw.host_primitive_reset_enabled);
+  mix(draw.guest_draw_vertex_count);
+  mix(draw.host_draw_vertex_count);
+  mix(draw.line_loop_closing_index);
+  mix(draw.bindless_descriptors);
+  mix(draw.shader_side_effects);
+  field = 7;
+  mix(draw.bound_render_target_bits);
+  for (uint32_t format : draw.bound_render_target_formats) mix(format);
+  for (uint32_t key : draw.bound_render_target_keys) mix(key);
+  field = 0;
+  if (draw.constants_index < frame.vertex_constants.size()) {
+    for (uint64_t map : frame.vertex_constants[draw.constants_index].register_map)
+      mix(map);
+  }
+  if (draw.pixel_constants_index < frame.pixel_constants.size()) {
+    for (uint64_t map : frame.pixel_constants[draw.pixel_constants_index].register_map)
+      mix(map);
+  }
+  return hash;
+}
+
+uint64_t D3D12CommandProcessor::GetOwnedRenderUnitDependencyBytes(
+    const InterpolationDrawBinding& draw) const {
+  std::unordered_map<uint32_t, uint32_t> ranges;
+  auto add_range = [&](uint32_t address, uint32_t size) {
+    if (!size) return;
+    auto [it, inserted] = ranges.emplace(address, size);
+    if (!inserted) it->second = std::max(it->second, size);
+  };
+  for (size_t word = 0; word + 1 < draw.vertex_fetch_words.size(); word += 2) {
+    xenos::xe_gpu_vertex_fetch_t fetch{};
+    fetch.dword_0 = draw.vertex_fetch_words[word];
+    fetch.dword_1 = draw.vertex_fetch_words[word + 1];
+    add_range(fetch.address << 2, fetch.size << 2);
+  }
+  if (draw.index_buffer_type == uint8_t(PrimitiveProcessor::kGuestDMA))
+    add_range(draw.guest_index_base, draw.index_bytes);
+  auto add_texture_keys = [&](const auto& keys) {
+    for (const auto& key : keys) {
+      if (!key.IsValid()) continue;
+      add_range(key.GetGuestBaseAddress(), key.GetGuestBaseSize());
+      add_range(key.GetGuestMipAddress(), key.GetGuestMipsSize());
+    }
+  };
+  add_texture_keys(draw.texture_srv_keys_vertex);
+  add_texture_keys(draw.texture_srv_keys_pixel);
+  uint64_t total = 0;
+  for (const auto& [address, size] : ranges) total += size;
+  return total;
+}
+
+void D3D12CommandProcessor::TryCaptureOwnedRenderUnit(
+    const InterpolationDrawBinding& draw) {
+  // IssueSwap increments the serial before closing the frame currently being
+  // recorded, so this draw belongs to the next serial.
+  const uint64_t serial = doax2_transform_trace_swap_serial + 1;
+  constexpr uint64_t kCompositeRecipe = 0xC0517E0000000001ull;
+  if (REXCVAR_GET(d3d12_doax2_owned_composite_draw) &&
+      owned_unit_snapshot_.state_count == 1 && (serial % 120) == 119 &&
+      serial > owned_unit_snapshot_.states[0].guest_swap_serial &&
+      owned_unit_snapshot_.states[0].guest_swap_serial + 1 != serial) {
+    owned_unit_snapshot_.Clear();
+  }
+  if (REXCVAR_GET(d3d12_doax2_owned_composite_draw) &&
+      (serial % 120) == 0 &&
+      draw.shader_hash == 0x118071C8F97830EAull &&
+      draw.pixel_shader_hash == 0x1E70EB9513D670C9ull &&
+      draw.host_draw_vertex_count == 4) {
+    REXGPU_INFO(
+        "DOAX2 owned composite capture gate: frame={} states={} complete={} index_class={} rt_bits={:02X} pixel_keys={} first_valid={} first_base={:08X} prior_frame={} prior_pipeline_match={} prior_root_match={}",
+        serial, owned_unit_snapshot_.state_count,
+        owned_unit_snapshot_.complete, draw.index_buffer_type,
+        draw.bound_render_target_bits, draw.texture_srv_keys_pixel.size(),
+        !draw.texture_srv_keys_pixel.empty() &&
+            draw.texture_srv_keys_pixel[0].IsValid(),
+        draw.texture_srv_keys_pixel.empty()
+            ? 0
+            : draw.texture_srv_keys_pixel[0].GetGuestBaseAddress(),
+        owned_unit_snapshot_.state_count
+            ? owned_unit_snapshot_.states[0].guest_swap_serial
+            : 0,
+        owned_unit_snapshot_.draw.pipeline_handle == draw.pipeline_handle,
+        owned_unit_snapshot_.draw.root_signature == draw.root_signature);
+  }
+  const bool composite_unit =
+      REXCVAR_GET(d3d12_doax2_owned_composite_draw) &&
+      draw.shader_hash == 0x118071C8F97830EAull &&
+      draw.pixel_shader_hash == 0x1E70EB9513D670C9ull &&
+      draw.index_buffer_type == uint8_t(PrimitiveProcessor::kNone) &&
+      draw.host_draw_vertex_count == 4 &&
+      (draw.bound_render_target_bits == 0x2 ||
+       draw.bound_render_target_bits == 0x3) &&
+      !draw.texture_srv_keys_pixel.empty() &&
+      draw.texture_srv_keys_pixel[0].IsValid() &&
+      draw.texture_srv_keys_pixel[0].GetGuestBaseAddress() ==
+          ((serial % 120) == 119 ? 0x1F577000 : 0x1F90F000) &&
+      ((serial % 120) == 119 || (serial % 120) == 0) &&
+      (owned_unit_snapshot_.state_count ? (serial % 120) == 0
