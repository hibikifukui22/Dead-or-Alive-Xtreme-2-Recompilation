+// Sleep until the deadline with sub-millisecond accuracy: a high-resolution
+// waitable timer for the bulk, then yield-spin for the last ~0.4 ms.
+void PreciseSleepUntil(SteadyClock::time_point deadline) {
+  thread_local HANDLE timer = CreateWaitableTimerExW(
+      nullptr, nullptr, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION, TIMER_ALL_ACCESS);
+  while (true) {
+    const auto now = SteadyClock::now();
+    if (now >= deadline) return;
+    const auto remaining = deadline - now;
+    if (remaining > std::chrono::microseconds(600)) {
+      const auto sleep_for = remaining - std::chrono::microseconds(400);
+      if (timer) {
+        LARGE_INTEGER due;
+        due.QuadPart = -int64_t(
+            std::chrono::duration_cast<std::chrono::nanoseconds>(sleep_for).count() / 100);
+        if (SetWaitableTimerEx(timer, &due, 0, nullptr, nullptr, nullptr, 0)) {
+          WaitForSingleObject(timer, INFINITE);
+          continue;
+        }
+      }
+      Sleep(1);
+    } else {
+      SwitchToThread();
+    }
+  }
