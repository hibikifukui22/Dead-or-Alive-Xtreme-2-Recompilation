+void D3D12CommandProcessor::VerifyFxaaBankWitness() {
+  if (!fxaa_bank_probe_fence_ || !submission_fence_) return;
+  const uint64_t observed = submission_fence_->GetCompletedValue();
+  if (observed == UINT64_MAX || observed < fxaa_bank_probe_fence_) return;
+  void* mapped[2]{};
+  D3D12_RANGE range{0, SIZE_T(fxaa_bank_readback_bytes_)};
+  bool equal = true;
+  uint64_t hash = 14695981039346656037ull;
+  for (size_t i = 0; i < 2; ++i) {
+    if (FAILED(fxaa_bank_readbacks_[i]->Map(0, &range, &mapped[i]))) equal = false;
+  }
