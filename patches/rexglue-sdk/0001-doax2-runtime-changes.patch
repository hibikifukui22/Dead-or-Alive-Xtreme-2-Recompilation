+          get_proc(instance, "vkEnumeratePhysicalDevices"));
+      auto destroy_instance =
+          reinterpret_cast<PFN_vkDestroyInstance>(get_proc(instance, "vkDestroyInstance"));
+      if (enumerate_devices) {
