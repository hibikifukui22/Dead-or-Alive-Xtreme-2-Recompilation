+            }
+          }
+          if (!best_previous_run ||
+              best_ordered_matches * 4 < run_n1.draw_count ||
+              run_n1.viewport_area < selected_complete_target_area) {
+            continue;
+          }
+          std::vector<OrderedGroupCandidate> run_candidates;
+          run_candidates.reserve(run_n1.draw_count);
+          bool dependencies_bounded = true;
+          for (size_t i = 0; i < run_n1.draw_count; ++i) {
+            const size_t ordinal_n1 = run_n1.first_ordinal + i;
+            const auto& draw_n1 = current.draws[ordinal_n1];
+            const uint64_t dependency_bytes =
+                GetOwnedRenderUnitDependencyBytes(draw_n1);
+            if (dependency_bytes > kCompleteTargetUnitBytes) {
+              dependencies_bounded = false;
+              break;
+            }
+            const bool recipe_matched = best_previous_ordinals[i] != SIZE_MAX;
+            const size_t ordinal_n = recipe_matched
+                                         ? best_previous_ordinals[i]
+                                         : ordinal_n1;
+            run_candidates.push_back(OrderedGroupCandidate{
+                GetOwnedRenderUnitRecipeKey(current, draw_n1),
+                dependency_bytes, draw_n1.host_draw_vertex_count, ordinal_n,
+                ordinal_n1, draw_n1.bound_render_target_formats,
+                draw_n1.bound_render_target_keys, !recipe_matched});
+          }
+          if (!dependencies_bounded) continue;
+          complete_target_run_candidates = std::move(run_candidates);
+          complete_target_run_matched_positions = best_ordered_matches;
+          selected_complete_target_area = run_n1.viewport_area;
+        }
+
+        const bool complete_target_run =
+            !complete_target_run_candidates.empty();
+        if (complete_target_run) {
+          ordered_group_candidates =
+              std::move(complete_target_run_candidates);
+        } else if (REXCVAR_GET(d3d12_doax2_owned_output_continuous)) {
+          // Do not spend a private submission on an intermediate or partial
+          // group: it cannot produce a visible frame.
+          ordered_group_candidates.clear();
+        } else {
+          std::sort(ordered_group_candidates.begin(),
+                    ordered_group_candidates.end(),
+                    [](const auto& a, const auto& b) {
+                      return a.vertices > b.vertices;
+                    });
+        }
+        if (ordered_group_candidates.size() < 2) {
+          if (log_owned_frame) REXGPU_INFO(
+              "DOAX2 complete target-run selection deferred: frames_N_N1={}/{}; no bounded final-color run with at least 25% ordered recipe compatibility",
+              previous.guest_swap_serial, current.guest_swap_serial);
+        } else {
+        const size_t group_unit_limit =
+            complete_target_run ? ordered_group_candidates.size() : 32;
+        const uint64_t group_byte_limit =
+            complete_target_run ? kFirstCompleteTargetRunBytes
+                                : uint64_t(64ull << 20);
+        const auto common_formats = ordered_group_candidates.front().target_formats;
+        const auto common_target_keys = ordered_group_candidates.front().target_keys;
+        uint64_t group_bytes = 0;
+        uint64_t group_vertices = 0;
+        auto materialize_snapshot = [&](const OrderedGroupCandidate& candidate,
+                                        OwnedRenderGroupSlot& slot) {
+          const auto& draw_n1 = current.draws[candidate.draw_ordinal];
+          const InterpolationFrame& state_frame_n =
+              candidate.hold_current_state_for_previous ? current : previous;
+          const auto& draw_n =
+              candidate.hold_current_state_for_previous
+                  ? draw_n1
+                  : previous.draws[candidate.previous_draw_ordinal];
+          if (draw_n.constants_index >= state_frame_n.vertex_constants.size() ||
+              draw_n1.constants_index >= current.vertex_constants.size()) {
+            return false;
+          }
+          auto fill_state = [](const InterpolationFrame& frame,
+                               const InterpolationDrawBinding& draw,
+                               OwnedRenderStateSnapshot& state) {
+            state.guest_swap_serial = frame.guest_swap_serial;
+            state.vertex_constants = frame.vertex_constants[draw.constants_index];
+            if (draw.pixel_constants_index != UINT32_MAX) {
+              if (draw.pixel_constants_index >= frame.pixel_constants.size())
+                return false;
+              state.pixel_constants =
+                  frame.pixel_constants[draw.pixel_constants_index];
+            }
+            std::copy(draw.bool_loop_constants.begin(),
+                      draw.bool_loop_constants.end(),
+                      &state.registers
+                           [XE_GPU_REG_SHADER_CONSTANT_BOOL_000_031]);
+            std::copy(draw.fetch_constants.begin(), draw.fetch_constants.end(),
+                      &state.registers[XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0]);
+            state.registers[XE_GPU_REG_RB_SURFACE_INFO] = draw.surface_info;
+            state.system_constants = draw.system_constants;
+            state.viewport = draw.viewport;
+            state.scissor = draw.scissor;
+            state.blend_factor = draw.blend_factor;
+            state.stencil_reference = draw.stencil_reference;
+            return true;
+          };
+
+          auto& snapshot = slot.snapshot;
+          snapshot.recipe_key = candidate.recipe_key;
+          snapshot.guest_swap_serial = current.guest_swap_serial;
+          snapshot.draw = draw_n1;
+          if (!fill_state(state_frame_n, draw_n, snapshot.states[0]) ||
+              !fill_state(current, draw_n1, snapshot.states[1])) {
+            snapshot.Clear();
+            return false;
+          }
+          // A draw that appeared only in N+1 is included without temporal
+          // interpolation. Label its held endpoint as N solely for coherent
+          // frame ownership; the copied values remain exactly N+1.
+          if (candidate.hold_current_state_for_previous) {
+            snapshot.states[0].guest_swap_serial =
+                previous.guest_swap_serial;
+          }
+          snapshot.state_count = 2;
+
+          std::unordered_map<uint32_t, uint32_t> vertex_ranges;
+          std::unordered_map<uint32_t, uint32_t> index_ranges;
+          std::unordered_map<uint32_t, uint32_t> texture_ranges;
+          auto add_range = [](auto& ranges, uint32_t address, uint32_t size) {
+            if (!size) return;
+            auto [it, inserted] = ranges.emplace(address, size);
+            if (!inserted) it->second = std::max(it->second, size);
+          };
+          for (size_t word = 0; word + 1 < draw_n1.vertex_fetch_words.size();
+               word += 2) {
+            xenos::xe_gpu_vertex_fetch_t fetch{};
+            fetch.dword_0 = draw_n1.vertex_fetch_words[word];
+            fetch.dword_1 = draw_n1.vertex_fetch_words[word + 1];
+            add_range(vertex_ranges, fetch.address << 2, fetch.size << 2);
+          }
+          add_range(index_ranges, draw_n1.guest_index_base,
+                    draw_n1.index_bytes);
+          auto add_textures = [&](const auto& keys) {
+            for (const auto& texture : keys) {
+              if (!texture.IsValid()) continue;
+              add_range(texture_ranges, texture.GetGuestBaseAddress(),
+                        texture.GetGuestBaseSize());
+              add_range(texture_ranges, texture.GetGuestMipAddress(),
+                        texture.GetGuestMipsSize());
+            }
+          };
+          add_textures(draw_n1.texture_srv_keys_vertex);
+          add_textures(draw_n1.texture_srv_keys_pixel);
+          uint64_t content_hash = 14695981039346656037ull;
+          auto copy_ranges = [&](const auto& ranges, auto& destination) {
+            for (const auto& [address, size] : ranges) {
+              const uint8_t* source = memory_->TranslatePhysical(address);
+              if (!source) return false;
+              OwnedGuestRangeSnapshot range;
+              range.guest_address = address;
+              range.bytes.resize(size);
+              std::memcpy(range.bytes.data(), source, size);
+              for (uint8_t value : range.bytes)
+                content_hash = (content_hash ^ value) * 1099511628211ull;
+              destination.push_back(std::move(range));
+            }
+            return true;
+          };
+          if (!copy_ranges(vertex_ranges, snapshot.vertex_ranges) ||
+              !copy_ranges(index_ranges, snapshot.index_ranges) ||
+              !copy_ranges(texture_ranges, snapshot.texture_ranges)) {
+            snapshot.Clear();
+            return false;
+          }
+          snapshot.content_hash = content_hash;
+          snapshot.midpoint_vertex_values =
+              snapshot.states[1].vertex_constants.values;
+          size_t packed_value = 0;
+          for (uint32_t map_word = 0; map_word < 4; ++map_word) {
+            uint64_t remaining =
+                snapshot.states[1].vertex_constants.register_map[map_word];
+            uint32_t bit;
+            while (rex::bit_scan_forward(remaining, &bit)) {
+              remaining &= ~(UINT64_C(1) << bit);
+              const uint32_t constant = (map_word << 6) + bit;
+              const bool interpolate =
+                  constant <= 3 || (constant >= 17 && constant <= 20) ||
+                  (constant >= 37 && constant <= 40) || constant >= 84;
+              for (uint32_t component = 0; component < 4;
+                   ++component, ++packed_value) {
+                if (packed_value >=
+                        snapshot.states[0].vertex_constants.values.size() ||
+                    packed_value >=
+                        snapshot.states[1].vertex_constants.values.size())
+                  break;
+                const float old_value = std::bit_cast<float>(
+                    snapshot.states[0].vertex_constants.values[packed_value]);
+                const float new_value = std::bit_cast<float>(
+                    snapshot.states[1].vertex_constants.values[packed_value]);
+                if (interpolate && std::isfinite(old_value) &&
+                    std::isfinite(new_value)) {
+                  snapshot.midpoint_vertex_values[packed_value] =
+                      std::bit_cast<uint32_t>((old_value + new_value) * 0.5f);
+                }
+              }
+            }
+          }
+          slot.captured_draw_ordinals = {candidate.previous_draw_ordinal,
+                                         candidate.draw_ordinal};
+          snapshot.complete = true;
+          return true;
+        };
+        for (const auto& candidate : ordered_group_candidates) {
+          if (owned_render_group_slots_.size() >=
+              group_unit_limit ||
+              candidate.target_formats != common_formats ||
+              candidate.target_keys != common_target_keys ||
+              group_bytes + candidate.dependency_bytes >
+                  group_byte_limit) {
+            continue;
+          }
+          OwnedRenderGroupSlot slot;
+          slot.recipe_key = candidate.recipe_key;
+          slot.draw_ordinal = candidate.draw_ordinal;
+          if (!materialize_snapshot(candidate, slot)) continue;
+          owned_render_group_slots_.push_back(std::move(slot));
+          group_bytes += candidate.dependency_bytes;
+          group_vertices += candidate.vertices;
+        }
+        if (complete_target_run &&
+            owned_render_group_slots_.size() !=
+                ordered_group_candidates.size()) {
+          REXGPU_WARN(
+              "DOAX2 complete target-run materialization rejected: expected_units={} materialized_units={}; partial run discarded before GPU allocation/submission",
+              ordered_group_candidates.size(),
+              owned_render_group_slots_.size());
+          owned_render_group_slots_.clear();
+        }
+        std::sort(owned_render_group_slots_.begin(),
+                  owned_render_group_slots_.end(),
+                  [](const auto& a, const auto& b) {
+                    return a.draw_ordinal < b.draw_ordinal;
+                  });
+        if (!owned_render_group_slots_.empty()) {
+          owned_render_group_selected_frame_ = current.guest_swap_serial;
+          owned_render_group_completion_logged_ = false;
+          if (log_owned_frame) REXGPU_INFO(
+              "DOAX2 owned render-group materialized: frames_N_N1={}/{} candidate_units={} selected_units={} selected_vertices={} dependency_bytes={} first_ordinals={}/{} last_ordinals={}/{} target_bits=3 target_keys={:08X}/{:08X} target_formats={:08X}/{:08X}/{:08X}/{:08X}/{:08X} complete_target_run={} positional_matches={} held_current={}; exact adjacent CPU frame records and guest backing copied immediately, exact attachment identity, no future-occurrence chase, no descriptors/resources/submission",
+              previous.guest_swap_serial, current.guest_swap_serial,
+              ordered_group_candidates.size(),
+              owned_render_group_slots_.size(), group_vertices, group_bytes,
+              owned_render_group_slots_.front().captured_draw_ordinals[0],
+              owned_render_group_slots_.front().captured_draw_ordinals[1],
+              owned_render_group_slots_.back().captured_draw_ordinals[0],
+              owned_render_group_slots_.back().captured_draw_ordinals[1],
+              common_target_keys[0], common_target_keys[1],
+              common_formats[0], common_formats[1], common_formats[2],
+              common_formats[3], common_formats[4], complete_target_run,
+              complete_target_run ? complete_target_run_matched_positions : 0,
+              complete_target_run
+                  ? ordered_group_candidates.size() -
+                        complete_target_run_matched_positions
+                  : 0);
+        }
+        }
+      }
+      if (owned_unit_dynamic_submissions_ < 4 &&
+          !owned_unit_snapshot_.complete && largest_candidate_key) {
+        owned_unit_snapshot_target_recipe_ = largest_candidate_key;
+        owned_unit_snapshot_selected_frame_ = current.guest_swap_serial;
+        if (log_owned_frame) REXGPU_INFO(
+            "DOAX2 owned-unit snapshot armed: frame={} draw={} recipe={:016X} dependency_bytes={} draw_vertices={} selection=largest_bounded_unique_side_effect_free_moving_pose; capture occurs at its next live draw, no submission",
+            current.guest_swap_serial, largest_candidate_draw,
+            largest_candidate_key, largest_candidate_bytes,
+            largest_candidate_vertices);
+      } else if (owned_unit_snapshot_.complete) {
+        uint64_t snapshot_hash = 14695981039346656037ull;
+        uint64_t live_guest_hash = 14695981039346656037ull;
+        bool guest_ranges_readable = true;
+        auto hash_snapshot_ranges = [&](const auto& ranges) {
+          for (const auto& range : ranges) {
+            const uint8_t* live =
+                memory_->TranslatePhysical(range.guest_address);
+            if (!live) {
+              guest_ranges_readable = false;
+              continue;
+            }
+            for (size_t i = 0; i < range.bytes.size(); ++i) {
+              snapshot_hash = (snapshot_hash ^ range.bytes[i]) *
+                              1099511628211ull;
+              live_guest_hash = (live_guest_hash ^ live[i]) *
+                                1099511628211ull;
+            }
+          }
+        };
+        hash_snapshot_ranges(owned_unit_snapshot_.vertex_ranges);
+        hash_snapshot_ranges(owned_unit_snapshot_.index_ranges);
+        hash_snapshot_ranges(owned_unit_snapshot_.texture_ranges);
+        if (log_owned_frame) REXGPU_INFO(
+            "DOAX2 owned-unit snapshot retained: frame={} recipe={:016X} captured_frame={} content_hash={:016X} snapshot_intact={} guest_ranges_readable={} guest_changed_since_capture={}; host copies independent of later guest reuse",
+            current.guest_swap_serial, owned_unit_snapshot_.recipe_key,
+            owned_unit_snapshot_.guest_swap_serial,
+            owned_unit_snapshot_.content_hash,
+            snapshot_hash == owned_unit_snapshot_.content_hash,
+            guest_ranges_readable,
+            guest_ranges_readable &&
+                live_guest_hash != owned_unit_snapshot_.content_hash);
+      }
+      if (log_owned_frame) REXGPU_INFO(
+          "DOAX2 owned-input classes: pipeline_root=immutable_reusable sampler=value_rebuild camera_instance_pose_material=mutable_snapshotted fetch_stream=mutable_snapshotted constant_upload=transient_copied descriptors=alias_fresh_required texture_backing=mutable_copy_or_pin index_converted=transient_rebuild render_targets=independent_backing visibility=draw_recipe_unresolved");
+    }
+  }
+}
+
+std::vector<DeferredCommandList::GraphicsRootConstantBufferOverride>
+D3D12CommandProcessor::BuildInterpolatedVertexConstantOverrides(
+    const InterpolationFrame& previous, const InterpolationFrame& current) {
+  std::vector<DeferredCommandList::GraphicsRootConstantBufferOverride> overrides;
+  // A different scene, UI transition, or draw order is not a safe candidate.
+  // Pair only positions where both frames used the same vertex shader and
+  // packed constant layout, then ensure one old binding maps to one new binding.
+  std::unordered_map<uint32_t, uint32_t> paired_constants;
+  std::unordered_set<uint32_t> rejected_constants;
+  const size_t draw_count = std::min(previous.draws.size(), current.draws.size());
+  for (size_t draw = 0; draw < draw_count; ++draw) {
+    const InterpolationDrawBinding& previous_draw = previous.draws[draw];
+    const InterpolationDrawBinding& current_draw = current.draws[draw];
+    if (previous_draw.shader_hash != current_draw.shader_hash ||
+        previous_draw.pixel_shader_hash != current_draw.pixel_shader_hash ||
+        previous_draw.used_texture_mask != current_draw.used_texture_mask ||
+        previous_draw.vertex_fetch_mask != current_draw.vertex_fetch_mask ||
+        previous_draw.constants_index >= previous.vertex_constants.size() ||
+        current_draw.constants_index >= current.vertex_constants.size()) {
+      continue;
+    }
+    const InterpolationVertexConstants& previous_constants =
+        previous.vertex_constants[previous_draw.constants_index];
+    const InterpolationVertexConstants& current_constants =
+        current.vertex_constants[current_draw.constants_index];
+    if (previous_constants.register_map != current_constants.register_map ||
+        previous_constants.values.size() != current_constants.values.size() ||
+        previous_constants.values.empty()) {
+      continue;
+    }
+    if (rejected_constants.contains(current_draw.constants_index)) {
+      continue;
+    }
+    auto [it, inserted] = paired_constants.emplace(current_draw.constants_index,
+                                                   previous_draw.constants_index);
+    if (!inserted && it->second != previous_draw.constants_index) {
+      // The same current CBV serves incompatible draw positions. It cannot be
+      // overridden globally in the current frame's replayed command stream.
+      paired_constants.erase(current_draw.constants_index);
+      rejected_constants.insert(current_draw.constants_index);
+    }
+  }
+
+  for (const auto& [current_index, previous_index] : paired_constants) {
+    if (previous_index >= previous.vertex_constants.size() ||
+        current_index >= current.vertex_constants.size()) {
+      continue;
+    }
+    const InterpolationVertexConstants& previous_constants =
+        previous.vertex_constants[previous_index];
+    const InterpolationVertexConstants& current_constants =
+        current.vertex_constants[current_index];
+    const size_t size_bytes = current_constants.values.size() * sizeof(uint32_t);
+    D3D12_GPU_VIRTUAL_ADDRESS replacement_address = 0;
+    uint8_t* replacement_bytes = constant_buffer_pool_->Request(
+        frame_current_, size_bytes, D3D12_CONSTANT_BUFFER_DATA_PLACEMENT_ALIGNMENT, nullptr,
+        nullptr, &replacement_address);
+    if (!replacement_bytes) {
+      break;
+    }
+    uint32_t* replacement_values = reinterpret_cast<uint32_t*>(replacement_bytes);
+    size_t packed_value = 0;
+    for (uint32_t map_word = 0; map_word < 4; ++map_word) {
+      uint64_t remaining = current_constants.register_map[map_word];
+      uint32_t bit;
+      while (rex::bit_scan_forward(remaining, &bit)) {
+        remaining &= ~(UINT64_C(1) << bit);
+        const uint32_t constant = (map_word << 6) + bit;
+        // The three low ranges were identified by DOAX2's three-frame trace as
+        // camera/projection matrices. c84+ contains object and GPU-skinning
+        // transforms. Other low constants include lighting, material values,
+        // flags and effect parameters and must remain bit-exact.
+        const bool interpolate_transform =
+            constant <= 3 || (constant >= 17 && constant <= 20) ||
+            (constant >= 37 && constant <= 40) || constant >= 84;
+        for (uint32_t component = 0; component < 4; ++component, ++packed_value) {
+          const float previous_value =
+              std::bit_cast<float>(previous_constants.values[packed_value]);
+          const float current_value =
+              std::bit_cast<float>(current_constants.values[packed_value]);
+          // Keep non-floating bit patterns exactly as the newer state rather
+          // than manufacturing NaNs or interpolating packed flags.
+          replacement_values[packed_value] =
+              interpolate_transform && std::isfinite(previous_value) &&
+                      std::isfinite(current_value)
+                  ? std::bit_cast<uint32_t>((previous_value + current_value) * 0.5f)
+                  : current_constants.values[packed_value];
+        }
+      }
+    }
+    overrides.push_back({current_constants.address, replacement_address});
+  }
+  return overrides;
+}
+
+bool D3D12CommandProcessor::UpdateBindings(const D3D12Shader* vertex_shader,
+                                           const D3D12Shader* pixel_shader,
+                                           ID3D12RootSignature* root_signature,
+                                           bool shared_memory_is_uav) {
+  const ui::d3d12::D3D12Provider& provider = GetD3D12Provider();
+  ID3D12Device* device = provider.GetDevice();
+  const RegisterFile& regs = *register_file_;
+
+#if XE_GPU_FINE_GRAINED_DRAW_SCOPES
+  SCOPE_profile_cpu_f("gpu");
+#endif  // XE_GPU_FINE_GRAINED_DRAW_SCOPES
+
+  // Set the new root signature.
+  if (current_graphics_root_signature_ != root_signature) {
+    current_graphics_root_signature_ = root_signature;
+    if (!bindless_resources_used_) {
+      GetRootBindfulExtraParameterIndices(vertex_shader, pixel_shader,
+                                          current_graphics_root_bindful_extras_);
+    }
+    // Changing the root signature invalidates all bindings.
+    current_graphics_root_up_to_date_ = 0;
+    deferred_command_list_.D3DSetGraphicsRootSignature(root_signature);
+  }
+
+  // Select the root parameter indices depending on the used binding model.
+  uint32_t root_parameter_fetch_constants = bindless_resources_used_
+                                                ? kRootParameter_Bindless_FetchConstants
+                                                : kRootParameter_Bindful_FetchConstants;
+  uint32_t root_parameter_float_constants_vertex =
+      bindless_resources_used_ ? kRootParameter_Bindless_FloatConstantsVertex
+                               : kRootParameter_Bindful_FloatConstantsVertex;
+  uint32_t root_parameter_float_constants_pixel = bindless_resources_used_
+                                                      ? kRootParameter_Bindless_FloatConstantsPixel
+                                                      : kRootParameter_Bindful_FloatConstantsPixel;
+  uint32_t root_parameter_system_constants = bindless_resources_used_
+                                                 ? kRootParameter_Bindless_SystemConstants
+                                                 : kRootParameter_Bindful_SystemConstants;
+  uint32_t root_parameter_bool_loop_constants = bindless_resources_used_
+                                                    ? kRootParameter_Bindless_BoolLoopConstants
+                                                    : kRootParameter_Bindful_BoolLoopConstants;
+  uint32_t root_parameter_shared_memory_and_bindful_edram =
+      bindless_resources_used_ ? kRootParameter_Bindless_SharedMemory
+                               : kRootParameter_Bindful_SharedMemoryAndEdram;
+
+  //
+  // Update root constant buffers that are common for bindful and bindless.
+  //
+
+  // These are the constant base addresses/ranges for shaders.
+  // We have these hardcoded right now cause nothing seems to differ on the Xbox
+  // 360 (however, OpenGL ES on Adreno 200 on Android has different ranges).
+  assert_true(regs[XE_GPU_REG_SQ_VS_CONST] == 0x000FF000 ||
+              regs[XE_GPU_REG_SQ_VS_CONST] == 0x00000000);
+  assert_true(regs[XE_GPU_REG_SQ_PS_CONST] == 0x000FF100 ||
+              regs[XE_GPU_REG_SQ_PS_CONST] == 0x00000000);
+  // Check if the float constant layout is still the same and get the counts.
+  const Shader::ConstantRegisterMap& float_constant_map_vertex =
+      vertex_shader->constant_register_map();
+  uint32_t float_constant_count_vertex = float_constant_map_vertex.float_count;
+  for (uint32_t i = 0; i < 4; ++i) {
+    if (current_float_constant_map_vertex_[i] != float_constant_map_vertex.float_bitmap[i]) {
+      current_float_constant_map_vertex_[i] = float_constant_map_vertex.float_bitmap[i];
+      // If no float constants at all, we can reuse any buffer for them, so not
+      // invalidating.
+      if (float_constant_count_vertex) {
+        cbuffer_binding_float_vertex_.up_to_date = false;
+      }
+    }
+  }
+  uint32_t float_constant_count_pixel = 0;
+  if (pixel_shader != nullptr) {
+    const Shader::ConstantRegisterMap& float_constant_map_pixel =
+        pixel_shader->constant_register_map();
+    float_constant_count_pixel = float_constant_map_pixel.float_count;
