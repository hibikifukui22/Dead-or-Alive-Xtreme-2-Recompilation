+std::optional<D3D12RenderTargetCache::Doax2SecondFrameTargets>
+D3D12RenderTargetCache::PrepareDoax2SecondFrameTargets(uint64_t completed_fence) {
+  // The most frequently bound target is often a shadow or an intermediate.
+  // Only reproduce the color target that the title actually resolved to the
+  // guest frontbuffer consumed by IssueSwap.
+  auto selected_it = doax2_frontbuffer_source_
+                         ? std::max_element(
+                               doax2_target_pair_uses_.begin(),
+                               doax2_target_pair_uses_.end(),
+                               [this](const auto& a, const auto& b) {
+                                 const uint64_t a_draws =
+                                     a.color == doax2_frontbuffer_source_ ? a.draws : 0;
+                                 const uint64_t b_draws =
+                                     b.color == doax2_frontbuffer_source_ ? b.draws : 0;
+                                 return a_draws < b_draws;
+                               })
+                         : doax2_target_pair_uses_.end();
+  if (selected_it == doax2_target_pair_uses_.end() ||
+      selected_it->color != doax2_frontbuffer_source_ || !selected_it->draws) {
+    static uint64_t skipped_count = 0;
+    ++skipped_count;
+    if (skipped_count <= 8 || (skipped_count % 120) == 0) {
+      REXGPU_WARN(
+          "DOAX2 final-color private pass skipped: count={} frontbuffer_source={} resolve_base={:08X} observed_pairs={}",
+          skipped_count,
+          doax2_frontbuffer_source_
+              ? static_cast<void*>(doax2_frontbuffer_source_->resource())
+              : nullptr,
+          doax2_frontbuffer_resolve_base_, doax2_target_pair_uses_.size());
+    }
+    ResetDoax2SecondFrameTargetObservations();
+    return std::nullopt;
+  }
+  const auto selected = *selected_it;
+  const uint32_t selected_resolve_base = doax2_frontbuffer_resolve_base_;
+  std::vector<D3D12RenderTarget*> sources = {selected.color};
+  uint64_t selected_draws = 0;
+  for (const auto& pair : doax2_target_pair_uses_) {
+    if (pair.color != selected.color) continue;
+    selected_draws += pair.draws;
+    if (pair.depth &&
+        std::find(sources.begin(), sources.end(), pair.depth) == sources.end()) {
+      sources.push_back(pair.depth);
+    }
+  }
+  ResetDoax2SecondFrameTargetObservations();
+  auto lease = doax2_second_frame_owner_.Acquire(completed_fence);
+  if (!lease) return std::nullopt;
+  if (!selected.color || !selected.draws) {
+    doax2_second_frame_owner_.CancelUnsubmitted(*lease);
+    return std::nullopt;
+  }
+  auto& bank = doax2_second_frame_banks_[lease->bank];
+  const size_t source_count = sources.size();
+  bool recreate = bank.targets.size() != source_count;
+  for (size_t i = 0; !recreate && i < source_count; ++i)
+    recreate = bank.targets[i].source != sources[i];
+  if (recreate) {
+    bank.targets.clear();
+    ID3D12Device* device = command_processor_.GetD3D12Provider().GetDevice();
+    for (size_t i = 0; i < source_count; ++i) {
+      D3D12RenderTarget* source = sources[i];
+      const RenderTargetKey key = source->key();
+      const D3D12_RESOURCE_DESC desc = source->resource()->GetDesc();
+      D3D12_CLEAR_VALUE clear{};
+      if (key.is_depth) {
+        clear.Format = GetDepthDSVDXGIFormat(key.GetDepthFormat());
+        clear.DepthStencil.Depth =
+            key.GetDepthFormat() == xenos::DepthRenderTargetFormat::kD24S8 ? 1.0f : 0.0f;
+      } else {
+        clear.Format = GetColorDrawDXGIFormat(key.GetColorFormat());
+      }
+      Doax2PrivateTarget target;
+      target.source = source;
+      const D3D12_RESOURCE_STATES initial =
+          key.is_depth ? D3D12_RESOURCE_STATE_DEPTH_WRITE : D3D12_RESOURCE_STATE_RENDER_TARGET;
+      if (FAILED(device->CreateCommittedResource(
+              &ui::d3d12::util::kHeapPropertiesDefault, D3D12_HEAP_FLAG_NONE, &desc,
+              initial, &clear, IID_PPV_ARGS(&target.resource)))) {
+        doax2_second_frame_owner_.CancelUnsubmitted(*lease);
+        bank.targets.clear();
+        return std::nullopt;
+      }
+      auto& pool = key.is_depth ? *descriptor_pool_depth_ : *descriptor_pool_color_;
+      target.descriptor = pool.AllocateDescriptor();
+      if (!target.descriptor.IsValid()) {
+        doax2_second_frame_owner_.CancelUnsubmitted(*lease);
+        bank.targets.clear();
+        return std::nullopt;
+      }
+      if (key.is_depth) {
+        D3D12_DEPTH_STENCIL_VIEW_DESC view{};
+        view.Format = clear.Format;
+        view.Flags = D3D12_DSV_FLAG_NONE;
+        view.ViewDimension = desc.SampleDesc.Count > 1 ? D3D12_DSV_DIMENSION_TEXTURE2DMS
+                                                      : D3D12_DSV_DIMENSION_TEXTURE2D;
+        if (desc.SampleDesc.Count == 1) view.Texture2D.MipSlice = 0;
+        device->CreateDepthStencilView(target.resource.Get(), &view,
+                                      target.descriptor.GetHandle());
+      } else {
+        D3D12_RENDER_TARGET_VIEW_DESC view{};
+        view.Format = clear.Format;
+        view.ViewDimension = desc.SampleDesc.Count > 1 ? D3D12_RTV_DIMENSION_TEXTURE2DMS
+                                                       : D3D12_RTV_DIMENSION_TEXTURE2D;
+        if (desc.SampleDesc.Count == 1) view.Texture2D.MipSlice = 0;
+        device->CreateRenderTargetView(target.resource.Get(), &view,
+                                       target.descriptor.GetHandle());
+      }
+      bank.targets.push_back(std::move(target));
+    }
+  }
+  Doax2SecondFrameTargets output;
+  output.lease = *lease;
+  output.observed_draws = selected_draws;
+  output.color_resource = bank.targets[0].resource.Get();
+  for (const auto& target : bank.targets) {
+    const auto key = target.source->key();
+    DeferredCommandList::GraphicsRenderTargetOverride entry;
+    entry.source = target.source->descriptor_draw().GetHandle();
+    entry.replacement = target.descriptor.GetHandle();
+    entry.is_depth = key.is_depth;
+    entry.depth_clear = key.is_depth &&
+                                key.GetDepthFormat() != xenos::DepthRenderTargetFormat::kD24S8
+                            ? 0.0f
+                            : 1.0f;
+    output.overrides.push_back(entry);
+  }
+  ++doax2_second_frame_prepared_count_;
+  if (doax2_second_frame_prepared_count_ <= 8 ||
+      (doax2_second_frame_prepared_count_ % 120) == 0) {
+    const auto desc = selected.color->resource()->GetDesc();
+    REXGPU_INFO(
+        "DOAX2 final-color private pass prepared: count={} bank={} resolve_base={:08X} color_key={:08X} private_depths={} size={}x{} samples={} format={} observed_draws={} source_color={} private_color={}",
+        doax2_second_frame_prepared_count_, lease->bank, selected_resolve_base,
+        selected.color->key().key, source_count - 1, desc.Width, desc.Height,
+        desc.SampleDesc.Count, uint32_t(desc.Format), selected_draws,
+        static_cast<void*>(selected.color->resource()),
+        static_cast<void*>(bank.targets[0].resource.Get()));
+  }
+  return output;
+}
