new file mode 100644
index 0000000..68a44c7
--- /dev/null
+++ b/include/rex/graphics/hires_capture.h
@@ -0,0 +1,64 @@
+/**
+ * @file        graphics/hires_capture.h
+ * @brief       Full-resolution copies of one resolve (e.g. an in-game photo)
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+#include <rex/graphics/xenos.h>
+
+namespace rex::graphics {
+class RegisterFile;
+}
+
+// With hires_resolve_capture on, every backend's resolve readback path asks
+// Prepare() whether the current resolve is the one to capture (a k_8_8_8_8
+// destination of hires_resolve_capture_width x _height, tiled). If so, the
+// backend copies the resolve's draw-resolution-scaled bytes (or, unscaled,
+// the 1x bytes) to the CPU and calls Store(), which untiles them into an RGB
+// image at the scaled size and keeps the newest one. The game asks for a file
+// by setting hires_resolve_capture_path and bumping hires_resolve_capture_request;
+// Poll(), called once per presented frame, writes the newest capture there
+// as PNG on a worker thread.
+namespace rex::graphics::hires_capture {
+
+struct Resolve {
+  uint32_t dest_base = 0;
+  uint32_t pitch = 0;   // pixels, as in RB_COPY_DEST_PITCH
+  uint32_t height = 0;  // rows, as in RB_COPY_DEST_PITCH
+  uint32_t width = 0;   // captured width (hires_resolve_capture_width)
+  uint32_t rows = 0;    // captured height (hires_resolve_capture_height)
+  uint32_t written_address = 0;
+  uint32_t written_length = 0;
+  xenos::Endian128 endian = xenos::Endian128::kNone;
+  bool swap = false;
+  uint32_t scale_x = 1, scale_y = 1;
+};
+
+// Whether the current resolve should take the readback path at all. True for
+// every resolve unless readback_resolve_frame_only is set, in which case only
+// colour k_8_8_8_8 resolves of hires_resolve_capture_width x _height (the
+// frame copy a game turns into a photo) are read back.
+// Also true for the 64x64 colour resolve of a photo's album thumbnail, a
+// one-off that must be read back with a full GPU wait (ForceFullReadback) to
+// get this resolve's data rather than the previous photo's.
+bool ReadbackWanted(const RegisterFile& regs);
+bool ForceFullReadback();
+
+// True if capture is enabled and the current resolve matches.
+bool Prepare(const RegisterFile& regs, uint32_t written_address, uint32_t written_length,
+             uint32_t scale_x, uint32_t scale_y, Resolve& out);
+
+// data: the resolve's bytes starting at written_address; each 1x pixel is a
+// contiguous scale_x * scale_y block of pixels (row-major) when scaled.
+void Store(const Resolve& resolve, const uint8_t* data, size_t size);
+
+void Poll();
+
+}  // namespace rex::graphics::hires_capture
