+bool D3D12Presenter::SubmitGuestOutputWitnessCopy(ID3D12Resource* resource,
+                                                  GuestOutputWitness& witness) {
+  if (!resource) return false;
+  ID3D12Device* device = provider_.GetDevice();
+  const D3D12_RESOURCE_DESC texture_desc = resource->GetDesc();
+  device->GetCopyableFootprints(&texture_desc, 0, 1, 0, &witness.footprint, nullptr,
+                                &witness.row_bytes, &witness.size);
+  D3D12_RESOURCE_DESC readback_desc;
+  util::FillBufferResourceDesc(readback_desc, witness.size, D3D12_RESOURCE_FLAG_NONE);
+  if (FAILED(device->CreateCommittedResource(
+          &util::kHeapPropertiesReadback, D3D12_HEAP_FLAG_NONE, &readback_desc,
+          D3D12_RESOURCE_STATE_COPY_DEST, nullptr, IID_PPV_ARGS(&witness.readback))) ||
+      FAILED(device->CreateCommandAllocator(D3D12_COMMAND_LIST_TYPE_DIRECT,
+                                            IID_PPV_ARGS(&witness.allocator))) ||
+      FAILED(device->CreateCommandList(0, D3D12_COMMAND_LIST_TYPE_DIRECT,
+                                       witness.allocator.Get(), nullptr,
+                                       IID_PPV_ARGS(&witness.command_list)))) {
+    return false;
+  }
+  D3D12_RESOURCE_BARRIER barrier{};
+  barrier.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+  barrier.Transition.pResource = resource;
+  barrier.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+  barrier.Transition.StateBefore = kGuestOutputInternalState;
+  barrier.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE;
+  witness.command_list->ResourceBarrier(1, &barrier);
+  D3D12_TEXTURE_COPY_LOCATION destination{};
+  destination.pResource = witness.readback.Get();
+  destination.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+  destination.PlacedFootprint = witness.footprint;
+  D3D12_TEXTURE_COPY_LOCATION source{};
+  source.pResource = resource;
+  source.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+  witness.command_list->CopyTextureRegion(&destination, 0, 0, 0, &source, nullptr);
+  std::swap(barrier.Transition.StateBefore, barrier.Transition.StateAfter);
+  witness.command_list->ResourceBarrier(1, &barrier);
+  if (FAILED(witness.command_list->Close())) return false;
+  ID3D12CommandList* command_list = witness.command_list.Get();
+  provider_.GetDirectQueue()->ExecuteCommandLists(1, &command_list);
+  return true;
+}
