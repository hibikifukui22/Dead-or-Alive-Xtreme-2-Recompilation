+void D3D12CommandProcessor::QueueAsyncSubmission(ID3D12CommandAllocator* command_allocator,
+                                                 uint64_t fence_value,
+                                                 ID3D12QueryHeap* timestamp_heap,
+                                                 ID3D12Resource* timestamp_readback,
+                                                 uint32_t timestamp_slot) {
+  AsyncSubmission submission;
+  {
+    std::unique_lock<std::mutex> lock(submission_mutex_);
+    submission_done_.wait(lock, [this]() { return !submission_free_lists_.empty(); });
+    submission.commands = std::move(submission_free_lists_.back());
+    submission_free_lists_.pop_back();
+  }
+  submission.commands->Swap(deferred_command_list_);
+  deferred_command_list_.Reset();
+  submission.command_allocator = command_allocator;
+  submission.fence_value = fence_value;
+  submission.timestamp_heap = timestamp_heap;
+  submission.timestamp_readback = timestamp_readback;
+  submission.timestamp_slot = timestamp_slot;
+  {
+    std::lock_guard<std::mutex> lock(submission_mutex_);
+    submission_queue_.push_back(std::move(submission));
+    ++submissions_in_flight_;
+  }
+  submission_queued_.notify_one();
+}
