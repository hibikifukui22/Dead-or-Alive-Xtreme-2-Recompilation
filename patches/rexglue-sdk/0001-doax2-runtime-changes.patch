+SharedMemory::RangeOrigin SharedMemory::DescribeRangeOrigin(
+    uint32_t start, uint32_t length) {
+  RangeOrigin result;
+  if (!length || start >= kBufferSize || length > kBufferSize - start)
+    return result;
+  const uint32_t first = start >> page_size_log2_;
+  const uint32_t last = (start + length - 1) >> page_size_log2_;
+  auto global_lock = global_critical_region_.Acquire();
+  result.valid_range = true;
+  result.pages = last - first + 1;
+  for (uint32_t page = first; page <= last; ++page) {
+    const uint64_t bit = UINT64_C(1) << (page & 63);
+    result.valid_pages +=
+        (system_page_flags_valid_[page >> 6] & bit) != 0;
+    result.gpu_written_pages +=
+        (system_page_flags_valid_and_gpu_written_[page >> 6] & bit) != 0;
+  }
+  return result;
+}
