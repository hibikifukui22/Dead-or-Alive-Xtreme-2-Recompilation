+void D3D12CommandProcessor::SubmissionThreadMain() {
+  rex::thread::set_current_thread_name("GPU Submission");
+  const ui::d3d12::D3D12Provider& provider = GetD3D12Provider();
+  ID3D12CommandQueue* direct_queue = provider.GetDirectQueue();
+  while (true) {
+    AsyncSubmission submission;
+    {
+      std::unique_lock<std::mutex> lock(submission_mutex_);
+      submission_queued_.wait(lock,
+                              [this]() { return submission_thread_exit_ || !submission_queue_.empty(); });
+      if (submission_queue_.empty()) {
+        return;
+      }
+      submission = std::move(submission_queue_.front());
+      submission_queue_.pop_front();
+    }
+    HRESULT result = submission.command_allocator->Reset();
+    if (SUCCEEDED(result)) {
+      result = command_list_->Reset(submission.command_allocator, nullptr);
+    }
+    if (SUCCEEDED(result)) {
+      if (submission.timestamp_heap) {
+        command_list_->EndQuery(submission.timestamp_heap, D3D12_QUERY_TYPE_TIMESTAMP,
+                                submission.timestamp_slot * 2);
+      }
+      const auto replay_begin = std::chrono::steady_clock::now();
+      submission.commands->Execute(command_list_, command_list_1_, nullptr);
+      async_replay_ns_ += uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                       std::chrono::steady_clock::now() - replay_begin)
+                                       .count());
+      if (submission.timestamp_heap) {
+        command_list_->EndQuery(submission.timestamp_heap, D3D12_QUERY_TYPE_TIMESTAMP,
+                                submission.timestamp_slot * 2 + 1);
+        command_list_->ResolveQueryData(submission.timestamp_heap, D3D12_QUERY_TYPE_TIMESTAMP,
+                                        submission.timestamp_slot * 2, 2,
+                                        submission.timestamp_readback,
+                                        sizeof(uint64_t) * submission.timestamp_slot * 2);
+      }
+      result = command_list_->Close();
+    }
+    if (SUCCEEDED(result)) {
+      ID3D12CommandList* execute_command_lists[] = {command_list_};
+      direct_queue->ExecuteCommandLists(1, execute_command_lists);
+    } else {
+      REXGPU_ERROR("D3D12 asynchronous submission {} failed to record: {:08X}",
+                   submission.fence_value, uint32_t(result));
+      graphics_system_->OnHostGpuLossFromAnyThread(false);
+    }
+    // Signaled even after a failure so waits for it don't hang.
+    if (FAILED(direct_queue->Signal(submission_fence_, submission.fence_value))) {
+      REXGPU_ERROR("D3D12 asynchronous submission {} fence signal failed",
+                   submission.fence_value);
+      graphics_system_->OnHostGpuLossFromAnyThread(false);
+    }
+    ++async_submissions_;
+    submission.commands->Reset();
+    {
+      std::lock_guard<std::mutex> lock(submission_mutex_);
+      submission_free_lists_.push_back(std::move(submission.commands));
+      --submissions_in_flight_;
+    }
+    submission_done_.notify_all();
+  }
+}
