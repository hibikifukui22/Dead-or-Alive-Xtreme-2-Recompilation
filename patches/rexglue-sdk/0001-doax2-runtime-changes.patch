+bool D3D12CommandProcessor::RecordCandidateAuditResolve(
+    const draw_util::ResolveInfo& info) {
+  if (!REXCVAR_GET(d3d12_doax2_candidate_audit) ||
+      ((doax2_transform_trace_swap_serial + 1) % 120 != 119 &&
+       (doax2_transform_trace_swap_serial + 1) % 120 != 0)) return false;
+  auto& frame = interpolation_frame_recording_;
+  if (frame.audit_resolves.size() >= 256) {
+    ++frame.audit_resolves_dropped;
+    return false;
+  }
+  auto& event = frame.audit_resolves.emplace_back();
+  event.before_draw = frame.draws.size();
+  event.info = info;
+  event.base_load_serial_before = texture_cache_->base_load_serial();
+  event.event_serial = ++frame.audit_event_serial;
+  return true;
+}
+
+void D3D12CommandProcessor::RecordCandidateAuditOwnershipPlan(
+    uint32_t destination, uint32_t source, uint32_t first_tile,
+    uint32_t end_tile, bool resolve_clear,
+    std::array<uint32_t, 4> clear_rect, bool is_claim) {
+  uint64_t swap_serial;
